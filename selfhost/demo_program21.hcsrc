struct Bag<T> {
    items: [T],
}

fn sum_bag_ints(b: Bag<Int>) -> Int {
    var total = 0;
    var i = 0;
    while i < b.items.length {
        total = total + b.items[i];
        i = i + 1;
    }
    return total;
}

fn combo(a: Int, b: Int) -> Int {
    let bag = Bag<Int> { items: [10, 20, 30] };
    return sum_bag_ints(bag) + a + b;
}
