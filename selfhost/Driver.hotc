}

fn merge_doc_comment_vec(a: Vec<DocComment>, b: Vec<DocComment>) -> Vec<DocComment> {
    var out = a;
    var i = 0;
    while i < b.length() {
        out.push(b.get(i));
        i = i + 1;
    }
    return out;
}

fn merge_program(a: Program, b: Program) -> Program {
    return Program {
        fns: merge_fns(a.fns, b.fns),
        structs: merge_structs(a.structs, b.structs),
        impls: merge_impls(a.impls, b.impls),
        enums: merge_enums(a.enums, b.enums),
        externs: merge_externs(a.externs, b.externs),
        statics: merge_statics(a.statics, b.statics),
        interfaces: merge_interfaces(a.interfaces, b.interfaces),
        struct_annotation_names: merge_str_vec(a.struct_annotation_names, b.struct_annotation_names),
        struct_annotation_data: merge_annotation_vec(a.struct_annotation_data, b.struct_annotation_data),
        fn_annotation_names: merge_str_vec(a.fn_annotation_names, b.fn_annotation_names),
        fn_annotation_data: merge_annotation_vec(a.fn_annotation_data, b.fn_annotation_data),
        extend_decls: merge_extend_decl_vec(a.extend_decls, b.extend_decls),
        must_use_fn_names: merge_str_vec(a.must_use_fn_names, b.must_use_fn_names),
        struct_doc_names: merge_str_vec(a.struct_doc_names, b.struct_doc_names),
        struct_doc_data: merge_doc_comment_vec(a.struct_doc_data, b.struct_doc_data),
        fn_doc_names: merge_str_vec(a.fn_doc_names, b.fn_doc_names),
        fn_doc_data: merge_doc_comment_vec(a.fn_doc_data, b.fn_doc_data),
        uses: merge_str_vec(a.uses, b.uses),
        sendable_struct_names: merge_str_vec(a.sendable_struct_names, b.sendable_struct_names),
        components: merge_component_decl_vec(a.components, b.components),
        systems: merge_system_decl_vec(a.systems, b.systems),
    };
}

fn stdlib_topic_path(topic: String) -> String {
    return "stdlib/" + topic + ".hotc";
}

fn str_vec_contains(v: &Vec<String>, s: String) -> Bool {
    var i = 0;
    while i < v.length() {
        if v.get(i) == s { return true; }
        i = i + 1;
    }
    return false;
}

// Adds `topic` (and, transitively, everything IT depends on -- `registry` needs `vec`+`option`,
// `io` needs `option`) to `wanted`, in dependency-before-dependent order, skipping anything
// already present (so requesting the same topic twice, or two topics that share a dependency,
// never double-adds it). Returns the updated list rather than mutating `wanted` in place through
// a `&mut` param -- `Vec<T>` IS a reference type under the hood in this language (a mutation
// through a method call like `.push()` already stays visible to every other reference to the
// SAME object), but this fn deliberately doesn't rely on that: real move-checking isn't
// implemented yet (see "Status" near the top of the README), and this is written to already be
// correct the day it is, not just correct by accident of what isn't enforced yet.
// The lowest `--target` a given stdlib topic is allowed to compile under -- every topic
// currently shipped is plain, portable JDK-17-compatible code, so this is `17` across the
// board today. The real point of this fn existing separately (rather than inlining a check
// straight into `add_stdlib_topic_and_deps` below) is for the FIRST genuinely version-gated
// topic (a virtual-thread `PhoenixPool` variant for Marshmallow/MC 1.21.1, say -- see the
// compiler's own JDK-target design) to have exactly one place to declare its own minimum,
// without touching the gating mechanism itself.
fn min_target_for_topic(topic: String) -> Int {
    if topic == "phoenix_virtual" {
        return 21;
    }
    return 17;
}

fn add_stdlib_topic_and_deps(topic: String, wanted: Vec<String>, target: Int) -> Vec<String> {
    if str_vec_contains(&wanted, topic) {
        return wanted;
    }
    // Checked on every real topic exactly once (the `str_vec_contains` guard right above
    // already keeps a topic pulled in twice -- once directly, once as someone else's transitive
    // dependency -- from reaching this a second time) -- and BEFORE this topic's own transitive
    // deps get added below, so a topic that transitively pulls in something version-gated gets
    // rejected with a message naming the ACTUAL topic that's too new, not whichever one the user
    // literally wrote `use` for.
    let min_target = min_target_for_topic(topic);
    if target < min_target {
        throw ParseError::new("module 'use " + topic + ";' requires --target " + JString4::valueOf(min_target) + " or higher, got --target " + JString4::valueOf(target));
    }
    var out = wanted;
    if topic == "registry" {
        out = add_stdlib_topic_and_deps("vec", out, target);
        out = add_stdlib_topic_and_deps("option", out, target);
    } else if topic == "io" {
        out = add_stdlib_topic_and_deps("option", out, target);
    } else if topic == "ecs" {
        // `Codegen.hotc`'s own archetype-synthesis pass (see `ECS_IDEAS.md`) builds real
        // `Vec$<Component>`-typed struct fields and emits real `Vec$<T>.push()`/`.get()` calls for
        // `world.spawn(...)`/`world.run_all()` -- entirely independent of whether the user's own
        // source ever literally writes `Vec` -- so `Vec<T>`'s own generic template must always be
        // merged in for `use ecs;`, exactly like `registry`'s own transitive dependency right
        // above. A real, previously-hit gap: without this, `ensure_method_instantiated` found no
        // template at all for `Vec#push` (`self.generic_method_templates` never got Vec's own impl
        // block merged in), and `gen_vec_push_ecs` handed ASM an empty method descriptor -- a real
        // crash caught only once `world.spawn(...)` was finally exercised end-to-end.
        out = add_stdlib_topic_and_deps("vec", out, target);
        // Phase B (real parallel dispatch, see `ECS_IDEAS.md`) synthesizes a real `PhoenixPool`
        // static and `pool.spawn(...)` calls whenever any two systems can run concurrently --
        // again, independent of whether the user's own source ever writes `use phoenix;` itself.
        out = add_stdlib_topic_and_deps("phoenix", out, target);
    } else if topic == "phoenix" {
        // `PhoenixPool::join_all_and_shutdown` (see `stdlib/phoenix.hotc`'s own header) takes a
        // real `&Vec<PhoenixTask>` -- `Vec<T>`'s own generic template has to be merged in for
        // THAT method's own body to type-check at all, same "codegen/stdlib-internal usage needs
        // the dependency even when the user's own source never writes the word" reasoning `ecs`'s
        // own `vec` dependency right above already established. A real, previously-hit gap: a
        // program with `use phoenix;` alone (no `use ecs;`, which already pulls `vec` in for an
        // unrelated reason) crashed compiling `join_all_and_shutdown` itself -- `ensure_method_
        // instantiated` found no template for `Vec#length`/`Vec#get` (`self.generic_method_
        // templates` never got Vec's own impl block merged in), corrupting the emitted method
        // descriptor.
        out = add_stdlib_topic_and_deps("vec", out, target);
    } else if topic == "phoenix_virtual" {
        // Virtual-thread `PhoenixPool` variant (see `stdlib/phoenix_virtual.hotc`'s own header) --
        // a NEW, separate type from `PhoenixPool` itself, but it reuses `PhoenixTask`/
        // `PhoenixCallable`/`PhoenixExecutorService` directly rather than re-declaring them, so
        // `use phoenix_virtual;` alone (no `use phoenix;`) still needs `phoenix`'s own program
        // merged in for those types to exist at all.
        out = add_stdlib_topic_and_deps("phoenix", out, target);
    } else if topic != "vec" && topic != "option" && topic != "result" && topic != "phoenix" && topic != "ecs" && topic != "phoenix_virtual" && topic != "math" {
        throw ParseError::new("unknown stdlib module 'use " + topic + ";' -- expected one of vec, registry, option, result, io, phoenix, phoenix_virtual, ecs, math");
    }
    out.push(topic);
    return out;
}

// The real "which stdlib topics does this compile actually need" decision -- see `merge_program`'s
// own header, right above, for the full design. `requested` is the WHOLE merged program's own
// `Program.uses` (every `use topic;` line found anywhere in it, `Ast.hc`'s own `Program.uses`
// header explains why that's a flat list rather than per-file). An empty list means no `use`
// anywhere -- the 100%-backward-compatible "inject everything" default every pre-existing program
// already relies on; a non-empty list means real opt-in, resolved (with transitive deps) via
// `add_stdlib_topic_and_deps` above.
fn resolve_stdlib_modules(requested: Vec<String>, target: Int) -> Program {
    if requested.length() == 0 {
        // No `use` anywhere -- the always-portable default set, unconditionally injected
        // regardless of `target` (every one of these is plain JDK-17-compatible code, and this
        // path never calls `add_stdlib_topic_and_deps` at all, so there's nothing to gate here
        // even in principle).
        var full = parse_source_file(stdlib_topic_path("option"));
        full = merge_program(full, parse_source_file(stdlib_topic_path("result")));
        full = merge_program(full, parse_source_file(stdlib_topic_path("vec")));
        full = merge_program(full, parse_source_file(stdlib_topic_path("registry")));
        full = merge_program(full, parse_source_file(stdlib_topic_path("io")));
        return full;
    }
    var wanted = empty_str_vec2();
    var i = 0;
    while i < requested.length() {
        wanted = add_stdlib_topic_and_deps(requested.get(i), wanted, target);
        i = i + 1;
    }
    var out = parse_source_file(stdlib_topic_path(wanted.get(0)));
    var j = 1;
    while j < wanted.length() {
        out = merge_program(out, parse_source_file(stdlib_topic_path(wanted.get(j))));
        j = j + 1;
    }
    return out;
}

// A tiny, synthetic `Int`-returning, zero-param function merged in alongside the real six files,
// purely so `compile_program`'s own "no real `main` found" fallback (see `Codegen.hotc`'s own
// `main(String[])` header) has something valid to wire its synthesized entry point to --
// none of the six real files declare a zero-arg `Int`-returning top-level fn of their own (they're
// pure library code with no entry point at all), and this probe cares only about whether
// CHECKING + CODEGEN succeed for the whole merged compiler, not about running anything meaningful.
fn probe_entry_source() -> String {
    let nl = codepoint_to_string(CP_NEWLINE);
    return "fn __selfcompile_probe_entry() -> Int \{" + nl + "return 42;" + nl + "\}" + nl;
}

pub fn run_selfcompile_probe() {
    print("--- self-compilation probe: the self-hosted compiler compiling its OWN 6 source files ---");

    var prog = parse_source_file("selfhost/ast/Ast.hotc");
    prog = merge_program(prog, parse_source_file("selfhost/types/Types.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/lexer/Lexer.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/parser/Parser.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/checker/Checker.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/codegen/Codegen.hotc"));
    prog = merge_program(prog, parse_source_string(probe_entry_source()));
    prog = merge_program(resolve_stdlib_modules(prog.uses, 17), prog); // internal bootstrap probe -- always resolved at the baseline target

    print(
        "parsed " + JString4::valueOf(prog.fns.length()) + " function(s), " + JString4::valueOf(prog.structs.length())
        + " struct(s), " + JString4::valueOf(prog.impls.length()) + " impl(s), " + JString4::valueOf(prog.enums.length())
        + " enum(s), " + JString4::valueOf(prog.externs.length()) + " extern(s), " + JString4::valueOf(prog.statics.length())
        + " static(s) (prelude + all 6 real compiler source files)"
    );

    let empty_args = driver_empty_int_vec();
    let errors = compile_program(
        prog.fns, prog.structs, prog.impls, prog.enums, prog.externs, prog.statics, prog.interfaces,
        "SelfhostSelfCompileProbe", "__selfcompile_probe_entry", empty_args, "SelfhostSelfCompileProbe.class",
        prog.struct_annotation_names, prog.struct_annotation_data, prog.fn_annotation_names, prog.fn_annotation_data,
        prog.extend_decls, prog.must_use_fn_names,
        prog.struct_doc_names, prog.struct_doc_data, prog.fn_doc_names, prog.fn_doc_data, prog.sendable_struct_names,
        prog.components, prog.systems, 17, false, // internal bootstrap probe -- always compiles at the baseline target, --explain-schedule never wanted here
    );
    if report_errors(errors) {
        print("SELF-HOSTING MILESTONE: the self-hosted compiler successfully checked+compiled its own full source (ast+types+lexer+parser+checker+codegen)!");
    }
}

// === Stage 2: does the COMPILED OUTPUT of self-compilation itself work as a real compiler? ===
//
// `run_selfcompile_probe` above proves the self-hosted compiler's own lex/parse/check/codegen
// ALGORITHMS correctly process the self-hosted compiler's own source -- but the class file it
// produces has no real driving logic in it, just a trivial `-> 42` stub wired up as its entry
// point purely so codegen has somewhere to attach a `main`. This is the actual remaining question:
// take the COMPILED bytecode that came out of that (which, critically, already contains real,
// callable, self-hosted-COMPILED `lexer_new`/`parser_new`/`checker_new`/`compile_program`
// functions -- see `run_selfcompile_probe`'s own header), give it a REAL driver instead of a stub,
// and check whether THAT compiled driver can itself correctly compile a target program. This is
// merged in exactly like the six real compiler files above -- `Driver.hotc`'s own driving logic
// (`read_source_file`/`prelude_source`/`merge_*`/`run_bootstrap_demo`/`report_errors`) is real,
// working `.hotc` source already, so it goes through the exact same self-hosted-compile step as
// everything else, landing INSIDE the same produced class as compiled methods it can then call.
fn stage2_entry_source() -> String {
    let nl = codepoint_to_string(CP_NEWLINE);
    return "pub fn main(args: [String]) \{" + nl + "run_bootstrap_demo(args[0]);" + nl + "\}" + nl;
}

// **Verified, not just compiled**: run manually after this writes `SelfhostStage2Compiler.class`
// (`java -cp <asm jars>:<hotchocolate.jar, for CodegenShim>:. SelfhostStage2Compiler
// selfhost/demo_program.hcsrc`) -- the resulting standalone executable, with NO Kotlin compiler
// involved at any point in this step, correctly read, lexed, parsed, checked, and generated
// bytecode for a real target program, and the class IT wrote (`SelfhostDemoProgram.class`) prints
// exactly `18` when run, matching `demo_program.hcsrc`'s own known-correct expected value. This is
// the actual, complete, end-to-end self-hosting fixed point: a compiler written in HotChocolate,
// compiled BY ITSELF, correctly compiling a real HotChocolate program into correct, runnable
// bytecode -- verified by running the real output, not just by the absence of a reported error.
pub fn run_selfcompile_stage2() {
    print("--- self-compilation stage 2: building a real, standalone, self-hosted-COMPILED compiler executable ---");

    var prog = parse_source_file("selfhost/ast/Ast.hotc");
    prog = merge_program(prog, parse_source_file("selfhost/types/Types.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/lexer/Lexer.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/parser/Parser.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/checker/Checker.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/codegen/Codegen.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/Driver.hotc"));
    prog = merge_program(prog, parse_source_string(stage2_entry_source()));
    prog = merge_program(resolve_stdlib_modules(prog.uses, 17), prog); // internal bootstrap probe -- always resolved at the baseline target

    print(
        "parsed " + JString4::valueOf(prog.fns.length()) + " function(s), " + JString4::valueOf(prog.structs.length())
        + " struct(s) for the stage-2 compiler executable"
    );

    let empty_args = driver_empty_int_vec();
    let errors = compile_program(
        prog.fns, prog.structs, prog.impls, prog.enums, prog.externs, prog.statics, prog.interfaces,
        "SelfhostStage2Compiler", "__selfcompile_probe_entry", empty_args, "SelfhostStage2Compiler.class",
        prog.struct_annotation_names, prog.struct_annotation_data, prog.fn_annotation_names, prog.fn_annotation_data,
        prog.extend_decls, prog.must_use_fn_names,
        prog.struct_doc_names, prog.struct_doc_data, prog.fn_doc_names, prog.fn_doc_data, prog.sendable_struct_names,
        prog.components, prog.systems, 17, false, // internal bootstrap probe -- always compiles at the baseline target, --explain-schedule never wanted here
    );
    if report_errors(errors) {
        print("wrote SelfhostStage2Compiler.class -- run it with a real target .hotc/.hcsrc path as argv[0] to test the true fixed point.");
    }
}

// === Stage 3: the actual triple-bootstrap test -- can gen1 rebuild itself with ZERO Kotlin? ===
//
// `run_selfcompile_stage2` above still runs INSIDE a process that Kotlin compiled (`TestDriver.hotc`
// itself was compiled by the real `hc`) -- the resulting `SelfhostStage2Compiler.class` ("gen1") is
// genuinely self-hosted-COMPILED bytecode, and stage 2 already proved gen1 can compile an unrelated
// target program standalone, but nothing yet has asked gen1 to compile the SAME SIX SOURCE FILES
// that produced it, running with no Kotlin anywhere in that step. That's the real fixed-point
// question: does the self-hosted compiler regenerate a working copy of itself, using only itself?
//
// This entry source is deliberately near-identical to `stage2_entry_source` -- the only difference
// is what `main` calls. Instead of driving a single demo file, gen1's `main` here calls
// `run_selfcompile_stage2()` directly (already baked into it, since `Driver.hotc` -- this whole
// file, including that very function -- is merged into every stage-2/3 build the same way the six
// core compiler files are). Running the resulting class re-executes the ENTIRE stage-2 build
// process again, but this time every step of it (`parse_source_file` reading the six real `.hotc`
// files fresh off disk, lexing/parsing/checking/codegen-ing them, writing the output class) runs as
// gen1's own compiled bytecode -- zero Kotlin involved. It overwrites `SelfhostStage2Compiler.class`
// with a freshly-produced "gen2" -- if gen2 also runs and correctly compiles a target program (same
// verification stage 2 already did), gen1 has proven it can rebuild a working copy of itself.
// Calls `run_selfcompile_stage2` (rebuilds `SelfhostStage2Compiler.class`, i.e. gen2),
// `run_selfcompile_stage3_prep` (rebuilds `SelfhostSelfReplicator.class` itself), AND
// `run_selfcompile_cli_prep` (rebuilds `SelfhostCLI.class`, the real general-purpose entry point)
// -- proving the fixed point is stable for the WHOLE toolchain, not just one artifact: if the
// replicator can regenerate an identical copy of itself, the stage-2 compiler, AND the CLI, then
// this ONE checked-in class file is a permanent, sufficient bootstrap seed -- see
// `selfhost/bootstrap/README.md` for what that actually means for retiring the Kotlin compiler.
fn stage3_entry_source() -> String {
    let nl = codepoint_to_string(CP_NEWLINE);
    return "pub fn main(args: [String]) \{" + nl + "run_selfcompile_stage2();" + nl + "run_selfcompile_stage3_prep();" + nl + "run_selfcompile_cli_prep();" + nl + "\}" + nl;
}

// **Verified, not just compiled**: run manually after this writes `SelfhostSelfReplicator.class`
// (`java -cp <asm jars>:<hotchocolate.jar>:. SelfhostSelfReplicator`, no argv needed) -- this
// standalone executable, again with NO Kotlin compiler involved, re-parses/checks/codegens the same
// six real compiler source files that built IT, overwriting `SelfhostStage2Compiler.class` with a
// freshly self-self-compiled "gen2". Confirmed: gen2 runs and correctly compiles
// `selfhost/demo_program.hcsrc` to `18`, exactly like gen1 did -- the actual triple-bootstrap fixed
// point, entirely under the self-hosted compiler's own steam past this one build.
pub fn run_selfcompile_stage3_prep() {
    print("--- self-compilation stage 3 prep: building the executable that will rebuild ITSELF with no Kotlin involved ---");

    var prog = parse_source_file("selfhost/ast/Ast.hotc");
    prog = merge_program(prog, parse_source_file("selfhost/types/Types.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/lexer/Lexer.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/parser/Parser.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/checker/Checker.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/codegen/Codegen.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/Driver.hotc"));
    prog = merge_program(prog, parse_source_string(stage3_entry_source()));
    prog = merge_program(resolve_stdlib_modules(prog.uses, 17), prog); // internal bootstrap probe -- always resolved at the baseline target

    print(
        "parsed " + JString4::valueOf(prog.fns.length()) + " function(s), " + JString4::valueOf(prog.structs.length())
        + " struct(s) for the self-replicating executable"
    );

    let empty_args = driver_empty_int_vec();
    let errors = compile_program(
        prog.fns, prog.structs, prog.impls, prog.enums, prog.externs, prog.statics, prog.interfaces,
        "SelfhostSelfReplicator", "__selfcompile_probe_entry", empty_args, "SelfhostSelfReplicator.class",
        prog.struct_annotation_names, prog.struct_annotation_data, prog.fn_annotation_names, prog.fn_annotation_data,
        prog.extend_decls, prog.must_use_fn_names,
        prog.struct_doc_names, prog.struct_doc_data, prog.fn_doc_names, prog.fn_doc_data, prog.sendable_struct_names,
        prog.components, prog.systems, 17, false, // internal bootstrap probe -- always compiles at the baseline target, --explain-schedule never wanted here
    );
    if report_errors(errors) {
        print("wrote SelfhostSelfReplicator.class -- run it standalone (no args) to rebuild SelfhostStage2Compiler.class with zero Kotlin involved.");
    }
}

fn cpprobe_bool_str(b: Bool) -> String {
    if b { return "true"; }
    return "false";
}

// A local copy of the same "empty `Vec<String>`" idiom used everywhere else in this codebase --
// NOT a call to `Checker.hotc`'s own `empty_str_vec2` (a real gap found running this exact probe:
// non-`pub` top-level fns are only accessible from bytecode generated INTO the same declaring
// file/class; calling one cross-file compiles cleanly under the flat source-level namespace this
// bootstrap otherwise relies on everywhere, but fails at class-LOAD time with a genuine
// `IllegalAccessError`, since the real JVM access check runs on the generated class file, not the
// source).
fn cpprobe_empty_str_vec() -> Vec<String> {
    var v = vec_of("__init__");
    return Vec { data: v.data, len: 0 };
}

// === Real classpath threading, verified end to end ===
//
// `Checker.hotc`'s own `verify_extern_signature`/`class_exists_reflect`/`resolve_real_methods` used
// to only ever consult the context classloader -- this fn proves a real `--classpath`-style
// `Vec<String>` of directory/jar paths is now genuinely consulted, not just accepted and ignored.
// `cp_test_scratch/classes/HcCpProbeTarget.class` (a plain `public static int triple(int)`,
// compiled with a real `javac` -- see this repo's own scratch setup, not checked in) is NOT on any
// default classloader's classpath at all, so `class_exists_reflect` can only find it when the real
// directory is actually passed and actually used to build a `URLClassLoader`.
pub fn run_classpath_verify_probe() {
    print("--- classpath-threaded reflection probe: does verify_extern_signature actually use a custom --classpath? ---");

    var empty_cp = cpprobe_empty_str_vec();
    var real_cp = vec_of("cp_test_scratch/classes");

    let found_without_cp = class_exists_reflect("HcCpProbeTarget", &empty_cp);
    let found_with_cp = class_exists_reflect("HcCpProbeTarget", &real_cp);
    print("found without classpath (expect false): " + cpprobe_bool_str(found_without_cp));
    print("found with classpath (expect true): " + cpprobe_bool_str(found_with_cp));

    // `checker_new()` seeds `errors` with one placeholder entry (`errs.set(0, "")`, never trimmed
    // back to length 0 -- see that fn's own body) -- `errors.length()` is always "1 + real error
    // count", not a bare count, matching this codebase's own established convention elsewhere
    // (real gap found writing THIS probe: assumed a bare 0/1 count at first, which made a genuinely
    // correct signature look like a failure).
    var checker = checker_new();
    let baseline = checker.errors.length(); // 1, not 0
    var correct_params = vec_of("Int");
    checker.verify_extern_signature("HcCpProbeTarget", "HcCpProbeTarget", "triple", correct_params, "Int", true, false, &real_cp);
    let after_correct = checker.errors.length() - baseline;
    print("real errors after a CORRECT declared signature (expect 0): " + JString4::valueOf(after_correct));

    var wrong_params = vec_of("String");
    checker.verify_extern_signature("HcCpProbeTarget", "HcCpProbeTarget", "triple", wrong_params, "Int", true, false, &real_cp);
    let after_wrong = checker.errors.length() - baseline;
    print("real errors after a WRONG declared signature too (expect 1): " + JString4::valueOf(after_wrong));

    if !found_without_cp && found_with_cp && after_correct == 0 && after_wrong == 1 {
        print("CLASSPATH-THREADING PROBE PASSED: a custom --classpath entry is genuinely being consulted, not just the context classloader.");
    } else {
        print("CLASSPATH-THREADING PROBE FAILED");
    }
}
