}

// Not named `main` -- `TestDriver.hotc` already owns this compile's entry point (directory-mode
// merges every file into one program, and two top-level fns both named `main` would collide).
// Called from `TestDriver.hotc`'s own `main(args: [String])` as this phase's final section,
// forwarding real argv through.
pub fn run_bootstrap_demo(path: String) {
    print("--- bootstrap: compiling " + path + " ---");
    let src = read_source_file(path);
    var lex = lexer_new(src);
    let toks = lex.tokenize();
    var p = parser_new(toks);
    let real_prog = p.parse_program();

    let prelude_prog = resolve_stdlib_modules(real_prog.uses, 17); // internal bootstrap probe -- always resolved at the baseline target

    let prog_fns = merge_fns(prelude_prog.fns, real_prog.fns);
    let prog_structs = merge_structs(prelude_prog.structs, real_prog.structs);
    let prog_impls = merge_impls(prelude_prog.impls, real_prog.impls);
    let prog_enums = merge_enums(prelude_prog.enums, real_prog.enums);
    let prog_externs = merge_externs(prelude_prog.externs, real_prog.externs);
    let prog_statics = merge_statics(prelude_prog.statics, real_prog.statics);
    let prog_interfaces = merge_interfaces(prelude_prog.interfaces, real_prog.interfaces);
    let prog_struct_ann_names = merge_str_vec(prelude_prog.struct_annotation_names, real_prog.struct_annotation_names);
    let prog_struct_ann_data = merge_annotation_vec(prelude_prog.struct_annotation_data, real_prog.struct_annotation_data);
    let prog_fn_ann_names = merge_str_vec(prelude_prog.fn_annotation_names, real_prog.fn_annotation_names);
    let prog_fn_ann_data = merge_annotation_vec(prelude_prog.fn_annotation_data, real_prog.fn_annotation_data);
    let prog_extend_decls = merge_extend_decl_vec(prelude_prog.extend_decls, real_prog.extend_decls);
    let prog_must_use_fn_names = merge_str_vec(prelude_prog.must_use_fn_names, real_prog.must_use_fn_names);
    let prog_struct_doc_names = merge_str_vec(prelude_prog.struct_doc_names, real_prog.struct_doc_names);
    let prog_struct_doc_data = merge_doc_comment_vec(prelude_prog.struct_doc_data, real_prog.struct_doc_data);
    let prog_fn_doc_names = merge_str_vec(prelude_prog.fn_doc_names, real_prog.fn_doc_names);
    let prog_fn_doc_data = merge_doc_comment_vec(prelude_prog.fn_doc_data, real_prog.fn_doc_data);

    print("parsed " + JString4::valueOf(prog_fns.length()) + " function(s), " + JString4::valueOf(prog_structs.length()) + " struct(s), " + JString4::valueOf(prog_impls.length()) + " impl(s), " + JString4::valueOf(prog_enums.length()) + " enum(s), " + JString4::valueOf(prog_externs.length()) + " extern(s), " + JString4::valueOf(prog_statics.length()) + " static(s) (prelude included)");

    var args = vec_of(3);
    args.push(4);
    let errors = compile_program(prog_fns, prog_structs, prog_impls, prog_enums, prog_externs, prog_statics, prog_interfaces, "SelfhostDemoProgram", "combo", args, "SelfhostDemoProgram.class", prog_struct_ann_names, prog_struct_ann_data, prog_fn_ann_names, prog_fn_ann_data, prog_extend_decls, prog_must_use_fn_names, prog_struct_doc_names, prog_struct_doc_data, prog_fn_doc_names, prog_fn_doc_data, merge_str_vec(prelude_prog.sendable_struct_names, real_prog.sendable_struct_names), merge_component_decl_vec(prelude_prog.components, real_prog.components), merge_system_decl_vec(prelude_prog.systems, real_prog.systems), 17, false); // internal bootstrap probe -- always compiles at the baseline target, --explain-schedule never wanted here
    if report_errors(errors) {
        print("wrote SelfhostDemoProgram.class (combo(3, 4) should print 18 when run)");
    }
}

// Prints any real error and returns `true` when there were none -- single pass over `errs`
// covering both "does anything need reporting" and "print it," since `errs` is move-only and a
// separate check-then-print pair (like `TestDriver.hotc`'s own `print_errors`) would need it read
// twice.
fn report_errors(errs: Vec<String>) -> Bool {
    var i = 0;
    var clean = true;
    while i < errs.length() {
        let e = errs.get(i);
        if e != "" {
            print(e);
            clean = false;
        }
        i = i + 1;
    }
    return clean;
}

extern class JString4 = "java.lang.String" {
    static fn valueOf(v: Int) -> String;
}

// === Self-compilation probe: the actual fixed-point test ===
//
// Every `run_bootstrap_demo` call above compiles a SINGLE real `.hotc` source file (or, in
// `TestDriver.hotc`'s multi-file cases, a single self-contained demo). Trying that same
// single-file approach directly against the self-hosted compiler's OWN 6 real source files
// (`ast/Ast.hotc`, `types/Types.hotc`, `lexer/Lexer.hotc`, `parser/Parser.hotc`,
// `checker/Checker.hotc`, `codegen/Codegen.hotc`) fails immediately and UNINFORMATIVELY on every
// file but `Ast.hotc`/`Lexer.hotc` -- not because of any real self-hosting gap, but simply because
// each file references types/functions declared in ANOTHER one of the six (`Parser.hotc` uses
// `FnDecl`/`StructDecl` from `Ast.hotc`, `Checker.hotc` uses `FnSig` from `Types.hotc`, etc.),
// and a single-file compile never merges those in. This mirrors exactly the same problem the REAL
// Kotlin compiler's own directory-mode compilation exists to solve (`Main.kt`'s own `parseEntry`
// merging every `.hotc` file in a directory into one program) -- so the fix here is the same idea,
// built from the merge helpers already sitting right above (`merge_fns`/`merge_structs`/etc.,
// used so far only to merge the PRELUDE in) generalized to merge all SIX real files together too.
fn parse_source_file(path: String) -> Program {
    let src = read_source_file(path);
    var lex = lexer_new(src);
    let toks = lex.tokenize();
    var p = parser_new(toks);
    return p.parse_program();
}

fn parse_source_string(src: String) -> Program {
    var lex = lexer_new(src);
    let toks = lex.tokenize();
    var p = parser_new(toks);
    return p.parse_program();
}

// Bare generic struct construction (`Vec { ... }`, no explicit `<Arg>`) only infers its type
// argument from the surrounding `return`'s OWN declared type (see `demo_program40.hcsrc`'s own
// header on the real, disclosed scope of that inference) -- NOT from a `let` binding's init
// expression, which is exactly the shape `let empty_args = Vec { data: [0; 1], len: 0 };` used to
// be, and exactly why it failed the self-hosted checker with "unknown struct or enum variant
// 'Vec'" merging this file into `run_selfcompile_stage2`'s own program. Routing the SAME
// construction through a real `return` inside a small helper (matching every other bare-`Vec{}`
// site already proven working across `Checker.hotc`/`Codegen.hotc`/`Parser.hotc`/`Types.hotc`,
// e.g. their own pervasive `return Vec { data: v.data, len: 0 };`) fixes it.
fn driver_empty_int_vec() -> Vec<Int> {
    return Vec { data: [0; 1], len: 0 };
}

fn merge_interfaces(a: Vec<InterfaceDecl>, b: Vec<InterfaceDecl>) -> Vec<InterfaceDecl> {
    var out = a;
    var i = 0;
    while i < b.length() {
        out.push(b.get(i));
        i = i + 1;
    }
    return out;
}

fn merge_str_vec(a: Vec<String>, b: Vec<String>) -> Vec<String> {
    var out = a;
    var i = 0;
    while i < b.length() {
        out.push(b.get(i));
        i = i + 1;
    }
    return out;
}

fn merge_annotation_vec(a: Vec<Annotation>, b: Vec<Annotation>) -> Vec<Annotation> {
    var out = a;
    var i = 0;
    while i < b.length() {
        out.push(b.get(i));
        i = i + 1;
    }
    return out;
}

fn merge_extend_decl_vec(a: Vec<ExtendDecl>, b: Vec<ExtendDecl>) -> Vec<ExtendDecl> {
    var out = a;
    var i = 0;
    while i < b.length() {
        out.push(b.get(i));
