module hc.selfhost.driver;

// The self-hosted bootstrap driver, phase 1 -- reads a real source file off disk, runs it through
// the self-hosted lexer -> parser -> checker -> codegen pipeline (each phase already ported and
// individually verified), and writes a real, loadable, runnable `.class` file.
//
// **Argv gap closed**: HC's own `fn main()` used to take no arguments at all -- fixed at the real
// compiler level (`Checker.kt`'s main-signature validation, `CodeGen.kt`'s two entry-wrapper
// blocks) to also accept a single `[String]` param, forwarded straight through from the JVM's own
// `main(String[])`. `TestDriver.hotc`'s `main(args: [String])` now takes this file's source path
// from real argv (falling back to the hardcoded demo path when none is given) instead of always
// reading a compiled-in constant -- see `run_bootstrap_demo` below.

// Plain `extern class` (no `interface` keyword) -- `extern class X = "..." interface {}` is a
// DIFFERENT declaration form the real compiler supports (see `Parser.kt`'s own
// `externClassOrInterfaceDecl`) that the self-hosted `Parser.hotc` doesn't parse at all (a real,
// disclosed gap found running `run_selfcompile_stage2`: "unexpected token 'interface'" merging
// this file in). `JPath` is only ever used as an opaque passthrough return/param type here (never
// has a method called ON it directly), so the plain, method-less form works identically for this
// file's own purposes and keeps `Driver.hotc` itself mergeable into a self-hosted compile.
extern class JPath = "java.nio.file.Path" {}
extern class JPaths = "java.nio.file.Paths" {
    static fn get(first: String, more: [String]) -> JPath;
}
extern class JFiles2 = "java.nio.file.Files" {
    static fn readString(p: JPath) -> String;
}

fn read_source_file(path: String) -> String {
    let p = JPaths::get(path, ["x"; 0]);
    return JFiles2::readString(p);
}

// `hc doc`'s own Markdown output -- plain `java.io.FileWriter` rather than
// `java.nio.file.Files.writeString` (which needs a varargs `OpenOption...` trailing param, real
// friction for the same "no real array-of-arbitrary-length construction beyond a fixed literal"
// reason `byte[]` itself is a known gap, see `IDEAS.md`'s own "A `Byte` primitive type" entry) --
// no byte[]/varargs involved here at all, just a plain three-call `forName`/`write`/`close`. The
// explicit `Charset` (Java 11's own `FileWriter(String, Charset)` overload, not the ancient
// platform-default-encoding constructor) matters for real: a doc comment's own text is ordinary
// user-authored prose, not guaranteed ASCII, and the platform-default constructor silently
// mangled a real em dash into `?` on this very session's own first verification run on Windows.
extern class JCharset = "java.nio.charset.Charset" {
    static fn forName(name: String) -> Self;
}
extern class JFileWriter = "java.io.FileWriter" {
    fn new(path: String, cs: JCharset) -> Self;
    fn write(&self, s: String);
    fn close(&self);
}

fn write_text_file(path: String, content: String) {
    let cs = JCharset::forName("UTF-8");
    var w = JFileWriter::new(path, cs);
    w.write(content);
    w.close();
}

// === Directory-mode CLI: mirrors the real compiler's own `Main.kt` `parseEntry` ===
// Walks a directory collecting every `.hotc` file, sorted by path for determinism (matching the
// real compiler's own `sortedBy { it.relativeTo(path).path }` -- merge order otherwise depends on
// `File.listFiles()`'s unspecified OS-level ordering, which would make `hc run <dir>` produce a
// different program from run to run of the exact same source), and merges them into one flat-
// namespace `Program`, same as `hc run <dir>`/`hc build <dir>` do at the Kotlin level.
extern class JFileCli = "java.io.File" {
    fn new(path: String) -> Self;
    fn listFiles(&self) -> [JFileCli];
    fn isDirectory(&self) -> Bool;
    fn isFile(&self) -> Bool;
    fn getPath(&self) -> String;
    fn getName(&self) -> String;
}

// `run_cli`'s own "run" mode (`SelfhostCLI run <path>`, mirroring `hc run`'s "compile AND
// execute" contract, as opposed to the bare `SelfhostCLI <path> [outPath]` build-only form) needs
// to actually EXECUTE the freshly-compiled class after writing it, with real stdin/stdout wired
// through -- a genuine child `java` process (`ProcessBuilder`, `inheritIO()`) rather than
// reflectively `Method.invoke`-ing `main` in-process, since invoking a real Java varargs method
// (`Method.invoke(Object, Object...)`) would need building a real `Object[]` wrapping the `String[]`
// args array, and this subset's arrays need a concrete element type inferred from a real first
// element (see `Ast.hc`'s own `ArrayRepeat`/`ArrayLit` codegen) -- there's no "Object" reference
// type to build one from. A child process sidesteps that entirely, and `inheritIO()` gets real
// stdin/stdout/stderr connected for free, matching exactly what `examples/battle`'s own
// `read_line()` call and `examples/calc`'s own `read_int()`/`read_string()` calls need.
// `java.class.path` -- the RUNNING process's own classpath (however `SelfhostCLI` itself was
// launched, `-cp "<jars>;."` per `selfhost/bootstrap/README.md`) -- is reused verbatim for the
// child, so the freshly-written class (in the current working directory, already on that same
// classpath) resolves the same way the parent process itself does.
extern class JSystemCli = "java.lang.System" {
    static fn getProperty(key: String) -> String;
}
// `--target 17|21|25` -- see `run_cli`'s own header. Only ever fed a value already validated to
// be digits by the CALLER (no try/catch around this -- a genuinely malformed `--target` value is
// a real, disclosed "crash with Java's own NumberFormatException" case for now, same trust-the-
// caller convention `JInteger` is bound here for, not softened with a friendlier error yet).
extern class JInteger = "java.lang.Integer" {
    static fn parseInt(s: String) -> Int;
}
extern class JProcessBuilderCli = "java.lang.ProcessBuilder" {
    fn new(cmd: [String]) -> Self;
    fn inheritIO(&mut self) -> JProcessBuilderCli;
    fn start(&self) -> JProcessCli;
}
extern class JProcessCli = "java.lang.Process" {
    fn waitFor(&mut self) -> Int;
}

// Real bug found auditing directory-mode compilation: this only ever matched `.hotc`, the
// extension this compiler's OWN self-hosted source uses (`selfhost/*.hotc`) -- but every real
// example and mod project (`examples/multifile/`, the Gradle plugin's `sourceDir`) uses plain
// `.hc`, same as single-file mode already accepts unconditionally (`base_name_no_ext`'s own
// header: "NOT extension-gated at all" for a single-file target). Directory mode silently
// collected zero files for any real `.hc` project -- `parse_directory`'s `files.get(0)` on that
// empty result then read back stale backing-array data (`"__init__"`, this Vec's own placeholder
// sentinel) instead of a real path, surfacing many steps later as a confusing
// `NoSuchFileException: __init__` with no obvious connection to "wrong extension". Both
// extensions are accepted now, matching single-file mode's own already-permissive behavior.
fn ends_with_hotc(name: String) -> Bool {
    return ends_with_suffix(name, ".hotc") || ends_with_suffix(name, ".hc");
}

fn ends_with_suffix(name: String, suffix: String) -> Bool {
    let nlen = name.length();
    let slen = suffix.length();
    if nlen < slen { return false; }
    return name.substring(nlen - slen, nlen) == suffix;
}

// No native `String` ordering operator in this subset (`<`/`>` are Int/Long-only, see
// `Checker.hotc`'s own `check_binary`) -- a plain codepoint-by-codepoint comparison via
// `codePointAt` is both simpler than porting a real collation and sufficient here, since this only
// needs to match the real compiler's own plain-path-string `sortedBy` (not real locale collation).
fn str_less_than(a: String, b: String) -> Bool {
    var i = 0;
    let alen = a.length();
    let blen = b.length();
    while i < alen && i < blen {
        let ca = a.codePointAt(i);
        let cb = b.codePointAt(i);
        if ca < cb { return true; }
        if ca > cb { return false; }
        i = i + 1;
    }
    return alen < blen;
}

fn sort_str_vec(v: Vec<String>) -> Vec<String> {
    var out = v;
    var i = 1;
    while i < out.length() {
        let key = out.get(i);
        var j = i - 1;
        var placed = false;
        while j >= 0 && !placed {
            let cur = out.get(j);
            if str_less_than(key, cur) {
                out.set(j + 1, cur);
                j = j - 1;
            } else {
                placed = true;
            }
        }
        out.set(j + 1, key);
        i = i + 1;
    }
    return out;
}

fn collect_hotc_files(dir_path: String) -> Vec<String> {
    var out = empty_str_vec2();
    let dir = JFileCli::new(dir_path);
    let entries = dir.listFiles();
    var i = 0;
    while i < entries.length {
        let e = entries[i];
        if e.isDirectory() {
            let sub = collect_hotc_files(e.getPath());
            var j = 0;
            while j < sub.length() {
                out.push(sub.get(j));
                j = j + 1;
            }
        } else if e.isFile() && ends_with_hotc(e.getName()) {
            out.push(e.getPath());
        }
        i = i + 1;
    }
    return out;
}

fn last_index_of_char(s: String, cp: Int) -> Int {
    var idx = -1;
    var i = 0;
    while i < s.length() {
        if s.codePointAt(i) == cp { idx = i; }
        i = i + 1;
    }
    return idx;
}

// Derives a JVM-legal-ish binary name from a source path (`selfhost/ast/Ast.hotc` -> `Ast`,
// `myproject` (a directory) -> `myproject`) -- real, disclosed scope cut: no sanitization of
// characters that aren't already valid in a Java identifier (matching this whole codebase's
// existing "trust the input, don't guess" convention), just enough to name the output class for a
// normal project/file path.
fn base_name_no_ext(path: String) -> String {
    // A real gap found running this compiler on a Windows ABSOLUTE path
    // (`C:\Users\...\CategoryDefinition.hotc`, real usage piloting Minecraft-modding on top of
    // this compiler): `CP_SLASH` alone finds nothing in a backslash-separated path, so `name`
    // stayed the WHOLE path (drive letter, every directory, backslashes and all) -- a real,
    // invalid JVM class name. Whichever separator appears LAST wins (a mixed path, unlikely but
    // possible, still resolves to its real last path segment either way).
    let slash_idx1 = last_index_of_char(path, CP_SLASH);
    let slash_idx2 = last_index_of_char(path, CP_BACKSLASH);
    var slash_idx = slash_idx1;
    if slash_idx2 > slash_idx1 {
        slash_idx = slash_idx2;
    }
    var name = path;
    if slash_idx >= 0 {
        name = path.substring(slash_idx + 1, path.length());
    }
    // Strips whatever extension is actually present (`.hotc`, `.hcsrc`, ...), matching the real
    // compiler's own `File.nameWithoutExtension` -- NOT hardcoded to `.hotc` specifically, since a
    // single-file target (unlike directory-mode's own file COLLECTION) isn't extension-gated at all.
    let dot_idx = last_index_of_char(name, CP_DOT);
    if dot_idx > 0 {
        name = name.substring(0, dot_idx);
    }
    return name;
}

// Does `name` (the file-derived program/entry-class name -- `base_name_no_ext`'s own result)
// collide with a struct or enum the TARGET PROGRAM ITSELF declares? A real, found-by-actually-
// piloting-a-real-mod gap: `compile_program`'s own `binary_name` param becomes the JVM class name
// of the program's "entry holder" class (top-level fns/statics/the generated `main(String[])`) --
// completely unrelated to the file's OWN declared structs, EXCEPT when one of them happens to
// share the file's own name, an extremely natural pattern (`Player.hotc` declaring `struct
// Player`) that silently corrupted the compiled output before this check existed: `gen_struct`
// would overwrite the SAME "Player.class" the entry holder needed, with no `main` at all left in
// it. See `run_cli`'s own header for the fix (mangling the entry class name, never the struct's).
fn name_collides_with_decl(name: String, structs: &Vec<StructDecl>, enums: &Vec<EnumDecl>) -> Bool {
    var i = 0;
    while i < structs.length() {
        if structs.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    var j = 0;
    while j < enums.length() {
        if enums.get(j).name == name {
            return true;
        }
        j = j + 1;
    }
    return false;
}

fn parse_directory(dir_path: String) -> Program {
    var files = collect_hotc_files(dir_path);
    files = sort_str_vec(files);
    var prog = parse_source_file(files.get(0));
    var i = 1;
    while i < files.length() {
        prog = merge_program(prog, parse_source_file(files.get(i)));
        i = i + 1;
    }
    return prog;
}

// The real, general-purpose entry point this whole effort has been building toward: takes a single
// real target path from argv (a `.hotc` file OR a project directory, exactly like `hc run`/`hc
// build`'s own second positional arg), and compiles it -- no hardcoded demo file, no hardcoded
// entry function, no hardcoded six-file list. `entry_name`/`entry_args` here are a harmless
// placeholder (same convention `run_selfcompile_stage2`'s own `__selfcompile_probe_entry` already
// uses): `compile_program`'s own priority logic prefers a REAL `main` in the target program itself
// first, so a normal target program with its own `pub fn main() ...` never reaches this fallback at
// all -- it only fires if the target defines neither, matching this subset's existing convention
// (see `Codegen.hotc`'s own `compile_program` header) rather than inventing a new one here.
// `hc doc <dir|file> [outFile]` -- the renderer half of structured `///` doc comments (the
// attachment/`@see`-resolution half shipped 2026-09-03, see README's own "Structured doc
// comments" section). One documented `struct`/`fn` per `###` heading, `@param`s as a bullet
// list, `@warning` as a blockquote, `@see` targets backtick-quoted. Deliberately does NOT mark an
// unresolved `@see` inline the way the retired Kotlin compiler's own version did -- `Checker.hotc`'s
// own `check_doc_sees` already rejects a dead `@see` link as a real COMPILE ERROR (run by
// `run_doc_cli`'s own `compile_program` call, right below, same as `build`/`run`), so rendering
// only ever happens once every `@see` in the program is already known-valid -- there's no
// "unresolved" case left by the time this runs at all.
fn render_doc_section(title: String, names: Vec<String>, docs: Vec<DocComment>) -> String {
    let nl = codepoint_to_string(CP_NEWLINE);
    var out = "";
    if names.length() == 0 { return out; }
    out = out + "## " + title + nl + nl;
    var i = 0;
    while i < names.length() {
        let name = names.get(i);
        let d = docs.get(i);
        out = out + "### `" + name + "`" + nl + nl;
        if d.summary != "" {
            out = out + d.summary + nl + nl;
        }
        if d.param_names.length() > 0 {
            out = out + "**Parameters:**" + nl;
            var pi = 0;
            while pi < d.param_names.length() {
                out = out + "- `" + d.param_names.get(pi) + "` -- " + d.param_texts.get(pi) + nl;
                pi = pi + 1;
            }
            out = out + nl;
        }
        if d.returns_text != "" {
            out = out + "**Returns:** " + d.returns_text + nl + nl;
        }
        if d.example_text != "" {
            out = out + "**Example:** " + d.example_text + nl + nl;
        }
        if d.warning_text != "" {
            out = out + "> **Warning:** " + d.warning_text + nl + nl;
        }
        if d.has_deprecated {
            if d.deprecated_text != "" {
                out = out + "**Deprecated:** " + d.deprecated_text + nl + nl;
            } else {
                out = out + "**Deprecated.**" + nl + nl;
            }
        }
        if d.see_targets.length() > 0 {
            out = out + "**See also:** ";
            var si = 0;
            while si < d.see_targets.length() {
                if si > 0 { out = out + ", "; }
                out = out + "`" + d.see_targets.get(si) + "`";
                si = si + 1;
            }
            out = out + nl + nl;
        }
        i = i + 1;
    }
    return out;
}

fn render_doc_markdown(struct_names: Vec<String>, struct_docs: Vec<DocComment>, fn_names: Vec<String>, fn_docs: Vec<DocComment>) -> String {
    let nl = codepoint_to_string(CP_NEWLINE);
    var out = "# API Documentation" + nl + nl;
    out = out + render_doc_section("Structs", struct_names, struct_docs);
    out = out + render_doc_section("Functions", fn_names, fn_docs);
    return out;
}

// `SelfhostCLI doc <path> [outFile]` -- same parse/merge-prelude/compile pipeline `run_cli`'s own
// build path uses (a real checker pass, `@see` resolution included, genuinely runs), then renders
// `Program`'s own doc-comment side-channel to Markdown once that succeeds. Split out as its own
// fn (rather than inlined into `run_cli` as one more branch) purely to keep its own local variable
// names from colliding with `run_cli`'s identically-purposed ones (`path`/`prog`/`name`/...) in
// the same function scope.
// `off` -- how many leading argv slots `run_cli`'s own `--target` handling already consumed (0
// if it wasn't present) -- every OTHERWISE-fixed-position `args[N]` access here shifts by it,
// since `[String]` has no slicing operation to hand this fn a shorter view instead.
fn run_doc_cli(args: [String], off: Int, target: Int, explain_schedule: Bool) {
    let doc_path = args[off + 1];
    var doc_out = "api.md";
    if args.length > off + 2 { doc_out = args[off + 2]; }
    let df = JFileCli::new(doc_path);
    var dprog = parse_source_string("");
    if df.isDirectory() {
        dprog = parse_directory(doc_path);
    } else {
        dprog = parse_source_file(doc_path);
    }
    dprog = merge_program(resolve_stdlib_modules(dprog.uses, target), dprog);
    let dname0 = base_name_no_ext(doc_path);
    var dname = dname0;
    if name_collides_with_decl(dname0, &dprog.structs, &dprog.enums) {
        dname = dname0 + "$Program";
    }
    let dclass_out = dname + ".class";
    let dempty_args = driver_empty_int_vec();
    let derrors = compile_program(
        dprog.fns, dprog.structs, dprog.impls, dprog.enums, dprog.externs, dprog.statics, dprog.interfaces,
        dname, "__selfcompile_probe_entry", dempty_args, dclass_out,
        dprog.struct_annotation_names, dprog.struct_annotation_data, dprog.fn_annotation_names, dprog.fn_annotation_data,
        dprog.extend_decls, dprog.must_use_fn_names,
        dprog.struct_doc_names, dprog.struct_doc_data, dprog.fn_doc_names, dprog.fn_doc_data, dprog.sendable_struct_names,
        dprog.components, dprog.systems, target, explain_schedule,
    );
    if report_errors(derrors) {
        let md = render_doc_markdown(dprog.struct_doc_names, dprog.struct_doc_data, dprog.fn_doc_names, dprog.fn_doc_data);
        write_text_file(doc_out, md);
        print("wrote " + doc_out);
    }
}

pub fn run_cli(args: [String]) {
    // `--target 17|21|25` -- a leading, optional flag PAIR recognized before every other
    // dispatch below (see the compiler's own JDK-target design: Marshmallow at 25, MC 1.21.1
    // mods at 21, MC 1.20.1 mods at 17 -- one compiler, target picked per invocation). Argv here
    // is otherwise strictly positional (no general flag-scanning loop, see the "doc"/"run" check
    // right below, which is the SAME convention) -- so recognizing this flag means shifting
    // every subsequent FIXED-position `args[N]` access by `off` slots instead, since `[String]`
    // has no slicing operation to build a shorter view without it. `target` itself isn't
    // CONSUMED yet by anything past this point -- classfile-version emission and stdlib topic
    // gating are their own, separate, not-yet-landed pieces (see the compiler's own target-
    // support design) -- this is deliberately just the recognize-and-shift piece on its own.
    var target = 17;
    var off = 0;
    if args[0] == "--target" {
        target = JInteger::parseInt(args[1]);
        if target != 17 && target != 21 && target != 25 {
            throw ParseError::new("--target must be 17, 21, or 25, got " + JString4::valueOf(target));
        }
        off = 2;
    }
    // `--explain-schedule` -- a second, independently optional leading flag, recognized right
    // after `--target` (stacking with it the same way, shifting `off` further) -- see `ECS_IDEAS
    // .md`'s own "Resolved decisions" #6 and `Codegen.hotc`'s own `print_schedule_report_ecs` for
    // the full design. Prints the REAL derived run order/parallel-groups for every `system` in
    // the program being compiled; a no-op flag for a program with no `system` declarations at
    // all.
    var explain_schedule = false;
    if args[off] == "--explain-schedule" {
        explain_schedule = true;
        off = off + 1;
    }
    if args[off] == "doc" {
        run_doc_cli(args, off, target, explain_schedule);
        return;
    }
    // `SelfhostCLI run <path>` (compile AND execute, mirroring `hc run` -- the shape
    // `build.gradle.kts`'s own `run`/`playBattle`/`calc` tasks and the IntelliJ plugin's Run
    // configuration all invoke) vs. plain `SelfhostCLI <path> [outPath]` (compile only,
    // mirroring `hc build` -- the original, still-supported form). Real `args[off] == "run"`
    // string comparison, not a separate subcommand type, keeping this a single flat `[String]`
    // argv exactly like the real `hc` CLI's own argv shape (plus the optional `--target` prefix
    // right above).
    var path = args[off];
    var execute = false;
    var out_idx = off + 1;
    if args[off] == "run" {
        path = args[off + 1];
        execute = true;
        out_idx = off + 2;
    }
    let f = JFileCli::new(path);
    // A cheap, filesystem-free dummy init (`parse_source_file` on a DIRECTORY path would try to
    // read its bytes as a file and throw `AccessDeniedException` -- found running this against a
    // real multi-file test project) -- immediately overwritten by whichever real branch applies.
    var prog = parse_source_string("");
    if f.isDirectory() {
        prog = parse_directory(path);
    } else {
        prog = parse_source_file(path);
    }
    prog = merge_program(resolve_stdlib_modules(prog.uses, target), prog);

    // See `name_collides_with_decl`'s own header, right above `parse_directory`: the entry class
    // name is mangled -- ONLY when it would otherwise collide -- never a struct's own name (which
    // is referenced by every `NEW`/construction site throughout the target program's own code,
    // far too widely to safely rename).
    let name0 = base_name_no_ext(path);
    var name = name0;
    if name_collides_with_decl(name0, &prog.structs, &prog.enums) {
        name = name0 + "$Program";
        print("note: '" + name0 + "' also names a struct/enum this program declares -- entry class renamed to '" + name + "' to avoid overwriting it");
    }
    var out_path = name + ".class";
    if args.length > out_idx {
        out_path = args[out_idx];
    }

    let empty_args = driver_empty_int_vec();
    let errors = compile_program(
        prog.fns, prog.structs, prog.impls, prog.enums, prog.externs, prog.statics, prog.interfaces,
        name, "__selfcompile_probe_entry", empty_args, out_path,
        prog.struct_annotation_names, prog.struct_annotation_data, prog.fn_annotation_names, prog.fn_annotation_data,
        prog.extend_decls, prog.must_use_fn_names,
        prog.struct_doc_names, prog.struct_doc_data, prog.fn_doc_names, prog.fn_doc_data, prog.sendable_struct_names,
        prog.components, prog.systems, target, explain_schedule,
    );
    if report_errors(errors) {
        print("wrote " + out_path);
        if execute {
            // `java.class.path` alone isn't enough: when `SelfhostCLI` itself is launched with an
            // explicit, absolute-paths-only classpath (e.g. Gradle's own `JavaExec` -- it never
            // puts the working directory "." on the classpath at all, unlike a typical manual
            // `java -cp "<jars>;." ...` invocation), the freshly-written `out_path` -- always
            // relative to the CURRENT working directory -- wouldn't be found by the child process
            // otherwise. Prepending "." (not appending) matters: `java.class.path` here also
            // carries `selfhost/bootstrap`, the compiler's own pre-compiled seed directory, which
            // (as an accident of how it was generated) contains stray same-named classes from past
            // demo/example compiles. With "." appended last, a freshly-compiled program whose name
            // collides with one of those (e.g. `Shape`, `Box`, `Item`, `Circle`) silently loaded
            // the STALE bootstrap version instead of the one just written -- real, reproduced
            // failures: `InstantiationError` (a stale `Shape` compiled as an interface),
            // `NoSuchFieldError`/`NoSuchMethodError` (stale `Circle`/`Item` with different
            // fields/ctors). Putting "." first makes the JVM's own classloader resolve the
            // just-written classes before anything else on the classpath, matching how a normal
            // `java -cp ".;<jars>" ...` invocation would already behave.
            let sep = JSystemCli::getProperty("path.separator");
            let cp = "." + sep + JSystemCli::getProperty("java.class.path");
            var cmd = ["java", "-cp", cp, name];
            var pb = JProcessBuilderCli::new(cmd);
            pb.inheritIO();
            var proc = pb.start();
            proc.waitFor();
        }
    }
}

fn cli_entry_source() -> String {
    let nl = codepoint_to_string(CP_NEWLINE);
    return "pub fn main(args: [String]) \{" + nl + "run_cli(args);" + nl + "\}" + nl;
}

// **Verified, not just compiled**: builds `SelfhostCLI.class`, a real standalone `hc`-replacement
// entry point -- run it with `java -cp <asm jars>:<hotchocolate.jar>:. SelfhostCLI <file-or-dir>
// [outPath]`, with NO Kotlin compiler involved. This is the last piece separating "the self-hosted
// compiler proved it can bootstrap itself" (stage 2/3, above) from "the self-hosted compiler can be
// pointed at an arbitrary real `.hotc` project the same way `hc` itself is."
pub fn run_selfcompile_cli_prep() {
    print("--- building the self-hosted CLI: a real hc-replacement entry point, no hardcoded target ---");

    var prog = parse_source_file("selfhost/ast/Ast.hotc");
    prog = merge_program(prog, parse_source_file("selfhost/types/Types.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/lexer/Lexer.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/parser/Parser.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/checker/Checker.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/codegen/Codegen.hotc"));
    prog = merge_program(prog, parse_source_file("selfhost/Driver.hotc"));
    prog = merge_program(prog, parse_source_string(cli_entry_source()));
    prog = merge_program(resolve_stdlib_modules(prog.uses, 17), prog); // internal bootstrap probe -- always resolved at the baseline target

    print(
        "parsed " + JString4::valueOf(prog.fns.length()) + " function(s), " + JString4::valueOf(prog.structs.length())
        + " struct(s) for the self-hosted CLI"
    );

    let empty_args2 = driver_empty_int_vec();
    let errors2 = compile_program(
        prog.fns, prog.structs, prog.impls, prog.enums, prog.externs, prog.statics, prog.interfaces,
        "SelfhostCLI", "__selfcompile_probe_entry", empty_args2, "SelfhostCLI.class",
        prog.struct_annotation_names, prog.struct_annotation_data, prog.fn_annotation_names, prog.fn_annotation_data,
        prog.extend_decls, prog.must_use_fn_names,
        prog.struct_doc_names, prog.struct_doc_data, prog.fn_doc_names, prog.fn_doc_data, prog.sendable_struct_names,
        prog.components, prog.systems, 17, false, // internal bootstrap probe -- always compiles at the baseline target, --explain-schedule never wanted here
    );
    if report_errors(errors2) {
        print("wrote SelfhostCLI.class -- run it standalone with a real target path to compile any .hotc file or project directory.");
    }
}

// A real, minimal standard library -- `Option<T>`/`Result<T, E>`/`Vec<T>`/`RegistryEntry<T>`/
// `Registry<T>` (plus `vec_of<T>`/`registry_new<T>`/`read_int`/`read_string`), mirroring the REAL
// compiler's own auto-injected `Prelude.kt`. A real, previously-undiscovered LIMIT of this whole
// self-hosting effort found attempting to self-compile `Lexer.hotc`: real `.hotc` source almost
// never declares `Vec`/`Option`/`Registry` itself (`Lexer.hotc`'s own `self.keywords:
// Registry<TokType>` relies ENTIRELY on the real compiler's prelude injection) -- without this,
// the self-hosted compiler could only ever compile programs that happen to declare every generic
// type they use themselves, which is essentially no real code at all.
//
// **Moved 2026-09-08 to real files under `stdlib/`** -- this used to be a ~125-line
// `fn prelude_source() -> String` right here, built entirely out of escaped-brace string
// concatenation (this language's own string literals have no escape-sequence support at all, so
// every `{`/`}` needed writing as `\{`/`\}`, joined line by line with `+ nl +`). Genuinely
// separates the standard library from the compiler's own source: real syntax, no escaping,
// diffable/editable files instead of a string blob buried in `Driver.hotc`. `stdlib/` lives
// OUTSIDE `selfhost/` specifically so `selfhost/`'s own directory-mode self-compile
// (`./gradlew run --args="run selfhost"`) doesn't ALSO sweep it up as just another loose `.hotc`
// tree, double-declaring everything in it on top of the explicit stdlib-merge below.
//
// **Split into topics, real opt-in via `use`, same day** -- what was one `stdlib/Prelude.hotc`
// bundling everything is now five independent files (`stdlib/{option,result,vec,registry,io}.hotc`
// -- see each one's own header for its own real dependencies on the others). A program naming
// ANY of them via `use vec;`/`use registry;`/etc. gets ONLY those topics (plus their own
// transitive deps) merged in -- real opt-in, not everything unconditionally. A program with NO
// `use` line anywhere keeps the full legacy behavior (all five, unchanged) -- 100% backward
// compatible with every `.hc`/`.hotc` file written before this feature existed, since none of
// them could have written a `use` statement at all. See `resolve_stdlib_modules`'s own header,
// right below `merge_program`, for the actual resolution logic, and README's own "Standard
// library modules" section for the full design.
fn merge_fns(a: Vec<FnDecl>, b: Vec<FnDecl>) -> Vec<FnDecl> {
    var out = a;
    var i = 0;
    while i < b.length() {
        out.push(b.get(i));
        i = i + 1;
    }
    return out;
}

fn merge_structs(a: Vec<StructDecl>, b: Vec<StructDecl>) -> Vec<StructDecl> {
    var out = a;
    var i = 0;
    while i < b.length() {
        out.push(b.get(i));
        i = i + 1;
    }
    return out;
}

