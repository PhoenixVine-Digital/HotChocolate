extern class JLong2 = "java/lang/Long" {
    static fn parseLong(s: String, radix: Int) -> Long;
}

// Exercises `Long` as a real 2-slot primitive: stored in locals/params (not just a transient
// stack value immediately cast away), arithmetic, comparisons, and both directions of cast.
fn add_longs(x: Long, y: Long) -> Long {
    var z: Long = x + y;
    var extra: Int = 1;
    // `extra` deliberately declared AFTER `z` -- if `z`'s own local slot allocation didn't
    // correctly reserve TWO slots for a `Long`, `extra` would silently alias `z`'s own second
    // slot, corrupting both `z`'s stored value and `extra` itself.
    return z + (extra as Long);
}

fn combo(a: Int, b: Int) -> Int {
    let big1 = JLong2::parseLong("100000", 10);
    let big2 = JLong2::parseLong("200000", 10);
    let sum = add_longs(big1, big2);
    var cmp_result = 0;
    if sum > big1 {
        cmp_result = 1;
    }
    if sum == sum {
        cmp_result = cmp_result + 10;
    }
    let back = sum as Int;
    return (back - 300000) + cmp_result + a + b;
}
