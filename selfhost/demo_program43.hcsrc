// Exercises real classpath reflection (`try`/`catch`, `extern class` static/instance methods, an
// array-of-extern-class return type with `.length`/indexing, and a genuinely `Bool`-returning
// extern method) end to end -- the target-program-facing counterpart to the reflection module this
// self-hosting effort just added to `Checker.hotc` itself (`verify_extern_signature`/
// `resolve_real_methods`, see that file's own header). That module lives INSIDE the self-hosted
// compiler and isn't reachable from a target program at all -- this demo separately proves the
// underlying LANGUAGE FEATURES it depends on (try/catch, extern-class arrays, `Bool`-returning
// externs) work correctly for any user program, not just the compiler's own internal use of them.
//
// Real bug this demo would have caught: `java.lang.reflect.Modifier.isPublic(int)`/`isStatic(int)`
// genuinely return JVM `boolean`, and this subset used to build EVERY extern method's descriptor
// via `descriptor_of_type`'s own `Bool` -> `"I"` mapping (correct for this subset's OWN internal
// `Bool` representation -- struct fields/locals/params -- but wrong for an extern boundary, where
// the descriptor has to match the REAL method being linked against). A declared `-> Bool` extern
// method used to compile clean and then crash with `NoSuchMethodError` the first time it was
// actually called -- fixed by giving extern method descriptors their own `Bool -> "Z"` mapping,
// scoped to extern params/returns only (see `Codegen.hotc`'s own `extern_descriptor_of_type`).

extern class JClassRef43 = "java.lang.Class" {
    static fn forName(name: String) -> JClassRef43;
    fn getMethods(&self) -> [JMethodRef43];
}
extern class JMethodRef43 = "java.lang.reflect.Method" {
    fn getName(&self) -> String;
    fn getModifiers(&self) -> Int;
}
extern class JModifierRef43 = "java.lang.reflect.Modifier" {
    static fn isPublic(mod: Int) -> Bool;
    static fn isStatic(mod: Int) -> Bool;
}
extern class JCNFE43 = "java.lang.ClassNotFoundException" {}

// Counts PUBLIC STATIC methods named `target` on `binary_name` -- real, disclosed simplification:
// returns -1 (rather than propagating the exception further) when `binary_name` isn't on the
// classpath at all, exercising the `catch` path for real, not just the `try` path.
fn count_public_static_named(binary_name: String, target: String) -> Int {
    try {
        let c = JClassRef43::forName(binary_name);
        let methods = c.getMethods();
        var count = 0;
        var i = 0;
        while i < methods.length {
            let m = methods[i];
            let mods = m.getModifiers();
            if m.getName() == target && JModifierRef43::isPublic(mods) && JModifierRef43::isStatic(mods) {
                count = count + 1;
            }
            i = i + 1;
        }
        return count;
    } catch (e: JCNFE43) {
        return -1;
    }
}

fn combo(a: Int, b: Int) -> Int {
    // `java.lang.String` really has exactly 9 public static `valueOf` overloads (boolean, char,
    // char[], char[]+offset+count, double, float, int, long, Object) -- confirmed via a standalone
    // real-`java.lang.reflect` probe, not guessed.
    let n = count_public_static_named("java.lang.String", "valueOf");
    // A deliberately-bogus binary name -- `Class.forName` genuinely throws here, proving `catch`
    // actually runs (not just parses) rather than the `try` block happening to never fail.
    let missing = count_public_static_named("com.totally.made.up.NotAClass", "x");
    var result = 0;
    if n == 9 { result = 100; }
    var caught = 0;
    if missing == -1 { caught = 10; }
    return result + caught + a + b;
}
