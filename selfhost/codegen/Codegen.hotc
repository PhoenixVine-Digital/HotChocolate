            // branching on it doesn't touch `index`/`arr_name` at all; each then only gets used
            // ONCE, in whichever single branch actually runs. See `Ast.hc`'s own `IndexFieldGet`
            // header for why this is a dedicated shape instead of peeking `FieldAccess { obj: Index
            // {...} } }` reactively (the move-checker issue that would otherwise cause).
            IndexFieldGet { arr_name, index, field } => {
                let at = self.type_of(arr_name);
                if is_arena_type_name_cg(at) {
                    return self.gen_arena_field_get(arr_name, index, arena_struct_name_cg(at), field);
