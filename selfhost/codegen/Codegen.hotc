                                // today, but leaving this one path unguarded would be exactly the
                                // kind of silent gap the (rt, method)-keyed original version of
                                // this check already got bitten by once.
                                if is_dyn_type_name_cg(target_ty2) && is_phoenix_background_iface_cg(dyn_interface_name_cg(target_ty2)) {
                                    var captured3 = empty_str_vec4();
                                    self.collect_lambda_captures(body, &params, &mut captured3);
                                    var cci3 = 0;
                                    while cci3 < captured3.length() {
                                        let cname3 = captured3.get(cci3);
                                        let cty_found3 = self.lookup_type(cname3);
                                        if let Some { value: cty3 } = cty_found3 {
                                            if !is_sendable_type_cg(cty3, &self.sendable_structs) {
                                                throw CodegenError::new("capturing '" + cname3 + "' (type " + cty3 + ") into a background task isn't allowed -- background tasks can only capture Int/Bool/Long/Float/Double/String or a struct marked '@sendable' (see README's own \"Compile-time concurrency safety\" section)");
                                            }
                                        }
                                        cci3 = cci3 + 1;
                                    }
                                }
                                at2 = self.gen_lambda(params, body, target_ty2);
                            }
                            ExternStaticFieldGet { type_name: mref_type_name, field: mref_field } => {
                                if self.is_method_ref_candidate_cg(mref_type_name, mref_field) {
                                    var target_ty2b = "";
                                    if i < raw_param_types2.length() { target_ty2b = raw_param_types2.get(i); }
                                    at2 = self.gen_method_ref(mref_type_name, mref_field, target_ty2b);
                                } else {
                                    at2 = self.gen_expr(a2);
                                }
                            }
                            _ => { at2 = self.gen_expr(a2); }
                        }
                        sarg_types.push(at2);
                        i = i + 1;
                    }
                } else {
                    var i = 0;
                    while i < args.length() {
                        let at2 = self.gen_expr(args.get(i));
                        sarg_types.push(at2);
                        i = i + 1;
                    }
                }
                let ekey = ekey0;
                let sig_ekey = ekey + "#" + join_type_names_cg(sarg_types);
                var desc_found = self.extern_method_descs.get(sig_ekey);
                var m_known = false;
                var lookup_ekey = sig_ekey;
                if let Some { value: d2 } = desc_found { m_known = true; }
                if !m_known {
                    desc_found = self.extern_method_descs.get(ekey);
                    lookup_ekey = ekey;
                }
                var desc = "";
                if let Some { value: d } = desc_found {
                    desc = d;
                    m_known = true;
                }
                if !m_known {
                    throw CodegenError::new("codegen: unknown extern method '" + method + "' on '" + type_name + "'");
                }
                if is_ctor {
                    self.mv.visitMethodInsn(183, binary, "<init>", desc, false); // INVOKESPECIAL
                    return type_name; // the constructed value's type tag is the alias name
                }
                // A real interface's STATIC method (legal since Java 8) still needs `isInterface
                // = true` on the very same `INVOKESTATIC` opcode -- ASM's own `isInterface` flag
                // picks the constant-pool entry KIND (`InterfaceMethodref` vs plain `Methodref`),
                // not just the opcode, and the verifier checks that against the owner's real
                // access flags regardless of which of the four `INVOKE*` instructions it is.
                var type_name_is_iface = 0;
                let tn_iface_found = self.extern_is_interface.get(type_name);
                if let Some { value: tnifv } = tn_iface_found { type_name_is_iface = tnifv; }
                self.mv.visitMethodInsn(184, binary, method, desc, type_name_is_iface == 1); // INVOKESTATIC
                let rt_found = self.extern_method_rettys.get(lookup_ekey);
                if let Some { value: rt } = rt_found {
                    return rt;
                }
                return "Int";
            }
            ExternStaticFieldGet { type_name, field } => {
                let ebinary_found2 = self.extern_binary.get(type_name);
                if let Some { value: ebinary2 } = ebinary_found2 {
                    let efkey2 = type_name + "#" + field;
                    let efdesc_found2 = self.extern_field_descs.get(efkey2);
                    let eftype_found2 = self.extern_field_type_names.get(efkey2);
                    if let Some { value: efdesc2 } = efdesc_found2 {
                        if let Some { value: eftype2 } = eftype_found2 {
                            self.mv.visitFieldInsn(178, ebinary2, field, efdesc2); // GETSTATIC
                            return eftype2;
                        }
                    }
                    throw CodegenError::new("codegen: unknown static field '" + field + "' on extern class '" + type_name + "'");
                }
                throw CodegenError::new("codegen: unknown extern class '" + type_name + "'");
            }
            ExternStaticFieldSet { type_name, field, value } => {
                let ebinary_found3 = self.extern_binary.get(type_name);
                if let Some { value: ebinary3 } = ebinary_found3 {
                    let efkey3 = type_name + "#" + field;
                    let efdesc_found3 = self.extern_field_descs.get(efkey3);
                    let eftype_found3 = self.extern_field_type_names.get(efkey3);
                    if let Some { value: efdesc3 } = efdesc_found3 {
                        if let Some { value: eftype3 } = eftype_found3 {
                            let vty = self.gen_expr(value); // stack: [value]
                            // `DUP`/`DUP2` (category-2 for `Long`/`Double`) -- see the plain
                            // `Assign`-to-static-field arm's own matching comment for why.
                            if vty == "Long" || vty == "Double" {
                                self.mv.visitInsn(92); // DUP2
                            } else {
                                self.mv.visitInsn(89); // DUP
                            }
                            self.mv.visitFieldInsn(179, ebinary3, field, efdesc3); // PUTSTATIC -- consumes one [value], leaves [value]
                            return eftype3;
                        }
                    }
                    throw CodegenError::new("codegen: unknown static field '" + field + "' on extern class '" + type_name + "'");
                }
                throw CodegenError::new("codegen: unknown extern class '" + type_name + "'");
            }
            Cast { expr, target_type } => { return self.gen_cast(expr, target_type); }
            IsCheck { expr, target_type } => { return self.gen_is(expr, target_type); }
            // See `Checker.hotc`'s own matching fallback arm's header -- a real error already fired
            // there for this exact shape before codegen ever runs (`compile_program` aborts on any
            // real error), so reaching this specific arm during a real compile is unreachable in
            // practice; kept as a clear diagnostic rather than an unhandled-match crash regardless.
            Lambda { params, body } => {
                throw CodegenError::new("codegen: lambda literal used outside a valid call-argument context");
            }
            TryOp { expr } => { return self.gen_try_op(expr); }
            // See `Checker.hotc`'s own matching fallback arm's header -- a real error already
            // fired there for this exact shape before codegen ever runs, so reaching this arm
            // during a real compile is unreachable in practice.
            NamedArg { name, value } => {
                throw CodegenError::new("codegen: named argument '" + name + "' used outside a supported call context");
            }
            // See `Ast.hc`'s own `Expr.NullLit` header -- a bare `ACONST_NULL`, "?" as the type tag
            // (the same "no real static type to report" convention `TyUnknown` is on the checker
            // side -- nothing downstream keys off this except `is_ref_type`, which already treats
            // any non-primitive tag identically).
            NullLit => {
                self.mv.visitInsn(1); // ACONST_NULL
                return "?";
            }
            SafeCall { recv, method, args } => { return self.gen_safe_call(recv, method, args); }
            SafeFieldAccess { recv, field } => { return self.gen_safe_field_access(recv, field); }
            Elvis { left, right } => { return self.gen_elvis(left, right); }
            // Never actually reached: `gen_stmt`'s own `Let` handling intercepts a `Comprehension`
            // init BEFORE it ever reaches this generic dispatch, calling `gen_comprehension`
            // directly with the declared type it needs. Anywhere else, `Checker.hotc`'s own
            // generic `Comprehension` dispatch already emitted a real error, and a real error
            // means this codegen pass never runs at all (`compile_program` checks `has_real_errors`
            // first) -- this arm exists only so the match stays exhaustive.
            Comprehension { result_expr, var_name, iter_expr, cond } => {
                throw CodegenError::new("codegen: comprehension reached outside its own special-cased 'let x: Vec<T> = [...]' path -- Checker.hotc should have already rejected this");
            }
        }
    }

    // `expr as Type` -- every numeric pair among `Int`/`Long`/`Float`/`Double` needs real JVM
    // conversion bytecode (each is a genuinely different bit representation -- unlike, say, two
    // reference types, where `as` is a plain pass-through with no bytecode at all, since this
    // subset doesn't emit `CHECKCAST` anywhere, matching its own loose, disclosed "trust declared
    // types" philosophy elsewhere). `Checker.hotc`'s own `check_cast` doesn't gate WHICH casts are
    // legal (`target_type` is trusted at face value -- see that fn's own header), so this has to
    // handle every numeric-to-numeric pair actually named, not just the ones a stricter checker
    // would allow through -- an unhandled pair would otherwise fall through to the plain
    // pass-through below, leaving the WRONG bit width/representation on the stack while claiming a
    // different type, corrupting everything downstream (wrong slot width, wrong arithmetic opcode
    // choice, etc).
    fn gen_cast(&mut self, expr: &Expr, target_type: String) -> String {
        let inner_ty = self.gen_expr(expr);
        if inner_ty == target_type { return target_type; }
        if inner_ty == "Int" && target_type == "Long" { self.mv.visitInsn(133); return "Long"; } // I2L
        if inner_ty == "Int" && target_type == "Float" { self.mv.visitInsn(134); return "Float"; } // I2F
        if inner_ty == "Int" && target_type == "Double" { self.mv.visitInsn(135); return "Double"; } // I2D
        if inner_ty == "Long" && target_type == "Int" { self.mv.visitInsn(136); return "Int"; } // L2I
        if inner_ty == "Long" && target_type == "Float" { self.mv.visitInsn(137); return "Float"; } // L2F
        if inner_ty == "Long" && target_type == "Double" { self.mv.visitInsn(138); return "Double"; } // L2D
        if inner_ty == "Float" && target_type == "Int" { self.mv.visitInsn(139); return "Int"; } // F2I
        if inner_ty == "Float" && target_type == "Long" { self.mv.visitInsn(140); return "Long"; } // F2L
        if inner_ty == "Float" && target_type == "Double" { self.mv.visitInsn(141); return "Double"; } // F2D
        if inner_ty == "Double" && target_type == "Int" { self.mv.visitInsn(142); return "Int"; } // D2I
        if inner_ty == "Double" && target_type == "Long" { self.mv.visitInsn(143); return "Long"; } // D2L
        if inner_ty == "Double" && target_type == "Float" { self.mv.visitInsn(144); return "Float"; } // D2F
        // `Char`/`Byte` live on the JVM operand stack as a plain `int` (same representation Int
        // itself uses) -- narrowing FROM `Int` needs a real truncating opcode (`i2c`/`i2b`, since
        // the value could be out of the narrower type's range), but widening BACK to `Int` needs
        // NO opcode at all (the bits are already a valid int, same "no-op, just relabel" the rest
        // of this fn's own same-type check at its very top already relies on for every other
        // trivial case).
        if inner_ty == "Int" && target_type == "Char" { self.mv.visitInsn(146); return "Char"; } // I2C
        if inner_ty == "Int" && target_type == "Byte" { self.mv.visitInsn(145); return "Byte"; } // I2B
        if inner_ty == "Char" && target_type == "Int" { return "Int"; }
        if inner_ty == "Byte" && target_type == "Int" { return "Int"; }
        // `Char`<->`Byte` directly: route through the SAME truncating/no-op rules above by way of
        // `Int` -- both are already plain ints on the stack, so `Char`->`Byte` is just `i2b` (the
        // value's current bit pattern narrowed, identical to `Int`->`Byte`) and `Byte`->`Char` is
        // a real, disclosed narrower case: `byte` is SIGNED (-128..127) and `char` is UNSIGNED
        // (0..65535) on the JVM, so a negative `Byte` value cast to `Char` would sign-extend
        // through `i2b`'s own inverse and land at a real, surprising large positive `Char` code
        // point -- `i2c` on the raw stack value (skipping any narrowing first) is the correct,
        // real Java-equivalent behavior for this pair (`(char) byteValue` in real Java does
        // exactly this: sign-extend to int implicitly, then mask to 16 bits).
        if inner_ty == "Char" && target_type == "Byte" { self.mv.visitInsn(145); return "Byte"; } // I2B
        if inner_ty == "Byte" && target_type == "Char" { self.mv.visitInsn(146); return "Char"; } // I2C
        // Primitive-to-reference (boxing) and reference-to-primitive (unboxing) -- the real gap
        // `stdlib/phoenix.hotc`'s own header used to disclose as a scope cut: `PhoenixTask::join()`
        // returns a raw `PhoenixObject` (`java.lang.Object`-erased, exactly like real
        // `Future<T>.get()`), so a primitive task RESULT (`Int`/`Bool`/etc.) needs a genuine
        // `Integer.valueOf`/`.intValue()`-style box/unbox pair, not the bare CHECKCAST-or-nothing
        // fallback below -- that fallback either emits `CHECKCAST` against a primitive value
        // (verifier-rejected: `CHECKCAST` operates on a reference on the stack, never a primitive)
        // or, going the other way, emits NOTHING at all and leaves a reference on the stack while
        // claiming a primitive type, corrupting every subsequent slot-width/opcode choice keyed off
        // that claim. Handles both directions uniformly for all five primitive type names -- not
        // just `Int`, since `Bool`/`Long`/`Float`/`Double` task results hit the exact same gap and
        // there's no reason to fix only one.
        if !is_ref_type(inner_ty) && is_ref_type(target_type) {
            self.mv.visitMethodInsn(184, box_class_for(inner_ty), "valueOf", box_desc_for(inner_ty), false); // INVOKESTATIC
            return target_type;
        }
        if is_ref_type(inner_ty) && !is_ref_type(target_type) {
            let box_cls = box_class_for(target_type);
            self.mv.visitTypeInsn(192, box_cls); // CHECKCAST -- narrow the erased reference back to its real wrapper type first
            self.mv.visitMethodInsn(182, box_cls, unbox_method_for(target_type), unbox_desc_for(target_type), false); // INVOKEVIRTUAL
            return target_type;
        }
        // Reference-to-reference cast (anything left, since a same-type cast already returned
        // above and every numeric pair is handled) -- real gap found needing this: an extern
        // `java.lang.Object`-typed value (e.g. `java.util.ArrayList.get(int)`'s own return,
        // widened through an `Object`-alias extern method) cast back to a narrower struct/
        // enum/extern-class type needs a genuine `CHECKCAST`, not the bare pass-through this
        // subset otherwise uses -- without one, the JVM verifier rejects any subsequent
        // `GETFIELD`/`INVOKEVIRTUAL` against the "narrower" claimed type with a real
        // `VerifyError`, not caught at HC compile time at all (`Checker.hotc`'s own
        // `check_cast` trusts `target_type` at face value -- see this fn's own header). A
        // WIDENING cast (checking a more-specific value against a broader declared type) still
        // passes a real `CHECKCAST` fine too -- a harmless no-op runtime check in that
        // direction -- so emitting this unconditionally for every non-primitive pair is safe.
        if is_ref_type(target_type) {
            self.mv.visitTypeInsn(192, self.resolve_elem_class_name(target_type)); // CHECKCAST
        }
        return target_type;
    }

    // `expr is Type` -- `gen_cast`'s boolean-returning sibling, a real `INSTANCEOF` against the
    // same class-name resolution `gen_cast`'s own `CHECKCAST` already uses (struct/enum/`dyn`/
    // extern-class alike -- see `resolve_elem_class_name`'s own header). Non-consuming at the HC
    // level (see `Ast.hc`'s own `Expr.IsCheck` header) but still a real stack pop -- `INSTANCEOF`
    // consumes the reference and pushes a fresh `0`/`1`, same as any other boolean-producing op.
    fn gen_is(&mut self, expr: &Expr, target_type: String) -> String {
        self.gen_expr(expr);
        self.mv.visitTypeInsn(193, self.resolve_elem_class_name(target_type)); // INSTANCEOF
        return "Bool";
    }

    // `expr?` -- see `Ast.hc`'s own `Expr.TryOp` header and `Checker.hotc`'s own `check_try_op`
    // (already validated the error types match, trusted here without re-checking, same "checker
    // already verified it" honesty every other codegen pass in this file has). `Result`'s own
    // enum representation is a single class with a `tag: Int` field plus the union of every
    // variant's own (mangled `Variant$field`) fields -- NOT one real subclass per variant the way
    // a naive INSTANCEOF/CHECKCAST sketch would assume -- so this reads `tag` and branches exactly
    // like `gen_stmt`'s own `Match` arm already does for an ordinary enum, just narrowed to
    // `Result`'s own two known variants (`Ok` tag, `Err` tag) instead of a general arm list.
    fn gen_try_op(&mut self, expr: &Expr) -> String {
        let sty = self.gen_expr(expr);
        let subj_slot = self.next_slot;
        self.next_slot = self.next_slot + 1;
        self.mv.visitVarInsn(58, subj_slot); // ASTORE -- Result is always a ref type

        var ok_tag = 0;
        let ok_tag_found = self.variant_tags.get(sty + "#Ok");
        if let Some { value: t } = ok_tag_found { ok_tag = t; }

        var ok_label = Label::new();
        self.mv.visitVarInsn(25, subj_slot); // ALOAD
        self.mv.visitFieldInsn(180, self.qualify(sty), "tag", "I"); // GETFIELD
        self.mv.visitIntInsn(17, ok_tag); // SIPUSH
        self.mv.visitJumpInsn(159, &ok_label); // IF_ICMPEQ -- tag == Ok -> unwrap

        // Err path: extract the `error` field (mangled `Err$error` on the real class, same
        // convention `gen_variant_construct`'s own PUTFIELD and `gen_stmt`'s own `Match` arm's
        // GETFIELD both already use), then construct a fresh `Result<FnT, E>::Err { error }` for
        // the ENCLOSING fn's own Result type (`self.ret_ty`) and return it immediately.
        var err_ftype = self.field_type_of(sty, "error");
        let vfn_err = self.variant_field_names.get(sty + "#Err");
        let vft_err = self.variant_field_types.get(sty + "#Err");
        if let Some { value: vfnames } = vfn_err {
            if let Some { value: vftypes } = vft_err {
                var vi = 0;
                while vi < vfnames.length() {
                    if vfnames.get(vi) == "error" { err_ftype = vftypes.get(vi); }
                    vi = vi + 1;
                }
            }
        }
        self.mv.visitVarInsn(25, subj_slot); // ALOAD
        self.mv.visitFieldInsn(180, self.qualify(sty), "Err$error", self.resolve_descriptor(err_ftype)); // GETFIELD -- mangled
        let err_slot = self.alloc_slot("$try_err", err_ftype);
        self.var_types.register("$try_err", err_ftype);
        self.mv.visitVarInsn(store_opcode(err_ftype), err_slot);
        var err_field_names = vec_of("error");
        var err_field_values = vec_of(Ident { name: "$try_err" });
        self.gen_variant_construct(self.ret_ty, "Err", err_field_names, err_field_values);
        self.mv.visitInsn(176); // ARETURN

        // Ok path: extract the `value` field (mangled `Ok$value`) -- that's the whole expression's
        // own result.
        self.mv.visitLabel(&ok_label);
        var ok_ftype = self.field_type_of(sty, "value");
        let vfn_ok = self.variant_field_names.get(sty + "#Ok");
        let vft_ok = self.variant_field_types.get(sty + "#Ok");
        if let Some { value: vfnames2 } = vfn_ok {
            if let Some { value: vftypes2 } = vft_ok {
                var vi2 = 0;
                while vi2 < vfnames2.length() {
                    if vfnames2.get(vi2) == "value" { ok_ftype = vftypes2.get(vi2); }
                    vi2 = vi2 + 1;
                }
            }
        }
        self.mv.visitVarInsn(25, subj_slot); // ALOAD
        self.mv.visitFieldInsn(180, self.qualify(sty), "Ok$value", self.resolve_descriptor(ok_ftype)); // GETFIELD -- mangled
        return ok_ftype;
    }

    // Converts the value currently on TOP of the stack from `from` to `to` -- only the pairs
    // `gen_widen_numeric_pair` (right below) can ever actually request: widening `Int`/`Long`/
    // `Float` UP to `Float`/`Double` (never narrowing, never touching `Int`+`Long`, which this
    // whole widening feature deliberately still doesn't cover -- see `Checker.hotc`'s own
    // `check_binary` header).
    fn gen_numeric_convert(&mut self, from: String, to: String) {
        if from == "Int" && to == "Float" { self.mv.visitInsn(134); return; } // I2F
        if from == "Int" && to == "Double" { self.mv.visitInsn(135); return; } // I2D
        if from == "Long" && to == "Float" { self.mv.visitInsn(137); return; } // L2F
        if from == "Long" && to == "Double" { self.mv.visitInsn(138); return; } // L2D
        if from == "Float" && to == "Double" { self.mv.visitInsn(141); return; } // F2D
    }

    // Ensures two ALREADY-PUSHED operands (stack: `[left(lt), right(rt)]`, exactly what every
    // arithmetic/comparison op in `gen_binary` has right after its own two `gen_expr` calls) end
    // up the SAME numeric type, per `numeric_widen_result_cg`'s own rule -- real gap found writing
    // ordinary game-code arithmetic, see `Checker.hotc`'s own `check_binary` header for the full
    // story (that's the checker-side twin that actually ALLOWS this pair through in the first
    // place; this is purely the codegen-side "make the bytecode agree" half).
    //
    // The JVM has no opcode to convert a value sitting BELOW the top of the stack in place, and a
    // category-2 value (`Long`/`Double`, 2 stack words) makes the usual `DUP`/`SWAP` reordering
    // tricks genuinely awkward to get right for every width combination -- so this spills BOTH
    // operands through two scratch local slots instead (the same "grab `self.next_slot` directly,
    // no name registration" pattern `gen_expr`'s own `For`/`Match`/`IndexAssign` arms already use
    // for similar width-mismatch problems), converting each one immediately after it's alone back
    // on the stack, where a plain top-of-stack conversion opcode is always enough:
    //   [left(lt), right(rt)]                          -- both already pushed by the caller
    //   -> convert right in place if needed             -- [left(lt), right(widened)]
    //   -> STORE right(widened) to a scratch slot        -- [left(lt)]
    //   -> convert left in place if needed               -- [left(widened)]
    //   -> LOAD right(widened) back                      -- [left(widened), right(widened)]
    // Returns the common (possibly-widened) type name -- unchanged from `lt` when the pair isn't
    // a real widen-eligible mismatch at all (already equal, or the still-unsupported `Int`+`Long`
    // pair a program that passed checking can never actually present here).
    fn gen_widen_numeric_pair(&mut self, lt: String, rt: String) -> String {
        if lt == rt { return lt; }
        let widened = numeric_widen_result_cg(lt, rt);
        if widened == "" { return lt; }
        if rt != widened {
            self.gen_numeric_convert(rt, widened);
        }
        let right_slot = self.next_slot;
        if widened == "Long" || widened == "Double" { self.next_slot = self.next_slot + 2; } else { self.next_slot = self.next_slot + 1; }
        self.mv.visitVarInsn(store_opcode(widened), right_slot);
        if lt != widened {
            self.gen_numeric_convert(lt, widened);
        }
        self.mv.visitVarInsn(load_opcode(widened), right_slot);
        return widened;
    }

    // Operator overloading -- see `Checker.hotc`'s own `check_binary` header for the full design
    // and naming convention (`add`/`sub`/`mul`/`div`/`rem`/`eq`). Called from EACH arithmetic/
    // equality branch in `gen_binary` right after its own two `gen_expr` calls -- `left`'s value
    // (the receiver) and `right`'s value (the sole argument) are ALREADY on the stack in exactly
    // the order `INVOKEVIRTUAL` wants (`[objectref, arg]`), so this never needs `finish_method_call`
    // (which would try to `gen_expr` its own `args` a second time, double-evaluating `right`) --
    // just a direct `INVOKEVIRTUAL` against the already-registered `struct_methods` descriptor.
    // Returns `None` (bytecode NOT emitted, stack untouched) when no such method exists, so the
    // caller falls through to its own built-in numeric/string handling unchanged.
    fn try_gen_operator_overload(&mut self, op: String, lt: String, rt: String) -> Option<String> {
        let opm = operator_method_name_cg(op);
        if opm == "" { return none_string2(); }
        let mkey = lt + "#" + opm;
        let mdesc_found = self.struct_methods.get(mkey);
        if let Some { value: mdesc } = mdesc_found {
            self.mv.visitMethodInsn(182, self.qualify(lt), opm, mdesc, false); // INVOKEVIRTUAL
            if op == "!=" {
                self.mv.visitIntInsn(17, 1);
                self.mv.visitInsn(130); // IXOR (negate) -- `!=` reuses `eq`, negated
            }
            if op == "==" || op == "!=" { return some_string2("Bool"); }
            let mret_found = self.struct_method_rettys.get(mkey);
            if let Some { value: mret } = mret_found { return some_string2(mret); }
            return some_string2("Int");
        }
        return none_string2();
    }

    fn gen_binary(&mut self, op: String, left: &Expr, right: &Expr) -> String {
        if op == "+" {
            let lt = self.gen_expr(left);
            let rt = self.gen_expr(right);
            if lt == "String" || rt == "String" {
                // Checker only allows String+String (see `Checker.hotc`'s `check_binary`), so
                // both operands are guaranteed String here.
                self.mv.visitMethodInsn(182, "java/lang/String", "concat", "(Ljava/lang/String;)Ljava/lang/String;", false); // INVOKEVIRTUAL
                return "String";
            }
            let overload = self.try_gen_operator_overload(op, lt, rt);
            if let Some { value: ort } = overload { return ort; }
            // A mixed numeric pair (`Int` + `Double`, say) is widened to a common type first --
            // see `gen_widen_numeric_pair`'s own header. A same-type pair (still the overwhelming
            // common case) returns immediately with no bytecode emitted at all.
            let widened = self.gen_widen_numeric_pair(lt, rt);
            if widened == "Long" { self.mv.visitInsn(97); return "Long"; } // LADD
            if widened == "Float" { self.mv.visitInsn(98); return "Float"; } // FADD
            if widened == "Double" { self.mv.visitInsn(99); return "Double"; } // DADD
            self.mv.visitInsn(96); // IADD
            // `Int`/`Char`/`Byte` all share this opcode (same JVM int-category representation) --
            // a real, previously-latent bug found adding `Char`/`Byte`: this used to hardcode
            // `return "Int"` unconditionally, silently WRONG the moment a same-type non-Int pair
            // (`Char + Char`) could ever reach this fallback at all (harmless before, since only
            // `Int` ever did) -- `widened` already holds the correct same-type result from
            // `gen_widen_numeric_pair`'s own `lt == rt` passthrough, so returning it instead keeps
            // a `Char + Char` result correctly typed `Char` (not silently relabeled `Int`, which
            // would pick the wrong print/interpolation descriptor downstream).
            return widened;
        } else if op == "-" {
            let lt2 = self.gen_expr(left); let rt2 = self.gen_expr(right);
            let overload2 = self.try_gen_operator_overload(op, lt2, rt2);
            if let Some { value: ort2 } = overload2 { return ort2; }
            let widened2 = self.gen_widen_numeric_pair(lt2, rt2);
            if widened2 == "Long" { self.mv.visitInsn(101); return "Long"; } // LSUB
            if widened2 == "Float" { self.mv.visitInsn(102); return "Float"; } // FSUB
            if widened2 == "Double" { self.mv.visitInsn(103); return "Double"; } // DSUB
            self.mv.visitInsn(100); return widened2; // ISUB (see the "+" branch's own header on why not a hardcoded "Int")
        } else if op == "*" {
            let lt3 = self.gen_expr(left); let rt3 = self.gen_expr(right);
            let overload3 = self.try_gen_operator_overload(op, lt3, rt3);
            if let Some { value: ort3 } = overload3 { return ort3; }
            let widened3 = self.gen_widen_numeric_pair(lt3, rt3);
            if widened3 == "Long" { self.mv.visitInsn(105); return "Long"; } // LMUL
            if widened3 == "Float" { self.mv.visitInsn(106); return "Float"; } // FMUL
            if widened3 == "Double" { self.mv.visitInsn(107); return "Double"; } // DMUL
            self.mv.visitInsn(104); return widened3; // IMUL (see the "+" branch's own header on why not a hardcoded "Int")
        } else if op == "/" {
            let lt4 = self.gen_expr(left); let rt4 = self.gen_expr(right);
            let overload4 = self.try_gen_operator_overload(op, lt4, rt4);
            if let Some { value: ort4 } = overload4 { return ort4; }
            let widened4 = self.gen_widen_numeric_pair(lt4, rt4);
            if widened4 == "Long" { self.mv.visitInsn(109); return "Long"; } // LDIV
            if widened4 == "Float" { self.mv.visitInsn(110); return "Float"; } // FDIV
            if widened4 == "Double" { self.mv.visitInsn(111); return "Double"; } // DDIV
            self.mv.visitInsn(108); return widened4; // IDIV (see the "+" branch's own header on why not a hardcoded "Int")
        } else if op == "%" {
            let lt5 = self.gen_expr(left); let rt5 = self.gen_expr(right);
            let overload5 = self.try_gen_operator_overload(op, lt5, rt5);
            if let Some { value: ort5 } = overload5 { return ort5; }
            let widened5 = self.gen_widen_numeric_pair(lt5, rt5);
            if widened5 == "Long" { self.mv.visitInsn(113); return "Long"; } // LREM
            if widened5 == "Float" { self.mv.visitInsn(114); return "Float"; } // FREM
            if widened5 == "Double" { self.mv.visitInsn(115); return "Double"; } // DREM
            self.mv.visitInsn(112); return widened5; // IREM (see the "+" branch's own header on why not a hardcoded "Int")
        } else if op == "&" || op == "|" {
            // Real bitwise AND/OR -- unlike `&&`/`||` right below, both operands are ALWAYS
            // evaluated (no short-circuit), matching real Java `&`/`|` semantics. `Bool` is
            // already represented as a plain JVM `I` at this compiler's own descriptor level
            // (`descriptor_of_type`'s own `Int`/`Bool` -> `"I"` mapping), so `IAND`/`IOR` work
            // correctly for `Bool` operands too (0/1 values) with zero extra casing needed --
            // real Java's own `Boolean & Boolean` compiles to the identical opcode.
            let lt6 = self.gen_expr(left);
            let rt6 = self.gen_expr(right);
            if lt6 == "Long" && rt6 == "Long" {
                if op == "&" { self.mv.visitInsn(127); } else { self.mv.visitInsn(129); } // LAND / LOR
                return "Long";
            }
            if op == "&" { self.mv.visitInsn(126); } else { self.mv.visitInsn(128); } // IAND / IOR
            return lt6;
        } else if op == "&&" {
            // Short-circuit: only evaluate `right` when `left` is true.
            self.gen_expr(left);
            var false_label = Label::new();
            var end_label = Label::new();
            self.mv.visitJumpInsn(153, &false_label); // IFEQ (left == 0/false) -> skip right
            self.gen_expr(right);
            self.mv.visitJumpInsn(167, &end_label); // GOTO
            self.mv.visitLabel(&false_label);
            self.mv.visitInsn(3); // ICONST_0
            self.mv.visitLabel(&end_label);
            return "Bool";
        } else if op == "||" {
            // Short-circuit: only evaluate `right` when `left` is false.
            self.gen_expr(left);
            var true_label = Label::new();
            var end_label = Label::new();
            self.mv.visitJumpInsn(154, &true_label); // IFNE (left != 0/true) -> skip right
            self.gen_expr(right);
            self.mv.visitJumpInsn(167, &end_label); // GOTO
            self.mv.visitLabel(&true_label);
            self.mv.visitInsn(4); // ICONST_1
            self.mv.visitLabel(&end_label);
            return "Bool";
        } else {
            let lt = self.gen_expr(left);
            let rt = self.gen_expr(right);
            if op == "==" || op == "!=" {
                let overload6 = self.try_gen_operator_overload(op, lt, rt);
                if let Some { value: ort6 } = overload6 { return ort6; }
            }
            // A nullable `String?` (or a bare `null` literal, tagged "?") widens this from "either
            // side is exactly String" to "either side is String-shaped, nullable or not" -- real
            // NPE risk found once `null` became a real expression (see `Ast.hc`'s own
            // `Expr.NullLit` header): the OLD exact-match check missed `String?`/`"?"` entirely, so
            // `null == "literal"` (`lt` tagged "?", `rt` "String") still matched via `rt`, then
            // called `INVOKEVIRTUAL Object.equals` with `lt` (the null) as the RECEIVER --
            // `null.equals(...)`, a guaranteed `NullPointerException`, not a compile error. Fixed by
            // routing anything that ISN'T PROVABLY a non-null `String` receiver through
            // `Objects.equals(a, b)` instead (null-safe on either argument) -- the cheaper direct
            // `a.equals(b)` stays ONLY for the case `lt` is exactly `"String"` (definitely non-null:
            // a literal, or an already-narrowed local).
            var lt_str_base = lt;
            if is_nullable_type_name_cg(lt) { lt_str_base = strip_nullable_cg(lt); }
            var rt_str_base = rt;
            if is_nullable_type_name_cg(rt) { rt_str_base = strip_nullable_cg(rt); }
            if (op == "==" || op == "!=") && (lt_str_base == "String" || rt_str_base == "String") {
                if lt == "String" {
                    self.mv.visitMethodInsn(182, "java/lang/Object", "equals", "(Ljava/lang/Object;)Z", false); // INVOKEVIRTUAL -- lt provably non-null
                } else {
                    self.mv.visitMethodInsn(184, "java/util/Objects", "equals", "(Ljava/lang/Object;Ljava/lang/Object;)Z", false); // INVOKESTATIC -- null-safe either side
                }
                if op == "!=" {
                    self.mv.visitIntInsn(17, 1);
                    self.mv.visitInsn(130); // IXOR (negate)
                }
                return "Bool";
            }
            // `<`/`<=`/`>`/`>=` get the same mixed-numeric widening the arithmetic ops do (see
            // `gen_widen_numeric_pair`'s own header) -- deliberately scoped to JUST these four,
            // not `==`/`!=` (mixed-type equality is a separate, unrelated concern this pass
            // doesn't touch -- widening would also emit real bytecode here, wrong for a
            // reference-identity/enum-tag comparison that never wanted numeric conversion at all).
            var lt6 = lt;
            var rt6 = rt;
            if op == "<" || op == "<=" || op == ">" || op == ">=" {
                let widened6 = self.gen_widen_numeric_pair(lt, rt);
                lt6 = widened6;
                rt6 = widened6;
            }
            if lt6 == "Long" && rt6 == "Long" {
                // The JVM has no two-operand `IF_LCMPxx` family the way it does for `Int`
                // (`IF_ICMPxx`) -- `Long`/`Float`/`Double` comparisons always go through a
                // dedicated compare-then-branch-on-zero shape instead: `LCMP` consumes both
                // operands and pushes a real `-1`/`0`/`1` Int, then a single-operand `IFxx`
                // (153-158, the same family the `while`/`if` condition machinery elsewhere in
                // this file already uses) branches on THAT against zero.
                self.mv.visitInsn(148); // LCMP
                var true_label4 = Label::new();
                var end_label4 = Label::new();
                let scmp = single_cmp_opcode(op);
                self.mv.visitJumpInsn(scmp, &true_label4);
                self.mv.visitInsn(3); // ICONST_0 (false)
                self.mv.visitJumpInsn(167, &end_label4); // GOTO
                self.mv.visitLabel(&true_label4);
                self.mv.visitInsn(4); // ICONST_1 (true)
                self.mv.visitLabel(&end_label4);
                return "Bool";
            }
            if (lt6 == "Float" && rt6 == "Float") || (lt6 == "Double" && rt6 == "Double") {
                // Same `CMP`-then-branch-on-zero shape as `Long` above, but `Float`/`Double` get
                // TWO compare opcodes each (`FCMPL`/`FCMPG`, `DCMPL`/`DCMPG`) instead of one, to
                // give NaN a well-defined direction: `G` treats a NaN operand as "greater than"
                // (so `<`/`<=` -- which want NaN to read as false -- use `G`, since a false "NaN >
                // x" comparison is what makes the branch not taken), `L` treats it as "less than"
                // (so `>`/`>=` use `L`, same reasoning mirrored). Mirrors the real compiler's own
                // `CodeGen.kt` `genBinary` exactly, not a guess.
                let is_float = lt6 == "Float";
                let use_g = op == "<" || op == "<=";
                var cmp_op = 149; // FCMPL
                if is_float && use_g { cmp_op = 150; } // FCMPG
                if !is_float && !use_g { cmp_op = 151; } // DCMPL
                if !is_float && use_g { cmp_op = 152; } // DCMPG
                self.mv.visitInsn(cmp_op);
                var true_label6 = Label::new();
                var end_label6 = Label::new();
                let scmp2 = single_cmp_opcode(op);
                self.mv.visitJumpInsn(scmp2, &true_label6);
                self.mv.visitInsn(3); // ICONST_0 (false)
                self.mv.visitJumpInsn(167, &end_label6); // GOTO
                self.mv.visitLabel(&true_label6);
                self.mv.visitInsn(4); // ICONST_1 (true)
                self.mv.visitLabel(&end_label6);
                return "Bool";
            }
            // Real bug found stress-testing bare enum-variant-as-value-expression comparisons
            // (`kind == FN`, real `Lexer.hotc`/`Parser.hotc` usage): this branch used to treat
            // `==`/`!=` on ANY ref type uniformly as reference-identity comparison, which is
            // correct for plain structs (no per-field structural equality, a real, disclosed gap
            // matching the real compiler's own) but WRONG for enums -- two separately-constructed
            // instances of the same variant (`t1.kind` and a freshly-built `FN` value, say) are
            // never the SAME object, so `if_acmpeq` was silently always false regardless of the
            // real tag values. The REAL compiler's own `CodeGen.kt` already fixes this (tag
            // comparison, not reference identity -- see `Parser.hotc`'s own header, a much earlier
            // finding), but this self-hosted PORT never got the equivalent fix until now.
            if (op == "==" || op == "!=") && (is_ref_type(lt) || is_ref_type(rt)) && self.is_enum_type(lt) {
                self.mv.visitFieldInsn(180, self.qualify(rt), "tag", "I"); // GETFIELD rightRef.tag -- stack: [leftRef, rightTag]
                self.mv.visitInsn(95); // SWAP -- stack: [rightTag, leftRef]
                self.mv.visitFieldInsn(180, self.qualify(lt), "tag", "I"); // GETFIELD leftRef.tag -- stack: [rightTag, leftTag]
                var true_label3 = Label::new();
                var end_label3 = Label::new();
                let icmp = comparison_opcode(op); // IF_ICMPEQ / IF_ICMPNE
                self.mv.visitJumpInsn(icmp, &true_label3);
                self.mv.visitInsn(3); // ICONST_0 (false)
                self.mv.visitJumpInsn(167, &end_label3); // GOTO
                self.mv.visitLabel(&true_label3);
                self.mv.visitInsn(4); // ICONST_1 (true)
                self.mv.visitLabel(&end_label3);
                return "Bool";
            }
            if (op == "==" || op == "!=") && (is_ref_type(lt) || is_ref_type(rt)) {
                // Struct reference-identity comparison -- no per-field structural equality (see
                // this file's own header, matches the real compiler's own disclosed gap).
                var true_label2 = Label::new();
                var end_label2 = Label::new();
                let acmp = ref_cmp_opcode(op);
                self.mv.visitJumpInsn(acmp, &true_label2);
                self.mv.visitInsn(3); // ICONST_0 (false)
                self.mv.visitJumpInsn(167, &end_label2); // GOTO
                self.mv.visitLabel(&true_label2);
                self.mv.visitInsn(4); // ICONST_1 (true)
                self.mv.visitLabel(&end_label2);
                return "Bool";
            }
            var true_label = Label::new();
            var end_label = Label::new();
            let cmp_opcode = comparison_opcode(op);
            self.mv.visitJumpInsn(cmp_opcode, &true_label);
            self.mv.visitInsn(3); // ICONST_0 (false)
            self.mv.visitJumpInsn(167, &end_label); // GOTO
            self.mv.visitLabel(&true_label);
            self.mv.visitInsn(4); // ICONST_1 (true)
            self.mv.visitLabel(&end_label);
            return "Bool";
        }
    }

    fn gen_unary(&mut self, op: String, inner: &Expr) -> String {
        let ity = self.gen_expr(inner);
        if op == "!" {
            self.mv.visitIntInsn(17, 1);
            self.mv.visitInsn(130); // IXOR (flip 0/1)
            return "Bool";
        } else {
            // Real gap fixed alongside the `Float`/`Double` port: this used to emit `INEG`
            // unconditionally regardless of the inner expression's actual type -- silently wrong
            // for `Long`/`Float`/`Double` (see `Checker.hotc`'s own `check_unary` header, fixed at
            // the same time).
            if ity == "Long" { self.mv.visitInsn(117); return "Long"; } // LNEG
            if ity == "Float" { self.mv.visitInsn(118); return "Float"; } // FNEG
            if ity == "Double" { self.mv.visitInsn(119); return "Double"; } // DNEG
            // Operator overloading, unary half -- see `Checker.hotc`'s own `check_unary` header.
            // `inner`'s value is already on the stack as the sole receiver -- a zero-arg
            // `INVOKEVIRTUAL` is all `neg` ever needs.
            let neg_key = ity + "#neg";
            let neg_desc_found = self.struct_methods.get(neg_key);
            if let Some { value: neg_desc } = neg_desc_found {
                self.mv.visitMethodInsn(182, self.qualify(ity), "neg", neg_desc, false); // INVOKEVIRTUAL
                let neg_rt_found = self.struct_method_rettys.get(neg_key);
                if let Some { value: neg_rt } = neg_rt_found { return neg_rt; }
                return "Int";
            }
            self.mv.visitInsn(116); // INEG
            // `Int`/`Char`/`Byte` share this opcode -- same latent-bug fix as `gen_binary`'s own
            // arithmetic branches (see that fn's own header): return the real inner type instead
            // of a hardcoded `"Int"`, so unary `-` on a `Char`/`Byte` doesn't get silently
            // relabeled.
            return ity;
        }
    }

    // `[result_expr for var_name in iter_expr if cond]` -- see `Ast.hc`'s own `Comprehension`
    // header and `COMPREHENSIONS_IDEAS.md` for the full design. `declared_type` is a real,
    // already-`ensure_instantiated`d mono struct name (`"Vec$Int"`), trusted directly -- see
    // `gen_stmt`'s own `Let` handling, the only real caller. Builds the whole thing as ONE
    // sequence of bytecode within this one expression's own codegen (no synthesized `FnDecl`, no
    // second compile pass) -- same "emit real instructions that leave one value on the stack"
    // shape `gen_string_interp` already uses for a `StringBuilder` chain.
    fn gen_comprehension(&mut self, result_expr: Expr, var_name: String, iter_expr: Expr, cond: Option<Expr>, declared_type: String) -> String {
        let elem_result_ty = mono_arg_cg(declared_type);
        // 1. The EMPTY result `Vec$<ResultType>` -- built as a REAL, synthesized `Vec$<T> { data:
        // [], len: 0 }` struct literal and handed to the ALREADY-PROVEN struct-literal codegen
        // (including its own empty-`[]`-field special case, `Codegen.hotc`'s own struct-
        // construction field loop) rather than hand-rolling the same `NEW`/`DUP`/`<init>` sequence
        // a second time here -- same "materialize real AST, reuse existing codegen" pattern this
        // whole compiler already uses for ECS synthesis.
        var empty_fnames = vec_of("data");
        empty_fnames.push("len");
        var empty_fvals = vec_of(ArrayLit { elements: empty_expr_vec_cg() });
        empty_fvals.push(IntLit { value: 0 });
        let empty_lit = StructLit { name: declared_type, field_names: empty_fnames, field_values: empty_fvals, generic_base: none_string2() };
        let result_ty = self.gen_expr(empty_lit);
        let result_slot = self.next_slot;
        self.next_slot = self.next_slot + 1;
        self.mv.visitVarInsn(58, result_slot); // ASTORE

        // 2. Real loop over `iter_expr` -- one of two shapes depending on its own checked source
        // type (both raw arrays and `Vec<T>` are accepted, see `COMPREHENSIONS_IDEAS.md`'s own
        // "Resolved decisions" #1), sharing everything except the innermost "get the current
        // element" step. Mirrors `gen_stmt`'s own `For` bytecode shape closely (see that arm's own
        // header) rather than inventing a second array-iteration pattern.
        self.push_var_scope();
        let src_ty = self.gen_expr(iter_expr);
        let src_slot = self.next_slot;
        self.next_slot = self.next_slot + 1;
        self.mv.visitVarInsn(58, src_slot); // ASTORE
        let idx_slot = self.next_slot;
        self.next_slot = self.next_slot + 1;
        self.mv.visitInsn(3); // ICONST_0
        self.mv.visitVarInsn(54, idx_slot); // ISTORE

        var is_vec_source = false;
        var elem_ty = "";
        if is_array_type_name_cg(src_ty) {
            elem_ty = array_elem_type_name_cg(src_ty);
        } else {
            is_vec_source = true;
            elem_ty = mono_arg_cg(src_ty);
        }

        let len_slot = self.next_slot;
        self.next_slot = self.next_slot + 1;
        self.mv.visitVarInsn(25, src_slot); // ALOAD
        if is_vec_source {
            self.mv.visitMethodInsn(182, self.qualify(src_ty), "length", "()I", false); // INVOKEVIRTUAL
        } else {
            self.mv.visitInsn(190); // ARRAYLENGTH
        }
        self.mv.visitVarInsn(54, len_slot); // ISTORE

        let var_slot = self.alloc_slot(var_name, elem_ty);
        self.var_types.register(var_name, elem_ty);

        var loop_start = Label::new();
        var loop_end = Label::new();
        self.mv.visitLabel(&loop_start);
        self.mv.visitVarInsn(21, idx_slot); // ILOAD
        self.mv.visitVarInsn(21, len_slot); // ILOAD
        self.mv.visitJumpInsn(162, &loop_end); // IF_ICMPGE

        if is_vec_source {
            self.mv.visitVarInsn(25, src_slot); // ALOAD
            self.mv.visitVarInsn(21, idx_slot); // ILOAD
            let get_desc = "(I)" + self.resolve_descriptor(elem_ty);
            self.mv.visitMethodInsn(182, self.qualify(src_ty), "get", get_desc, false); // INVOKEVIRTUAL
            self.mv.visitVarInsn(store_opcode(elem_ty), var_slot);
        } else {
            self.mv.visitVarInsn(25, src_slot); // ALOAD
            self.mv.visitVarInsn(21, idx_slot); // ILOAD
            self.mv.visitInsn(array_load_opcode_cg(elem_ty));
            self.mv.visitVarInsn(store_opcode(elem_ty), var_slot);
        }

        // 3. Optional filter -- skip straight to the increment step (no push) when false.
        var skip_label = Label::new();
        match cond {
            Some { value: c } => {
                self.gen_expr(c);
                self.mv.visitJumpInsn(153, &skip_label); // IFEQ (cond == 0/false) -> skip
            }
            None => {}
        }

        // 4. Matching element: `result_vec.push(result_expr)` -- INVOKEVIRTUAL needs [objectref,
        // value] on the stack in that order, so the receiver loads FIRST.
        self.mv.visitVarInsn(25, result_slot); // ALOAD result vec
        self.gen_expr(result_expr);
        let push_desc = "(" + self.resolve_descriptor(elem_result_ty) + ")V";
        self.mv.visitMethodInsn(182, self.qualify(declared_type), "push", push_desc, false); // INVOKEVIRTUAL

        self.mv.visitLabel(&skip_label);
        self.mv.visitVarInsn(21, idx_slot); // ILOAD
        self.mv.visitIntInsn(17, 1); // SIPUSH 1
        self.mv.visitInsn(96); // IADD
        self.mv.visitVarInsn(54, idx_slot); // ISTORE
        self.mv.visitJumpInsn(167, &loop_start); // GOTO
        self.mv.visitLabel(&loop_end);
        self.pop_var_scope();

        // 5. The comprehension's own overall value: the now-fully-populated result Vec.
        self.mv.visitVarInsn(25, result_slot); // ALOAD
        return result_ty;
    }

    fn gen_stmt(&mut self, s: Stmt) {
        match s {
            Let { name, mutable, init, declared_type, line } => {
                self.mark_line(line);
                // Consumed exactly ONCE, right here, into plain `Copy`-safe locals (`dt_str`/
                // `has_dt`) -- both this arm's own NEW comprehension special-case below and the
                // EXISTING `dyn`-override check right after it need `declared_type`, and matching/
                // destructuring an `Option<String>` twice would trip the same "use of moved value"
                // trap this file's own header repeatedly documents elsewhere.
                var dt_str = "";
                var has_dt = false;
                if let Some { value: dt0 } = declared_type { dt_str = dt0; has_dt = true; }
                // A comprehension (`let result: Vec<Int> = [x * x for x in numbers];`) needs its
                // own dedicated codegen (`gen_comprehension`, right below) -- NOT the generic
                // `gen_expr` dispatch every other `init` shape goes through, since a comprehension
                // genuinely can't be compiled without ALREADY knowing its own declared result type
                // (see `COMPREHENSIONS_IDEAS.md`'s own header on why: this compiler has no way to
                // learn an arbitrary expression's type without actually generating its bytecode,
                // so the empty result `Vec` this needs to build BEFORE the loop even starts has
                // nothing to infer its own element type FROM unless the caller declared one).
                // `Checker.hotc`'s own `check_stmt` already requires exactly this same annotation
                // for a `Comprehension` init (a real error otherwise, blocking codegen from ever
                // running at all) -- trusted here unconditionally, same "checker already verified
                // it" discipline every other codegen pass in this file already has.
                // `self.gen_expr(init)` (the fallback, non-comprehension path) is called FROM
                // INSIDE the wildcard arm itself, not after this whole match -- calling it
                // afterward would need `init` again post-match, and the move-checker's own
                // conservative branch handling treats a value as "possibly moved" after ANY match
                // arm moves it, regardless of which arm actually ran (the same trap this file's
                // own header documents elsewhere, e.g. `register_enum`).
                var ty = "?";
                match init {
                    Comprehension { result_expr, var_name, iter_expr, cond } => {
                        if !has_dt {
                            throw CodegenError::new("comprehension needs a declared result type (Checker.hotc should have already caught this)");
                        }
                        ty = self.gen_comprehension(result_expr, var_name, iter_expr, cond, dt_str);
                    }
                    _ => {
                        ty = self.gen_expr(init);
                        // See `Ast.hc`'s own `Stmt::Let.declared_type` header: a `dyn` annotation
                        // here is unconditionally trusted (no re-verifying it against a `struct_
                        // interfaces` registry this file doesn't have) -- `Checker.hotc`'s own
                        // `check_stmt` already either applied the exact same override or emitted a
                        // real error for it, and a real error means this codegen pass never runs
                        // at all. A JVM store instruction doesn't care about the exact static type
                        // either way -- `ty`/`dt_str` are both ordinary object-reference types,
                        // same `ASTORE`/1-slot storage regardless.
                        if has_dt && is_dyn_type_name_cg(dt_str) {
                            ty = dt_str;
                        }
                    }
                }
                let slot = self.alloc_slot(name, ty);
                self.var_types.register(name, ty);
                self.mv.visitVarInsn(store_opcode(ty), slot);
            }
            ExprStmt { expr, line } => {
                self.mark_line(line);
                let ety = self.gen_expr(expr);
                // `POP` only pops ONE category-1 stack slot -- `Long` is category-2 (occupies two
                // slots on the operand stack too, not just in locals) and needs `POP2` (88) instead,
                // or the verifier rejects it as leaving a stray half-slot behind. A genuinely
                // `Unit`-typed expression (a void extern-method call used as a bare statement --
                // real `Codegen.hotc` usage: `self.mv.visitInsn(89);`) needs NO pop at all: real
                // gap found self-compiling THIS very function (`gen_variant_construct`) -- a void
                // `INVOKEVIRTUAL` genuinely pushes nothing onto the stack, but this arm used to POP
                // unconditionally whenever `ety != "Long"`, silently popping a value that was never
                // pushed. Harmless-looking in isolation (ASM's own `COMPUTE_FRAMES` doesn't catch a
                // single stray `POP` immediately), but it desyncs this statement's own net stack
                // effect from what surrounding code (a `while` loop's back-edge, say) expects,
                // eventually surfacing as a real `NegativeArraySizeException` in stack-frame
                // merging once enough code accumulates around it.
                if ety == "Unit" {
                    // no value was pushed -- nothing to pop
                } else if ety == "Long" || ety == "Double" {
                    self.mv.visitInsn(88); // POP2 -- both are category-2, occupy two stack slots
                } else {
                    self.mv.visitInsn(87); // POP
                }
            }
            Return { value, line } => {
                self.mark_line(line);
                if let Some { value: v } = value {
                    self.gen_expr(v);
                    if self.ret_ty == "Long" { self.mv.visitInsn(173); } // LRETURN
                    else if self.ret_ty == "Float" { self.mv.visitInsn(174); } // FRETURN
                    else if self.ret_ty == "Double" { self.mv.visitInsn(175); } // DRETURN
                    else if is_ref_type(self.ret_ty) { self.mv.visitInsn(176); } // ARETURN
                    else { self.mv.visitInsn(172); } // IRETURN
                } else {
                    self.mv.visitInsn(177); // RETURN
                }
            }
            If { cond, then_body, else_body, line, narrow_name, narrow_is_eq } => {
                self.mark_line(line);
                self.gen_expr(cond);
                // Mirrors `Checker.hotc`'s own identical guard-clause null-narrowing -- see `Ast.hc`'s
                // own `Stmt::If.narrow_name` header for why the parser already recognized the shape
                // (`narrow_name`/`narrow_is_eq`, read directly here, no re-inspection of `cond`
                // needed). This side needs no VALIDATION at all (the checker already rejected
                // anything unsafe) -- it only has to keep `self.var_types` in sync with the SAME
                // narrowing decisions, so a method/field access on a narrowed value still resolves
                // against its real, un-suffixed extern/struct registration instead of a "?"-suffixed
                // name nothing was ever registered under.
                var do_narrow = false;
                var narrow_orig_type = "";
                if narrow_name != "" {
                    let vfound = self.lookup_type(narrow_name);
                    if let Some { value: vty } = vfound {
                        if is_nullable_type_name_cg(vty) {
                            do_narrow = true;
                            narrow_orig_type = vty;
                        }
                    }
                }
                var else_label = Label::new();
                var end_label = Label::new();
                self.mv.visitJumpInsn(153, &else_label); // IFEQ -- cond==0 (false) -> else
                var then_diverges = false;
                if do_narrow && narrow_is_eq && then_body.length() > 0 {
                    let last = then_body.get(then_body.length() - 1);
                    match last {
                        Return { value, line } => { then_diverges = true; }
                        Throw { value, line } => { then_diverges = true; }
                        _ => {}
                    }
                }
                if do_narrow && !narrow_is_eq {
                    self.var_types.register(narrow_name, strip_nullable_cg(narrow_orig_type));
                }
                self.gen_block(then_body);
                if do_narrow && !narrow_is_eq {
                    self.var_types.register(narrow_name, narrow_orig_type);
                }
                self.mv.visitJumpInsn(167, &end_label); // GOTO
                self.mv.visitLabel(&else_label);
                if let Some { value: eb } = else_body {
                    if do_narrow && narrow_is_eq {
                        self.var_types.register(narrow_name, strip_nullable_cg(narrow_orig_type));
                        self.gen_block(eb);
                        self.var_types.register(narrow_name, narrow_orig_type);
                    } else {
                        self.gen_block(eb);
                    }
                }
                if do_narrow && narrow_is_eq && then_diverges {
                    self.var_types.register(narrow_name, strip_nullable_cg(narrow_orig_type));
                }
                self.mv.visitLabel(&end_label);
            }
            While { cond, body, line } => {
                var start_label = Label::new();
                var end_label = Label::new();
                self.mv.visitLabel(&start_label);
                // Re-marked here (not once before the loop) so a debugger stepping through re-hits
                // this line every iteration, matching real per-iteration re-evaluation of `cond` --
                // `mark_line`'s own "skip a repeat of the SAME line" dedup is keyed on the last
                // emitted line GLOBALLY within this method, not per-label, so a `while` immediately
                // followed by its own first body statement on a later line still re-marks itself
                // correctly on the NEXT iteration once that later line has been marked in between.
                self.mark_line(line);
                self.gen_expr(cond);
                self.mv.visitJumpInsn(153, &end_label); // IFEQ
                // Save/restore around the (possibly nested) body -- matches `Checker.hotc`'s own
                // `loop_depth` save/restore, and mirrors the real compiler's `loopLabels` stack
                // except as plain locals: codegen only ever needs the CURRENT innermost loop's
                // labels (a `Break`/`Continue` inside this body targets THIS loop, never an outer
                // one), so there's nothing a real stack would give that save/restore doesn't.
                let outer_start = self.cur_loop_start;
                let outer_end = self.cur_loop_end;
                self.cur_loop_start = start_label;
                self.cur_loop_end = end_label;
                self.gen_block(body);
                // Read the labels back out of `self` (still ours -- nothing else has touched them
                // yet) before restoring the outer ones, rather than reusing `start_label`/
                // `end_label` directly -- `Label` is a real Java-object extern type, not `Copy`,
                // so moving it into `self.cur_loop_start`/`self.cur_loop_end` above means the
                // ORIGINAL locals can't be read again (real compiler's own move checker caught
                // this while compiling this very file).
                let my_start = self.cur_loop_start;
                let my_end = self.cur_loop_end;
                self.cur_loop_start = outer_start;
                self.cur_loop_end = outer_end;
                self.mv.visitJumpInsn(167, &my_start); // GOTO
                self.mv.visitLabel(&my_end);
            }
            // `for var_name in a..b { }` (real int range) or `for var_name in arr_expr { }` (real
            // `[T]` array) -- see `Ast.hc`'s own `Stmt::For` header for why both shapes share one
            // AST variant. Both desugar to an index/counter-driven `while`-shaped loop, same three-
            // label (`loop_start`/`loop_continue`/`loop_end`) save/restore-around-the-body
            // discipline `While`'s own case right above already uses -- `continue` has to jump to
            // the INCREMENT step (`loop_continue`), not back to the top unconditionally, or it
            // would loop forever without ever advancing; `While`'s own single-label reuse (`continue`
            // re-checks `cond` directly) doesn't apply here since there's a real counter to bump.
            For { var_name, is_range, range_start, range_end, inclusive, arr_expr, body, line } => {
                self.mark_line(line);
                // Real scope for `var_name` itself -- see `CodeGen.var_type_scopes`'s own header --
                // mirrors `Checker.hotc`'s own `check_for`, which pushes one around exactly the same
                // span for exactly the same reason.
                self.push_var_scope();
                if is_range {
                    self.gen_expr(range_start);
                    let var_slot = self.alloc_slot(var_name, "Int");
                    self.var_types.register(var_name, "Int");
                    self.mv.visitVarInsn(54, var_slot); // ISTORE
                    self.gen_expr(range_end);
                    let end_slot = self.next_slot;
                    self.next_slot = self.next_slot + 1;
                    self.mv.visitVarInsn(54, end_slot); // ISTORE

                    var loop_start = Label::new();
                    var loop_continue = Label::new();
                    var loop_end = Label::new();
                    self.mv.visitLabel(&loop_start);
                    self.mv.visitVarInsn(21, var_slot); // ILOAD
                    self.mv.visitVarInsn(21, end_slot); // ILOAD
                    if inclusive {
                        self.mv.visitJumpInsn(163, &loop_end); // IF_ICMPGT
                    } else {
                        self.mv.visitJumpInsn(162, &loop_end); // IF_ICMPGE
                    }
                    let outer_start = self.cur_loop_start;
                    let outer_end = self.cur_loop_end;
                    self.cur_loop_start = loop_continue;
                    self.cur_loop_end = loop_end;
                    self.gen_block(body);
                    let my_continue = self.cur_loop_start;
                    let my_end = self.cur_loop_end;
                    self.cur_loop_start = outer_start;
                    self.cur_loop_end = outer_end;
                    self.mv.visitLabel(&my_continue);
                    self.mv.visitVarInsn(21, var_slot); // ILOAD
                    self.mv.visitIntInsn(17, 1); // SIPUSH 1
                    self.mv.visitInsn(96); // IADD
                    self.mv.visitVarInsn(54, var_slot); // ISTORE
                    self.mv.visitJumpInsn(167, &loop_start); // GOTO
                    self.mv.visitLabel(&my_end);
                } else {
                    let arr_ty = self.gen_expr(arr_expr);
                    let arr_slot = self.next_slot;
                    self.next_slot = self.next_slot + 1;
                    self.mv.visitVarInsn(58, arr_slot); // ASTORE
                    let idx_slot = self.next_slot;
                    self.next_slot = self.next_slot + 1;
                    self.mv.visitInsn(3); // ICONST_0
                    self.mv.visitVarInsn(54, idx_slot); // ISTORE
                    let len_slot = self.next_slot;
                    self.next_slot = self.next_slot + 1;
                    self.mv.visitVarInsn(25, arr_slot); // ALOAD
                    self.mv.visitInsn(190); // ARRAYLENGTH
                    self.mv.visitVarInsn(54, len_slot); // ISTORE

                    let elem_ty = array_elem_type_name_cg(arr_ty);
                    let var_slot = self.alloc_slot(var_name, elem_ty);
                    self.var_types.register(var_name, elem_ty);

                    var loop_start = Label::new();
                    var loop_continue = Label::new();
                    var loop_end = Label::new();
                    self.mv.visitLabel(&loop_start);
                    self.mv.visitVarInsn(21, idx_slot); // ILOAD
                    self.mv.visitVarInsn(21, len_slot); // ILOAD
                    self.mv.visitJumpInsn(162, &loop_end); // IF_ICMPGE
                    self.mv.visitVarInsn(25, arr_slot); // ALOAD
                    self.mv.visitVarInsn(21, idx_slot); // ILOAD
                    self.mv.visitInsn(array_load_opcode_cg(elem_ty));
                    self.mv.visitVarInsn(store_opcode(elem_ty), var_slot);

                    let outer_start = self.cur_loop_start;
                    let outer_end = self.cur_loop_end;
                    self.cur_loop_start = loop_continue;
                    self.cur_loop_end = loop_end;
                    self.gen_block(body);
                    let my_continue = self.cur_loop_start;
                    let my_end = self.cur_loop_end;
                    self.cur_loop_start = outer_start;
                    self.cur_loop_end = outer_end;
                    self.mv.visitLabel(&my_continue);
                    self.mv.visitVarInsn(21, idx_slot); // ILOAD
                    self.mv.visitIntInsn(17, 1); // SIPUSH 1
                    self.mv.visitInsn(96); // IADD
                    self.mv.visitVarInsn(54, idx_slot); // ISTORE
                    self.mv.visitJumpInsn(167, &loop_start); // GOTO
                    self.mv.visitLabel(&my_end);
                }
                self.pop_var_scope();
            }
            Match { subject, arms, line } => {
                self.mark_line(line);
                let sty = self.gen_expr(subject);
                // A raw local slot, not routed through `alloc_slot`/`self.slots` -- the subject
                // is never referenced by name later (unlike a `let`), only read back inside this
                // same statement's own codegen below.
                let subj_slot = self.next_slot;
                self.next_slot = self.next_slot + 1;
                if is_ref_type(sty) { self.mv.visitVarInsn(58, subj_slot); } else { self.mv.visitVarInsn(54, subj_slot); } // ASTORE / ISTORE
                var end_label = Label::new();
                // `match`ing a `&dyn InterfaceName` value dispatches via real `INSTANCEOF`/
                // `CHECKCAST` against each arm's own STRUCT name, not `GETFIELD tag` comparison --
                // there's no shared `tag` field the way every enum-variant class has one (a struct
                // implementing a sealed interface is an ordinary struct otherwise, see
                // `Ast.hc`'s own `InterfaceDecl` header) -- see the loop below's own header for the
                // real bytecode shape. `Checker.hotc`'s own `check_sealed_match` already verified
                // every non-wildcard arm names a real implementor, so `struct_name` below is
                // trusted without re-checking here (same "checker already verified it" honesty
                // this file's enum-tag dispatch, right below, already has for `arm.variant_name`).
                if is_dyn_type_name_cg(sty) {
                    var i2 = 0;
                    while i2 < arms.length() {
                        let arm2 = arms.get(i2);
                        if arm2.variant_name == "_" {
                            self.gen_block(arm2.body);
                            self.mv.visitJumpInsn(167, &end_label); // GOTO
                        } else {
                            var next_label2 = Label::new();
                            let struct_name = arm2.variant_name;
                            self.mv.visitVarInsn(25, subj_slot); // ALOAD
                            self.mv.visitTypeInsn(193, self.qualify(struct_name)); // INSTANCEOF
                            self.mv.visitJumpInsn(153, &next_label2); // IFEQ -- not this struct -> next arm
                            self.mv.visitVarInsn(25, subj_slot); // ALOAD
                            self.mv.visitTypeInsn(192, self.qualify(struct_name)); // CHECKCAST
                            let cast_slot = self.alloc_slot(struct_name + "$cast", struct_name);
                            self.mv.visitVarInsn(58, cast_slot); // ASTORE
                            // Scoped to this arm alone -- mirrors `Checker.hotc`'s own `check_sealed_
                            // match`, which pushes one around exactly the same span.
                            self.push_var_scope();
                            var fj2 = 0;
                            while fj2 < arm2.field_names.length() {
                                let fname2 = arm2.field_names.get(fj2);
                                let bname2 = arm2.bind_names.get(fj2);
                                let fty2 = self.field_type_of(struct_name, fname2);
                                let fslot2 = self.alloc_slot(bname2, fty2);
                                self.var_types.register(bname2, fty2);
                                self.mv.visitVarInsn(25, cast_slot); // ALOAD
                                self.mv.visitFieldInsn(180, self.qualify(struct_name), fname2, self.resolve_descriptor(fty2)); // GETFIELD
                                self.mv.visitVarInsn(store_opcode(fty2), fslot2);
                                fj2 = fj2 + 1;
                            }
                            self.gen_block(arm2.body);
                            self.pop_var_scope();
                            self.mv.visitJumpInsn(167, &end_label); // GOTO
                            self.mv.visitLabel(&next_label2);
                        }
                        i2 = i2 + 1;
                    }
                    self.mv.visitLabel(&end_label);
                } else {
                var i = 0;
                while i < arms.length() {
                    let arm = arms.get(i);
                    if arm.is_literal {
                        // Reuses `gen_binary`'s OWN "==" codegen (real `String.equals()`/`Int`
                        // comparison/etc, whichever the subject's real type needs) rather than
                        // re-deriving type-specific comparison bytecode here -- `subj_slot` is a
                        // raw, unnamed local (see this arm's own header, right above), so it's
                        // temporarily registered under a `$`-prefixed synthetic name (can't
                        // collide with any real user identifier) purely so `gen_binary` can
                        // reference it via an ordinary `Ident`, then re-registered fresh on every
                        // literal arm -- `Registry<T>::register` overwrites an existing entry by
                        // key rather than accumulating stale duplicates, so this is safe to do
                        // once per arm.
                        var next_label3 = Label::new();
                        let synth_name = "$match_subject";
                        self.slots.register(synth_name, subj_slot);
                        self.var_types.register(synth_name, sty);
                        self.gen_binary("==", Ident { name: synth_name }, arm.literal);
                        self.mv.visitJumpInsn(153, &next_label3); // IFEQ -- not equal -> next arm
                        self.gen_block(arm.body);
                        self.mv.visitJumpInsn(167, &end_label); // GOTO
                        self.mv.visitLabel(&next_label3);
                    } else if arm.variant_name == "_" {
                        self.gen_block(arm.body);
                        self.mv.visitJumpInsn(167, &end_label); // GOTO
                    } else {
                        var next_label = Label::new();
                        let tag_key = sty + "#" + arm.variant_name;
                        var vtag = -1;
                        let vtag_found = self.variant_tags.get(tag_key);
                        if let Some { value: t } = vtag_found {
                            vtag = t;
                        }
                        if is_ref_type(sty) { self.mv.visitVarInsn(25, subj_slot); } else { self.mv.visitVarInsn(21, subj_slot); }
                        self.mv.visitFieldInsn(180, self.qualify(sty), "tag", "I"); // GETFIELD
                        self.mv.visitIntInsn(17, vtag); // SIPUSH
                        self.mv.visitJumpInsn(160, &next_label); // IF_ICMPNE -- tag mismatch -> next arm
                        // Prefer the ARM's OWN variant's dedicated field table (`variant_field_
                        // names`/`variant_field_types`, keyed "EnumName#VariantName") over
                        // `field_type_of(sty, ...)`'s enum-wide union -- same real gap
                        // `Checker.hotc`'s own `check_match` had (see `ProgramInfo`'s own
                        // `variant_field_keys` header): `Ast.hc`'s `Expr` enum reuses the field
                        // name "value" across variants at different types, so the union's linear
                        // scan always resolved to whichever variant registered first.
                        let vfn_key = sty + "#" + arm.variant_name;
                        let vfn_found = self.variant_field_names.get(vfn_key);
                        let vft_found = self.variant_field_types.get(vfn_key);
                        var variant_fnames = empty_str_vec4();
                        var variant_ftypes = empty_str_vec4();
                        var has_variant_fields = false;
                        if let Some { value: vfn } = vfn_found {
                            if let Some { value: vft } = vft_found {
                                variant_fnames = vfn;
                                variant_ftypes = vft;
                                has_variant_fields = true;
                            }
                        }
                        // Scoped to this arm alone -- mirrors `Checker.hotc`'s own `check_match`,
                        // which pushes one around exactly the same span.
                        self.push_var_scope();
                        var fj = 0;
                        while fj < arm.field_names.length() {
                            let fname = arm.field_names.get(fj);
                            let bname = arm.bind_names.get(fj);
                            var fty = self.field_type_of(sty, fname);
                            if has_variant_fields {
                                var vfi2 = 0;
                                while vfi2 < variant_fnames.length() {
                                    if variant_fnames.get(vfi2) == fname {
                                        fty = variant_ftypes.get(vfi2);
                                    }
                                    vfi2 = vfi2 + 1;
                                }
                            }
                            let fslot = self.alloc_slot(bname, fty);
                            self.var_types.register(bname, fty);
                            if is_ref_type(sty) { self.mv.visitVarInsn(25, subj_slot); } else { self.mv.visitVarInsn(21, subj_slot); }
                            self.mv.visitFieldInsn(180, self.qualify(sty), arm.variant_name + "$" + fname, self.resolve_descriptor(fty)); // GETFIELD -- mangled, see gen_enum's own header
                            self.mv.visitVarInsn(store_opcode(fty), fslot);
                            fj = fj + 1;
                        }
                        self.gen_block(arm.body);
                        self.pop_var_scope();
                        self.mv.visitJumpInsn(167, &end_label); // GOTO
                        self.mv.visitLabel(&next_label);
                    }
                    i = i + 1;
                }
                self.mv.visitLabel(&end_label);
                }
            }
            // A `String` value still wraps into a hardcoded `java.lang.RuntimeException` (unchanged
            // -- codegen still doesn't know the message's own source line/context beyond that).
            // Anything else is trusted to already be a real exception object (`LexError::new(msg)`
            // -- real `Lexer.hotc` usage, a genuine gap closed now that `extern class` support
            // exists) and `ATHROW`n directly, no wrapping. `value` has to be evaluated BEFORE its
            // type is known (same real ordering conflict `ArrayLit`'s own codegen already
            // describes: `NEW`/`DUP` for the wrapping case would need to come BEFORE the message
            // is pushed, but the message has to be evaluated first to know whether wrapping is
            // even needed at all) -- stashed in a raw temp slot, same "unregistered slot" trick
            // `ArrayLit`/`Match`'s own subject already use.
            Throw { value, line } => {
                self.mark_line(line);
                let vty = self.gen_expr(value);
                let tmp_slot = self.next_slot;
                self.next_slot = self.next_slot + 1;
                if is_ref_type(vty) { self.mv.visitVarInsn(58, tmp_slot); } else { self.mv.visitVarInsn(54, tmp_slot); } // ASTORE / ISTORE
                if vty == "String" {
                    self.mv.visitTypeInsn(187, "java/lang/RuntimeException"); // NEW
                    self.mv.visitInsn(89); // DUP
                    self.mv.visitVarInsn(25, tmp_slot); // ALOAD the message
                    self.mv.visitMethodInsn(183, "java/lang/RuntimeException", "<init>", "(Ljava/lang/String;)V", false); // INVOKESPECIAL
                    self.mv.visitInsn(191); // ATHROW
                } else {
                    self.mv.visitVarInsn(25, tmp_slot); // ALOAD the already-real exception object
                    self.mv.visitInsn(191); // ATHROW
                }
            }
            // Plain unconditional jumps to the innermost enclosing loop's own labels -- nothing
            // to clean up first (no `Drop`/RAII in this subset, see `Ast.hotc`'s `Break`/`Continue`
            // header). `Checker.hotc`'s `loop_depth` already guarantees `self.in_loop` is true here
            // for any program that passed the checker, so there's no fallback path to generate.
            Break { line } => {
                self.mark_line(line);
                let target = self.cur_loop_end;
                self.mv.visitJumpInsn(167, &target); // GOTO loop end
            }
            Continue { line } => {
                self.mark_line(line);
                let target = self.cur_loop_start;
                self.mv.visitJumpInsn(167, &target); // GOTO loop start (re-checks cond, same as real compiler's plain `while`)
            }
            // `try { try_block } catch (catch_var: catch_type) { catch_block } catch (...) { ... }
            // ...` -- one real `visitTryCatchBlock` exception table entry PER catch clause, all
            // covering the SAME `try_block` instruction range (`try_start`..`try_end`, emitted
            // once), each with its own handler label -- registered in DECLARATION order, matching
            // the real JVM's own "first matching handler in table order wins" resolution (so an
            // earlier, narrower `catch` clause is correctly preferred over a later, broader one
            // catching a common supertype, same as real Java source order already implies).
            // `Checker.hotc`'s own `Try` check already guarantees every `catch_type` names a known
            // extern class, so `self.extern_binary.get(...)` is trusted to succeed here.
            Try { try_block, catches, line } => {
                self.mark_line(line);
                var try_start = Label::new();
                var try_end = Label::new();
                var end_label = Label::new();
                var handlers = empty_label_vec_cg();
                var ci = 0;
                while ci < catches.length() {
                    let c = catches.get(ci);
                    var binary_name = c.catch_type;
                    let bin_found = self.extern_binary.get(c.catch_type);
                    if let Some { value: b } = bin_found { binary_name = b; }
                    var handler = Label::new();
                    self.mv.visitTryCatchBlock(&try_start, &try_end, &handler, binary_name);
                    handlers.push(handler);
                    ci = ci + 1;
                }
                self.mv.visitLabel(&try_start);
                self.gen_block(try_block);
                self.mv.visitLabel(&try_end);
                self.mv.visitJumpInsn(167, &end_label); // GOTO
                var hi = 0;
                while hi < catches.length() {
                    let c2 = catches.get(hi);
                    let this_handler = handlers.get(hi);
                    self.mv.visitLabel(&this_handler);
                    // Scoped to this catch clause alone -- mirrors `Checker.hotc`'s own `Try` arm.
                    self.push_var_scope();
                    let catch_slot = self.alloc_slot(c2.catch_var, c2.catch_type);
                    self.var_types.register(c2.catch_var, c2.catch_type);
                    self.mv.visitVarInsn(58, catch_slot); // ASTORE
                    self.gen_block(c2.catch_block);
                    self.pop_var_scope();
                    self.mv.visitJumpInsn(167, &end_label); // GOTO
                    hi = hi + 1;
                }
                self.mv.visitLabel(&end_label);
            }
        }
    }

    fn gen_block(&mut self, stmts: Vec<Stmt>) {
        self.push_var_scope();
        var i = 0;
        while i < stmts.length() {
            self.gen_stmt(stmts.get(i));
            i = i + 1;
        }
        self.pop_var_scope();
    }
}

fn comparison_opcode(op: String) -> Int {
    if op == "==" { return 159; } // IF_ICMPEQ
    if op == "!=" { return 160; } // IF_ICMPNE
    if op == "<" { return 161; }  // IF_ICMPLT
    if op == ">=" { return 162; } // IF_ICMPGE
    if op == ">" { return 163; }  // IF_ICMPGT
    return 164; // IF_ICMPLE ("<=", and the fallback)
}

// The single-operand `IFxx` family (branches on ONE int against zero) -- used after `LCMP` has
// already reduced a `Long` comparison down to a real `-1`/`0`/`1` Int, unlike `comparison_opcode`
// above (`IF_ICMPxx`, a two-operand family comparing two Ints directly -- the JVM has no `Long`
// equivalent of that).
fn single_cmp_opcode(op: String) -> Int {
    if op == "==" { return 153; } // IFEQ
    if op == "!=" { return 154; } // IFNE
    if op == "<" { return 155; }  // IFLT
    if op == ">=" { return 156; } // IFGE
    if op == ">" { return 157; }  // IFGT
    return 158; // IFLE ("<=", and the fallback)
}

fn ref_cmp_opcode(op: String) -> Int {
    if op == "==" { return 165; } // IF_ACMPEQ
    return 166; // IF_ACMPNE
}

// Anything that isn't a plain JVM int (or other primitive) on the operand stack (`Int`/`Bool`/
// `Long`/`Float`/`Double`) is a reference type -- `String` and every struct instance alike -- and
// needs `ALOAD`/`ASTORE` instead of `ILOAD`/`ISTORE`/`LLOAD`/`FLOAD`/`DLOAD`/etc.
fn is_ref_type(name: String) -> Bool {
    return name != "Int" && name != "Bool" && name != "Long" && name != "Float" && name != "Double" && name != "Char" && name != "Byte";
}

// The real JDK wrapper class for a given primitive type name -- `gen_cast`'s own box/unbox pair
// (above) is the only reader: boxing calls `<class>.valueOf(...)`, unboxing first `CHECKCAST`s
// down to `<class>` before calling its own `<x>Value()` method.
fn box_class_for(ty: String) -> String {
    if ty == "Bool" { return "java/lang/Boolean"; }
    if ty == "Long" { return "java/lang/Long"; }
    if ty == "Float" { return "java/lang/Float"; }
    if ty == "Double" { return "java/lang/Double"; }
    if ty == "Char" { return "java/lang/Character"; }
    if ty == "Byte" { return "java/lang/Byte"; }
    return "java/lang/Integer";
}

// `<Wrapper>.valueOf(<prim>)` descriptors -- `gen_cast`'s own boxing branch.
fn box_desc_for(ty: String) -> String {
    if ty == "Bool" { return "(Z)Ljava/lang/Boolean;"; }
    if ty == "Long" { return "(J)Ljava/lang/Long;"; }
    if ty == "Float" { return "(F)Ljava/lang/Float;"; }
    if ty == "Double" { return "(D)Ljava/lang/Double;"; }
    if ty == "Char" { return "(C)Ljava/lang/Character;"; }
    if ty == "Byte" { return "(B)Ljava/lang/Byte;"; }
    return "(I)Ljava/lang/Integer;";
}

// `<Wrapper>.<x>Value()` method names -- `gen_cast`'s own unboxing branch.
fn unbox_method_for(ty: String) -> String {
    if ty == "Bool" { return "booleanValue"; }
    if ty == "Long" { return "longValue"; }
    if ty == "Float" { return "floatValue"; }
    if ty == "Double" { return "doubleValue"; }
    if ty == "Char" { return "charValue"; }
    if ty == "Byte" { return "byteValue"; }
    return "intValue";
}

// `<Wrapper>.<x>Value()` descriptors -- `gen_cast`'s own unboxing branch.
fn unbox_desc_for(ty: String) -> String {
    if ty == "Bool" { return "()Z"; }
    if ty == "Long" { return "()J"; }
    if ty == "Float" { return "()F"; }
    if ty == "Double" { return "()D"; }
    if ty == "Char" { return "()C"; }
    if ty == "Byte" { return "()B"; }
    return "()I";
}

// The right JVM local-variable load/store opcode for a given type name -- `Long`/`Double` need
// `LLOAD`/`LSTORE`/`DLOAD`/`DSTORE` (real category-2 primitives), `Float` needs `FLOAD`/`FSTORE`
// (category-1, like `Int`, but its own opcode family), everything else keeps the existing
// `ALOAD`/`ASTORE` vs `ILOAD`/`ISTORE` split. Centralized here instead of repeating the branch at
// every call site.
fn load_opcode(ty: String) -> Int {
    if ty == "Long" { return 22; } // LLOAD
    if ty == "Float" { return 23; } // FLOAD
    if ty == "Double" { return 24; } // DLOAD
    if is_ref_type(ty) { return 25; } // ALOAD
    return 21; // ILOAD
}

fn store_opcode(ty: String) -> Int {
    if ty == "Long" { return 55; } // LSTORE
    if ty == "Float" { return 56; } // FSTORE
    if ty == "Double" { return 57; } // DSTORE
    if is_ref_type(ty) { return 58; } // ASTORE
    return 54; // ISTORE
}

// A real, pre-existing gap found alongside the `FloatLit`/`DoubleLit` port: array element load/
// store/allocation throughout this file used a bare ref-vs-int split (`AALOAD`/`IALOAD`,
// `AASTORE`/`IASTORE`, `T_INT`-only `NEWARRAY`) -- never hit before, since no array of `Long`/
// `Float`/`Double` existed until now. These three centralize the REAL per-type JVM array opcodes
// (mirroring `load_opcode`/`store_opcode`'s own local-variable equivalents, right above), used at
// every array element access site below.
fn array_load_opcode_cg(ty: String) -> Int {
    if ty == "Long" { return 47; } // LALOAD
    if ty == "Float" { return 48; } // FALOAD
    if ty == "Double" { return 49; } // DALOAD
    // `Byte` gets a REAL `byte[]` array (via `BALOAD`, shared with `Bool`'s own JVM
    // representation when it genuinely IS `boolean[]` -- this compiler's own `Bool` never is, see
    // `newarray_atype_cg`'s own header just below, so this branch is Byte-only in practice), for
    // real interop with byte-array-based JDK APIs (network/file I/O) -- unlike `Bool`, which
    // deliberately stays a plain `int[]` (see `array_store_opcode_cg`'s own "Int/Bool" comment
    // right below), `Byte` has a real, disclosed motivation to be a genuine JVM `byte[]`.
    if ty == "Byte" { return 51; } // BALOAD
    if ty == "Char" { return 52; } // CALOAD
    if is_ref_type(ty) { return 50; } // AALOAD
    return 46; // IALOAD (Int/Bool)
}

fn array_store_opcode_cg(ty: String) -> Int {
    if ty == "Long" { return 80; } // LASTORE
    if ty == "Float" { return 81; } // FASTORE
    if ty == "Double" { return 82; } // DASTORE
    if ty == "Byte" { return 84; } // BASTORE
    if ty == "Char" { return 85; } // CASTORE
    if is_ref_type(ty) { return 83; } // AASTORE
    return 79; // IASTORE (Int/Bool)
}

// `NEWARRAY`'s own `atype` operand for a primitive element type -- `-1` for anything that isn't
// one (a reference element type, which needs `ANEWARRAY` against a real class name instead, not
// `NEWARRAY` at all). `Bool` stays `T_INT` deliberately (this compiler's own `Bool` is never a
// real JVM `boolean` at the field/array-descriptor level either -- see `resolve_descriptor`'s own
// "Bool intentionally maps to I, not Z" header), so a real `T_BOOLEAN` (4) is never used here --
// `Byte`/`Char` are the two REAL new primitive array kinds this adds.
fn newarray_atype_cg(ty: String) -> Int {
    if ty == "Int" || ty == "Bool" { return 10; } // T_INT
    if ty == "Long" { return 11; } // T_LONG
    if ty == "Float" { return 6; } // T_FLOAT
    if ty == "Double" { return 7; } // T_DOUBLE
    if ty == "Byte" { return 8; } // T_BYTE
    if ty == "Char" { return 5; } // T_CHAR
    return -1;
}

fn empty_str_vec4() -> Vec<String> {
    var v = vec_of("__init__");
    return Vec { data: v.data, len: 0 };
}

// `Try`'s own multi-catch codegen needs to create every handler `Label` (registered via
// `visitTryCatchBlock`) BEFORE emitting any handler's own body -- the `try_block` itself has to be
// emitted in between, so the labels need to persist across that gap, hence a real `Vec` rather
// than emitting each handler inline in one pass.
fn empty_label_vec_cg() -> Vec<Label> {
    var v = vec_of(Label::new());
    return Vec { data: v.data, len: 0 };
}

fn empty_str_vec_vec() -> Vec<Vec<String>> {
    var v = vec_of(empty_str_vec4());
    return Vec { data: v.data, len: 0 };
}

fn empty_int_vec() -> Vec<Int> {
    var v = vec_of(0);
    return Vec { data: v.data, len: 0 };
}

extern class CodegenError = "java.lang.RuntimeException" {
    fn new(msg: String) -> Self;
}

// One method per `FnDecl`. Static, `ACC_PUBLIC | ACC_STATIC` (9) -- this simplified AST has no
// notion of `self`/instance methods at all yet. `fn_names`/`fn_descs_list`/`fn_rettys_list` are
// three parallel `Vec`s (one entry per function in the whole program) rebuilt into two fresh
// `Registry`s here every call -- see `compile_program`'s own comment on why they're passed as
// plain `Vec`s and rebuilt per-call rather than a single shared `Registry` reused across its
// codegen loop.
// The real JVM classfile MAJOR version for a given `--target` (17/21/25) -- `44 + <JDK version>`
// per the JVM spec (V17 = 61, matching the literal every class-header emission site in this file
// used before targets existed at all). Every real class-header emission site in this file
// (`gen_lambda`/`gen_interface`/`gen_struct`/`gen_enum`/`compile_program`'s own entry class)
// calls this instead of hardcoding `61` now -- `emit_and_write`, a standalone test-driver helper
// unrelated to the real `compile_program` pipeline, is the one deliberate exception, still
// pinned directly to `61`.
fn classfile_major_for_target(target: Int) -> Int {
    return 44 + target;
}

// Shared by `gen_fn` and `gen_method` -- rebuilds all the cross-function/cross-struct lookup
// tables from `info` fresh (see `ProgramInfo`'s own header for why: reused across a `compile_
// program` codegen loop that rebuilds `info` itself fresh every iteration).
fn build_codegen(mv: MethodVisitor2, owner: String, ret_type_name: String, info: ProgramInfo, fn_identity: String) -> CodeGen {
    var descs = registry_new("__init__", "");
    var rettys = registry_new("__init__", "");
    var fnparamtypes = registry_new("__init__", empty_str_vec4());
    var fnparamnames = registry_new("__init__", empty_str_vec4());
    var ki = 0;
    while ki < info.fn_names.length() {
        descs.register(info.fn_names.get(ki), info.fn_descs_list.get(ki));
        rettys.register(info.fn_names.get(ki), info.fn_rettys_list.get(ki));
        fnparamtypes.register(info.fn_names.get(ki), info.fn_param_types_list.get(ki));
        fnparamnames.register(info.fn_names.get(ki), info.fn_param_names_list.get(ki));
        ki = ki + 1;
    }
    var sfields = registry_new("__init__", empty_str_vec4());
    var sftypes = registry_new("__init__", empty_str_vec4());
    var si = 0;
    while si < info.struct_names.length() {
        sfields.register(info.struct_names.get(si), info.struct_field_names_list.get(si));
        sftypes.register(info.struct_names.get(si), info.struct_field_types_list.get(si));
        si = si + 1;
    }
    var smethods = registry_new("__init__", "");
    var smethod_rettys = registry_new("__init__", "");
    var smethod_param_types = registry_new("__init__", empty_str_vec4());
    var mi = 0;
    while mi < info.method_keys.length() {
        smethods.register(info.method_keys.get(mi), info.method_descs_list.get(mi));
        smethod_rettys.register(info.method_keys.get(mi), info.method_rettys_list.get(mi));
        smethod_param_types.register(info.method_keys.get(mi), info.method_param_types_list.get(mi));
        mi = mi + 1;
    }
    var sendable_structs = registry_new("__init__", false);
    var sdi = 0;
    while sdi < info.sendable_struct_names.length() {
        sendable_structs.register(info.sendable_struct_names.get(sdi), true);
        sdi = sdi + 1;
    }
    var vowner = registry_new("__init__", "");
    var vi = 0;
    while vi < info.variant_owner_names.length() {
        vowner.register(info.variant_owner_names.get(vi), info.variant_owner_enums.get(vi));
        vi = vi + 1;
    }
    var vtags = registry_new("__init__", -1);
    var vti = 0;
    while vti < info.variant_tag_keys.length() {
        vtags.register(info.variant_tag_keys.get(vti), info.variant_tag_list.get(vti));
        vti = vti + 1;
    }
    var ebinary = registry_new("__init__", "");
    var eisiface = registry_new("__init__", 0);
    var ebi = 0;
    while ebi < info.extern_alias_names.length() {
        ebinary.register(info.extern_alias_names.get(ebi), info.extern_binary_names.get(ebi));
        eisiface.register(info.extern_alias_names.get(ebi), info.extern_alias_is_interface.get(ebi));
        ebi = ebi + 1;
    }
    var emdescs = registry_new("__init__", "");
    var emrettys = registry_new("__init__", "");
    var emstatic = registry_new("__init__", 0);
    var emctor = registry_new("__init__", 0);
    var emparamtypes = registry_new("__init__", empty_str_vec4());
    var emi = 0;
    while emi < info.extern_method_keys.length() {
        emdescs.register(info.extern_method_keys.get(emi), info.extern_method_descs_list.get(emi));
        emrettys.register(info.extern_method_keys.get(emi), info.extern_method_rettys_list.get(emi));
        emstatic.register(info.extern_method_keys.get(emi), info.extern_method_static_list.get(emi));
        emctor.register(info.extern_method_keys.get(emi), info.extern_method_ctor_list.get(emi));
        emparamtypes.register(info.extern_method_keys.get(emi), info.extern_method_param_types_list.get(emi));
        emi = emi + 1;
    }
    var efdescs = registry_new("__init__", "");
    var eftypenames = registry_new("__init__", "");
    var efstatic = registry_new("__init__", 0);
    var efi = 0;
    while efi < info.extern_field_keys.length() {
        efdescs.register(info.extern_field_keys.get(efi), info.extern_field_descs_list.get(efi));
        eftypenames.register(info.extern_field_keys.get(efi), info.extern_field_type_names_list.get(efi));
        efstatic.register(info.extern_field_keys.get(efi), info.extern_field_static_list.get(efi));
        efi = efi + 1;
    }
    var sextends = registry_new("__init__", "");
    var sxi = 0;
    while sxi < info.struct_extends_names.length() {
        sextends.register(info.struct_extends_names.get(sxi), info.struct_extends_targets.get(sxi));
        sxi = sxi + 1;
    }
    var ginfer = registry_new("__init__", -1);
    var ginferunwrap = registry_new("__init__", 0);
    var ginfer2 = registry_new("__init__", -1);
    var ginferunwrap2 = registry_new("__init__", 0);
    var gfi = 0;
    while gfi < info.generic_fn_names.length() {
        ginfer.register(info.generic_fn_names.get(gfi), info.generic_fn_infer_idx.get(gfi));
        ginferunwrap.register(info.generic_fn_names.get(gfi), info.generic_fn_infer_unwrap.get(gfi));
        ginfer2.register(info.generic_fn_names.get(gfi), info.generic_fn_infer_idx2.get(gfi));
        ginferunwrap2.register(info.generic_fn_names.get(gfi), info.generic_fn_infer_unwrap2.get(gfi));
        gfi = gfi + 1;
    }
    var gstructinfer = registry_new("__init__", "");
    var gsii = 0;
    while gsii < info.generic_struct_infer_names.length() {
        gstructinfer.register(info.generic_struct_infer_names.get(gsii), info.generic_struct_infer_fields.get(gsii));
        gsii = gsii + 1;
    }
    var genuminferowner = registry_new("__init__", "");
    var genuminferfield = registry_new("__init__", "");
    var geii = 0;
    while geii < info.generic_enum_infer_variant_names.length() {
        genuminferowner.register(info.generic_enum_infer_variant_names.get(geii), info.generic_enum_infer_owner_names.get(geii));
        genuminferfield.register(info.generic_enum_infer_variant_names.get(geii), info.generic_enum_infer_field_names.get(geii));
        geii = geii + 1;
    }
    var static_types = registry_new("__init__", "");
    var sti2 = 0;
    while sti2 < info.static_names.length() {
        static_types.register(info.static_names.get(sti2), info.static_type_names.get(sti2));
        sti2 = sti2 + 1;
    }
    var enum_names_reg = registry_new("__init__", true);
    var eni = 0;
    while eni < info.enum_names.length() {
        enum_names_reg.register(info.enum_names.get(eni), true);
        eni = eni + 1;
    }
    var vfnames = registry_new("__init__", empty_str_vec4());
    var vftypes = registry_new("__init__", empty_str_vec4());
    var vfi = 0;
    while vfi < info.variant_field_keys.length() {
        vfnames.register(info.variant_field_keys.get(vfi), info.variant_field_names_list.get(vfi));
        vftypes.register(info.variant_field_keys.get(vfi), info.variant_field_types_list.get(vfi));
        vfi = vfi + 1;
    }
    var module_of = registry_new("__init__", "");
    var moi = 0;
    while moi < info.module_names.length() {
        module_of.register(info.module_names.get(moi), info.module_values.get(moi));
        moi = moi + 1;
    }
    var slot_scopes_seed2 = vec_of(registry_new("__init__", -1));
    var var_type_scopes_seed2 = vec_of(registry_new("__init__", "Int"));
    return CodeGen { mv: mv, target: info.target, slots: registry_new("__init__", -1), slot_scopes: Vec { data: slot_scopes_seed2.data, len: 0 }, next_slot: 0, owner: owner, fn_descs: descs, fn_ret_tys: rettys, fn_param_types: fnparamtypes, fn_param_names: fnparamnames, var_types: registry_new("__init__", "Int"), var_type_scopes: Vec { data: var_type_scopes_seed2.data, len: 0 }, ret_ty: ret_type_name, struct_fields: sfields, struct_ftypes: sftypes, struct_methods: smethods, struct_method_rettys: smethod_rettys, struct_method_param_types: smethod_param_types, sendable_structs: sendable_structs, variant_owner: vowner, variant_tags: vtags, extern_binary: ebinary, extern_is_interface: eisiface, extern_method_descs: emdescs, extern_method_rettys: emrettys, extern_method_static: emstatic, extern_method_ctor: emctor, extern_method_param_types: emparamtypes, extern_field_descs: efdescs, extern_field_type_names: eftypenames, extern_field_static: efstatic, struct_extends: sextends, generic_fn_infer_idx: ginfer, generic_fn_infer_unwrap: ginferunwrap, generic_fn_infer_idx2: ginfer2, generic_fn_infer_unwrap2: ginferunwrap2, generic_struct_infer_field: gstructinfer, generic_enum_infer_owner: genuminferowner, generic_enum_infer_field: genuminferfield, static_types: static_types, enum_names: enum_names_reg, cur_loop_start: Label::new(), cur_loop_end: Label::new(), variant_field_names: vfnames, variant_field_types: vftypes, last_emitted_line: -1, module_of: module_of, interfaces_raw: info.interfaces_raw, fn_identity: fn_identity, lambda_counter: 0 };
}

// A monomorphized instantiation (`"Box$Int"`) resolves to its TEMPLATE's own `module_name`
// (`mono_base_cg`) -- `structs`/`enums` never register a `module_name` under the mono name
// itself, only under the generic declaration's own bare name (see `Ast.hc`'s own
// `StructDecl.module_name` header). Used by `gen_struct`/`gen_enum`'s own top-level emission
// loop, which already has `structs`/`enums` on hand but no `ProgramInfo`/`CodeGen` receiver yet
// at the point the class's own header/output-path needs qualifying.
fn find_struct_module_cg(name: String, structs: &Vec<StructDecl>) -> Option<String> {
    var base = name;
    if is_mono_name_cg(name) { base = mono_base_cg(name); }
    var i = 0;
    while i < structs.length() {
        let sd = structs.get(i);
        if sd.name == base {
            return sd.module_name;
        }
        i = i + 1;
    }
    return none_string();
}

fn find_enum_module_cg(name: String, enums: &Vec<EnumDecl>) -> Option<String> {
    var base = name;
    if is_mono_name_cg(name) { base = mono_base_cg(name); }
    var i = 0;
    while i < enums.length() {
        let ed = enums.get(i);
        if ed.name == base {
            return ed.module_name;
        }
        i = i + 1;
    }
    return none_string();
}

// `name` unchanged (default package) when `module_name` is `None` -- the single fallback every
// call site of this relies on to stay backward-compatible with every `.hotc` file that never
// wrote a `module` declaration at all.
fn qualify_with_opt_module_cg(name: String, module_name: Option<String>) -> String {
    if let Some { value: m } = module_name {
        return dot_to_slash_cg(m) + "/" + name;
    }
    return name;
}

pub fn gen_fn(cw: &mut ClassWriter2, owner: String, name: String, param_names: Vec<String>, param_type_names: Vec<String>, ret_type_name: String, body: Vec<Stmt>, info: ProgramInfo, annotation: Option<Annotation>) {
    let param_count = param_names.length();
    // Built inline (not via the standalone `fn_descriptor` helper) so `param_type_names` stays
    // available afterward for the per-param `var_types` registration loop below -- passing the
    // whole `Vec` into another function would move it, but repeated `.get()` calls on it here do
    // not (same distinction `compile_program`'s own comments make elsewhere in this file).
    var desc = "(";
    var di = 0;
    while di < param_type_names.length() {
        desc = desc + descriptor_of_type(param_type_names.get(di), &info.extern_alias_names, &info.extern_binary_names, &info.module_names, &info.module_values);
        di = di + 1;
    }
    desc = desc + ")" + descriptor_of_type(ret_type_name, &info.extern_alias_names, &info.extern_binary_names, &info.module_names, &info.module_values);
    var mv0 = CodegenShim::visitMethodNoSig(&mut cw, 9, name, desc, ["x"; 0]); // ACC_PUBLIC | ACC_STATIC
    if let Some { value: ann0 } = annotation {
        emit_method_annotation(&mut mv0, ann0);
    }
    var gen = build_codegen(mv0, owner, ret_type_name, info, name);
    var i = 0;
    while i < param_count {
        gen.alloc_slot(param_names.get(i), param_type_names.get(i));
        gen.var_types.register(param_names.get(i), param_type_names.get(i));
        i = i + 1;
    }
    gen.mv.visitCode();
    gen.gen_block(body);
    gen_fallback_return(&mut gen, ret_type_name); // see its own header -- guards against a dangling trailing label
    gen.mv.visitMaxs(0, 0); // COMPUTE_MAXS on the ClassWriter makes the real values irrelevant
    gen.mv.visitEnd();
}

// Same shape as `gen_fn`, but an instance method (`ACC_PUBLIC` only, not `ACC_STATIC`) on the
// struct's own class -- `self` lives in the always-implicit JVM local slot 0 (not part of the
// method's own descriptor, which covers only the *other* declared params), matching how every
// real JVM instance method receives its receiver.
// A real `<clinit>` (`ACC_STATIC` only -- no `ACC_PUBLIC`, matching what a JVM static initializer
// actually is) computing every top-level `pub static NAME: Type = expr;`'s real value and
// `PUTSTATIC`-ing it into the field `compile_program` already declared for it. `gen_expr` already
// knows how to emit ordinary literal/expression bytecode, so no separate constant-folding pass is
// needed -- this just reuses it inside a real (if trivial) method body, same as `<init>` reuses
// ordinary field-assignment codegen for a struct's own constructor.
pub fn gen_static_init(cw: &mut ClassWriter2, owner: String, statics: &Vec<StaticDecl>, info: ProgramInfo) {
    let mv0 = CodegenShim::visitMethodNoSig(&mut cw, 8, "<clinit>", "()V", ["x"; 0]); // ACC_STATIC
    var gen = build_codegen(mv0, owner, "Unit", info, "clinit");
    gen.mv.visitCode();
    // `$stdin` -- a real static `BufferedReader` field (`compile_program`'s own class-header
    // emission declares it, `read_line`'s own `Call` codegen reads it -- `read_int`/`read_string`
    // reach it only indirectly, by calling `read_line()` themselves from the injected prelude)
    // wrapping `System.in`, initialized unconditionally right here regardless of whether this
    // program declares any `pub static` fields of its own -- the ONLY `<clinit>` this class gets,
    // so a program using `read_line()` but no `pub static`s still needs this method to exist at
    // all (see `compile_program`'s own header for why `gen_static_init` is now called
    // unconditionally, not just when `statics.length() > 0`).
    gen.mv.visitTypeInsn(187, "java/io/BufferedReader"); // NEW
    gen.mv.visitInsn(89); // DUP
    gen.mv.visitTypeInsn(187, "java/io/InputStreamReader"); // NEW
    gen.mv.visitInsn(89); // DUP
    gen.mv.visitFieldInsn(178, "java/lang/System", "in", "Ljava/io/InputStream;"); // GETSTATIC
    gen.mv.visitMethodInsn(183, "java/io/InputStreamReader", "<init>", "(Ljava/io/InputStream;)V", false); // INVOKESPECIAL
    gen.mv.visitMethodInsn(183, "java/io/BufferedReader", "<init>", "(Ljava/io/Reader;)V", false); // INVOKESPECIAL
    gen.mv.visitFieldInsn(179, gen.owner, "$stdin", "Ljava/io/BufferedReader;"); // PUTSTATIC
    var i = 0;
    while i < statics.length() {
        let s = statics.get(i);
        // `__resource_<Name>` (see `resource_field_name_ecs`'s own header) is a real entry in
        // THIS list (so `build_program_info`'s own `static_names`/`static_type_names` -- and
        // this fn's field-declaration sibling loop in `compile_program` -- pick it up with zero
        // special-casing), but its own `.value` here is a meaningless throwaway (`BoolLit
        // {false}`, never the field's real type) -- PUTSTATIC-ing it would be a real type
        // mismatch. Skipped here, and ONLY here: this field is deliberately left at the JVM's
        // own default (`null`) until a real `world.set_resource(...)` call first sets it.
        if !str_starts_with(s.name, "__resource_") {
            let s2 = statics.get(i); // fresh copy -- `.value` is only safe to read once
            gen.gen_expr(s2.value);
            gen.mv.visitFieldInsn(179, gen.owner, s.name, gen.resolve_descriptor(s.type_name)); // PUTSTATIC
        }
        i = i + 1;
    }
    gen.mv.visitInsn(177); // RETURN
    gen.mv.visitMaxs(0, 0);
    gen.mv.visitEnd();
}

pub fn gen_method(cw: &mut ClassWriter2, binary_name: String, struct_name: String, name: String, param_names: Vec<String>, param_type_names: Vec<String>, ret_type_name: String, body: Vec<Stmt>, info: ProgramInfo) {
    var desc = "(";
    var di = 0;
    while di < param_type_names.length() {
        desc = desc + descriptor_of_type(param_type_names.get(di), &info.extern_alias_names, &info.extern_binary_names, &info.module_names, &info.module_values);
        di = di + 1;
    }
    desc = desc + ")" + descriptor_of_type(ret_type_name, &info.extern_alias_names, &info.extern_binary_names, &info.module_names, &info.module_values);
    let mv0 = CodegenShim::visitMethodNoSig(&mut cw, 1, name, desc, ["x"; 0]); // ACC_PUBLIC
    // `owner` (used only for same-class *top-level function* calls -- see `gen_expr`'s `Call`
    // arm) stays the main class, not this struct's class -- a method body calling an ordinary fn
    // still targets the class functions actually live in.
    var gen = build_codegen(mv0, binary_name, ret_type_name, info, struct_name + "_" + name);
    gen.alloc_slot("self", struct_name); // slot 0, matching the JVM's own implicit receiver convention
    gen.var_types.register("self", struct_name);
    var i = 0;
    while i < param_names.length() {
        gen.alloc_slot(param_names.get(i), param_type_names.get(i));
        gen.var_types.register(param_names.get(i), param_type_names.get(i));
        i = i + 1;
    }
    gen.mv.visitCode();
    gen.gen_block(body);
    gen_fallback_return(&mut gen, ret_type_name); // see its own header -- guards against a dangling trailing label
    gen.mv.visitMaxs(0, 0);
    gen.mv.visitEnd();
}

// A real fn/method body that provably returns on every path (the checker doesn't verify this,
// but every demo this phase writes does) still leaves its *last* control-flow-join label (e.g.
// `match`'s own `end_label`, when every arm ends in `return`) with no instruction after it --
// the label sits exactly at the end of the method's bytecode, which the JVM verifier rejects
// outright (a stack-map frame must describe a real instruction offset, not "one past the end").
// Unconditionally emitting one dummy return after the real body -- dead code whenever the real
// body already returned everywhere, but a genuine instruction at that trailing offset either way
// -- sidesteps the whole class of "dangling final label" bug family (`match`, but potentially any
// future construct with the same shape) without needing real reachability analysis.
fn gen_fallback_return(gen: &mut CodeGen, ret_type_name: String) {
    if ret_type_name == "Unit" {
        gen.mv.visitInsn(177); // RETURN
    } else if ret_type_name == "Long" {
        gen.mv.visitInsn(9); // LCONST_0
        gen.mv.visitInsn(173); // LRETURN
    } else if ret_type_name == "Float" {
        gen.mv.visitInsn(11); // FCONST_0
        gen.mv.visitInsn(174); // FRETURN
    } else if ret_type_name == "Double" {
        gen.mv.visitInsn(14); // DCONST_0
        gen.mv.visitInsn(175); // DRETURN
    } else if is_ref_type(ret_type_name) {
        gen.mv.visitInsn(1); // ACONST_NULL
        gen.mv.visitInsn(176); // ARETURN
    } else {
        gen.mv.visitInsn(3); // ICONST_0
        gen.mv.visitInsn(172); // IRETURN
    }
}

// Rebuilds a `ProgramInfo` from the whole program's real, original `fns`/`structs`/`impls`
// -- called fresh once per codegen unit (each top-level fn, each impl-block method), borrowed
// rather than owned (`&Vec<...>`) specifically so calling it many times in a loop never risks the
// "used after move inside a loop" problem `compile_program`'s own per-iteration rebuilding
// comments describe elsewhere in this file -- a borrow never consumes what it points at, so the
// same `fns`/`structs`/`impls` bindings stay usable across as many calls as needed.
fn build_program_info(target: Int, fns: &Vec<FnDecl>, structs: &Vec<StructDecl>, impls: &Vec<ImplDecl>, enums: &Vec<EnumDecl>, mono_names: &Vec<String>, fn_mono_names: &Vec<String>, method_mono_names: &Vec<String>, statics: &Vec<StaticDecl>, externs: &Vec<ExternClassDecl>, interfaces: &Vec<InterfaceDecl>, sendable_struct_names: &Vec<String>) -> ProgramInfo {
    // Built once, reused for every descriptor built below (fn/method params or return types
    // naming an extern alias need the real binary name -- see `descriptor_of_type`'s own header).
    // `extern interface`'s own name/binary pairs fold into this SAME table, right alongside
    // `extern class` ones -- `descriptor_of_type`'s own `is_dyn_type_name_cg` branch (and
    // `resolve_descriptor`'s identical one, via `self.extern_binary` -- built from this same
    // table, see `build_codegen`) consult it by the bare interface name either way, so this is
    // the only place that needs to know `extern interface`s exist at all for descriptor purposes.
    var alias_names = extern_alias_list(&externs);
    var alias_binaries = extern_binary_list(&externs);
    var ebii = 0;
    while ebii < interfaces.length() {
        let ebifd = interfaces.get(ebii);
        if let Some { value: ebbin } = ebifd.extern_binary_name {
            alias_names.push(ebifd.name);
            alias_binaries.push(dot_to_slash_cg(ebbin)); // see `dot_to_slash_cg`'s own header
        }
        ebii = ebii + 1;
    }
    // Built here too, up front alongside the extern-alias tables above -- `fn_descriptor`'s own
    // calls (right below, for every top-level fn/method's descriptor) need real module-qualified
    // names for any LOCAL struct/enum/interface param or return type just as much as they need
    // extern-alias resolution, and both tables have to already be complete before the very FIRST
    // descriptor gets built (a forward reference to a struct/enum declared later in the same file
    // is otherwise missed, same reasoning `extern_alias_list`'s own header gives for going first).
    // See `ProgramInfo.module_names`'s own header for why generic TEMPLATE declarations are
    // included, not skipped.
    var module_names = empty_str_vec4();
    var module_values = empty_str_vec4();
    var msi = 0;
    while msi < structs.length() {
        let msd = structs.get(msi);
        if let Some { value: mval } = msd.module_name {
            module_names.push(msd.name);
            module_values.push(mval);
        }
        msi = msi + 1;
    }
    var mei = 0;
    while mei < enums.length() {
        let med = enums.get(mei);
        if let Some { value: mval2 } = med.module_name {
            module_names.push(med.name);
            module_values.push(mval2);
        }
        mei = mei + 1;
    }
    var mii = 0;
    while mii < interfaces.length() {
        let mid = interfaces.get(mii);
        if let Some { value: mval3 } = mid.module_name {
            module_names.push(mid.name);
            module_values.push(mval3);
        }
        mii = mii + 1;
    }
    var fn_names = empty_str_vec4();
    var fn_descs_list = empty_str_vec4();
    var fn_rettys_list = empty_str_vec4();
    // Parallel to `fn_names` -- the DECLARED param type name strings, not yet compiled to JVM
    // descriptors (see `extern_method_param_types_list`'s own header, same reason). Only a
    // non-generic top-level fn's OWN entry is populated (matching `fn_names`/`fn_descs_list`'s own
    // scope) -- a generic fn's own bare-callee lookup never reaches `fn_descs`/`fn_param_types` at
    // all (see `generic_fn_names`'s own header), so it doesn't need one.
    var fn_param_types_list = empty_str_vec_vec();
    // Parallel to `fn_param_types_list` (same index, same fn) -- the DECLARED param NAMES, in
    // order, for a plain (non-generic) top-level fn -- feeds `CodeGen.fn_param_names` via
    // `build_codegen`, used by `resolve_named_args_cg` to reorder a call's `NamedArg` list back
    // to positional order.
    var fn_param_names_list = empty_str_vec_vec();
    var static_names = empty_str_vec4();
    var static_type_names = empty_str_vec4();
    var sni = 0;
    while sni < statics.length() {
        let sd4 = statics.get(sni);
        static_names.push(sd4.name);
        static_type_names.push(sd4.type_name);
        sni = sni + 1;
    }
    // A generic top-level fn declaration (`type_param` is `Some`) is never directly callable --
    // skipped here entirely, same as a generic struct/enum declaration above/below -- only its
    // concrete monomorphizations (the `fn_mono_names` loop further down) get real descriptor
    // entries. `generic_fn_names`/`generic_fn_infer_idx` record enough about the template itself
    // for `gen_expr`'s own `Call` codegen to infer a concrete instantiation at each call site (see
    // `ProgramInfo`'s own header).
    var generic_fn_names = empty_str_vec4();
    var generic_fn_infer_idx = empty_int_vec();
    var generic_fn_infer_unwrap = empty_int_vec();
    var generic_fn_infer_idx2 = empty_int_vec();
    var generic_fn_infer_unwrap2 = empty_int_vec();
    var fi = 0;
    while fi < fns.length() {
        let g = fns.get(fi);
        let g2 = fns.get(fi); // fresh copy -- `.params` is only safe to read once
        let g2b = fns.get(fi); // another fresh copy -- the SECOND type param's own scan needs its own read
        let g3 = fns.get(fi); // another fresh copy -- `fn_param_types_list` needs its own read
        let g4 = fns.get(fi); // another fresh copy -- `fn_param_names_list` needs its own read
        var g_is_generic = false;
        var g_tp = "";
        if let Some { value: tp } = g.type_param { g_is_generic = true; g_tp = tp; }
        if g_is_generic {
            generic_fn_names.push(g.name);
            var infer_idx = -1;
            var infer_unwrap = 0;
            var pgi = 0;
            while pgi < g2.params.length() {
                let ptn = g2.params.get(pgi).type_name;
                if ptn == g_tp && infer_idx < 0 {
                    infer_idx = pgi;
                    infer_unwrap = 0;
                } else if is_mono_name_cg(ptn) && mono_arg_cg(ptn) == g_tp && infer_idx < 0 {
                    // `b: Box<T>` -- see `ProgramInfo`'s own header on `generic_fn_infer_unwrap`.
                    infer_idx = pgi;
                    infer_unwrap = 1;
                } else if is_array_type_name_cg(ptn) && array_elem_type_name_cg(ptn) == g_tp && infer_idx < 0 {
                    // `arr: &[T]` -- mirrors `Checker.hotc`'s own identical `check_generic_call`
                    // fix (same real gap: `fn first<T>(arr: &[T]) -> T`) -- `infer_unwrap = 2`
                    // means "peel one `[...]` layer off the arg's own array type instead of one
                    // `Base$...` layer" at the call site below.
                    infer_idx = pgi;
                    infer_unwrap = 2;
                }
                pgi = pgi + 1;
            }
            generic_fn_infer_idx.push(infer_idx);
            generic_fn_infer_unwrap.push(infer_unwrap);
            // `fn hash_map2_new<K: Hashable, V>(...)` -- the SAME scan, independently, for the
            // SECOND type param (see `Ast.hc`'s own `FnDecl.type_param2` header). `-1`/`0` when
            // there is no second type param at all.
            var g_has_tp2 = false;
            var g_tp2 = "";
            if let Some { value: tp2g } = g.type_param2 { g_has_tp2 = true; g_tp2 = tp2g; }
            var infer_idx2 = -1;
            var infer_unwrap2 = 0;
            if g_has_tp2 {
                var pgi2 = 0;
                while pgi2 < g2b.params.length() {
                    let ptn2 = g2b.params.get(pgi2).type_name;
                    if ptn2 == g_tp2 && infer_idx2 < 0 {
                        infer_idx2 = pgi2;
                        infer_unwrap2 = 0;
                    } else if is_mono_name_cg(ptn2) && mono_arg_cg(ptn2) == g_tp2 && infer_idx2 < 0 {
                        infer_idx2 = pgi2;
                        infer_unwrap2 = 1;
                    } else if is_array_type_name_cg(ptn2) && array_elem_type_name_cg(ptn2) == g_tp2 && infer_idx2 < 0 {
                        infer_idx2 = pgi2;
                        infer_unwrap2 = 2;
                    }
                    pgi2 = pgi2 + 1;
                }
            }
            generic_fn_infer_idx2.push(infer_idx2);
            generic_fn_infer_unwrap2.push(infer_unwrap2);
        } else {
            // `"Unit"`, not `"Int"` -- a real, pre-existing mismatch found self-hosting the new
            // classpath-reflection module's own `verify_extern_signature` (the first `Unit`-
            // returning method/fn anywhere in this codebase with an EXPLICIT bare `return;` mid-
            // body, rather than only falling off the end). `Checker.hotc`'s own `opt_string_or2`
            // default (`self.cur_ret_ty`, driving `Return`'s choice of opcode -- a bare `return;`
            // ALWAYS emits a plain void `RETURN` regardless of what the descriptor claims) was
            // already correctly `"Unit"`; every one of THIS file's own descriptor-building sites
            // defaulted to `"Int"` instead, silently papered over until now by
            // `gen_fallback_return` synthesizing a harmless dummy `ICONST_0`/`IRETURN` for any
            // function that never explicitly returns a value at all (matching the WRONG "Int"
            // descriptor well enough that nothing ever caught the mismatch) -- a real, explicit
            // `return;` bypasses that fallback entirely and desyncs from the (wrongly `I`-typed)
            // descriptor, a genuine `VerifyError: Method expects a return value`.
            let g_ret = opt_string_or(g.ret_type, "Unit");
            fn_names.push(g.name);
            fn_descs_list.push(fn_descriptor(param_type_names_of(g2.params), g_ret, &alias_names, &alias_binaries, &module_names, &module_values));
            fn_rettys_list.push(g_ret);
            fn_param_types_list.push(param_type_names_of(g3.params));
            fn_param_names_list.push(param_names_of(g4.params));
        }
        fi = fi + 1;
    }
    // Monomorphized generic FUNCTION instantiations (`"identity$Int"`) get their own descriptor
    // entries too, same substitution `Checker.hotc`'s own `ensure_fn_instantiated` already
    // performed once to decide this instantiation was needed at all -- mirrors the struct
    // `mono_names` loop further down.
    var fmn = 0;
    while fmn < fn_mono_names.length() {
        let fmono_name = fn_mono_names.get(fmn);
        let mono_params = monomorphized_fn_params_cg(&fns, fmono_name);
        let mono_ret = monomorphized_fn_retty_cg(&fns, fmono_name);
        fn_names.push(fmono_name);
        fn_descs_list.push(fn_descriptor(param_type_names_of(mono_params), mono_ret, &alias_names, &alias_binaries, &module_names, &module_values));
        fn_rettys_list.push(mono_ret);
        fn_param_types_list.push(param_type_names_of(mono_params));
        fn_param_names_list.push(param_names_of(mono_params));
        fmn = fmn + 1;
    }
    var enum_names = empty_str_vec4();
    var struct_names = empty_str_vec4();
    var struct_field_names_list = empty_str_vec_vec();
    var struct_field_types_list = empty_str_vec_vec();
    var generic_struct_infer_names = empty_str_vec4();
    var generic_struct_infer_fields = empty_str_vec4();
    var si = 0;
    while si < structs.length() {
        let sd = structs.get(si);
        let sd2 = structs.get(si); // fresh copy -- `.fields` is only safe to read once
        let sd3 = structs.get(si); // fresh copy again -- see above, needed a third time below
        var is_generic = false;
        var g_tp2 = "";
        if let Some { value: tp } = sd.type_param { is_generic = true; g_tp2 = tp; }
        if !is_generic {
            struct_names.push(sd.name);
            struct_field_names_list.push(param_names_of(sd.fields));
            struct_field_types_list.push(param_type_names_of(sd2.fields));
        } else {
            var gsi = 0;
            var found_field = false;
            while gsi < sd3.fields.length() && !found_field {
                let gf = sd3.fields.get(gsi);
                if gf.type_name == g_tp2 {
                    generic_struct_infer_names.push(sd3.name);
                    generic_struct_infer_fields.push(gf.name);
                    found_field = true;
                }
                gsi = gsi + 1;
            }
        }
        si = si + 1;
    }
    var variant_owner_names = empty_str_vec4();
    var variant_owner_enums = empty_str_vec4();
    var variant_tag_keys = empty_str_vec4();
    var variant_tag_list = empty_int_vec();
    var variant_field_keys = empty_str_vec4();
    var variant_field_names_list = empty_str_vec_vec();
    var variant_field_types_list = empty_str_vec_vec();
    // Monomorphized generic instantiations (`"Box$Int"`) get their own field table entries too --
    // same substitution `Checker.hotc`'s `ensure_instantiated` and this file's own `gen_struct`
    // emission loop both already perform, redone here so `FieldAccess`/`StructLit` codegen inside
    // function/method bodies can resolve fields on them (see `monomorphized_fields`'s own header).
    // A generic *enum* instantiation (`"Option$Int"`, `is_generic_enum_mono`) takes the enum-
    // shaped path instead: its substituted variants' union of fields (mirroring the plain-enum
    // loop just below) plus `variant_tag_*` entries -- deliberately NOT `variant_owner_*` (bare
    // name -> owner), since that would collide across multiple concrete instantiations of the same
    // generic enum; `gen_expr`'s own `StructLit` codegen resolves a qualified construction site's
    // owner directly from `generic_base` instead, and `Match` codegen already keys everything off
    // the subject's own concrete type name (`sty`), needing no bare-name lookup at all (see
    // `Ast.hc`'s own `EnumDecl` header).
    var mn = 0;
    while mn < mono_names.length() {
        let mono_name = mono_names.get(mn);
        if is_generic_enum_mono(&enums, mono_name) {
            let mono_variants = monomorphized_enum_variants(&enums, mono_name);
            var eunion_names = empty_str_vec4();
            var eunion_types = empty_str_vec4();
            var evi = 0;
            while evi < mono_variants.length() {
                let ev = mono_variants.get(evi);
                variant_tag_keys.push(mono_name + "#" + ev.name);
                variant_tag_list.push(evi);
                var v_field_names = empty_str_vec4();
                var v_field_types = empty_str_vec4();
                var efi = 0;
                while efi < ev.fields.length() {
                    let ef = ev.fields.get(efi);
                    eunion_names.push(ef.name);
                    eunion_types.push(ef.type_name);
                    v_field_names.push(ef.name);
                    v_field_types.push(ef.type_name);
                    efi = efi + 1;
                }
                variant_field_keys.push(mono_name + "#" + ev.name);
                variant_field_names_list.push(v_field_names);
                variant_field_types_list.push(v_field_types);
                evi = evi + 1;
            }
            struct_names.push(mono_name);
            struct_field_names_list.push(eunion_names);
            struct_field_types_list.push(eunion_types);
            enum_names.push(mono_name);
        } else {
            struct_names.push(mono_name);
            let mono_fields = monomorphized_fields(&structs, mono_name);
            let mono_fields2 = monomorphized_fields(&structs, mono_name);
            struct_field_names_list.push(param_names_of(mono_fields));
            struct_field_types_list.push(param_type_names_of(mono_fields2));
        }
        mn = mn + 1;
    }
    var method_keys = empty_str_vec4();
    var method_descs_list = empty_str_vec4();
    var method_rettys_list = empty_str_vec4();
    var method_param_types_list = empty_str_vec_vec();
    var ii = 0;
    while ii < impls.length() {
        let impl_decl = impls.get(ii);
        // An instance method inside a GENERIC struct's own `impl` block is never directly
        // callable -- skipped here (same as a generic struct/enum/fn declaration is skipped
        // elsewhere in this file) -- only its concrete monomorphizations (the `method_mono_names`
        // loop further down) get real descriptor entries. Static methods keep their existing
        // unconditional behavior (a real, disclosed scope cut -- see `Checker.hotc`'s own
        // `generic_method_templates` header).
        var impl_is_generic = false;
        let impl_tp = struct_type_param_cg(&structs, impl_decl.struct_name);
        if impl_tp != "" { impl_is_generic = true; }
        var mi = 0;
        while mi < impl_decl.methods.length() {
            let m = impl_decl.methods.get(mi);
            let m2 = impl_decl.methods.get(mi); // fresh copy -- `.params` is only safe to read once
            if !impl_is_generic {
                let m_ret = opt_string_or(m.ret_type, "Unit");
                method_keys.push(impl_decl.struct_name + "#" + m.name);
                method_descs_list.push(fn_descriptor(param_type_names_of(m.params), m_ret, &alias_names, &alias_binaries, &module_names, &module_values));
                method_rettys_list.push(m_ret);
                method_param_types_list.push(param_type_names_of(m2.params));
            }
            mi = mi + 1;
        }
        // Static methods share the same "StructName#method" table as instance methods --
        // `Expr::StaticCall` and `Expr::MethodCall` are different enough syntactically that a
        // struct is never expected to declare both a static and an instance method of the same
        // name, so reusing one flat table here (rather than a separate one) is safe and simpler.
        var smi = 0;
        while smi < impl_decl.static_methods.length() {
            let sm = impl_decl.static_methods.get(smi);
            let sm2 = impl_decl.static_methods.get(smi); // fresh copy -- `.params` is only safe to read once
            let sm_ret = opt_string_or(sm.ret_type, "Unit");
            method_keys.push(impl_decl.struct_name + "#" + sm.name);
            method_descs_list.push(fn_descriptor(param_type_names_of(sm.params), sm_ret, &alias_names, &alias_binaries, &module_names, &module_values));
            method_rettys_list.push(sm_ret);
            method_param_types_list.push(param_type_names_of(sm2.params));
            smi = smi + 1;
        }
        ii = ii + 1;
    }
    // An interface method's own signature -- keyed `"dyn InterfaceName#method"`, piggybacking on
    // the SAME flat `method_keys`/`method_descs_list`/`method_rettys_list` table struct methods
    // already use (no separate registry/`CodeGen` field needed at all): `gen_expr`'s own
    // `MethodCall` codegen already looks up `rt + "#" + method"` directly, and for a `&dyn
    // InterfaceName`-typed receiver `rt` IS exactly `"dyn InterfaceName"` (see `Parser.hotc`'s own
    // `type_name_ref` header) -- so this table entry existing at all is the only new lookup-side
    // plumbing this feature needs; the call SITE itself still has to pick `INVOKEINTERFACE` over
    // `INVOKEVIRTUAL` and target the interface's own binary name, see that arm's own header.
    var ifi = 0;
    while ifi < interfaces.length() {
        let ifd = interfaces.get(ifi);
        // The FULL, FLATTENED method set (own methods plus everything inherited, transitively,
        // from `extends`) -- not just `ifd.methods` (its OWN declarations only) -- so a call
        // through a `&dyn Child`-typed receiver to a method it only inherits from a supertrait
        // still finds a real `"dyn Child#method"` descriptor entry here. See `Ast.hc`'s own
        // `flatten_interface_methods` header.
        let ifd_methods = flatten_interface_methods(&interfaces, ifd.name);
        var imi = 0;
        while imi < ifd_methods.length() {
            let im = ifd_methods.get(imi);
            let im2 = ifd_methods.get(imi); // fresh copy -- `.params` is only safe to read once
            method_keys.push("dyn " + ifd.name + "#" + im.name);
            // Empty module tables here on purpose, NOT the real `module_names`/`module_values` --
            // this descriptor has to match whatever `gen_interface` actually wrote onto the
            // interface's own `.class` file for this method, and that emission (see its own
            // header) is a disclosed narrower scope that doesn't qualify param/return types
            // either; using the real tables here while `gen_interface` doesn't would desync the
            // two into a real `NoSuchMethodError`/verify mismatch at INVOKEINTERFACE dispatch time.
            let no_iface_modules = empty_str_vec4();
            let no_iface_module_vals = empty_str_vec4();
            method_descs_list.push(fn_descriptor(param_type_names_of(im.params), im.ret_type, &alias_names, &alias_binaries, &no_iface_modules, &no_iface_module_vals));
            method_rettys_list.push(im.ret_type);
            method_param_types_list.push(param_type_names_of(im2.params));
            imi = imi + 1;
        }
        ifi = ifi + 1;
    }
    // Monomorphized generic METHOD instantiations (`"Box$Int#get"`) get their own descriptor
    // entries too, same substitution `Checker.hotc`'s own `ensure_method_instantiated` already
    // performed once to decide this instantiation was needed at all -- mirrors the `fn_mono_names`
    // loop above. `gen_expr`'s own `MethodCall` codegen needs NO changes for this at all: it
    // already looks up `rn + "#" + method` directly (`rn` being the receiver's own concrete mono
    // type), which is EXACTLY this key shape -- the only piece that needed building was this
    // table entry existing at all.
    var mmn = 0;
    while mmn < method_mono_names.length() {
        let mkey = method_mono_names.get(mmn);
        let midx = mkey.indexOf("#");
        let mowner = mkey.substring(0, midx);
        let mmethod = mkey.substring(midx + 1, mkey.length());
        let mono_mparams = monomorphized_method_params_cg(&impls, &structs, mowner, mmethod);
        let mono_mret = monomorphized_method_retty_cg(&impls, &structs, mowner, mmethod);
        method_keys.push(mkey);
        method_descs_list.push(fn_descriptor(param_type_names_of(mono_mparams), mono_mret, &alias_names, &alias_binaries, &module_names, &module_values));
        method_rettys_list.push(mono_mret);
        method_param_types_list.push(param_type_names_of(mono_mparams));
        mmn = mmn + 1;
    }
    // Each *non-generic* enum's *union* of variant fields is registered under the enum's own name
    // into the same `struct_names`/`struct_field_*_list` arrays `gen_expr`'s `FieldAccess`/
    // `StructLit` already read for real structs -- an enum instance's fields are looked up exactly
    // the same way a struct's are (see `Checker.hotc`'s `register_enum`, same simplification
    // mirrored here). `variant_owner_*`/`variant_tag_*` are the two pieces genuinely new to enums:
    // which enum a variant name belongs to, and that variant's tag index. A *generic* enum
    // declaration (`type_param` is `Some`) is skipped here entirely -- it's just a template, same
    // as a generic struct declaration above; only its concrete monomorphizations (handled in the
    // `mono_names` loop above) get real field-table entries.
    var generic_enum_infer_variant_names = empty_str_vec4();
    var generic_enum_infer_owner_names = empty_str_vec4();
    var generic_enum_infer_field_names = empty_str_vec4();
    var ei = 0;
    while ei < enums.length() {
        let ed = enums.get(ei);
        let ed2 = enums.get(ei); // fresh copy -- `.variants` is only safe to read once
        var ed_is_generic = false;
        var e_tp = "";
        if let Some { value: etp } = ed.type_param { ed_is_generic = true; e_tp = etp; }
        if ed_is_generic {
            // Parallel to `generic_struct_infer_names`/`generic_struct_infer_fields` above, but
            // keyed by VARIANT name (not the enum's own base name) since which field carries the
            // inference is a per-variant question (`Option<T>`'s `Some { value: T }` has one,
            // `None {}` has none) -- see `gen_expr`'s own `StructLit` header on why this exists.
            var gei = 0;
            while gei < ed2.variants.length() {
                let gev = ed2.variants.get(gei);
                var gefi = 0;
                var ge_found_field = false;
                while gefi < gev.fields.length() && !ge_found_field {
                    let gevf = gev.fields.get(gefi);
                    if gevf.type_name == e_tp {
                        generic_enum_infer_variant_names.push(gev.name);
                        generic_enum_infer_owner_names.push(ed2.name);
                        generic_enum_infer_field_names.push(gevf.name);
                        ge_found_field = true;
                    }
                    gefi = gefi + 1;
                }
                gei = gei + 1;
            }
            ei = ei + 1;
            continue;
        }
        var union_names = empty_str_vec4();
        var union_types = empty_str_vec4();
        var vi = 0;
        while vi < ed.variants.length() {
            let v = ed.variants.get(vi);
            variant_owner_names.push(v.name);
            variant_owner_enums.push(ed.name);
            variant_tag_keys.push(ed.name + "#" + v.name);
            variant_tag_list.push(vi);
            var v_field_names2 = empty_str_vec4();
            var v_field_types2 = empty_str_vec4();
            var fi2 = 0;
            while fi2 < v.fields.length() {
                let f = v.fields.get(fi2);
                union_names.push(f.name);
                union_types.push(f.type_name);
                v_field_names2.push(f.name);
                v_field_types2.push(f.type_name);
                fi2 = fi2 + 1;
            }
            variant_field_keys.push(ed.name + "#" + v.name);
            variant_field_names_list.push(v_field_names2);
            variant_field_types_list.push(v_field_types2);
            vi = vi + 1;
        }
        struct_names.push(ed.name);
        struct_field_names_list.push(union_names);
        struct_field_types_list.push(union_types);
        enum_names.push(ed.name);
        // `gen_enum` emits a real static `valueOf(String) -> Name` and instance `.name() ->
        // String` for any enum with at least one zero-field variant (its own `has_singleton`
        // gate) -- register the SAME two entries here, into the SAME `method_keys`/
        // `method_descs_list`/`method_rettys_list` table real `impl`-block methods use, so
        // `gen_expr`'s `StaticCall`/`MethodCall` codegen (which only ever consults this one
        // table) can find and INVOKESTATIC/INVOKEVIRTUAL them like any other struct method,
        // instead of only being reachable from real Java callers.
        var has_singleton3 = false;
        var hsi3 = 0;
        while hsi3 < ed.variants.length() {
            if ed.variants.get(hsi3).fields.length() == 0 { has_singleton3 = true; }
            hsi3 = hsi3 + 1;
        }
        if has_singleton3 {
            var vof_param_names = empty_str_vec4();
            vof_param_names.push("String");
            var vof_param_names2 = empty_str_vec4();
            vof_param_names2.push("String");
            method_keys.push(ed.name + "#valueOf");
            method_descs_list.push(fn_descriptor(vof_param_names, ed.name, &alias_names, &alias_binaries, &module_names, &module_values));
            method_rettys_list.push(ed.name);
            method_param_types_list.push(vof_param_names2);
            method_keys.push(ed.name + "#name");
            method_descs_list.push(fn_descriptor(empty_str_vec4(), "String", &alias_names, &alias_binaries, &module_names, &module_values));
            method_rettys_list.push("String");
            method_param_types_list.push(empty_str_vec4());
        }
        ei = ei + 1;
    }
    // Built as its own FIRST pass over every extern, complete before any method descriptor is
    // built -- an extern method's own param/return type can itself be ANOTHER extern-class alias
    // (real `Codegen.hotc` usage: `CodegenShim`'s methods take `ClassWriter2`/`MethodVisitor2`
    // params), possibly one declared LATER in the source than the extern whose method references
    // it. Building the alias table incrementally, interleaved with the method-descriptor loop
    // below (as this used to), would miss a genuine forward reference; this way the table is
    // always complete by the time any descriptor is resolved against it.
    var extern_alias_names = empty_str_vec4();
    var extern_binary_names = empty_str_vec4();
    var extern_alias_is_interface = empty_int_vec();
    var xai = 0;
    while xai < externs.length() {
        let xda = externs.get(xai);
        extern_alias_names.push(xda.name);
        extern_binary_names.push(dot_to_slash_cg(xda.binary_name));
        var xda_iface = 0;
        if xda.is_interface { xda_iface = 1; }
        extern_alias_is_interface.push(xda_iface);
        xai = xai + 1;
    }
    // Same interface-folding as the OTHER `alias_names`/`alias_binaries` pair right above (a
    // separately-scoped, separately-built table just for extern METHOD descriptors -- see this
    // fn's own header for why) -- an extern class method's own declared param/return type can
    // itself be a `&dyn ExternInterfaceName` (real usage: `JThread::new(target: &dyn Run)`, see
    // `Ast.hc`'s own `InterfaceDecl.extern_binary_name` header), and this is the table
    // `extern_method_descriptor`'s own calls, right below, actually resolve against.
    var xaii = 0;
    while xaii < interfaces.length() {
        let xaifd = interfaces.get(xaii);
        if let Some { value: xaibin } = xaifd.extern_binary_name {
            extern_alias_names.push(xaifd.name);
            extern_binary_names.push(dot_to_slash_cg(xaibin));
            // Not flagged interface here -- an `extern interface`-folded entry only ever gets
            // referenced as a TYPE (descriptor resolution), never through this alias's own extern
            // METHOD table (only `ExternClassDecl`s populate that, right below), so there's no
            // `MethodCall` codegen path that would ever read this flag for one of these.
            extern_alias_is_interface.push(0);
        }
        xaii = xaii + 1;
    }
    var extern_method_keys = empty_str_vec4();
    var extern_method_descs_list = empty_str_vec4();
    var extern_method_rettys_list = empty_str_vec4();
    var extern_method_static_list = empty_int_vec();
    var extern_method_ctor_list = empty_int_vec();
    // Parallel to the four lists above (same key, same push order) -- the DECLARED param type name
    // strings (`"dyn Run"`, not yet compiled down to a JVM descriptor like `"Ljava/lang/Runnable;"`)
    // -- `gen_expr`'s own lambda-argument detection needs these, not the compiled descriptor, to
    // tell whether a given param position is even a valid lambda target at all (see `gen_lambda`'s
    // own header). Nothing else in this file previously needed the RAW type name once the real
    // descriptor was built, so this is new plumbing, not a pre-existing gap.
    var extern_method_param_types_list = empty_str_vec_vec();
    var xi = 0;
    while xi < externs.length() {
        let xd = externs.get(xi);
        var xmi = 0;
        while xmi < xd.methods.length() {
            let xm = xd.methods.get(xmi);
            let xm2 = xd.methods.get(xmi); // fresh copy -- `.params` is only safe to read once
            let xm3 = xd.methods.get(xmi); // another fresh copy -- pushed a second time below, for the sig-key entry
            var xm_desc = "";
            var xm_retty = "";
            if xm.is_ctor {
                xm_desc = extern_ctor_descriptor(param_type_names_of(xm.params), &extern_alias_names, &extern_binary_names);
                xm_retty = xd.name;
            } else {
                xm_desc = extern_method_descriptor(param_type_names_of(xm.params), xm.ret_type, dot_to_slash_cg(xd.binary_name), &extern_alias_names, &extern_binary_names);
                if xm.ret_type == "Self" {
                    xm_retty = xd.name;
                } else {
                    xm_retty = xm.ret_type;
                }
            }
            var xm_static = 0;
            if xm.is_static { xm_static = 1; }
            var xm_ctor = 0;
            if xm.is_ctor { xm_ctor = 1; }
            // Registered under BOTH the arity-only key AND a full-signature key (types joined via
            // `arity_str_cg`'s own header) -- `gen_expr`'s `StaticCall`/`MethodCall` extern
            // branches try the precise signature key first, falling back to arity-only, so two
            // same-arity overloads (Gson's `addProperty(String,String)` vs
            // `addProperty(String,Number)`) each get their own reachable entry.
            let key = xd.name + "#" + xm.name + "#" + arity_str_cg(xm.params.length());
            extern_method_keys.push(key);
            extern_method_descs_list.push(xm_desc);
            extern_method_rettys_list.push(xm_retty);
            extern_method_static_list.push(xm_static);
            extern_method_ctor_list.push(xm_ctor);
            extern_method_param_types_list.push(param_type_names_of(xm2.params));
            let sig_key = key + "#" + join_type_names_cg(param_type_names_of(xm.params));
            extern_method_keys.push(sig_key);
            extern_method_descs_list.push(xm_desc);
            extern_method_rettys_list.push(xm_retty);
            extern_method_static_list.push(xm_static);
            extern_method_ctor_list.push(xm_ctor);
            extern_method_param_types_list.push(param_type_names_of(xm3.params));
            xmi = xmi + 1;
        }
        xi = xi + 1;
    }
    var extern_field_keys = empty_str_vec4();
    var extern_field_descs_list = empty_str_vec4();
    var extern_field_type_names_list = empty_str_vec4();
    var extern_field_static_list = empty_int_vec();
    var xfi = 0;
    while xfi < externs.length() {
        let xfd = externs.get(xfi);
        var xffi = 0;
        while xffi < xfd.fields.length() {
            let xf = xfd.fields.get(xffi);
            var xf_static = 0;
            if xf.is_static { xf_static = 1; }
            extern_field_keys.push(xfd.name + "#" + xf.name);
            extern_field_descs_list.push(descriptor_of_type(xf.type_name, &extern_alias_names, &extern_binary_names, &module_names, &module_values));
            extern_field_type_names_list.push(xf.type_name);
            extern_field_static_list.push(xf_static);
            xffi = xffi + 1;
        }
        xfi = xfi + 1;
    }
    var struct_extends_names = empty_str_vec4();
    var struct_extends_targets = empty_str_vec4();
    var sxbi = 0;
    while sxbi < structs.length() {
        let sxbd = structs.get(sxbi);
        if let Some { value: sxsup } = sxbd.super_class {
            struct_extends_names.push(sxbd.name);
            struct_extends_targets.push(sxsup);
        }
        sxbi = sxbi + 1;
    }
    var interfaces_raw = empty_interface_vec_cg();
    var ifci = 0;
    while ifci < interfaces.length() {
        interfaces_raw.push(interfaces.get(ifci));
        ifci = ifci + 1;
    }
    var sendable_names_owned = empty_str_vec4();
    var sni = 0;
    while sni < sendable_struct_names.length() {
        sendable_names_owned.push(sendable_struct_names.get(sni));
        sni = sni + 1;
    }
    return ProgramInfo { target: target, sendable_struct_names: sendable_names_owned, fn_names: fn_names, fn_descs_list: fn_descs_list, fn_rettys_list: fn_rettys_list, fn_param_types_list: fn_param_types_list, fn_param_names_list: fn_param_names_list, static_names: static_names, static_type_names: static_type_names, generic_fn_names: generic_fn_names, generic_fn_infer_idx: generic_fn_infer_idx, generic_fn_infer_unwrap: generic_fn_infer_unwrap, generic_fn_infer_idx2: generic_fn_infer_idx2, generic_fn_infer_unwrap2: generic_fn_infer_unwrap2, generic_struct_infer_names: generic_struct_infer_names, generic_struct_infer_fields: generic_struct_infer_fields, generic_enum_infer_variant_names: generic_enum_infer_variant_names, generic_enum_infer_owner_names: generic_enum_infer_owner_names, generic_enum_infer_field_names: generic_enum_infer_field_names, enum_names: enum_names, struct_names: struct_names, struct_field_names_list: struct_field_names_list, struct_field_types_list: struct_field_types_list, method_keys: method_keys, method_descs_list: method_descs_list, method_rettys_list: method_rettys_list, method_param_types_list: method_param_types_list, variant_owner_names: variant_owner_names, variant_owner_enums: variant_owner_enums, variant_tag_keys: variant_tag_keys, variant_tag_list: variant_tag_list, extern_alias_names: extern_alias_names, extern_binary_names: extern_binary_names, extern_alias_is_interface: extern_alias_is_interface, extern_method_keys: extern_method_keys, extern_method_descs_list: extern_method_descs_list, extern_method_rettys_list: extern_method_rettys_list, extern_method_static_list: extern_method_static_list, extern_method_ctor_list: extern_method_ctor_list, extern_method_param_types_list: extern_method_param_types_list, extern_field_keys: extern_field_keys, extern_field_descs_list: extern_field_descs_list, extern_field_type_names_list: extern_field_type_names_list, extern_field_static_list: extern_field_static_list, struct_extends_names: struct_extends_names, struct_extends_targets: struct_extends_targets, variant_field_keys: variant_field_keys, variant_field_names_list: variant_field_names_list, variant_field_types_list: variant_field_types_list, module_names: module_names, module_values: module_values, interfaces_raw: interfaces_raw };
}

fn empty_interface_vec_cg() -> Vec<InterfaceDecl> {
    var v = vec_of(InterfaceDecl { name: "__init__", methods: empty_interfacemethod_vec_cg(), is_sealed: false, parents: empty_str_vec4(), extern_binary_name: none_string2(), module_name: none_string2(), is_open: false });
    return Vec { data: v.data, len: 0 };
}

fn empty_interfacemethod_vec_cg() -> Vec<InterfaceMethod> {
    var v = vec_of(InterfaceMethod { name: "__init__", params: empty_param_vec2(), ret_type: "Unit", body: none_stmt_list_cg() });
    return Vec { data: v.data, len: 0 };
}

// "Self" -> the real binary name's own descriptor (`"L<binary>;"`), anything else -> the usual
// `descriptor_of_type`. Real gap found self-compiling `Codegen.hotc` itself: the original scope
// cut here ("extern method params can't be extern-typed, only fields/plain fn params can be, so
// no real alias table is ever needed") is violated by `Codegen.hotc`'s own `CodegenShim` extern
// class, whose methods take `ClassWriter2`/`MethodVisitor2` params -- OTHER extern-class types,
// not just `Int`/`Bool`/`String`. Passing empty alias tables meant `descriptor_of_type` fell
// through to its "unknown name -> treat as a literal class reference" branch for these, emitting
// a real but WRONG descriptor (`"LClassWriter2;"` instead of `"Lorg/objectweb/asm/ClassWriter;"`)
// -- not caught by the checker (no real classpath reflection), not caught by ASM's own
// `COMPUTE_FRAMES` either (a syntactically valid, just nonexistent, class name) -- only surfaced
// as a genuine `NoClassDefFoundError` at JVM class-LOAD time. Now threads the real, accumulated
// alias tables through from `build_program_info`'s own externs loop instead.
// `"Bool"` -> `"Z"` here specifically, NOT the general `"I"` `descriptor_of_type` itself uses
// (see that fn's own header -- this subset represents `Bool` as a plain JVM int for ITS OWN
// struct fields/locals/params, harmless since only ITS OWN already-consistent bytecode ever reads
// them back). An EXTERN method boundary is different: the METHOD DESCRIPTOR is what the JVM's own
// linker matches a call site against, and a real JVM method genuinely declared `boolean` has
// descriptor `"...)Z"`, not `"...)I"` -- these are different signatures as far as method
// resolution is concerned. Real gap found giving `Checker.hotc` classpath reflection at all:
// `java.lang.reflect.Modifier.isPublic(int)` genuinely returns `boolean`, and every PRIOR extern
// declaration in this whole session either avoided `-> Bool` entirely or special-cased a literal
// descriptor string directly (`MethodCall`'s own hardcoded `String.contains` -- see that arm) --
// this is the first time the GENERIC extern-descriptor path was asked to build one, producing a
// real `NoSuchMethodError` at call time (a syntactically valid but WRONG descriptor, same
// "compiles clean, fails at link/run time" class of bug as `ClassWriter2`'s own alias mismatch).
fn extern_descriptor_of_type(name: String, alias_names: &Vec<String>, alias_binaries: &Vec<String>) -> String {
    if name == "Bool" { return "Z"; }
    // Extern method params/returns can't name a LOCAL, module-qualified struct/enum this round --
    // a real, disclosed narrower scope, same class of cut as this file's other extern-method
    // limitations (see this fn's own call site header) -- so empty module tables here are safe.
    let no_modules = empty_str_vec4();
    let no_modules2 = empty_str_vec4();
    return descriptor_of_type(name, &alias_names, &alias_binaries, &no_modules, &no_modules2);
}

fn extern_ret_descriptor(ret_type: String, binary_name: String, alias_names: &Vec<String>, alias_binaries: &Vec<String>) -> String {
    if ret_type == "Self" { return "L" + binary_name + ";"; }
    return extern_descriptor_of_type(ret_type, &alias_names, &alias_binaries);
}

fn extern_method_descriptor(param_types: Vec<String>, ret_type: String, binary_name: String, alias_names: &Vec<String>, alias_binaries: &Vec<String>) -> String {
    var d = "(";
    var i = 0;
    while i < param_types.length() {
        d = d + extern_descriptor_of_type(param_types.get(i), &alias_names, &alias_binaries);
        i = i + 1;
    }
    return d + ")" + extern_ret_descriptor(ret_type, binary_name, &alias_names, &alias_binaries);
}

// Constructors always return `void` at the real bytecode level regardless of the HC-level
// `-> Self` annotation -- same real JVM convention `gen_struct`'s own constructor already follows.
// Real alias tables threaded through, same fix as `extern_method_descriptor`'s own header.
fn extern_ctor_descriptor(param_types: Vec<String>, alias_names: &Vec<String>, alias_binaries: &Vec<String>) -> String {
    var d = "(";
    var i = 0;
    while i < param_types.length() {
        d = d + extern_descriptor_of_type(param_types.get(i), &alias_names, &alias_binaries);
        i = i + 1;
    }
    return d + ")V";
}

// One real `.class` file per `StructDecl`: public fields (declared order), a constructor taking
// every field's value in that same order and `PUTFIELD`-ing each (the only way this phase's
// `StructLit` codegen constructs an instance -- `INVOKESPECIAL <init>`, see `gen_expr`), and
// every impl-block method declared for this struct (`gen_method`).
// A real JVM interface class: `ACC_PUBLIC | ACC_INTERFACE | ACC_ABSTRACT` (1 + 512 + 1024 = 1537)
// on the class itself, `ACC_PUBLIC | ACC_ABSTRACT` (1 + 1024 = 1025) on each method -- no
// `visitCode()` call at all for an abstract method (an interface method has no `Code` attribute;
// `visitEnd()` right after `visitMethodNoSig` is what actually produces that, same as any abstract
// method on any real Java interface). `extends` is real: a `Child : Parent`'s own `Child.class`
// genuinely lists `Parent` in its own JVM `interfaces[]` table (same array slot Java's own
// `interface Child extends Parent` compiles to) -- that's what lets a real `INVOKEINTERFACE
// Child.inheritedMethod` resolve at all when `inheritedMethod` is only declared on `Parent`, per
// real JVM interface-method resolution walking the NAMED interface's own supertype chain (JVMS
// 5.4.3.4), even though `Child.class` never redeclares it. Every method here -- including one with
// a real default BODY in the source -- still gets ONLY an abstract stub on the interface class
// itself (no default bodies compiled here, still a real, disclosed narrower scope than the real
// compiler's own JVM-native default methods): interface-method RESOLUTION only needs a matching
// (name, descriptor) to exist SOMEWHERE in the hierarchy, it doesn't care whether that declaration
// is abstract or concrete, and the REAL runtime dispatch always lands on whichever concrete
// struct's own `.class` is actually running -- which always genuinely HAS the method, abstract or
// not, thanks to `Codegen.hotc`'s own `materialize_default_methods` giving every implementing
// struct a real, compiled copy of any default it didn't override itself. Descriptor building reuses
// `descriptor_of_type` with EMPTY alias tables (interface method signatures can't reference an
// extern-class alias this phase -- a real, disclosed narrower scope than `gen_method`'s own, which
// gets real alias tables from its enclosing struct's own `externs`).
pub fn gen_interface(target: Int, name: String, methods: Vec<InterfaceMethod>, parents: Vec<String>, module_name: Option<String>, interfaces: &Vec<InterfaceDecl>) {
    var cw = ClassWriter2::new(2); // COMPUTE_FRAMES
    let qname = qualify_with_opt_module_cg(name, module_name);
    // Each `extends`ed parent is resolved the SAME way a struct's own `implements` clause is --
    // see `struct_iface_jvm_name`'s own header (extern binary name, else this parent's own
    // `module`-qualified name, else its bare declared name unchanged).
    var parents_arr = [qname; parents.length()]; // placeholder-filled, overwritten below
    var exi = 0;
    while exi < parents.length() {
        parents_arr[exi] = struct_iface_jvm_name(parents.get(exi), interfaces);
        exi = exi + 1;
    }
    CodegenShim::visitClassHeader(&mut cw, classfile_major_for_target(target), 1537, qname, "java/lang/Object", parents_arr); // ACC_PUBLIC | ACC_INTERFACE | ACC_ABSTRACT
    CodegenShim::visitSource(&mut cw, name + ".hotc");
    let empty_aliases = empty_str_vec4();
    let empty_binaries = empty_str_vec4();
    // Interface method signatures can't reference a LOCAL, module-qualified struct/enum this
    // round either -- same disclosed narrower scope as the extern-alias cut right above (empty
    // tables both ways).
    let empty_modules = empty_str_vec4();
    let empty_module_vals = empty_str_vec4();
    var mi = 0;
    while mi < methods.length() {
        let m = methods.get(mi);
        var desc = "(";
        var di = 0;
        while di < m.params.length() {
            desc = desc + descriptor_of_type(m.params.get(di).type_name, &empty_aliases, &empty_binaries, &empty_modules, &empty_module_vals);
            di = di + 1;
        }
        desc = desc + ")" + descriptor_of_type(m.ret_type, &empty_aliases, &empty_binaries, &empty_modules, &empty_module_vals);
        let mv0 = CodegenShim::visitMethodNoSig(&mut cw, 1025, m.name, desc, ["x"; 0]); // ACC_PUBLIC | ACC_ABSTRACT
        mv0.visitEnd();
        mi = mi + 1;
    }
    CodegenShim::writeClass(cw, qname + ".class");
}

// A struct implementing an interface (`impl InterfaceName for StructName { ... }`) needs the real
// JVM to know it -- otherwise a `&dyn InterfaceName`-typed value holding this struct would fail
// `INVOKEINTERFACE`'s own runtime check with a real `IncompatibleClassChangeError`, regardless of
// how correct the method bodies themselves are. Scans `impls` (already threaded into `gen_struct`
// for its OWN methods) rather than needing a new param -- see `ImplDecl`'s own header for the
// "at most one interface per struct" scope cut this relies on (first match wins, but there should
// only ever be one).
// Every interface `struct_name` directly `impl`s -- a REAL gap this used to have, closed
// alongside `Checker.hotc`'s own matching `struct_interfaces` fix: a struct implementing MORE
// than one interface (`impl A for Widget { ... }` and `impl B for Widget { ... }`, two SEPARATE
// `ImplDecl`s sharing one `struct_name`) is real now, not a one-interface-per-struct limit -- see
// `Ast.hc`'s own `ImplDecl` header, which used to disclose this as a scope cut.
fn struct_interfaces_of(impls: &Vec<ImplDecl>, struct_name: String) -> Vec<String> {
    var out = empty_str_vec4();
    var i = 0;
    while i < impls.length() {
        let im = impls.get(i);
        if im.struct_name == struct_name {
            if let Some { value: iface } = im.interface_name {
                out.push(iface);
            }
        }
        i = i + 1;
    }
    return out;
}

// The real JVM name a struct's own `implements` entry needs for the ONE interface it directly
// `impl`s -- its own declared name for a local interface (unchanged), or the real binary name
// (dot-to-slash-normalized) for an `extern interface` (see `Ast.hc`'s own
// `InterfaceDecl.extern_binary_name` header) -- a struct implementing `Run = "java.lang.Runnable"`
// needs a real `implements java/lang/Runnable` clause, not `implements Run` (which names a class
// that was never emitted at all, see `gen_interface`'s own call-site header).
fn struct_iface_jvm_name(iface_name: String, interfaces: &Vec<InterfaceDecl>) -> String {
    var i2 = 0;
    while i2 < interfaces.length() {
        let ifd2 = interfaces.get(i2);
        if ifd2.name == iface_name {
            if let Some { value: bin2 } = ifd2.extern_binary_name {
                return dot_to_slash_cg(bin2);
            }
            // A local (non-extern) interface still needs its own `module a.b.c;` declaration
            // honored here -- otherwise a struct's `implements` clause (or, via this same
            // function, an interface's own `extends` clause -- see `gen_interface`'s own call
            // site) would name an unqualified class the real JVM can never actually find once
            // `gen_interface` itself starts emitting this interface's `.class` under its real
            // package-qualified name.
            if let Some { value: modn2 } = ifd2.module_name {
                return dot_to_slash_cg(modn2) + "/" + iface_name;
            }
        }
        i2 = i2 + 1;
    }
    return iface_name;
}

pub fn gen_struct(target: Int, name: String, fields: Vec<Param>, methods: Vec<FnDecl>, static_methods: Vec<FnDecl>, binary_name: String, fns: &Vec<FnDecl>, structs: &Vec<StructDecl>, impls: &Vec<ImplDecl>, enums: &Vec<EnumDecl>, mono_names: &Vec<String>, fn_mono_names: &Vec<String>, method_mono_names: &Vec<String>, statics: &Vec<StaticDecl>, externs: &Vec<ExternClassDecl>, interfaces: &Vec<InterfaceDecl>, super_class: Option<String>, annotation: Option<Annotation>, sendable_struct_names: &Vec<String>) {
    var cw = ClassWriter2::new(2); // COMPUTE_FRAMES (implies COMPUTE_MAXS; real ASM value is 2, not 4)
    let qname = qualify_with_opt_module_cg(name, find_struct_module_cg(name, &structs));
    let iface_names = struct_interfaces_of(&impls, name);
    var struct_interfaces = ["x"; iface_names.length()];
    var sii = 0;
    while sii < iface_names.length() {
        struct_interfaces[sii] = struct_iface_jvm_name(iface_names.get(sii), &interfaces);
        sii = sii + 1;
    }
    // `struct S extends C { }` -- see `Ast.hc`'s own `StructDecl.extends` header. `C`'s real
    // binary name becomes this class's actual JVM `superName` (not `java/lang/Object`), and the
    // class itself is emitted `final` (ACC_PUBLIC | ACC_FINAL | ACC_SUPER = 1 + 16 + 32 = 49) --
    // single inheritance only, nothing can extend an extends-struct further (real, disclosed scope
    // cut, see README's own "Known limitations" for this feature).
    var super_name = "java/lang/Object";
    var class_access = 33; // ACC_PUBLIC | ACC_SUPER
    var extends_alias = "";
    var is_extends_struct = false;
    if let Some { value: sup } = super_class {
        extends_alias = sup;
        is_extends_struct = true;
        class_access = 49; // ACC_PUBLIC | ACC_FINAL | ACC_SUPER
        var sbi = 0;
        while sbi < externs.length() {
            let sxd = externs.get(sbi);
            if sxd.name == sup {
                super_name = dot_to_slash_cg(sxd.binary_name);
            }
            sbi = sbi + 1;
        }
    }
    CodegenShim::visitClassHeader(&mut cw, classfile_major_for_target(target), class_access, qname, super_name, struct_interfaces);
    if let Some { value: ann0 } = annotation {
        emit_class_annotation(&mut cw, ann0);
    }
    CodegenShim::visitSource(&mut cw, name + ".hotc");
    let n = fields.length();
    // A field naming an extern alias needs the real binary name -- see `descriptor_of_type`'s own
    // header.
    let alias_names = extern_alias_list(&externs);
    let alias_binaries = extern_binary_list(&externs);
    // Same reasoning, for a field naming a LOCAL, module-qualified struct/enum type instead --
    // built directly from `structs`/`enums` here (this fn already has them on hand) rather than a
    // full `build_program_info` call, which does far more work than this needs.
    var field_module_names = empty_str_vec4();
    var field_module_values = empty_str_vec4();
    var fmi = 0;
    while fmi < structs.length() {
        let fms = structs.get(fmi);
        if let Some { value: fmv } = fms.module_name {
            field_module_names.push(fms.name);
            field_module_values.push(fmv);
        }
        fmi = fmi + 1;
    }
    var fmei = 0;
    while fmei < enums.length() {
        let fme = enums.get(fmei);
        if let Some { value: fmev } = fme.module_name {
            field_module_names.push(fme.name);
            field_module_values.push(fmev);
        }
        fmei = fmei + 1;
    }

    var fi = 0;
    while fi < n {
        let f = fields.get(fi);
        let ftype = f.type_name;
        CodegenShim::visitInstanceField(&mut cw, 1, f.name, descriptor_of_type(ftype, &alias_names, &alias_binaries, &field_module_names, &field_module_values)); // ACC_PUBLIC
        fi = fi + 1;
    }

    if is_extends_struct {
        // One real `<init>` per ctor `extends_alias` itself declares -- each just loads its args
        // and forwards straight to `super_name`'s own real `<init>` via `INVOKESPECIAL`, nothing
        // else (no fields to initialize -- `register_struct`'s own check already enforced zero
        // fields on an extends-struct). `S::new(args)` codegen (`gen_expr`'s `StaticCall` fallback)
        // is what actually calls whichever of these matches the given arg count/types.
        var exi = 0;
        while exi < externs.length() {
            let exd = externs.get(exi);
            if exd.name == extends_alias {
                var exmi = 0;
                while exmi < exd.methods.length() {
                    let exm = exd.methods.get(exmi);
                    let exm2 = exd.methods.get(exmi); // fresh copy -- `.params` is only safe to read once
                    if exm.is_ctor {
                        let exctor_desc = extern_ctor_descriptor(param_type_names_of(exm.params), &alias_names, &alias_binaries);
                        let exctor = CodegenShim::visitMethodNoSig(&mut cw, 1, "<init>", exctor_desc, ["x"; 0]);
                        exctor.visitCode();
                        exctor.visitVarInsn(25, 0); // ALOAD 0
                        var exslot = 1;
                        var expi = 0;
                        while expi < exm2.params.length() {
                            let expty = exm2.params.get(expi).type_name;
                            exctor.visitVarInsn(load_opcode(expty), exslot);
                            if expty == "Long" || expty == "Double" { exslot = exslot + 2; } else { exslot = exslot + 1; }
                            expi = expi + 1;
                        }
                        exctor.visitMethodInsn(183, super_name, "<init>", exctor_desc, false); // INVOKESPECIAL
                        exctor.visitInsn(177); // RETURN
                        exctor.visitMaxs(0, 0);
                        exctor.visitEnd();
                    }
                    exmi = exmi + 1;
                }
            }
            exi = exi + 1;
        }
    } else {
        var ctor_desc = "(";
        var di = 0;
        while di < n {
            ctor_desc = ctor_desc + descriptor_of_type(fields.get(di).type_name, &alias_names, &alias_binaries, &field_module_names, &field_module_values);
            di = di + 1;
        }
        ctor_desc = ctor_desc + ")V";
        let ctor = CodegenShim::visitMethodNoSig(&mut cw, 1, "<init>", ctor_desc, ["x"; 0]);
        ctor.visitCode();
        ctor.visitVarInsn(25, 0); // ALOAD 0
        ctor.visitMethodInsn(183, "java/lang/Object", "<init>", "()V", false); // INVOKESPECIAL
        var slot = 1;
        var ci = 0;
        while ci < n {
            let f2 = fields.get(ci);
            let ftype2 = f2.type_name;
            ctor.visitVarInsn(25, 0); // ALOAD 0
            // A real, pre-existing bug found alongside the `FloatLit`/`DoubleLit` port: this used a
            // bare `ILOAD`/`ALOAD` split (never hit before, since no struct ever had a `Long`/`Float`/
            // `Double`-typed field until now) instead of `load_opcode`'s real per-type dispatch --
            // wrong for a category-2 field (`Long`/`Double` need `LLOAD`/`DLOAD`, not `ILOAD`) and,
            // separately, never widened `slot` by 2 for one either, so every field AFTER the first
            // `Double`/`Long` field read from the WRONG local slot entirely. A real `VerifyError: Bad
            // local variable type` at class-load time, not a silent miscompile.
            ctor.visitVarInsn(load_opcode(ftype2), slot);
            ctor.visitFieldInsn(181, qname, f2.name, descriptor_of_type(ftype2, &alias_names, &alias_binaries, &field_module_names, &field_module_values)); // PUTFIELD
            if ftype2 == "Long" || ftype2 == "Double" { slot = slot + 2; } else { slot = slot + 1; }
            ci = ci + 1;
        }
        ctor.visitInsn(177); // RETURN
        ctor.visitMaxs(0, 0);
        ctor.visitEnd();
    }

    var mi2 = 0;
    while mi2 < methods.length() {
        let m2 = methods.get(mi2);
        let m2b = methods.get(mi2); // fresh copy -- `.params` is only safe to read once
        let info = build_program_info(target, &fns, &structs, &impls, &enums, &mono_names, &fn_mono_names, &method_mono_names, &statics, &externs, &interfaces, sendable_struct_names); // fresh every iteration, see build_program_info's own header
        gen_method(&mut cw, binary_name, name, m2.name, param_names_of(m2.params), param_type_names_of(m2b.params), opt_string_or(m2.ret_type, "Unit"), m2.body, info);
        mi2 = mi2 + 1;
    }

    // Static impl methods (no `self`) are structurally identical to a plain top-level fn --
    // `ACC_STATIC`, no implicit receiver slot -- just emitted onto this struct's own `cw` instead
    // of the main class's, so `gen_fn` is reused directly rather than needing a separate function.
    var smi = 0;
    while smi < static_methods.length() {
        let sm = static_methods.get(smi);
        let smb = static_methods.get(smi); // fresh copy -- `.params` is only safe to read once
        let sinfo = build_program_info(target, &fns, &structs, &impls, &enums, &mono_names, &fn_mono_names, &method_mono_names, &statics, &externs, &interfaces, sendable_struct_names); // fresh every iteration
        gen_fn(&mut cw, binary_name, sm.name, param_names_of(sm.params), param_type_names_of(smb.params), opt_string_or(sm.ret_type, "Unit"), sm.body, sinfo, none_annotation2());
        smi = smi + 1;
    }

    cw.visitEnd();
    CodegenShim::writeClass(cw, qname + ".class");
}

// One real `.class` file per `EnumDecl` -- a `tag: Int` field (the variant index, declaration
// order) plus the *union* of every variant's own fields (same simplification `Checker.hotc`'s
// `register_enum` makes: field lookups don't distinguish which variant a field belongs to).
// Unlike `gen_struct`'s constructor (which takes every field as a param, since a struct has only
// one "shape"), this is a trivial no-arg constructor -- different variant literals populate
// different subsets of fields, so `StructLit`-for-a-variant codegen (see `gen_expr`) sets `tag`
// and each field via individual `PUTFIELD`s after construction instead.
pub fn gen_enum(target: Int, name: String, variants: Vec<EnumVariant>, module_name: Option<String>, structs: &Vec<StructDecl>, enums: &Vec<EnumDecl>) {
    var cw = ClassWriter2::new(2); // COMPUTE_FRAMES (implies COMPUTE_MAXS; real ASM value is 2, not 4)
    let qname = qualify_with_opt_module_cg(name, module_name);
    CodegenShim::visitClassHeader(&mut cw, classfile_major_for_target(target), 33, qname, "java/lang/Object", ["x"; 0]); // ACC_PUBLIC | ACC_SUPER
    CodegenShim::visitSource(&mut cw, name + ".hotc");

    CodegenShim::visitInstanceField(&mut cw, 1, "tag", "I"); // ACC_PUBLIC

    // Enum fields do not support extern-typed fields this round -- always pass empty alias vecs.
    // Module-qualified LOCAL struct/enum field types DO need real support here though -- a real
    // bug found self-hosting this very feature: a generic prelude enum monomorphized over a
    // module-qualified type argument (`Option$TokType`, `TokType` declared under `module
    // hc.selfhost.lexer;`) needs its own `Some$value` field descriptor to say
    // `Lhc/selfhost/lexer/TokType;`, matching EXACTLY what `CodeGen.resolve_descriptor`/`.qualify`
    // computes at every `GETFIELD`/`PUTFIELD` call site that reads/writes it -- leaving this side
    // unqualified (an empty module table, as an earlier disclosed scope cut) produced a real,
    // silent field-descriptor MISMATCH: the class declared `LTokType;`, every access site expected
    // `Lhc/selfhost/lexer/TokType;`, and the JVM's own field resolution (which matches on name AND
    // descriptor together) threw `NoSuchFieldError` at runtime despite the field visibly existing
    // under the same NAME -- not caught by ASM's `COMPUTE_FRAMES` (a syntactically valid
    // descriptor on each side, just two DIFFERENT ones) or by anything at compile time at all.
    let enum_alias_names = empty_str_vec4();
    let enum_alias_binaries = empty_str_vec4();
    var enum_module_names = empty_str_vec4();
    var enum_module_values = empty_str_vec4();
    var emi2 = 0;
    while emi2 < structs.length() {
        let ems = structs.get(emi2);
        if let Some { value: emv } = ems.module_name {
            enum_module_names.push(ems.name);
            enum_module_values.push(emv);
        }
        emi2 = emi2 + 1;
    }
    var emei2 = 0;
    while emei2 < enums.length() {
        let eme = enums.get(emei2);
        if let Some { value: emev } = eme.module_name {
            enum_module_names.push(eme.name);
            enum_module_values.push(emev);
        }
        emei2 = emei2 + 1;
    }
    // Every field gets its OWN JVM field, mangled "VariantName$FieldName" -- NOT deduped/shared
    // by bare field name across variants. Real bug found actually RUNNING (not just compiling+
    // loading) a self-hosted-compiled program whose enum reuses a field name across variants at
    // DIFFERENT types (`Ast.hc`'s own `Expr`: `IntLit.value: Int`, `StringLit.value: String`,
    // `BoolLit.value: Bool`, ...): the old code declared exactly ONE shared "value" field, typed
    // by whichever variant registered first -- every OTHER variant's `PUTFIELD`/`GETFIELD` used a
    // descriptor that didn't match what the class actually declared, a real `NoSuchFieldError` at
    // class-verify/link time (silent at compile time -- ASM's own `COMPUTE_FRAMES` doesn't check
    // field existence against the class's own declared fields, only stack-shape consistency).
    // `gen_variant_construct` and `Match` codegen's own field extraction were updated to use this
    // same mangled name; direct `FieldAccess` on an un-matched enum value (already a disclosed,
    // pre-existing imprecision -- see `Checker.hotc`'s own `check_field_access` header) is NOT
    // mangling-aware and stays unsupported for a colliding field name specifically (no real self-
    // hosted source does this -- every real access goes through a `match` arm's own binding).
    var vi = 0;
    while vi < variants.length() {
        let v = variants.get(vi);
        var fi = 0;
        while fi < v.fields.length() {
            let f = v.fields.get(fi);
            CodegenShim::visitInstanceField(&mut cw, 1, v.name + "$" + f.name, descriptor_of_type(f.type_name, &enum_alias_names, &enum_alias_binaries, &enum_module_names, &enum_module_values)); // ACC_PUBLIC
            fi = fi + 1;
        }
        vi = vi + 1;
    }

    // Real Java-enum-style interop: a ZERO-FIELD variant (`LOCKED {}`, no per-instance data at
    // all) gets a real `public static final <ClassName> <VariantName>;` singleton field --
    // real Java code the pure-data model classes this feature exists for (`QuestState`,
    // `QuestGroup.IconKind`, ...) still gets to write `QuestState.LOCKED` as an ordinary static-
    // constant reference and `state == QuestState.LOCKED` as ordinary reference-equality, exactly
    // like a real `java.lang.Enum` constant, even though this class does NOT actually extend
    // `java.lang.Enum` (a real, disclosed narrower scope -- no `.name()`/`.ordinal()`/real
    // `switch`-on-this-enum support; HC's own internal `==`/`match` codegen already compares by
    // `tag`, never by reference, so this is purely for the JAVA-facing surface). A variant WITH
    // fields has no meaningful "the" singleton (each construction genuinely needs its own
    // instance), so only zero-field variants get one.
    var svi = 0;
    while svi < variants.length() {
        let sv = variants.get(svi);
        if sv.fields.length() == 0 {
            CodegenShim::visitInstanceField(&mut cw, 25, sv.name, "L" + qname + ";"); // ACC_PUBLIC | ACC_STATIC | ACC_FINAL
        }
        svi = svi + 1;
    }
    var has_singleton = false;
    var hsi = 0;
    while hsi < variants.length() {
        if variants.get(hsi).fields.length() == 0 { has_singleton = true; }
        hsi = hsi + 1;
    }

    let ctor = CodegenShim::visitMethodNoSig(&mut cw, 1, "<init>", "()V", ["x"; 0]);
    ctor.visitCode();
    ctor.visitVarInsn(25, 0); // ALOAD 0
    ctor.visitMethodInsn(183, "java/lang/Object", "<init>", "()V", false); // INVOKESPECIAL
    ctor.visitInsn(177); // RETURN
    ctor.visitMaxs(0, 0);
    ctor.visitEnd();

    if has_singleton {
        // Tag values assigned here MUST match `build_program_info`'s own `variant_tag_list`
        // convention (plain declaration-order index into `variants`) -- see that fn's own header
        // -- so a singleton constructed HERE compares correctly against a `match`/`==` computed
        // tag anywhere else in the program.
        let clinit = CodegenShim::visitMethodNoSig(&mut cw, 8, "<clinit>", "()V", ["x"; 0]); // ACC_STATIC
        clinit.visitCode();
        var cvi = 0;
        while cvi < variants.length() {
            let cv = variants.get(cvi);
            if cv.fields.length() == 0 {
                clinit.visitTypeInsn(187, qname); // NEW
                clinit.visitInsn(89); // DUP
                clinit.visitMethodInsn(183, qname, "<init>", "()V", false); // INVOKESPECIAL -- stack: [instance]
                clinit.visitInsn(89); // DUP -- stack: [instance, instance]
                clinit.visitIntInsn(17, cvi); // SIPUSH
                clinit.visitFieldInsn(181, qname, "tag", "I"); // PUTFIELD -- stack: [instance]
                clinit.visitFieldInsn(179, qname, cv.name, "L" + qname + ";"); // PUTSTATIC -- consumes [instance]
            }
            cvi = cvi + 1;
        }
        clinit.visitInsn(177); // RETURN
        clinit.visitMaxs(0, 0);
        clinit.visitEnd();

        // A hand-rolled `valueOf(String) -> ClassName` (NOT `java.lang.Enum`'s real one, which
        // this class doesn't have access to since it doesn't extend `Enum` -- see this whole
        // block's own header) -- matches real callers' existing `EnumName.valueOf(str)` usage
        // (`QuestGroup.IconKind.valueOf(kindStr.toUpperCase())`, real pre-port code) without
        // requiring them to change at all. Linear string-equality scan against each zero-field
        // variant's own declared name; throws `IllegalArgumentException` for anything else,
        // mirroring the real `Enum.valueOf`'s own documented failure mode closely enough for
        // real callers (message format is NOT byte-for-byte identical to the JDK's own -- a real,
        // disclosed narrower scope, since no real caller inspects the message text itself).
        let vof = CodegenShim::visitMethodNoSig(&mut cw, 9, "valueOf", "(Ljava/lang/String;)L" + qname + ";", ["x"; 0]); // ACC_PUBLIC | ACC_STATIC
        vof.visitCode();
        var vofi = 0;
        while vofi < variants.length() {
            let vov = variants.get(vofi);
            if vov.fields.length() == 0 {
                var next_label = Label::new();
                vof.visitLdcInsn(vov.name as JObject4);
                vof.visitVarInsn(25, 0); // ALOAD 0 -- the `name` param
                vof.visitMethodInsn(182, "java/lang/String", "equals", "(Ljava/lang/Object;)Z", false); // INVOKEVIRTUAL
                vof.visitJumpInsn(153, &next_label); // IFEQ -- not this variant -> next
                vof.visitFieldInsn(178, qname, vov.name, "L" + qname + ";"); // GETSTATIC
                vof.visitInsn(176); // ARETURN
                vof.visitLabel(&next_label);
            }
            vofi = vofi + 1;
        }
        vof.visitTypeInsn(187, "java/lang/IllegalArgumentException"); // NEW
        vof.visitInsn(89); // DUP
        vof.visitVarInsn(25, 0); // ALOAD 0
        vof.visitMethodInsn(183, "java/lang/IllegalArgumentException", "<init>", "(Ljava/lang/String;)V", false); // INVOKESPECIAL
        vof.visitInsn(191); // ATHROW
        vof.visitMaxs(0, 0);
        vof.visitEnd();

        // `name()`'s real, symmetric partner to `valueOf` -- an INSTANCE method (a real
        // `java.lang.Enum.name()` is one too) dispatching on `self.tag` (every variant, not just
        // the zero-field/singleton ones this whole block otherwise focuses on -- there's no extra
        // cost to making this one fully general, and no reason a fielded variant's own name
        // should be any less real).
        let nof = CodegenShim::visitMethodNoSig(&mut cw, 1, "name", "()Ljava/lang/String;", ["x"; 0]); // ACC_PUBLIC
        nof.visitCode();
        var nofi = 0;
        while nofi < variants.length() {
            let nov = variants.get(nofi);
            var next_label2 = Label::new();
            nof.visitVarInsn(25, 0); // ALOAD 0 -- self
            nof.visitFieldInsn(180, qname, "tag", "I"); // GETFIELD
            nof.visitIntInsn(17, nofi); // SIPUSH
            nof.visitJumpInsn(160, &next_label2); // IF_ICMPNE -- tag mismatch -> next
            nof.visitLdcInsn(nov.name as JObject4);
            nof.visitInsn(176); // ARETURN
            nof.visitLabel(&next_label2);
            nofi = nofi + 1;
        }
        nof.visitLdcInsn("" as JObject4); // unreachable for a well-formed instance; a real, harmless fallback
        nof.visitInsn(176); // ARETURN
        nof.visitMaxs(0, 0);
        nof.visitEnd();
    }

    cw.visitEnd();
    CodegenShim::writeClass(cw, qname + ".class");
}

fn int_descriptor(param_count: Int) -> String {
    var d = "(";
    var i = 0;
    while i < param_count {
        d = d + "I";
        i = i + 1;
    }
    return d + ")I";
}

extern class JStringCg = "java.lang.String" {
    fn length(&self) -> Int;
    fn codePointAt(&self, index: Int) -> Int;
    fn substring(&self, start: Int, end: Int) -> String;
    fn indexOf(&self, s: String) -> Int;
}

// See `Checker.hotc`'s own `capitalize_first_chk` header -- identical, redone independently here
// (this file doesn't share the checker's own registries or helpers, same split as everywhere
// else in this codebase).
fn capitalize_first_cg(s: String) -> String {
    if s.length() == 0 { return s; }
    let c0 = s.codePointAt(0);
    var cap0 = c0;
    if c0 >= 97 && c0 <= 122 { cap0 = c0 - 32; }
    return codepoint_to_string(cap0) + s.substring(1, s.length());
}

// Real bug found self-compiling `Lexer.hotc`: its own `extern class` declarations use DOT-form
// binary names (`"java.lang.String"`, matching what the REAL compiler accepts via real classpath
// reflection's own dot-to-slash conversion), but this subset's own disclosed scope cut says
// `binary_name` must already be JVM-internal-SLASH form -- no conversion. The old behavior wasn't
// a compile error at all: the raw dotted string just got used AS-IS in `NEW`/`INVOKESTATIC`/field
// descriptors, silently producing a real, invalid class file (`ClassFormatError: Illegal class
// name` at JVM class-LOAD time, not caught by ASM's own `COMPUTE_FRAMES` at compile time either).
// `dot_to_slash_cg` normalizes every extern binary name at the one place they're first read off
// the AST, so every downstream use (`NEW`/`INVOKE*`/descriptors, all sourced from these same lists)
// gets the correct form for free.
// Manual codepoint scan instead of `String.replace` -- the real `java.lang.String.replace` only
// has `(char, char)` and `(CharSequence, CharSequence)` overloads, no exact `(String, String)`
// match, and this subset's extern-signature validator requires an EXACT nominal match against a
// real classpath overload (no implicit String->CharSequence reference-supertype compatibility).
// `substring`/`length` are already proven-working externs, so this sidesteps the mismatch entirely.
fn dot_to_slash_cg(name: String) -> String {
    var out = "";
    var i = 0;
    while i < name.length() {
        let c = name.substring(i, i + 1);
        if c == "." {
            out = out + "/";
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    return out;
}

// `@"binary.Name"(arg: value, ...)` -- see `Ast.hc`'s own `Annotation`/`AnnValue` headers. Shared
// between `emit_class_annotation`/`emit_method_annotation` (right below) since both just hand this
// the `AnnotationVisitor2` their own `visitAnnotation` call already produced -- the actual
// value-by-value emission is identical either way.
fn emit_annotation_args(av: &mut AnnotationVisitor2, ann: Annotation) {
    var i = 0;
    while i < ann.args.length() {
        let arg = ann.args.get(i);
        emit_ann_value(av, arg.name, arg.value);
        i = i + 1;
    }
}

// The NAMED (top-level argument) shape -- `name` is a real arg name here, never `null`.
fn emit_ann_value(av: &mut AnnotationVisitor2, name: String, value: AnnValue) {
    match value {
        AnnStr { value: v } => { av.visit(name, v as JObject4); }
        AnnEnumConst { binary_name, const_name } => {
            av.visitEnum(name, "L" + dot_to_slash_cg(binary_name) + ";", const_name);
        }
        AnnArray { values } => {
            var sub = av.visitArray(name);
            var j = 0;
            while j < values.length() {
                emit_ann_array_elem(&mut sub, values.get(j));
                j = j + 1;
            }
            sub.visitEnd();
        }
    }
}

// The UNNAMED (array element) shape -- see `CodegenShim.java`'s own header for why this needs its
// own real Java-`null`-`name` path (`visitArrayString`/`visitArrayEnum`) instead of just calling
// `emit_ann_value` with an empty string. Nested arrays aren't part of the documented grammar (an
// array of scalar/enum values only, never an array of arrays) -- `AnnArray` here is a real error,
// not a silently-dropped case.
fn emit_ann_array_elem(av: &mut AnnotationVisitor2, value: AnnValue) {
    match value {
        AnnStr { value: v } => { CodegenShim::visitArrayString(av, v); }
        AnnEnumConst { binary_name, const_name } => {
            CodegenShim::visitArrayEnum(av, "L" + dot_to_slash_cg(binary_name) + ";", const_name);
        }
        AnnArray { values } => {
            throw CodegenError::new("codegen: nested annotation arrays aren't supported");
        }
    }
}

pub fn emit_class_annotation(cw: &mut ClassWriter2, ann: Annotation) {
    let descriptor = "L" + dot_to_slash_cg(ann.binary_name) + ";";
    var av = cw.visitAnnotation(descriptor, true);
    emit_annotation_args(&mut av, ann);
    av.visitEnd();
}

pub fn emit_method_annotation(mv: &mut MethodVisitor2, ann: Annotation) {
    let descriptor = "L" + dot_to_slash_cg(ann.binary_name) + ";";
    var av = mv.visitAnnotation(descriptor, true);
    emit_annotation_args(&mut av, ann);
    av.visitEnd();
}

fn none_annotation2() -> Option<Annotation> {
    return None;
}
fn some_annotation2(a: Annotation) -> Option<Annotation> {
    return Some { value: a };
}

// Linear scan over `Program`'s own flat "declared name -> its one `Annotation`" side-list -- see
// `Ast.hc`'s own `Program.struct_annotation_names` header for why it's shaped this way. Shared by
// both the struct-name and fn-name lookups (`compile_program`'s own two call sites), since the
// shape is identical either way.
fn find_annotation_cg(names: &Vec<String>, anns: &Vec<Annotation>, target: String) -> Option<Annotation> {
    var i = 0;
    while i < names.length() {
        if names.get(i) == target {
            return some_annotation2(anns.get(i));
        }
        i = i + 1;
    }
    return none_annotation2();
}

// Real extern methods (and constructors, all declared `fn new(...)`) are keyed with an arity
// suffix -- see `Checker.hotc`'s own `register_extern` header for why -- so this table's own
// keys, and the `gen_expr` call sites that look them up, all need the same "#<argCount>" suffix.
// Arities involved are always small (real method params, never a computed runtime value), so a
// plain mod/div digit loop is fine -- reuses `Lexer.hotc`'s own `codepoint_to_string` (visible
// here since every `.hotc` source file compiles as one flat unit) rather than adding a whole new
// extern class just for int->String.
fn arity_str_cg(n: Int) -> String {
    if n == 0 { return "0"; }
    var v = n;
    var s = "";
    while v > 0 {
        let d = v % 10;
        s = codepoint_to_string(48 + d) + s;
        v = v / 10;
    }
    return s;
}

// Joins param/arg type names with "," -- mirrors `Checker.hotc`'s own `join_type_names_chk`,
// duplicated rather than shared (flat cross-module function namespace, `_cg` suffix convention
// this file already uses elsewhere for that reason). Builds the full-signature half of an extern
// method's registry key -- see the `key`/`sig_key` pair right above this fn's own call site.
fn join_type_names_cg(names: Vec<String>) -> String {
    var out = "";
    var i = 0;
    while i < names.length() {
        if i > 0 { out = out + ","; }
        out = out + names.get(i);
        i = i + 1;
    }
    return out;
}

// `Integer::valueOf` here is a HOST-SIDE call -- this compiler's OWN runtime boxing an `Int` value
// so it can hand ASM's real `visitLdcInsn(Object)` a real Java object, telling ASM which constant-
// pool entry variant to emit. It does NOT box anything in the TARGET program's own bytecode -- the
// resulting `LDC` instruction pushes a genuine primitive `int`, not a reference to this boxed
// object (see `IntLit`'s own header for why this is needed at all).
extern class JIntegerCg = "java/lang/Integer" {
    static fn valueOf(v: Int) -> JIntegerCg;
}

// `FloatLit`/`DoubleLit`'s own host-side boxing call -- see `JIntegerCg`'s own header, same
// mechanism, just parsing from the literal's own source text instead of an already-native `Int`
// (this compiler's own implementation language has no native `Float`/`Double` locals to box in the
// first place -- see `Ast.hc`'s own `Expr.FloatLit`/`Expr.DoubleLit` header). `java.lang.Float`/
// `java.lang.Double`'s own static `valueOf(String)` parses AND boxes in one real call.
extern class JFloatCg = "java/lang/Float" {
    static fn valueOf(s: String) -> JFloatCg;
}
extern class JDoubleCg = "java/lang/Double" {
    static fn valueOf(s: String) -> JDoubleCg;
}

// Array types are represented as the plain string `"[ElemType]"` -- same convention (and same
// duplicated-helper pattern, `_cg` suffix here only to dodge the flat cross-module function
// namespace) as `Checker.hotc`'s own `is_array_type_name`/`array_elem_type_name`.
fn is_array_type_name_cg(name: String) -> Bool {
    if name.length() < 2 { return false; }
    return name.codePointAt(0) == 91 && name.codePointAt(name.length() - 1) == 93; // '[' / ']'
}

fn array_elem_type_name_cg(name: String) -> String {
    return name.substring(1, name.length() - 1);
}

// Mirrors `Checker.hotc`'s own identical `is_nullable_type_name`/`strip_nullable` -- see that
// file's own header. `self.var_types` needs the SAME "SecurityManager?" narrowing this file's own
// `gen_stmt`'s `If` arm applies, independently of `Checker.hotc`'s `self.vars` -- a still-suffixed
// var_types entry would make `gen_expr`'s own method/extern dispatch (keyed by exact type name)
// fail to find a real declaration even for a call the checker already approved after narrowing.
fn is_nullable_type_name_cg(name: String) -> Bool {
    if name.length() < 2 { return false; }
    return name.codePointAt(name.length() - 1) == 63; // '?'
}

fn strip_nullable_cg(name: String) -> String {
    return name.substring(0, name.length() - 1);
}

// Every real interface a lambda literal can reach a Phoenix Flight background thread through --
// `PhoenixCallable` (`pool.spawn`/`spawn_after`/`spawn_after_all`) and, since real
// `CompletableFuture`-based chaining landed, `PhoenixSupplier` (`pool.spawn_chain`'s own FIRST
// stage) and `PhoenixFunction` (every `.then(...)` stage after it) -- see `finish_method_call`'s
// own header, right where this is called, for why the capture-safety check is gated on this SET
// of interface names rather than a hardcoded (receiver, method-name) pair.
fn is_phoenix_background_iface_cg(name: String) -> Bool {
    return name == "PhoenixCallable" || name == "PhoenixSupplier" || name == "PhoenixFunction";
}

// Phoenix Flight's own capture-safety rule -- see `finish_method_call`'s own header, right where
// this is called, for the full design. `Int`/`Bool`/`Long`/`Float`/`Double` and `String` are
// always safe (`Copy` primitives, or a genuinely immutable reference type); anything else needs
// an explicit `@sendable` marker on the struct itself (`sendable_structs`, populated from
// `Ast.hc`'s own `Program.sendable_struct_names`) -- the author's own assertion that every field
// is safe to hand across a thread boundary, NOT verified field-by-field this pass (same "declared
// type is truth" honesty `extern class` already gets elsewhere in this checker).
fn is_sendable_type_cg(ty: String, sendable_structs: &Registry<Bool>) -> Bool {
    if is_numeric_ty_name_cg(ty) { return true; }
    if ty == "String" { return true; }
    if ty == "?" { return true; }
    let found = sendable_structs.get(ty);
    if let Some { value: v } = found { return v; }
    return false;
}

fn is_numeric_ty_name_cg(name: String) -> Bool {
    return name == "Int" || name == "Long" || name == "Float" || name == "Double" || name == "Char" || name == "Byte";
}

// Mirrors `Checker.hotc`'s own identical `numeric_widen_result` -- see that fn's own header for
// the real gap this closes and the exact rule (same one here). `CodeGen.gen_widen_numeric_pair`
// (a real METHOD, unlike this free fn, since it needs `&mut self` to emit the actual widening
// bytecode) is what actually applies this.
fn numeric_widen_result_cg(lt: String, rt: String) -> String {
    if !is_numeric_ty_name_cg(lt) || !is_numeric_ty_name_cg(rt) { return ""; }
    if lt == rt { return lt; }
    if lt == "Double" || rt == "Double" { return "Double"; }
    if lt == "Float" || rt == "Float" { return "Float"; }
    return "";
}

// Mirrors `Checker.hotc`'s own identical `operator_method_name` -- see that fn's own header for
// the full design and naming convention.
fn operator_method_name_cg(op: String) -> String {
    if op == "+" { return "add"; }
    if op == "-" { return "sub"; }
    if op == "*" { return "mul"; }
    if op == "/" { return "div"; }
    if op == "%" { return "rem"; }
    if op == "==" { return "eq"; }
    if op == "!=" { return "eq"; }
    return "";
}

// `"dyn Name"` -- see `Parser.hotc`'s own `type_name_ref` header for why a `&dyn Name` type shows
// up as this plain, space-containing type-name string rather than a new `Ty`/AST shape.
fn is_dyn_type_name_cg(name: String) -> Bool {
    if name.length() < 4 { return false; }
    return name.substring(0, 4) == "dyn ";
}

fn dyn_interface_name_cg(name: String) -> String {
    return name.substring(4, name.length());
}

// `"arena Name"` -- see `Ast.hc`'s own `ArenaNew` header.
fn is_arena_type_name_cg(name: String) -> Bool {
    if name.length() < 6 { return false; }
    return name.substring(0, 6) == "arena ";
}

fn arena_struct_name_cg(name: String) -> String {
    return name.substring(6, name.length());
}

// Codegen-side mirror of `Checker.hotc`'s own `substitute_field_type` (`_cg` suffix to dodge the
// flat cross-module function namespace, same pattern every other duplicated helper in this file
// already uses) -- exact match OR array-of-the-type-parameter (`"[T]"` -> `"[Int]"`, needed for
// `Vec<T> { data: [T], len: Int }`'s own `data` field).
// See `Checker.hotc`'s own `substitute_field_type` header for the real bug this fixes (the
// original recursive-single-nested-arg shape only ever substituted a mono name's LAST `"$"`-
// delimited segment, silently leaving earlier ones untouched -- invisible for a single-param
// template, real for a flat two-param one like `"Pair$K$V"`). Same fix here: split flat on every
// `"$"` and check each segment independently, instead of recursing into "the rest" as if it were
// always exactly one more nested type application.
fn substitute_field_type_cg(ftype: String, type_param: String, arg: String) -> String {
    if is_array_type_name_cg(ftype) {
        let elem = array_elem_type_name_cg(ftype);
        return "[" + substitute_field_type_cg(elem, type_param, arg) + "]";
    }
    if !is_mono_name_cg(ftype) {
        if ftype == type_param { return arg; }
        return ftype;
    }
    var result = "";
    var remaining = ftype;
    var first = true;
    var keep_going = true;
    while keep_going {
        let idx = remaining.indexOf("$");
        var seg = remaining;
        var has_more = false;
        if idx >= 0 {
            seg = remaining.substring(0, idx);
            remaining = remaining.substring(idx + 1, remaining.length());
            has_more = true;
        }
        var out_seg = seg;
        if !first && seg == type_param {
            out_seg = arg;
        }
        if first {
            result = out_seg;
        } else {
            result = result + "$" + out_seg;
        }
        first = false;
        if !has_more { keep_going = false; }
    }
    return result;
}

fn empty_expr_vec_cg() -> Vec<Expr> {
    var v = vec_of(IntLit { value: 0 });
    return Vec { data: v.data, len: 0 };
}

fn empty_matcharm_vec_cg() -> Vec<MatchArm> {
    var v = vec_of(MatchArm { variant_name: "_", field_names: empty_str_vec4(), bind_names: empty_str_vec4(), body: empty_stmt_vec2(), is_literal: false, literal: IntLit { value: 0 } });
    return Vec { data: v.data, len: 0 };
}

// Codegen-side mirror of `Checker.hotc`'s own `subst_expr`/`subst_stmt` (`_cg` suffix to dodge the
// flat cross-module function namespace, same pattern every other duplicated helper in this file
// already uses) -- a real whole-tree copy of `e`, substituting `type_param` for `arg` everywhere a
// type name string appears (`StructLit`'s `name`/`generic_base`, `StaticCall`'s `type_name`, via
// `substitute_field_type_cg`), needed so a monomorphized generic fn's emitted body actually
// constructs/calls the real concrete instantiation (`"Vec$Int"`) instead of the still-abstract
// template name (`"Vec$T"`, which would emit `NEW`/`ANEWARRAY` against a class that was never
// compiled). See `Checker.hotc`'s own header for why this pass exists at all.
fn subst_expr_cg(e: &Expr, type_param: String, arg: String) -> Expr {
    match e {
        IntLit { value } => { return IntLit { value: value }; }
        FloatLit { text } => { return FloatLit { text: text }; }
        DoubleLit { text } => { return DoubleLit { text: text }; }
        StringLit { value } => { return StringLit { value: value }; }
        StringInterp { literals, exprs } => { return StringInterp { literals: literals, exprs: subst_expr_list_cg(exprs, type_param, arg) }; }
        BoolLit { value } => { return BoolLit { value: value }; }
        Ident { name } => { return Ident { name: name }; }
        Binary { op, left, right } => { return Binary { op: op, left: subst_expr_cg(left, type_param, arg), right: subst_expr_cg(right, type_param, arg) }; }
        Unary { op, expr } => { return Unary { op: op, expr: subst_expr_cg(expr, type_param, arg) }; }
        Call { callee, args } => { return Call { callee: callee, args: subst_expr_list_cg(args, type_param, arg) }; }
        FieldAccess { obj, field } => { return FieldAccess { obj: subst_expr_cg(obj, type_param, arg), field: field }; }
        MethodCall { recv, method, args } => { return MethodCall { recv: subst_expr_cg(recv, type_param, arg), method: method, args: subst_expr_list_cg(args, type_param, arg) }; }
        Assign { name, value } => { return Assign { name: name, value: subst_expr_cg(value, type_param, arg) }; }
        FieldAssign { obj, field, value } => { return FieldAssign { obj: subst_expr_cg(obj, type_param, arg), field: field, value: subst_expr_cg(value, type_param, arg) }; }
        StructLit { name, field_names, field_values, generic_base } => {
            let new_name = substitute_field_type_cg(name, type_param, arg);
            var new_gb = none_string2();
            if let Some { value: gb } = generic_base {
                new_gb = some_string2(substitute_field_type_cg(gb, type_param, arg));
            }
            return StructLit { name: new_name, field_names: field_names, field_values: subst_expr_list_cg(field_values, type_param, arg), generic_base: new_gb };
        }
        ArrayLit { elements } => { return ArrayLit { elements: subst_expr_list_cg(elements, type_param, arg) }; }
        ArrayRepeat { value, count } => { return ArrayRepeat { value: subst_expr_cg(value, type_param, arg), count: subst_expr_cg(count, type_param, arg) }; }
        ArenaNew { struct_name, count } => { return ArenaNew { struct_name: struct_name, count: subst_expr_cg(count, type_param, arg) }; }
        Index { arr, index } => { return Index { arr: subst_expr_cg(arr, type_param, arg), index: subst_expr_cg(index, type_param, arg) }; }
        IndexAssign { arr, index, value } => { return IndexAssign { arr: subst_expr_cg(arr, type_param, arg), index: subst_expr_cg(index, type_param, arg), value: subst_expr_cg(value, type_param, arg) }; }
        IndexFieldGet { arr_name, index, field } => { return IndexFieldGet { arr_name: arr_name, index: subst_expr_cg(index, type_param, arg), field: field }; }
        IndexFieldSet { arr_name, index, field, value } => { return IndexFieldSet { arr_name: arr_name, index: subst_expr_cg(index, type_param, arg), field: field, value: subst_expr_cg(value, type_param, arg) }; }
        StaticCall { type_name, method, args } => { return StaticCall { type_name: substitute_field_type_cg(type_name, type_param, arg), method: method, args: subst_expr_list_cg(args, type_param, arg) }; }
        ExternStaticFieldGet { type_name, field } => { return ExternStaticFieldGet { type_name: type_name, field: field }; }
        ExternStaticFieldSet { type_name, field, value } => { return ExternStaticFieldSet { type_name: type_name, field: field, value: subst_expr_cg(value, type_param, arg) }; }
        Cast { expr, target_type } => { return Cast { expr: subst_expr_cg(expr, type_param, arg), target_type: target_type }; }
        IsCheck { expr, target_type } => { return IsCheck { expr: subst_expr_cg(expr, type_param, arg), target_type: target_type }; }
        Lambda { params, body } => { return Lambda { params: params, body: subst_expr_cg(body, type_param, arg) }; }
        TryOp { expr } => { return TryOp { expr: subst_expr_cg(expr, type_param, arg) }; }
        NamedArg { name, value } => { return NamedArg { name: name, value: subst_expr_cg(value, type_param, arg) }; }
        NullLit => { return NullLit; }
        SafeCall { recv, method, args } => { return SafeCall { recv: subst_expr_cg(recv, type_param, arg), method: method, args: subst_expr_list_cg(args, type_param, arg) }; }
        SafeFieldAccess { recv, field } => { return SafeFieldAccess { recv: subst_expr_cg(recv, type_param, arg), field: field }; }
        Elvis { left, right } => { return Elvis { left: subst_expr_cg(left, type_param, arg), right: subst_expr_cg(right, type_param, arg) }; }
        Comprehension { result_expr, var_name, iter_expr, cond } => {
            var new_cond2 = none_expr_cg();
            if let Some { value: c } = cond { new_cond2 = some_expr_cg(subst_expr_cg(c, type_param, arg)); }
            return Comprehension { result_expr: subst_expr_cg(result_expr, type_param, arg), var_name: var_name, iter_expr: subst_expr_cg(iter_expr, type_param, arg), cond: new_cond2 };
        }
    }
}

fn subst_expr_list_cg(es: Vec<Expr>, type_param: String, arg: String) -> Vec<Expr> {
    var out = empty_expr_vec_cg();
    var i = 0;
    while i < es.length() {
        out.push(subst_expr_cg(es.get(i), type_param, arg));
        i = i + 1;
    }
    return out;
}

fn subst_stmt_cg(s: Stmt, type_param: String, arg: String) -> Stmt {
    match s {
        Let { name, mutable, init, declared_type, line } => { return Let { name: name, mutable: mutable, init: subst_expr_cg(init, type_param, arg), declared_type: declared_type, line: line }; }
        ExprStmt { expr, line } => { return ExprStmt { expr: subst_expr_cg(expr, type_param, arg), line: line }; }
        Return { value, line } => {
            var new_val = none_expr_cg();
            if let Some { value: v } = value { new_val = some_expr_cg(subst_expr_cg(v, type_param, arg)); }
            return Return { value: new_val, line: line };
        }
        If { cond, then_body, else_body, line, narrow_name, narrow_is_eq } => {
            var new_else = none_stmt_list_cg();
            if let Some { value: eb } = else_body { new_else = some_stmt_list_cg(subst_stmt_list_cg(eb, type_param, arg)); }
            return If { cond: subst_expr_cg(cond, type_param, arg), then_body: subst_stmt_list_cg(then_body, type_param, arg), else_body: new_else, line: line, narrow_name: narrow_name, narrow_is_eq: narrow_is_eq };
        }
        While { cond, body, line } => { return While { cond: subst_expr_cg(cond, type_param, arg), body: subst_stmt_list_cg(body, type_param, arg), line: line }; }
        For { var_name, is_range, range_start, range_end, inclusive, arr_expr, body, line } => {
            return For { var_name: var_name, is_range: is_range, range_start: subst_expr_cg(range_start, type_param, arg), range_end: subst_expr_cg(range_end, type_param, arg), inclusive: inclusive, arr_expr: subst_expr_cg(arr_expr, type_param, arg), body: subst_stmt_list_cg(body, type_param, arg), line: line };
        }
        Match { subject, arms, line } => { return Match { subject: subst_expr_cg(subject, type_param, arg), arms: subst_arm_list_cg(arms, type_param, arg), line: line }; }
        Throw { value, line } => { return Throw { value: subst_expr_cg(value, type_param, arg), line: line }; }
        Break { line } => { return Break { line: line }; }
        Continue { line } => { return Continue { line: line }; }
        Try { try_block, catches, line } => {
            return Try { try_block: subst_stmt_list_cg(try_block, type_param, arg), catches: subst_catches_cg(catches, type_param, arg), line: line };
        }
    }
}

fn subst_stmt_list_cg(ss: Vec<Stmt>, type_param: String, arg: String) -> Vec<Stmt> {
    var out = empty_stmt_vec2();
    var i = 0;
    while i < ss.length() {
        out.push(subst_stmt_cg(ss.get(i), type_param, arg));
        i = i + 1;
    }
    return out;
}

fn subst_catches_cg(cs: Vec<CatchClause>, type_param: String, arg: String) -> Vec<CatchClause> {
    var out = empty_catchclause_vec_cg();
    var i = 0;
    while i < cs.length() {
        let c = cs.get(i);
        out.push(CatchClause { catch_var: c.catch_var, catch_type: c.catch_type, catch_block: subst_stmt_list_cg(c.catch_block, type_param, arg) });
        i = i + 1;
    }
    return out;
}

fn empty_catchclause_vec_cg() -> Vec<CatchClause> {
    var v = vec_of(CatchClause { catch_var: "_", catch_type: "_", catch_block: empty_stmt_vec2() });
    return Vec { data: v.data, len: 0 };
}

fn subst_arm_list_cg(arms: Vec<MatchArm>, type_param: String, arg: String) -> Vec<MatchArm> {
    var out = empty_matcharm_vec_cg();
    var i = 0;
    while i < arms.length() {
        let a = arms.get(i);
        out.push(MatchArm { variant_name: a.variant_name, field_names: a.field_names, bind_names: a.bind_names, body: subst_stmt_list_cg(a.body, type_param, arg), is_literal: a.is_literal, literal: subst_expr_cg(a.literal, type_param, arg) });
        i = i + 1;
    }
    return out;
}

fn none_expr_cg() -> Option<Expr> {
    return None;
}

fn some_expr_cg(e: Expr) -> Option<Expr> {
    return Some { value: e };
}

fn none_stmt_list_cg() -> Option<Vec<Stmt>> {
    return None;
}

fn some_stmt_list_cg(ss: Vec<Stmt>) -> Option<Vec<Stmt>> {
    return Some { value: ss };
}

// Finds `method`'s own template `FnDecl` (params/ret/body, still un-substituted) declared inside
// the generic struct `base`'s own `impl` block -- searched fresh each call (same "redo the search,
// simplicity over caching" convention `monomorphized_fields`/`monomorphized_fn_params_cg` already
// use), a sentinel empty `FnDecl` if nothing matches.
fn find_template_method_cg(impls: &Vec<ImplDecl>, base: String, method: String) -> FnDecl {
    var i = 0;
    while i < impls.length() {
        let im = impls.get(i);
        if im.struct_name == base {
            var j = 0;
            while j < im.methods.length() {
                let m = im.methods.get(j);
                if m.name == method {
                    return m;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return FnDecl { name: "_", params: empty_param_vec2(), ret_type: none_string2(), body: empty_stmt_vec2(), type_param: none_string2(), type_bounds: empty_str_vec4(), self_is_mut: false, type_param2: none_string2(), type_bounds2: empty_str_vec4() };
}

// A generic struct declaration's own `type_param` string (`"T"` for `struct Box<T> { ... }`), `""`
// if `base` isn't found or isn't generic -- `Codegen.hotc` doesn't share `Checker.hotc`'s own
// `generic_templates` registry, so this is derived fresh from the plain `structs: Vec<StructDecl>`
// every caller already has, same pattern the rest of this file's mono helpers use.
fn struct_type_param_cg(structs: &Vec<StructDecl>, base: String) -> String {
    var i = 0;
    while i < structs.length() {
        let sd = structs.get(i);
        if sd.name == base {
            var tp = "";
            if let Some { value: t } = sd.type_param { tp = t; }
            return tp;
        }
        i = i + 1;
    }
    return "";
}

// The `type_param2`-shaped sibling of `struct_type_param_cg` above -- `""` when `base` isn't
// found or has only one type param, see `Ast.hc`'s own `StructDecl.type_param2` header.
fn struct_type_param2_cg(structs: &Vec<StructDecl>, base: String) -> String {
    var i = 0;
    while i < structs.length() {
        let sd = structs.get(i);
        if sd.name == base {
            var tp2 = "";
            if let Some { value: t2 } = sd.type_param2 { tp2 = t2; }
            return tp2;
        }
        i = i + 1;
    }
    return "";
}

// The method-shaped counterpart to `monomorphized_fn_params_cg`/`_retty_cg`/body substitution --
// `owner` is the MONO struct name (`"Box$Int"`), `method` the bare method name (`"get"`); finds
// the template via `find_template_method_cg` (base = `mono_base_cg(owner)`) and substitutes its
// declared `T` (the OWNING STRUCT's own type parameter, found via `struct_type_param_cg` -- NOT
// the method's own `type_param`, which is always `None`; a method isn't independently generic, it
// just uses its struct's `T`) for `mono_arg_cg(owner)`.
fn monomorphized_method_params_cg(impls: &Vec<ImplDecl>, structs: &Vec<StructDecl>, owner: String, method: String) -> Vec<Param> {
    let base = mono_base_cg(owner);
    let arg = mono_arg_cg(owner);
    let found_tp = struct_type_param_cg(&structs, base);
    // `impl Pair<K, V> { fn describe(&self) { self.key.hash_key(); } }` -- a SECOND type param on
    // the RECEIVER's own struct, mirroring `monomorphized_fields`'s own two-param handling (see
    // `Ast.hc`'s own `StructDecl.type_param2` header).
    let tp2meth = struct_type_param2_cg(&structs, base);
    let has_tp2meth = tp2meth != "";
    var real_argmeth = arg;
    var arg2meth = "";
    if has_tp2meth {
        real_argmeth = mono_arg1_of2_cg(owner);
        arg2meth = mono_arg2_of2_cg(owner);
    }
    let tmpl = find_template_method_cg(&impls, base, method);
    var out = empty_param_vec2();
    var i = 0;
    while i < tmpl.params.length() {
        let p = tmpl.params.get(i);
        var pty = substitute_field_type_cg(p.type_name, found_tp, real_argmeth);
        if has_tp2meth {
            pty = substitute_field_type_cg(pty, tp2meth, arg2meth);
        }
        out.push(Param { name: p.name, type_name: pty, is_ref: p.is_ref, is_mut_ref: p.is_mut_ref });
        i = i + 1;
    }
    return out;
}

fn monomorphized_method_retty_cg(impls: &Vec<ImplDecl>, structs: &Vec<StructDecl>, owner: String, method: String) -> String {
    let base = mono_base_cg(owner);
    let arg = mono_arg_cg(owner);
    let found_tp = struct_type_param_cg(&structs, base);
    let tp2meth2 = struct_type_param2_cg(&structs, base);
    let has_tp2meth2 = tp2meth2 != "";
    var real_argmeth2 = arg;
    var arg2meth2 = "";
    if has_tp2meth2 {
        real_argmeth2 = mono_arg1_of2_cg(owner);
        arg2meth2 = mono_arg2_of2_cg(owner);
    }
    let tmpl = find_template_method_cg(&impls, base, method);
    let ret_str = opt_string_or(tmpl.ret_type, "Unit");
    var subbed_ret = substitute_field_type_cg(ret_str, found_tp, real_argmeth2);
    if has_tp2meth2 {
        subbed_ret = substitute_field_type_cg(subbed_ret, tp2meth2, arg2meth2);
    }
    return subbed_ret;
}

fn monomorphized_method_body_cg(impls: &Vec<ImplDecl>, structs: &Vec<StructDecl>, owner: String, method: String) -> Vec<Stmt> {
    let base = mono_base_cg(owner);
    let arg = mono_arg_cg(owner);
    let found_tp = struct_type_param_cg(&structs, base);
    let tp2meth3 = struct_type_param2_cg(&structs, base);
    let has_tp2meth3 = tp2meth3 != "";
    var real_argmeth3 = arg;
    var arg2meth3 = "";
    if has_tp2meth3 {
        real_argmeth3 = mono_arg1_of2_cg(owner);
        arg2meth3 = mono_arg2_of2_cg(owner);
    }
    let tmpl = find_template_method_cg(&impls, base, method);
    var subbed_body = subst_stmt_list_cg(tmpl.body, found_tp, real_argmeth3);
    if has_tp2meth3 {
        subbed_body = subst_stmt_list_cg(subbed_body, tp2meth3, arg2meth3);
    }
    return subbed_body;
}

// The full substituted `FnDecl` for one mono method instantiation, ready to hand to `gen_method`
// exactly like a real, non-generic method's own declaration -- `gen_struct`'s own method-emission
// loop needs no changes at all once it's handed one of these (see this file's own header).
fn monomorphized_method_decl_cg(impls: &Vec<ImplDecl>, structs: &Vec<StructDecl>, owner: String, method: String) -> FnDecl {
    let params = monomorphized_method_params_cg(&impls, &structs, owner, method);
    let ret = monomorphized_method_retty_cg(&impls, &structs, owner, method);
    let body = monomorphized_method_body_cg(&impls, &structs, owner, method);
    let base2 = mono_base_cg(owner);
    let tmpl2 = find_template_method_cg(&impls, base2, method);
    return FnDecl { name: method, params: params, ret_type: some_string2(ret), body: body, type_param: none_string2(), type_bounds: empty_str_vec4(), self_is_mut: tmpl2.self_is_mut, type_param2: none_string2(), type_bounds2: empty_str_vec4() };
}

// Every substituted method `checker.method_mono_needed` recorded for THIS particular mono struct
// (`mono_name`, e.g. `"Box$Int"`) -- `gen_struct`'s own mono-instantiation call site passes this
// as its `methods` argument instead of the empty `Vec` it used before this phase (see `Codegen.hc`'s
// own header for why generic struct instance methods needed this whole new pathway).
fn monomorphized_methods_for_struct_cg(impls: &Vec<ImplDecl>, structs: &Vec<StructDecl>, method_mono_names: &Vec<String>, mono_name: String) -> Vec<FnDecl> {
    var out = empty_fn_decl_vec2();
    var i = 0;
    while i < method_mono_names.length() {
        let key = method_mono_names.get(i);
        let idx = key.indexOf("#");
        let owner = key.substring(0, idx);
        let method = key.substring(idx + 1, key.length());
        if owner == mono_name {
            out.push(monomorphized_method_decl_cg(&impls, &structs, owner, method));
        }
        i = i + 1;
    }
    return out;
}

// "Int"/"Bool" -> "I" (both are plain JVM ints, see this file's own header), "String" ->
// "Ljava/lang/String;", "Unit" -> "V" (only valid in return position -- no HC param can be Unit),
// "[X]" -> "[" + descriptor_of_type(X) (a real JVM array descriptor), an extern alias name ->
// "L<real binary name>;" (looked up in the parallel `alias_names`/`alias_binaries` arrays --
// closes the last disclosed extern-class gap: a struct field or fn param/return of extern type
// now resolves to the real class, not "L<alias>;" nonsense), anything else -> "L<name-or-its-
// module-qualified-form>;" (presumed a struct/enum -- every non-module struct/enum's binary
// class name equals its declared name, see `gen_struct`; a module-declared one's real binary
// name is `module_names`/`module_values`-qualified instead, see `CodeGen.qualify`'s own header --
// the SAME lookup, just plumbed here as parallel arrays since this is a free function with no
// `CodeGen` receiver to hang a `Registry` off of).
fn descriptor_of_type(name0: String, alias_names: &Vec<String>, alias_binaries: &Vec<String>, module_names: &Vec<String>, module_values: &Vec<String>) -> String {
    // See `resolve_descriptor`'s own identical header, right above -- same reasoning, duplicated
    // here since this is the free-function twin with no `CodeGen` receiver to share it through.
    var name = name0;
    if is_nullable_type_name_cg(name) { name = strip_nullable_cg(name); }
    if name == "String" { return "Ljava/lang/String;"; }
    if name == "Unit" { return "V"; }
    if name == "Int" { return "I"; }
    // See resolve_descriptor's own comment: Bool -> "Z" here causes a reproducible field-vs-ctor
    // descriptor mismatch across the self-host bootstrap. Keep as "I" until root-caused.
    if name == "Bool" { return "I"; }
    // `Long`/`Float`/`Double` aren't general first-class primitives with their own literal syntax
    // in this subset (see `Ast.hc`'s own `Cast` header) -- this mapping exists so a struct field,
    // fn param/return, or extern method's own declared type (`JLong::parseLong`, real `Lexer.hotc`
    // usage) builds the right JVM descriptor (a real category-1/2 primitive) rather than falling
    // through to the "unknown name -> treat as a class reference" fallback below (`"LLong;"`, which
    // names a nonexistent class).
    if name == "Long" { return "J"; }
    if name == "Float" { return "F"; }
    if name == "Double" { return "D"; }
    if name == "Char" { return "C"; }
    if name == "Byte" { return "B"; }
    if is_array_type_name_cg(name) { return "[" + descriptor_of_type(array_elem_type_name_cg(name), &alias_names, &alias_binaries, &module_names, &module_values); }
    if is_dyn_type_name_cg(name) {
        // See `resolve_descriptor`'s own header (the `&mut self` sibling of this free fn) -- an
        // `extern interface`'s own real binary name, when this is one, lives in the SAME
        // `alias_names`/`alias_binaries` table `extern class` aliases already populate
        // (`build_program_info` folds both in together), keyed by the bare interface name.
        let bare2 = dyn_interface_name_cg(name);
        var di = 0;
        while di < alias_names.length() {
            if alias_names.get(di) == bare2 {
                return "L" + alias_binaries.get(di) + ";";
            }
            di = di + 1;
        }
        return "L" + qualify_names_cg(bare2, &module_names, &module_values) + ";";
    }
    if is_arena_type_name_cg(name) { return "Ljava/lang/foreign/MemorySegment;"; } // see `resolve_descriptor`'s own header
    var i = 0;
    while i < alias_names.length() {
        if alias_names.get(i) == name {
            return "L" + alias_binaries.get(i) + ";";
        }
        i = i + 1;
    }
    return "L" + qualify_names_cg(name, &module_names, &module_values) + ";";
}

// Free-function, parallel-array-driven twin of `CodeGen.qualify` -- used by `descriptor_of_type`,
// which (unlike most of this file's other codegen) has no `CodeGen` receiver to read
// `self.module_of` off of.
fn qualify_names_cg(name: String, module_names: &Vec<String>, module_values: &Vec<String>) -> String {
    var base = name;
    if is_mono_name_cg(name) { base = mono_base_cg(name); }
    var i = 0;
    while i < module_names.length() {
        if module_names.get(i) == base {
            return dot_to_slash_cg(module_values.get(i)) + "/" + name;
        }
        i = i + 1;
    }
    return name;
}

fn extern_alias_list(externs: &Vec<ExternClassDecl>) -> Vec<String> {
    var out = empty_str_vec4();
    var i = 0;
    while i < externs.length() {
        out.push(externs.get(i).name);
        i = i + 1;
    }
    return out;
}

fn extern_binary_list(externs: &Vec<ExternClassDecl>) -> Vec<String> {
    var out = empty_str_vec4();
    var i = 0;
    while i < externs.length() {
        out.push(dot_to_slash_cg(externs.get(i).binary_name));
        i = i + 1;
    }
    return out;
}

// Does `args` contain a `Lambda` literal anywhere? `gen_expr`'s extern `MethodCall`/`StaticCall`
// branches need to know this BEFORE evaluating any arg at all -- a `Lambda` can't be `gen_expr`'d
// directly (see `Expr.Lambda`'s own header), so those branches only take the "look up the target
// param types first, then check each arg against its own" slower path when this is actually true,
// leaving the ordinary (and far more common) no-lambda call path completely untouched.
// Also matches `ExternStaticFieldGet` (a `Type::method` bare reference MIGHT be a method-ref
// candidate -- see `gen_method_ref`'s own header) even though some of those turn out to be
// genuine static field reads once actually dispatched -- an over-approximation that's harmless
// here: it only decides whether to take the "resolve the callee's real param types before
// evaluating any arg" slower path, not whether an arg's own eventual `gen_expr`/`gen_method_ref`
// dispatch is correct.
fn args_has_lambda_cg(args: &Vec<Expr>) -> Bool {
    var i = 0;
    while i < args.length() {
        match args.get(i) {
            Lambda { params, body } => { return true; }
            ExternStaticFieldGet { type_name, field } => { return true; }
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

// `Type::method` -- a bare method reference used directly as a lambda-typed argument, see
// `Checker.hotc`'s own `check_method_ref` header for the full design (this is its codegen
// mirror -- independent registries, same split as everywhere else in this file). Synthesizes the
// exact same `Lambda { params: [mref_p0, ...], body: StaticCall { type_name, method, args:
// [idents] } }` the checker's own version builds, then hands it to `gen_lambda` unchanged -- no
// separate emission path, no new bytecode shape.
fn synth_method_ref_lambda_params_cg(count: Int) -> Vec<String> {
    var out = empty_str_vec4();
    var i = 0;
    while i < count {
        out.push("mref_p" + arity_str_cg(i));
        i = i + 1;
    }
    return out;
}

fn synth_method_ref_args_cg(params: &Vec<String>) -> Vec<Expr> {
    var out = empty_expr_vec_cg();
    var i = 0;
    while i < params.length() {
        out.push(Ident { name: params.get(i) });
        i = i + 1;
    }
    return out;
}

// Does `v` already contain `s`? A plain linear scan -- `Vec<String>`'s own small, expected size
// here (a lambda literal's own free-variable count) doesn't earn a `Registry`.
fn str_vec_contains_cg(v: &Vec<String>, s: String) -> Bool {
    var i = 0;
    while i < v.length() {
        if v.get(i) == s { return true; }
        i = i + 1;
    }
    return false;
}

// Monomorphized generic instantiations are named `"Base$Arg"` -- same convention (and same
// duplicated-helper-with-`_cg`-suffix pattern) as `Checker.hotc`'s own `is_mono_name`/
// `mono_base`/`mono_arg`.
fn is_mono_name_cg(name: String) -> Bool {
    return name.indexOf("$") >= 0;
}

fn mono_base_cg(name: String) -> String {
    let idx = name.indexOf("$");
    return name.substring(0, idx);
}

fn mono_arg_cg(name: String) -> String {
    let idx = name.indexOf("$");
    return name.substring(idx + 1, name.length());
}

// Finds `mono_name`'s (`"Box$Int"`) generic template (`structs`' own `"Box"` declaration) and
// substitutes its type parameter with the real argument, producing the concrete field list
// `gen_struct` needs to emit a real class for it -- same substitution `Checker.hotc`'s own
// `ensure_instantiated` already performed once to decide this instantiation was needed at all,
// redone here on the codegen side since `Checker.hotc`'s own `GenericTemplate` isn't exposed
// (only the plain `structs: Vec<StructDecl>` this file already has).
fn monomorphized_fields(structs: &Vec<StructDecl>, mono_name: String) -> Vec<Param> {
    let base = mono_base_cg(mono_name);
    let arg = mono_arg_cg(mono_name);
    var i = 0;
    while i < structs.length() {
        let sd = structs.get(i);
        if sd.name == base {
            var found_tp = "";
            if let Some { value: tp } = sd.type_param {
                found_tp = tp;
            }
            // `struct HashMap<K, V> { ... }` -- see `Ast.hc`'s own `StructDecl.type_param2`
            // header, and `monomorphized_enum_variants`'s own identical two-param handling right
            // above for why a two-param mono name needs its own arg-splitting instead of reusing
            // `mono_arg_cg`.
            var has_tp2f = false;
            var tp2f = "";
            if let Some { value: tp2fv } = sd.type_param2 { has_tp2f = true; tp2f = tp2fv; }
            var arg2f = "";
            var real_argf = arg;
            if has_tp2f {
                real_argf = mono_arg1_of2_cg(mono_name);
                arg2f = mono_arg2_of2_cg(mono_name);
            }
            var out = empty_param_vec2();
            var j = 0;
            while j < sd.fields.length() {
                let f = sd.fields.get(j);
                var ftype3 = substitute_field_type_cg(f.type_name, found_tp, real_argf);
                if has_tp2f {
                    ftype3 = substitute_field_type_cg(ftype3, tp2f, arg2f);
                }
                out.push(Param { name: f.name, type_name: ftype3, is_ref: false, is_mut_ref: false });
                j = j + 1;
            }
            return out;
        }
        i = i + 1;
    }
    return empty_param_vec2();
}

// `mono_name`'s (`"identity$Int"`) generic FUNCTION template's own params, substituted -- the fn-
// shaped counterpart to `monomorphized_fields` above (structs) and `monomorphized_enum_variants`
// (enums). `fns` here is the WHOLE program's fn list (including generic templates, which never
// made it into `fn_names`/`fn_descs_list` -- see `build_program_info`'s own header), searched
// linearly for the one whose name matches `mono_name`'s base and whose `type_param` is `Some`.
fn monomorphized_fn_params_cg(fns: &Vec<FnDecl>, mono_name: String) -> Vec<Param> {
    let base = mono_base_cg(mono_name);
    let arg = mono_arg_cg(mono_name);
    var i = 0;
    while i < fns.length() {
        let f = fns.get(i);
        var found_tp = "";
        var is_generic = false;
        if let Some { value: tp } = f.type_param { found_tp = tp; is_generic = true; }
        if f.name == base && is_generic {
            // `fn hash_map2_new<K: Hashable, V>(...)` -- a SECOND type param, mirroring
            // `monomorphized_fields`/`monomorphized_enum_variants`'s own identical two-param
            // handling (see `Ast.hc`'s own `FnDecl.type_param2` header).
            var has_tp2p = false;
            var tp2p = "";
            if let Some { value: tp2pv } = f.type_param2 { has_tp2p = true; tp2p = tp2pv; }
            var arg2p = "";
            var real_argp = arg;
            if has_tp2p {
                real_argp = mono_arg1_of2_cg(mono_name);
                arg2p = mono_arg2_of2_cg(mono_name);
            }
            var out = empty_param_vec2();
            var j = 0;
            while j < f.params.length() {
                let p = f.params.get(j);
                var pty = substitute_field_type_cg(p.type_name, found_tp, real_argp);
                if has_tp2p {
                    pty = substitute_field_type_cg(pty, tp2p, arg2p);
                }
                out.push(Param { name: p.name, type_name: pty, is_ref: p.is_ref, is_mut_ref: p.is_mut_ref });
                j = j + 1;
            }
            return out;
        }
        i = i + 1;
    }
    return empty_param_vec2();
}

// The return-type-shaped sibling of `monomorphized_fn_params_cg` above -- same linear search,
// substituting the template's own declared return type instead of its params.
fn monomorphized_fn_retty_cg(fns: &Vec<FnDecl>, mono_name: String) -> String {
    let base = mono_base_cg(mono_name);
    let arg = mono_arg_cg(mono_name);
    var i = 0;
    while i < fns.length() {
        let f = fns.get(i);
        var found_tp = "";
        var is_generic = false;
        if let Some { value: tp } = f.type_param { found_tp = tp; is_generic = true; }
        if f.name == base && is_generic {
            var has_tp2r = false;
            var tp2r = "";
            if let Some { value: tp2rv } = f.type_param2 { has_tp2r = true; tp2r = tp2rv; }
            var real_argr = arg;
            var arg2r = "";
            if has_tp2r {
                real_argr = mono_arg1_of2_cg(mono_name);
                arg2r = mono_arg2_of2_cg(mono_name);
            }
            let ret_str = opt_string_or(f.ret_type, "Unit");
            var subbed = substitute_field_type_cg(ret_str, found_tp, real_argr);
            if has_tp2r {
                subbed = substitute_field_type_cg(subbed, tp2r, arg2r);
            }
            return subbed;
        }
        i = i + 1;
    }
    return "Int";
}

// The generic FUNCTION template's own body, substituted for this particular `mono_name`
// (`subst_stmt_list_cg`, fixing up any nested generic construction site inside the body that
// referenced the fn's own still-abstract `T` -- see `Checker.hotc`'s own `ensure_fn_instantiated`
// header for why this substitution has to happen, not just on params/return types).
fn fn_body_of_generic_template_cg(fns: &Vec<FnDecl>, mono_name: String) -> Vec<Stmt> {
    let base = mono_base_cg(mono_name);
    let arg = mono_arg_cg(mono_name);
    var i = 0;
    while i < fns.length() {
        let f = fns.get(i);
        var found_tp = "";
        var is_generic = false;
        if let Some { value: tp } = f.type_param { found_tp = tp; is_generic = true; }
        if f.name == base && is_generic {
            var has_tp2b = false;
            var tp2b = "";
            if let Some { value: tp2bv } = f.type_param2 { has_tp2b = true; tp2b = tp2bv; }
            var real_argb = arg;
            var arg2b = "";
            if has_tp2b {
                real_argb = mono_arg1_of2_cg(mono_name);
                arg2b = mono_arg2_of2_cg(mono_name);
            }
            var subbed_body = subst_stmt_list_cg(f.body, found_tp, real_argb);
            if has_tp2b {
                subbed_body = subst_stmt_list_cg(subbed_body, tp2b, arg2b);
            }
            return subbed_body;
        }
        i = i + 1;
    }
    return empty_stmt_vec2();
}

fn empty_variant_vec_cg() -> Vec<EnumVariant> {
    var v = vec_of(EnumVariant { name: "_", fields: empty_param_vec2() });
    return Vec { data: v.data, len: 0 };
}

// `mono_name`'s (`"Option$Int"`) generic ENUM template (an `EnumDecl` in `enums` whose own
// `type_param` is `Some`), variant field types substituted -- the enum-shaped counterpart to
// `monomorphized_fields` above. Returns an empty `Vec` if `mono_name`'s base isn't a generic enum
// at all (the caller falls back to `monomorphized_fields`/`gen_struct` in that case -- see
// `compile_program`'s own mono-instantiation loop).
fn monomorphized_enum_variants(enums: &Vec<EnumDecl>, mono_name: String) -> Vec<EnumVariant> {
    let base = mono_base_cg(mono_name);
    let arg = mono_arg_cg(mono_name);
    var i = 0;
    while i < enums.length() {
        let ed = enums.get(i);
        var found_tp = "";
        var is_generic = false;
        if let Some { value: tp } = ed.type_param {
            found_tp = tp;
            is_generic = true;
        }
        if ed.name == base && is_generic {
            // `Result<T, E>` -- see `Ast.hc`'s own `EnumDecl.type_param2` header, and
            // `Checker.hotc`'s own `ensure_instantiated` for why a two-param mono name needs its
            // own arg-splitting instead of reusing `mono_arg_cg`.
            var has_tp2 = false;
            var tp2 = "";
            if let Some { value: tp2v } = ed.type_param2 { has_tp2 = true; tp2 = tp2v; }
            var arg2 = "";
            var real_arg = arg;
            if has_tp2 {
                real_arg = mono_arg1_of2_cg(mono_name);
                arg2 = mono_arg2_of2_cg(mono_name);
            }
            var out = empty_variant_vec_cg();
            var vi = 0;
            while vi < ed.variants.length() {
                let v = ed.variants.get(vi);
                var new_fields = empty_param_vec2();
                var fj = 0;
                while fj < v.fields.length() {
                    let f = v.fields.get(fj);
                    var ftype4 = substitute_field_type_cg(f.type_name, found_tp, real_arg);
                    if has_tp2 {
                        ftype4 = substitute_field_type_cg(ftype4, tp2, arg2);
                    }
                    new_fields.push(Param { name: f.name, type_name: ftype4, is_ref: false, is_mut_ref: false });
                    fj = fj + 1;
                }
                out.push(EnumVariant { name: v.name, fields: new_fields });
                vi = vi + 1;
            }
            return out;
        }
        i = i + 1;
    }
    return empty_variant_vec_cg();
}

// See `monomorphized_enum_variants`'s own header.
fn mono_arg1_of2_cg(name: String) -> String {
    let idx1 = name.indexOf("$");
    let rest = name.substring(idx1 + 1, name.length());
    let idx2 = rest.indexOf("$");
    return rest.substring(0, idx2);
}
fn mono_arg2_of2_cg(name: String) -> String {
    let idx1 = name.indexOf("$");
    let rest = name.substring(idx1 + 1, name.length());
    let idx2 = rest.indexOf("$");
    return rest.substring(idx2 + 1, rest.length());
}

// `true` iff `mono_name`'s base names a generic ENUM template (as opposed to a generic struct) --
// decides whether `compile_program`'s mono-instantiation loop and `build_program_info` route a
// given `"Base$Arg"` name through the enum-shaped path (`monomorphized_enum_variants`/`gen_enum`)
// or the struct-shaped one (`monomorphized_fields`/`gen_struct`).
fn is_generic_enum_mono(enums: &Vec<EnumDecl>, mono_name: String) -> Bool {
    let base = mono_base_cg(mono_name);
    var i = 0;
    while i < enums.length() {
        let ed = enums.get(i);
        var is_generic = false;
        if let Some { value: tp } = ed.type_param { is_generic = true; }
        if ed.name == base && is_generic { return true; }
        i = i + 1;
    }
    return false;
}

fn fn_descriptor(param_type_names: Vec<String>, ret_type_name: String, alias_names: &Vec<String>, alias_binaries: &Vec<String>, module_names: &Vec<String>, module_values: &Vec<String>) -> String {
    var d = "(";
    var i = 0;
    while i < param_type_names.length() {
        d = d + descriptor_of_type(param_type_names.get(i), &alias_names, &alias_binaries, &module_names, &module_values);
        i = i + 1;
    }
    return d + ")" + descriptor_of_type(ret_type_name, &alias_names, &alias_binaries, &module_names, &module_values);
}

// Builds a full, real, loadable class: a default constructor, the target fn (`Int -> Int`, one
// param, matching this phase's own test function), and a `main(String[])` that calls it with a
// hardcoded test value and prints the result -- making the generated class directly runnable and
// its correctness independently verifiable with a real `java` invocation, not just "it compiled."
pub fn emit_and_write(fn_name: String, param_names: Vec<String>, body: Vec<Stmt>, class_name: String, binary_name: String, test_arg: Int, out_path: String) {
    var cw = ClassWriter2::new(2); // COMPUTE_FRAMES (implies COMPUTE_MAXS; real ASM value is 2, not 4)
    CodegenShim::visitClassHeader(&mut cw, 61, 33, binary_name, "java/lang/Object", ["x"; 0]); // V17, ACC_PUBLIC | ACC_SUPER
    CodegenShim::visitSource(&mut cw, binary_name + ".hotc");

    let ctor = CodegenShim::visitMethodNoSig(&mut cw, 1, "<init>", "()V", ["x"; 0]);
    ctor.visitCode();
    ctor.visitVarInsn(25, 0); // ALOAD 0
    ctor.visitMethodInsn(183, "java/lang/Object", "<init>", "()V", false); // INVOKESPECIAL
    ctor.visitInsn(177); // RETURN
    ctor.visitMaxs(1, 1);
    ctor.visitEnd();

    let param_count = param_names.length();
    var self_only_names = vec_of(fn_name); // supports self-recursive calls
    var self_only_descs = vec_of(int_descriptor(param_count));
    var self_only_rettys = vec_of("Int");
    var int_types = all_int_types(param_count);
    let info = ProgramInfo { target: 17, fn_names: self_only_names, fn_descs_list: self_only_descs, fn_rettys_list: self_only_rettys, fn_param_types_list: vec_of(empty_str_vec4()), fn_param_names_list: vec_of(empty_str_vec4()), static_names: empty_str_vec4(), static_type_names: empty_str_vec4(), generic_fn_names: empty_str_vec4(), generic_fn_infer_idx: empty_int_vec(), generic_fn_infer_unwrap: empty_int_vec(), generic_fn_infer_idx2: empty_int_vec(), generic_fn_infer_unwrap2: empty_int_vec(), generic_struct_infer_names: empty_str_vec4(), generic_struct_infer_fields: empty_str_vec4(), generic_enum_infer_variant_names: empty_str_vec4(), generic_enum_infer_owner_names: empty_str_vec4(), generic_enum_infer_field_names: empty_str_vec4(), enum_names: empty_str_vec4(), struct_names: empty_str_vec4(), struct_field_names_list: empty_str_vec_vec(), struct_field_types_list: empty_str_vec_vec(), method_keys: empty_str_vec4(), method_descs_list: empty_str_vec4(), method_rettys_list: empty_str_vec4(), method_param_types_list: empty_str_vec_vec(), variant_owner_names: empty_str_vec4(), variant_owner_enums: empty_str_vec4(), variant_tag_keys: empty_str_vec4(), variant_tag_list: empty_int_vec(), extern_alias_names: empty_str_vec4(), extern_binary_names: empty_str_vec4(), extern_alias_is_interface: empty_int_vec(), extern_method_keys: empty_str_vec4(), extern_method_descs_list: empty_str_vec4(), extern_method_rettys_list: empty_str_vec4(), extern_method_static_list: empty_int_vec(), extern_method_ctor_list: empty_int_vec(), extern_method_param_types_list: empty_str_vec_vec(), extern_field_keys: empty_str_vec4(), extern_field_descs_list: empty_str_vec4(), extern_field_type_names_list: empty_str_vec4(), extern_field_static_list: empty_int_vec(), struct_extends_names: empty_str_vec4(), struct_extends_targets: empty_str_vec4(), variant_field_keys: empty_str_vec4(), variant_field_names_list: empty_str_vec_vec(), variant_field_types_list: empty_str_vec_vec(), module_names: empty_str_vec4(), module_values: empty_str_vec4(), interfaces_raw: empty_interface_vec_cg(), sendable_struct_names: empty_str_vec4() };
    gen_fn(&mut cw, binary_name, fn_name, param_names, int_types, "Int", body, info, none_annotation2());

    let main_mv = CodegenShim::visitMethodNoSig(&mut cw, 9, "main", "([Ljava/lang/String;)V", ["x"; 0]);
    main_mv.visitCode();
    main_mv.visitFieldInsn(178, "java/lang/System", "out", "Ljava/io/PrintStream;"); // GETSTATIC
    main_mv.visitIntInsn(17, test_arg); // SIPUSH test_arg
    main_mv.visitMethodInsn(184, binary_name, fn_name, int_descriptor(param_count), false); // INVOKESTATIC
    main_mv.visitMethodInsn(182, "java/io/PrintStream", "println", "(I)V", false); // INVOKEVIRTUAL
    main_mv.visitInsn(177); // RETURN
    main_mv.visitMaxs(2, 1);
    main_mv.visitEnd();

    cw.visitEnd();
    CodegenShim::writeClass(cw, out_path);
}

// === Whole-program compilation: check every fn (forward signatures registered first, so calls
// between functions resolve regardless of declaration order), then codegen every fn into one
// shared class. Returns the checker's error list (index 0 is always "" -- see `Checker.hotc`'s
// own `checker_new`) -- empty of anything else means "compiled clean." Bytecode is only written
// when there are no real errors, matching a real compiler refusing to emit broken output.
// A struct `impl`ing an interface that has one or more DEFAULT methods (a real body right on the
// interface declaration, not just a `;`-terminated signature -- see `Ast.hc`'s own `InterfaceMethod`
// header) doesn't have to provide its own override for those -- exactly like the real language's
// own default methods. Rather than teach every downstream consumer of `impls` (struct-method
// registration, struct-method type-checking, AND `gen_struct`'s own bytecode emission) to
// separately know about interface defaults, this materializes each missing default ONCE, up front,
// as a genuine extra `FnDecl` appended to that struct's own `ImplDecl.methods` -- every one of
// those consumers already just iterates `im.methods`, so this is the ONLY place that needs to know
// defaults exist at all. Simpler than the real compiler's own approach (a REAL, once-only-compiled
// JVM default method the JVM's own interface-method resolution finds for every implementer, see the
// real `Codegen.kt`'s own `genInterface`) but a real, working, disclosed narrower subset: the
// default body gets compiled ONCE PER IMPLEMENTING STRUCT here (a little bytecode duplication if
// many structs share one un-overridden default), not once total.
// `impl Interface for Struct by field { }` -- composition delegation sugar. Runs BEFORE
// `materialize_default_methods` (right below), so an interface method that's BOTH delegatable
// (the struct has a `by field`) and has a default body gets the delegated forwarder, not the
// interface's own default -- the more specific, deliberately-chosen behavior wins; the "already
// present" check in `materialize_default_methods` naturally skips a name this pass already filled
// in, no extra coordination needed.
fn materialize_delegated_methods(impls: Vec<ImplDecl>, interfaces: &Vec<InterfaceDecl>) -> Vec<ImplDecl> {
    var out = empty_impl_decl_vec();
    var i = 0;
    while i < impls.length() {
        let imd = impls.get(i);
        let struct_name = imd.struct_name;
        let static_methods = imd.static_methods;
        let iface_opt = imd.interface_name;
        let deleg_opt = imd.delegate_field;
        var methods = imd.methods;
        var has_iface = false;
        var iface_name = "?";
        if let Some { value: ifn3 } = iface_opt { has_iface = true; iface_name = ifn3; }
        var has_deleg = false;
        var deleg_field = "?";
        if let Some { value: df } = deleg_opt { has_deleg = true; deleg_field = df; }
        if has_iface && has_deleg {
            let flat2 = flatten_interface_methods(&interfaces, iface_name);
            var fi2 = 0;
            while fi2 < flat2.length() {
                let fm2 = flat2.get(fi2);
                let fm2_name = fm2.name;
                let fm2_params = fm2.params;
                let fm2_ret_type = fm2.ret_type;
                var already2 = false;
                var mi2 = 0;
                while mi2 < methods.length() {
                    if methods.get(mi2).name == fm2_name { already2 = true; }
                    mi2 = mi2 + 1;
                }
                if !already2 {
                    var fwd_args = empty_expr_vec_cg();
                    var pi2 = 0;
                    while pi2 < fm2_params.length() {
                        fwd_args.push(Ident { name: fm2_params.get(pi2).name });
                        pi2 = pi2 + 1;
                    }
                    let fwd_call = MethodCall { recv: FieldAccess { obj: Ident { name: "self" }, field: deleg_field }, method: fm2_name, args: fwd_args };
                    var fwd_body = empty_stmt_vec2();
                    if fm2_ret_type == "Unit" {
                        // A bare `Return { value: Some(voidCall) }` is a real, separate, pre-
                        // existing gap in `gen_stmt`'s own `Return` codegen (never hit before --
                        // no hand-written `.hotc` source ever explicitly `return`s a void call's
                        // result): it unconditionally emits SOME return opcode based on
                        // `self.ret_ty` alone, picking `ARETURN` for `"Unit"` (`is_ref_type`'s
                        // own definition is "not one of the known primitives", and `"Unit"` isn't
                        // one) -- but a void call pushes NOTHING onto the stack, so `ARETURN`
                        // there would pop a stack-underflow/garbage value, a real `VerifyError`.
                        // Sidestepped by construction here: call it as a bare statement instead,
                        // and let `gen_fallback_return`'s own trailing dummy `RETURN` (already
                        // unconditionally emitted after any fn/method body, matching-`Unit`-ret-
                        // type-correct) supply the real return -- no explicit `Return` needed at
                        // all for this case.
                        fwd_body.push(ExprStmt { expr: fwd_call, line: 0 });
                    } else {
                        fwd_body.push(Return { value: some_expr_cg(fwd_call), line: 0 });
                    }
                    methods.push(FnDecl { name: fm2_name, params: fm2_params, ret_type: some_string2(fm2_ret_type), body: fwd_body, type_param: none_string2(), type_bounds: empty_str_vec4(), self_is_mut: false, type_param2: none_string2(), type_bounds2: empty_str_vec4() });
                }
                fi2 = fi2 + 1;
            }
        }
        out.push(ImplDecl { struct_name: struct_name, methods: methods, static_methods: static_methods, interface_name: iface_opt, delegate_field: deleg_opt });
        i = i + 1;
    }
    return out;
}

fn materialize_default_methods(impls: Vec<ImplDecl>, interfaces: &Vec<InterfaceDecl>) -> Vec<ImplDecl> {
    var out = empty_impl_decl_vec();
    var i = 0;
    while i < impls.length() {
        let imd = impls.get(i);
        let struct_name = imd.struct_name;
        let static_methods = imd.static_methods;
        let iface_opt = imd.interface_name;
        var methods = imd.methods;
        var has_iface = false;
        var iface_name = "?";
        if let Some { value: ifn2 } = iface_opt { has_iface = true; iface_name = ifn2; }
        var final_iface_name = none_string2();
        if has_iface {
            final_iface_name = some_string2(iface_name);
        }
        if has_iface {
            let flat = flatten_interface_methods(&interfaces, iface_name);
            var fi = 0;
            while fi < flat.length() {
                let fm = flat.get(fi);
                let fm_name = fm.name;
                let fm_params = fm.params;
                let fm_ret_type = fm.ret_type;
                var has_default = false;
                var default_body = empty_stmt_vec2();
                if let Some { value: stmts } = fm.body { has_default = true; default_body = stmts; }
                if has_default {
                    var already = false;
                    var mi = 0;
                    while mi < methods.length() {
                        if methods.get(mi).name == fm_name { already = true; }
                        mi = mi + 1;
                    }
                    if !already {
                        methods.push(FnDecl { name: fm_name, params: fm_params, ret_type: some_string2(fm_ret_type), body: default_body, type_param: none_string2(), type_bounds: empty_str_vec4(), self_is_mut: false, type_param2: none_string2(), type_bounds2: empty_str_vec4() });
                    }
                }
                fi = fi + 1;
            }
        }
        out.push(ImplDecl { struct_name: struct_name, methods: methods, static_methods: static_methods, interface_name: final_iface_name, delegate_field: imd.delegate_field });
        i = i + 1;
    }
    return out;
}

// `extend Target { fn m(&self, params) -> Ret { body } ... }` -- see `Ast.hc`'s own `ExtendDecl`
// header. Desugars each method into an ORDINARY top-level `FnDecl`, receiver as an explicit,
// literally-named `"self"` first param -- since a method body's own `self.x`/`self.m2(...)`
// references are already just ordinary `Ident`/`FieldAccess`/`MethodCall` nodes naming `"self"`
// (no special AST shape the way an `impl`-block method's IMPLICIT slot-0 receiver needs), giving
// the synthesized param that exact same name means the body compiles completely unchanged --
// `check_ident`/`gen_ident` see an ordinary local, nothing extend-specific anywhere downstream of
// this one pass. `recv.m(args)` then resolves to this desugared fn as a last-resort checker/
// codegen fallback (see `Checker.hotc`'s own `check_extension_fallback` and this file's own
// `gen_expr` `MethodCall` fallback) once every real method-lookup path has failed -- exactly the
// same "no new runtime mechanism" story a plain top-level fn call already has.
//
// `target`'s self-param type is resolved HERE, once, by checking which kind of declaration it
// actually names: a registered STRUCT gets the bare struct name (an ordinary, non-`dyn` receiver,
// same as any inherent method); a registered `open interface` gets `"dyn " + target` (the same
// `&dyn Name` convention an extern method's own interface-typed param already uses) -- which is
// exactly what makes `is_arg_type_mismatch`'s EXISTING interface-widening logic accept a concrete
// struct implementing that interface as a valid receiver with zero new checker code. A target
// that's neither (or a non-open interface) is a real, loud compile error -- `open` exists
// specifically so an interface author opts in; extending a non-open one is exactly the mistake this
// guards against.
fn merge_fn_decl_vec_cg(a: Vec<FnDecl>, b: Vec<FnDecl>) -> Vec<FnDecl> {
    var out = a;
    var i = 0;
    while i < b.length() {
        out.push(b.get(i));
        i = i + 1;
    }
    return out;
}

fn materialize_extend_fns(extend_decls: Vec<ExtendDecl>, structs: &Vec<StructDecl>, interfaces: &Vec<InterfaceDecl>) -> Vec<FnDecl> {
    var out = empty_fn_decl_vec2();
    var i = 0;
    while i < extend_decls.length() {
        let ed = extend_decls.get(i);
        let target = ed.target;
        var self_type = "";
        var target_known = false;
        var si = 0;
        while si < structs.length() {
            if structs.get(si).name == target {
                self_type = target;
                target_known = true;
            }
            si = si + 1;
        }
        if !target_known {
            var ii = 0;
            while ii < interfaces.length() {
                let ifd = interfaces.get(ii);
                if ifd.name == target {
                    if !ifd.is_open {
                        throw CodegenError::new("codegen: 'extend " + target + "' -- interface '" + target + "' is not declared 'open'");
                    }
                    self_type = "dyn " + target;
                    target_known = true;
                }
                ii = ii + 1;
            }
        }
        if !target_known {
            throw CodegenError::new("codegen: 'extend " + target + "' -- unknown struct or open interface '" + target + "'");
        }
        var mi = 0;
        while mi < ed.methods.length() {
            let m = ed.methods.get(mi);
            let m2 = ed.methods.get(mi); // fresh copy -- `.params` is only safe to read once
            let m3 = ed.methods.get(mi); // fresh copy -- same reason, needed for `self_is_mut` below
            // `is_ref: true` -- self's own ref-kind IS tracked now (`m3.self_is_mut`, see `Ast.hc`'s
            // own `FnDecl.self_is_mut` header), so this synthesized `self` param carries it
            // faithfully instead of a fixed default.
            var new_params = vec_of(Param { name: "self", type_name: self_type, is_ref: true, is_mut_ref: m3.self_is_mut });
            var pi = 0;
            while pi < m.params.length() {
                new_params.push(m2.params.get(pi));
                pi = pi + 1;
            }
            // Desugared into a PLAIN top-level fn (its own `self` is just an ordinary first param
            // now, not a real receiver) -- `self_is_mut: false` is right regardless of `m`'s own
            // receiver kind, which the synthesized param above already carries forward.
            out.push(FnDecl { name: m.name, params: new_params, ret_type: m.ret_type, body: m.body, type_param: none_string2(), type_bounds: empty_str_vec4(), self_is_mut: false, type_param2: none_string2(), type_bounds2: empty_str_vec4() });
            mi = mi + 1;
        }
        i = i + 1;
    }
    return out;
}

// ECS archetype synthesis -- see `ECS_IDEAS.md`'s own design doc, and `compile_program`'s own
// call site for the full picture. A "zero value" `Expr` for an arbitrary FIELD type, recursively
// built from a component struct's own registered fields (`structs` -- the SAME list `compile_
// program` already threads through) -- the one piece an archetype's initial, empty storage needs
// (a real value to SEED an otherwise-empty `Vec<T>` with, see `empty_vec_expr_ecs`'s own header)
// but never actually reads (an empty `Vec` never touches its own seed slot). Scope cut, disclosed:
// only primitives and OTHER plain structs (recursively) are supported -- a component field of some
// other shape (an array, a generic, an extern type) throws a real, named `CodegenError` rather
// than silently producing broken code.
fn zero_value_expr_ecs(type_name: String, structs: &Vec<StructDecl>) -> Expr {
    if type_name == "Int" { return IntLit { value: 0 }; }
    if type_name == "Bool" { return BoolLit { value: false }; }
    if type_name == "String" { return StringLit { value: "" }; }
    if type_name == "Float" { return FloatLit { text: "0.0" }; }
    if type_name == "Double" { return DoubleLit { text: "0.0" }; }
    if type_name == "Long" { return Cast { expr: IntLit { value: 0 }, target_type: "Long" }; }
    if type_name == "Char" { return Cast { expr: IntLit { value: 0 }, target_type: "Char" }; }
    if type_name == "Byte" { return Cast { expr: IntLit { value: 0 }, target_type: "Byte" }; }
    var i = 0;
    while i < structs.length() {
        let sd = structs.get(i);
        if sd.name == type_name {
            var fnames = empty_str_vec4();
            var fvals = empty_expr_vec_cg();
            var j = 0;
            while j < sd.fields.length() {
                let f = sd.fields.get(j);
                fnames.push(f.name);
                fvals.push(zero_value_expr_ecs(f.type_name, structs));
                j = j + 1;
            }
            return StructLit { name: type_name, field_names: fnames, field_values: fvals, generic_base: none_string2() };
        }
        i = i + 1;
    }
    throw CodegenError::new("ECS: don't know how to synthesize a zero value for component field type '" + type_name + "' -- only primitives and other plain structs are supported as component fields this phase");
}

// A real, empty `Vec<T>` expression (`Vec$T { data: [zero; 1], len: 0 }`, the exact "seed via a
// real value, then report zero length" idiom every hand-written `empty_*_vec` helper in this whole
// compiler already uses -- see this fn's own callers) for an ARBITRARY component/field type `t`,
// built as source-level `Expr` rather than requiring a real value to already exist -- exactly what
// an archetype's own initial (pre-any-`spawn`) storage needs.
fn empty_vec_expr_ecs(t: String, structs: &Vec<StructDecl>) -> Expr {
    let seed = zero_value_expr_ecs(t, structs);
    var fnames = vec_of("data");
    fnames.push("len");
    var fvals = vec_of(ArrayRepeat { value: seed, count: IntLit { value: 1 } });
    fvals.push(IntLit { value: 0 });
    // `name` is the FULL mono name directly ("Vec$Int"), `generic_base` stays `None` -- mirrors
    // exactly how the parser itself already hands an explicit `Vec<T> { ... }` literal to this
    // same codegen (see `gen_expr`'s own `StructLit` arm, "an EXPLICIT one... already arrives
    // here with `name` baked to the full mono name"). A real, previously-hit bug: setting `name:
    // "Vec"` with `generic_base: Some("Vec$" + t)` instead -- the pairing that AST actually uses
    // for a generic-ENUM-variant's own explicit instantiation (`Option<Int>::Some { ... }`) --
    // made `gen_expr` treat this as enum-variant construction instead of a plain struct, emitting
    // a no-arg constructor + field-by-field `PUTFIELD`s instead of a real `Vec$<T>(data, len)`
    // constructor call. Caught only once `world.spawn(...)` was run end-to-end (`NoSuchMethodError:
    // Vec$Int: method 'void <init>()' not found`).
    return StructLit { name: "Vec$" + t, field_names: fnames, field_values: fvals, generic_base: none_string2() };
}

// One component-set "archetype signature" (`checker.archetype_signatures`, populated by `Checker.
// hotc`'s own `World#spawn` gate) becomes: a real `StructDecl` (one `Vec<Int>` field for entity
// ids, plus one `Vec<Component>` field per component in the signature, field-named `c0`, `c1`, ...
// by POSITION -- simple, collision-proof, and never seen by the user, since nothing in this phase
// exposes archetype internals as real syntax) and a real top-level `pub static` holding ONE,
// already-empty instance of it (`empty_vec_expr_ecs` on every field) -- `Codegen.hotc`'s own
// `finish_method_call` (the `World#spawn` codegen) is the only reader of either. Named
// deterministically from the signature itself (`Archetype$C1$C2`/`__archetype_C1_C2`) so the SAME
// signature always resolves to the SAME struct/static, however many `spawn` call sites share it.
fn archetype_struct_name_ecs(sig: &Vec<String>) -> String {
    var n = "Archetype";
    var i = 0;
    while i < sig.length() {
        n = n + "$" + sig.get(i);
        i = i + 1;
    }
    return n;
}

fn archetype_static_name_ecs(sig: &Vec<String>) -> String {
    var n = "__archetype";
    var i = 0;
    while i < sig.length() {
        n = n + "_" + sig.get(i);
        i = i + 1;
    }
    return n;
}

// The synthesized archetype struct's own component field NAMES, in signature order -- `c0`, `c1`,
// ... -- shared by both the struct-synthesis and the `World#spawn` codegen so they always agree.
fn archetype_field_name_ecs(idx: Int) -> String {
    return "c" + JString::valueOf(idx);
}

// `Changed<Component>`'s own backing state -- one parallel `Vec<Bool>` per component field,
// same positional naming convention as `archetype_field_name_ecs` (`c0_changed`, `c1_changed`,
// ...). `true` at index `i` means "component `c{idx}` at row `i` was written (or the row was
// freshly created/moved-into) since the start of the CURRENT `world.run_all()` call" -- see
// `build_run_all_body_ecs`'s own header for the full reset-and-mark protocol this backs.
fn archetype_field_changed_name_ecs(idx: Int) -> String {
    return archetype_field_name_ecs(idx) + "_changed";
}

// `__id` -- the archetype's own compile-time-assigned integer id (its index in the CLOSED
// signature list `Codegen.hotc`'s own ECS section computes -- see `archetype_closure_ecs`'s own
// header), stored as a REAL field so `World#spawn`'s codegen (and, later, every archetype-
// transition dispatcher) can read it straight off the static via an ordinary `GETFIELD` instead
// of needing a second, Codegen-instance-level lookup table anywhere. Always last, after every
// real component field -- nothing else in this file assumes fields end there, but keeping it
// out of the way of `entities`/`c0`/`c1`/...'s own fixed positional convention (`archetype_
// field_name_ecs`) costs nothing and avoids ever having to ask.
fn synthesize_archetype_struct_ecs(sig: Vec<String>) -> StructDecl {
    var fields = empty_param_vec2();
    fields.push(Param { name: "entities", type_name: "Vec$Int", is_ref: false, is_mut_ref: false });
    var i = 0;
    while i < sig.length() {
        fields.push(Param { name: archetype_field_name_ecs(i), type_name: "Vec$" + sig.get(i), is_ref: false, is_mut_ref: false });
        // `Changed<T>`'s own backing store -- see `archetype_field_changed_name_ecs`'s own header.
        fields.push(Param { name: archetype_field_changed_name_ecs(i), type_name: "Vec$Bool", is_ref: false, is_mut_ref: false });
        i = i + 1;
    }
    fields.push(Param { name: "__id", type_name: "Int", is_ref: false, is_mut_ref: false });
    return StructDecl { name: archetype_struct_name_ecs(&sig), type_param: none_string2(), fields: fields, is_arena: false, module_name: none_string2(), super_class: none_string2(), type_param2: none_string2() };
}

fn synthesize_archetype_static_ecs(sig: Vec<String>, structs: &Vec<StructDecl>, id: Int) -> StaticDecl {
    let struct_name = archetype_struct_name_ecs(&sig);
    var fnames = vec_of("entities");
    var fvals = vec_of(empty_vec_expr_ecs("Int", structs));
    var i = 0;
    while i < sig.length() {
        fnames.push(archetype_field_name_ecs(i));
        fvals.push(empty_vec_expr_ecs(sig.get(i), structs));
        fnames.push(archetype_field_changed_name_ecs(i));
        fvals.push(empty_vec_expr_ecs("Bool", structs));
        i = i + 1;
    }
    fnames.push("__id");
    fvals.push(IntLit { value: id });
    let init = StructLit { name: struct_name, field_names: fnames, field_values: fvals, generic_base: none_string2() };
    return StaticDecl { name: archetype_static_name_ecs(&sig), type_name: struct_name, value: init };
}

// `world.run_all()` -- see `Checker.hotc`'s own `World#run_all` gate and this file's own
// `finish_method_call` branch for the two ends of this; everything in between (deciding WHICH
// archetypes a system actually needs to visit, and building the real loop/call AST for each) is
// plain source-level `Ast.hc` construction, fed through the ORDINARY fn-registration/check/
// codegen pipeline like any other real fn -- same "materialize real AST, reuse existing
// codegen" precedent `synthesize_archetype_struct_ecs`/`_static_ecs` already established, one
// level up: THEIR output (a real struct/static) still needed a hand-written `World#spawn`
// bytecode branch to ever be touched; a `Call`/`MethodCall`/`For` tree needs none at all.

// The first index of `s` in `v`, or `-1` if absent -- `sig_has_all_ecs`'s own building block.
fn str_vec_index_of_ecs(v: &Vec<String>, s: String) -> Int {
    var i = 0;
    while i < v.length() {
        if v.get(i) == s { return i; }
        i = i + 1;
    }
    return -1;
}

// Is `sig` (one archetype's own, as-spawned component list) a superset of `needed` (one
// system's own required components, reads and writes both)? An archetype with EXTRA components
// beyond what a system needs still matches -- a system only ever touches the few components its
// own `run` params name, never "all of an entity's components".
// `--explain-schedule`'s own real output -- one line per group, in RUN order (the same order
// `build_run_all_body_ecs` itself dispatches them in), each listing its own member system names
// in declaration order, with `(parallel)` appended for any group with more than one member (see
// this fn's own caller in `compile_program` for the full design). Deliberately the simplest
// shape that answers the actual question this flag exists for -- "which systems run together,
// and in what order" -- rather than a full dependency-graph dump; the ALREADY-existing per-
// conflict warning (right above this flag's own check) is what explains WHY two systems didn't
// land in the same group, so this report doesn't need to repeat that reasoning.
fn print_schedule_report_ecs(groups: &Vec<Vec<String>>) {
    print("schedule (" + JString::valueOf(groups.length()) + " group(s), in run order):");
    var gi = 0;
    while gi < groups.length() {
        let g = groups.get(gi);
        var line = "  group " + JString::valueOf(gi) + ": ";
        var mi = 0;
        while mi < g.length() {
            if mi > 0 { line = line + ", "; }
            line = line + g.get(mi);
            mi = mi + 1;
        }
        if g.length() > 1 {
            line = line + "  (parallel)";
        }
        print(line);
        gi = gi + 1;
    }
}

fn sig_has_all_ecs(sig: &Vec<String>, needed: &Vec<String>) -> Bool {
    var i = 0;
    while i < needed.length() {
        if str_vec_index_of_ecs(sig, needed.get(i)) == -1 { return false; }
        i = i + 1;
    }
    return true;
}

// `sig_has_all_ecs`'s negated sibling for `Without<T>` -- does `sig` contain ANY of `excluded`?
// Used to drop an archetype from a system's own matching set entirely the moment it has even
// one of the components that system's own `Without<...>` params name.
fn sig_has_any_ecs(sig: &Vec<String>, excluded: &Vec<String>) -> Bool {
    var i = 0;
    while i < excluded.length() {
        if str_vec_index_of_ecs(sig, excluded.get(i)) != -1 { return true; }
        i = i + 1;
    }
    return false;
}

// Deterministic, collision-proof name for the real top-level fn a `system`'s own `run` block
// becomes -- shared by the synthesis below and the call-site builder right after it.
fn system_fn_name_ecs(sys_name: String) -> String {
    return "__system_" + sys_name + "_run";
}

// A system's own required component set, in declared-param order -- reads and writes both (a
// system's read/write SPLIT matters to `check_systems`'s own conflict analysis, not to which
// archetypes it needs to visit here). Includes query-filter pseudo-params too -- callers that
// need those excluded use `required_components_of_system_ecs` instead; this one is kept as-is
// since nothing outside the filter feature reads it.
fn component_names_of_system_ecs(run_params: &Vec<Param>) -> Vec<String> {
    var out = empty_str_vec4();
    var i = 0;
    while i < run_params.length() {
        out.push(run_params.get(i).type_name);
        i = i + 1;
    }
    return out;
}

// `Without<Component>` -- a query filter, not a component borrow (see `Checker.hotc`'s own
// `check_systems` header). Rides the existing generic type-name mono-name convention
// (`"Without$Transform"`), same as `Vec<Int>` -> `"Vec$Int"` -- no new AST/parser work needed.
fn is_without_filter_ecs(type_name: String) -> Bool {
    return is_mono_name_cg(type_name) && mono_base_cg(type_name) == "Without";
}

// `Changed<Component>` rides the same convention -- recognized here so `real_run_params_ecs`/
// `required_components_of_system_ecs` treat it consistently with `Without<T>`, even though
// `Checker.hotc`'s own `check_systems` currently rejects any real USE of it with a clear "not
// implemented yet" error before a program using one ever reaches this file at all (see that
// error's own header for why: real change-tracking runtime state doesn't exist yet).
fn is_changed_filter_ecs(type_name: String) -> Bool {
    return is_mono_name_cg(type_name) && mono_base_cg(type_name) == "Changed";
}

fn is_query_filter_param_ecs(type_name: String) -> Bool {
    return is_without_filter_ecs(type_name) || is_changed_filter_ecs(type_name);
}

// The REAL component-borrow params only -- excludes `Without<T>`/`Changed<T>` query-filter
// pseudo-params, which bind no real value at runtime (there's no archetype field backing
// either one). Used for the synthesized `run` fn's own signature (`synthesize_system_fn_ecs`)
// and for building its call-site arguments (`synthesize_system_call_stmt_ecs`) -- both need the
// filters gone, or codegen would try to resolve a nonexistent archetype field for one.
fn real_run_params_ecs(run_params: &Vec<Param>) -> Vec<Param> {
    var out = empty_param_vec2();
    var i = 0;
    while i < run_params.length() {
        let p = run_params.get(i);
        if !is_query_filter_param_ecs(p.type_name) {
            out.push(p);
        }
        i = i + 1;
    }
    return out;
}

// The component set an archetype must CONTAIN for `sysd` to visit it -- every ordinary
// component-borrow param's own type name, PLUS every `Changed<T>` filter's inner name (an
// archetype has to actually HAVE `T` for `T`'s own change-flag to exist at all) -- but NOT a
// `Without<T>` filter's inner name, which must be ABSENT instead (see `excluded_components_of_
// system_ecs`, right below `sig_has_any_ecs`), and NOT a resource-typed param either -- a
// resource is a single, world-wide value (fetched from a real top-level static, see
// `synthesize_system_call_stmts_ecs`), never a per-entity archetype field, so it must never make
// it into "what does an archetype need to have" at all. Real, disclosed scope cut: a system
// naming ONLY resource params (no real component borrow at all) still gets archetype-matched
// against `needed == []`, which is trivially true for every archetype that exists -- it would run
// once per ENTITY across every archetype rather than once per `run_all()` call, which is almost
// certainly not what a pure-resource ("global") system wants. Not a real, reachable shape yet
// (every system built so far pairs a resource with at least one real component), so left
// unguarded rather than designed around speculatively.
fn required_components_of_system_ecs(run_params: &Vec<Param>, resource_names: &Vec<String>) -> Vec<String> {
    var out = empty_str_vec4();
    var i = 0;
    while i < run_params.length() {
        let p = run_params.get(i);
        if is_changed_filter_ecs(p.type_name) {
            out.push(mono_arg_cg(p.type_name));
        } else if is_query_filter_param_ecs(p.type_name) {
            // Without<T> -- excluded above already, nothing to add here either.
        } else if str_vec_index_of_ecs(resource_names, p.type_name) != -1 {
            // A resource -- see this fn's own header.
        } else {
            out.push(p.type_name);
        }
        i = i + 1;
    }
    return out;
}

// Every component named by a `Without<T>` filter param on this system -- an archetype
// containing ANY of these is skipped entirely for this system, regardless of whether it also
// satisfies `required_components_of_system_ecs` (see `sig_has_any_ecs`, right below `sig_has_
// all_ecs`).
fn excluded_components_of_system_ecs(run_params: &Vec<Param>) -> Vec<String> {
    var out = empty_str_vec4();
    var i = 0;
    while i < run_params.length() {
        let p = run_params.get(i);
        if is_without_filter_ecs(p.type_name) {
            out.push(mono_arg_cg(p.type_name));
        }
        i = i + 1;
    }
    return out;
}

// Every component named by a `Changed<T>` filter param on this system -- a matching archetype's
// own per-row loop (`synthesize_system_call_stmts_ecs`) skips calling `run` for any row where
// even ONE of these components' own change-flag reads `false` this tick.
fn changed_components_of_system_ecs(run_params: &Vec<Param>) -> Vec<String> {
    var out = empty_str_vec4();
    var i = 0;
    while i < run_params.length() {
        let p = run_params.get(i);
        if is_changed_filter_ecs(p.type_name) {
            out.push(mono_arg_cg(p.type_name));
        }
        i = i + 1;
    }
    return out;
}

// A `system Name { fn run(...) { ... } }` becomes a real, plain, directly-callable top-level fn
// -- literally `sysd`'s own `run_params`/`run_body`, unchanged, just given a real name and no
// return type. `check_systems` only ever validated `run`'s PARAMS; feeding this into `compile_
// program`'s own ordinary `fns` pipeline (see that fn's own ECS section) is what actually
// type-checks `run`'s STATEMENTS for the first time.
// `real_run_params_ecs` strips any `Without<T>`/`Changed<T>` query-filter params before this
// becomes a real fn signature -- neither binds a real value (there's no archetype field backing
// a filter), so keeping one in the ACTUAL synthesized fn's param list would ask codegen to
// declare a JVM param of a type ("Without$Transform") that doesn't exist as a real class at all.
fn synthesize_system_fn_ecs(sysd: SystemDecl) -> FnDecl {
    return FnDecl { name: system_fn_name_ecs(sysd.name), params: real_run_params_ecs(&sysd.run_params), ret_type: none_string2(), body: sysd.run_body, type_param: none_string2(), type_bounds: empty_str_vec4(), self_is_mut: false, type_param2: none_string2(), type_bounds2: empty_str_vec4() };
}

// The real top-level static field name a `resource Name { ... }`'s own world-wide value lives
// in -- same `__`-prefixed, no-collision-with-user-declared-names convention `__next_entity_id`/
// `__world_pool` already use. Declared once per distinct resource TYPE actually named by any
// system's `run` params (`compile_program`'s own resource-field-declaration loop), regardless of
// how many systems read/write it -- there's only ever one value per resource type, program-wide.
fn resource_field_name_ecs(resource_name: String) -> String {
    return "__resource_" + resource_name;
}

// One call to a system's own synthesized `run` fn, reading every argument either straight off
// one row of ONE specific matching archetype (`<archetype>.c{idx}.get(<loop_var>)`, the ordinary
// per-entity component case) OR straight off a real top-level static (`__resource_<Name>`, see
// `resource_field_name_ecs`'s own header) for a resource-typed param -- the SAME static, read
// fresh on every call, for every row, since a resource is one world-wide value, not something an
// archetype row ever stores. PLUS -- right after the call -- one `<archetype>.c{idx}_changed.set
// (<loop_var>, true);` per REAL `&mut` COMPONENT param (see `archetype_field_changed_name_ecs`'s
// own header: writing through a `&mut` param is exactly the "changed" event this flag tracks) --
// a resource-typed `&mut` param never gets one, since `Changed<T>` change-tracking is a real,
// disclosed component-only feature; a resource has no per-row flag to set at all. `sig` is that
// specific archetype's own signature (already confirmed a superset of everything this system's
// own REAL component needs by `sig_has_all_ecs` -- resource params are never part of `sig` at
// all, see `required_components_of_system_ecs`'s own header), so `idx` -- looked up fresh per
// component param since two different archetypes matching the same system can place its
// components at different positions -- always resolves for those.
fn synthesize_system_call_stmts_ecs(sysd: &SystemDecl, sig: &Vec<String>, static_name: String, loop_var: String, resource_names: &Vec<String>) -> Vec<Stmt> {
    var call_args = empty_expr_vec_cg();
    let real_params = real_run_params_ecs(&sysd.run_params);
    var mark_stmts = empty_stmt_vec2();
    var pi = 0;
    while pi < real_params.length() {
        let p = real_params.get(pi);
        if str_vec_index_of_ecs(resource_names, p.type_name) != -1 {
            call_args.push(Ident { name: resource_field_name_ecs(p.type_name) });
        } else {
            let idx = str_vec_index_of_ecs(sig, p.type_name);
            let field_name = archetype_field_name_ecs(idx);
            let row_get = MethodCall { recv: FieldAccess { obj: Ident { name: static_name }, field: field_name }, method: "get", args: vec_of(Ident { name: loop_var }) };
            call_args.push(row_get);
            if p.is_mut_ref {
                var mark_args = vec_of(Ident { name: loop_var });
                mark_args.push(BoolLit { value: true });
                let mark = ExprStmt { expr: MethodCall { recv: FieldAccess { obj: Ident { name: static_name }, field: archetype_field_changed_name_ecs(idx) }, method: "set", args: mark_args }, line: 0 };
                mark_stmts.push(mark);
            }
        }
        pi = pi + 1;
    }
    var out = vec_of(ExprStmt { expr: Call { callee: system_fn_name_ecs(sysd.name), args: call_args }, line: 0 });
    var mi = 0;
    while mi < mark_stmts.length() { out.push(mark_stmts.get(mi)); mi = mi + 1; }
    return out;
}

// `for <loop_var> in 0..<archetype>.entities.length() { <call the system once per row, mark any
// &mut component changed> }` -- one per (system, matching archetype) pair, sequenced into `
// __world_run_all`'s own body by `build_run_all_body_ecs`, right below. When `sysd` has one or
// more `Changed<T>` filter params, the call+mark statements are wrapped in an `If` that ANDs
// together every filter's own `<archetype>.c{idx}_changed.get(<loop_var>)` check first -- a row
// where even one such flag reads `false` this tick is skipped entirely, never even calling
// `run`. `loop_idx` only exists to keep every such loop's own induction variable name distinct
// within the one, flat (never nested) `__world_run_all` body.
fn synthesize_archetype_loop_stmt_ecs(sysd: &SystemDecl, sig: &Vec<String>, loop_idx: Int, resource_names: &Vec<String>) -> Stmt {
    let static_name = archetype_static_name_ecs(sig);
    let loop_var = "__ecs_row" + JString::valueOf(loop_idx);
    let n_expr = MethodCall { recv: FieldAccess { obj: Ident { name: static_name }, field: "entities" }, method: "length", args: empty_expr_vec_cg() };
    let call_stmts = synthesize_system_call_stmts_ecs(sysd, sig, static_name, loop_var, resource_names);
    let changed_names = changed_components_of_system_ecs(&sysd.run_params);
    var body_stmts = empty_stmt_vec2();
    if changed_names.length() > 0 {
        var ci = 0;
        var cond = BoolLit { value: true };
        while ci < changed_names.length() {
            let idx = str_vec_index_of_ecs(sig, changed_names.get(ci));
            let flag_get = MethodCall { recv: FieldAccess { obj: Ident { name: static_name }, field: archetype_field_changed_name_ecs(idx) }, method: "get", args: vec_of(Ident { name: loop_var }) };
            if ci == 0 { cond = flag_get; } else { cond = Binary { op: "&&", left: cond, right: flag_get }; }
            ci = ci + 1;
        }
        body_stmts = vec_of(If { cond: cond, then_body: call_stmts, else_body: none_stmt_list_cg(), line: 0, narrow_name: "", narrow_is_eq: false });
    } else {
        body_stmts = call_stmts;
    }
    return For { var_name: loop_var, is_range: true, range_start: IntLit { value: 0 }, range_end: n_expr, inclusive: false, arr_expr: IntLit { value: 0 }, body: body_stmts, line: 0 };
}

// `system_name`'s own real query-iteration body -- one `For` loop (`synthesize_archetype_loop_
// stmt_ecs`, right above) per matching archetype in `archetype_signatures`, in that list's own
// declaration order (matches "Resolved decisions" #4's own declaration-order tie-break) -- plus
// a trailing `return "";` (see `synthesize_system_dispatch_fn_ecs`'s own header for why this
// whole thing is a real, separately-callable fn rather than being inlined straight into `
// __world_run_all` the way Phase A had it: Phase B's own `pool.spawn(...)` dispatch needs
// something with NO free variables to call, and a fn with zero params is exactly that).
// `@profile` -- see `ECS_IDEAS.md`'s own "Still open" #1 answer ("trivial once systems/
// scheduling exist"). Real, implemented: a profiled system's own dispatch fn (below) times
// itself with `System.nanoTime()` (via a synthesized `__ProfileClock` extern -- see
// `synthesize_profile_clock_extern_ecs`, only ever added to a program that actually has one)
// and prints "which system, whether it ran in a real parallel group (and how big), how long" --
// exactly the "which system touched what, did it run in parallel" structured event this doc's
// own header asked for, instead of a raw stack trace. Lives INSIDE the dispatch fn itself, not
// wrapped around the call SITE: a call site inside a size>1 group is a `pool.spawn(|| ... as
// PhoenixObject)` lambda whose own body is a single `Expr` (`Ast.hc`'s own `Lambda.body` header --
// no block-expr support), so there's nowhere to fit a "record start, call, record end, print" a
// SEQUENCE outside the dispatch fn itself; inside it, that's just an ordinary multi-statement
// `Vec<Stmt>` body, ordinary for either call shape.
fn any_system_profiled_ecs(systems: &Vec<SystemDecl>) -> Bool {
    var i = 0;
    while i < systems.length() {
        if systems.get(i).has_profile { return true; }
        i = i + 1;
    }
    return false;
}

// Which parallel-dispatch group (`checker.system_groups`) a given system landed in, by its own
// SIZE -- 1 means it runs directly (Phase A shape); >1 means it's real Phoenix-Flight-backed
// parallel dispatch (Phase B). Falls back to `1` if somehow not found (never happens for a real
// system name -- `check_systems` places every one of them into exactly one group).
fn group_size_for_system_ecs(groups: &Vec<Vec<String>>, name: String) -> Int {
    var gi = 0;
    while gi < groups.length() {
        let g = groups.get(gi);
        if str_vec_index_of_ecs(&g, name) != -1 { return g.length(); }
        gi = gi + 1;
    }
    return 1;
}

// The one real static method this profiler needs -- `java.lang.System.nanoTime()`, bound under
// a private, `__`-prefixed HC-level name so it never collides with (or needs) any REAL `System`
// extern the user's own program might separately declare. Only ever synthesized into a program
// that actually has at least one `@profile`-marked system (`any_system_profiled_ecs`'s own
// caller in `compile_program`) -- a program with none never pays for it at all.
fn synthesize_profile_clock_extern_ecs() -> ExternClassDecl {
    let m = ExternMethod { name: "nanoTime", params: empty_param_vec2(), ret_type: "Long", is_static: true, is_ctor: false };
    var fields = vec_of(ExternField { name: "_", type_name: "_", is_static: false });
    fields = Vec { data: fields.data, len: 0 };
    return ExternClassDecl { name: "__ProfileClock", binary_name: "java.lang.System", methods: vec_of(m), fields: fields, is_interface: false };
}

fn build_system_dispatch_body_ecs(sysd: &SystemDecl, archetype_signatures: &Vec<Vec<String>>, profiled: Bool, group_size: Int, resource_names: &Vec<String>) -> Vec<Stmt> {
    var body = empty_stmt_vec2();
    if profiled {
        let t0_call = StaticCall { type_name: "__ProfileClock", method: "nanoTime", args: empty_expr_vec_cg() };
        body.push(Let { name: "__prof_t0", mutable: false, init: t0_call, declared_type: none_string2(), line: 0 });
    }
    let needed = required_components_of_system_ecs(&sysd.run_params, resource_names);
    let excluded = excluded_components_of_system_ecs(&sysd.run_params);
    var loop_idx = 0;
    var ai = 0;
    while ai < archetype_signatures.length() {
        let sig = archetype_signatures.get(ai);
        // `Without<T>` (see `excluded_components_of_system_ecs`'s own header): an archetype
        // holding even one excluded component is skipped for this system entirely, regardless of
        // whether it also satisfies `needed`.
        if sig_has_all_ecs(&sig, &needed) && !sig_has_any_ecs(&sig, &excluded) {
            body.push(synthesize_archetype_loop_stmt_ecs(sysd, &sig, loop_idx, resource_names));
            loop_idx = loop_idx + 1;
        }
        ai = ai + 1;
    }
    if profiled {
        let t1_call = StaticCall { type_name: "__ProfileClock", method: "nanoTime", args: empty_expr_vec_cg() };
        let elapsed_ns = Binary { op: "-", left: t1_call, right: Ident { name: "__prof_t0" } };
        let ms_expr = Binary { op: "/", left: elapsed_ns, right: Cast { expr: IntLit { value: 1000000 }, target_type: "Long" } };
        var mode = "sequential";
        if group_size > 1 { mode = "parallel, group of " + JString::valueOf(group_size); }
        var literals = vec_of("profile: " + sysd.name + " (" + mode + ") took ");
        literals.push("ms");
        let msg = StringInterp { literals: literals, exprs: vec_of(ms_expr) };
        body.push(ExprStmt { expr: Call { callee: "print", args: vec_of(msg) }, line: 0 });
    }
    body.push(Return { value: some_expr_cg(StringLit { value: "" }), line: 0 });
    return body;
}

fn system_dispatch_fn_name_ecs(sys_name: String) -> String {
    return "__system_" + sys_name + "_dispatch";
}

// One real, plain, ZERO-PARAM top-level fn per `system` -- see `build_system_dispatch_body_ecs`'s
// own header for why zero params matters. Returns `String` (always `""`) rather than `Unit`
// purely so `world.run_all()`'s own Phase B codegen can hand this straight to `pool.spawn(|| ...
// as PhoenixObject)` (a real reference value to cast, mirroring `stdlib/phoenix.hotc`'s own
// documented `"{...}" as PhoenixObject` idiom) without needing a second wrapper fn just to
// manufacture one.
fn synthesize_system_dispatch_fn_ecs(sysd: &SystemDecl, archetype_signatures: &Vec<Vec<String>>, profiled: Bool, group_size: Int, resource_names: &Vec<String>) -> FnDecl {
    return FnDecl { name: system_dispatch_fn_name_ecs(sysd.name), params: empty_param_vec2(), ret_type: some_string2("String"), body: build_system_dispatch_body_ecs(sysd, archetype_signatures, profiled, group_size, resource_names), type_param: none_string2(), type_bounds: empty_str_vec4(), self_is_mut: false, type_param2: none_string2(), type_bounds2: empty_str_vec4() };
}

// `__world_run_all`'s own real body, Phase B (real parallel dispatch) -- see `ECS_IDEAS.md`'s
// own design doc. `groups` is `checker.system_groups`: each inner list is a set of systems ready
// to run in the SAME batch (mutually ready AND pairwise non-conflicting). A size-1 group is a
// direct call to that one system's own dispatch fn -- identical to Phase A's fully-sequential
// behavior, and still the ONLY shape most programs will ever actually need (two systems only
// land in the same group when the checker's OWN conflict analysis already proved neither can
// alias the other's mutable state, see `check_systems`'s own header). A size>1 group spawns
// every member's dispatch fn onto `__world_pool` (Phoenix Flight's real thread pool, synthesized
// alongside this fn only when at least one group actually needs it) and `.join()`s every one of
// them before the next group runs -- that `.join()` is also the real memory-visibility barrier
// making this SAFE under the JVM memory model: nothing in the NEXT group can see a stale value
// from a system this group's own threads wrote, because `Future.get()`'s own synchronization
// already established happens-before by the time every `.join()` here returns.
// `pool_size` is `max_group_size_ecs`'s own result -- 0 or 1 means no group ever needs more than
// one thread, so this whole fn skips the pool entirely (identical to Phase A's plain sequential
// body). When it's >1, a REAL `PhoenixPool` is created as a LOCAL (`__pool`), used by every
// multi-member group's dispatch, and explicitly `.shutdown()` at the very end of this same
// function -- deliberately NOT a program-wide static: `Executors.newFixedThreadPool`'s own
// worker threads are NOT daemon threads, so a pool that outlives this one call (a `pub static`,
// created once in `<clinit>` and never shut down) would keep the whole JVM process alive
// forever after `main()` returns -- a real, previously-hit hang caught testing this end to end.
// The real cost of this choice, disclosed: a fresh thread pool gets created and torn down on
// EVERY `world.run_all()` call, not just once -- a real, deferred performance concern (`ECS_IDEAS
// .md`'s own "Explicitly deferred" already tracks "archetype-transition performance work" in the
// same spirit; this joins it) rather than something this pass optimizes away.
// `groups.length() > 0` performance note (see `ECS_IDEAS.md`'s own "Phase B" writeup for the
// full history): an EARLIER version of this fn created a fresh `PhoenixPool` local to every
// single call and shut it down at the end -- correct, but recreating/tearing down a real thread
// pool on every `world.run_all()` call is real, avoidable overhead once a program calls it in a
// tight loop. This version instead references `__world_pool`, a REAL top-level static
// (synthesized once, alongside this fn, only when `pool_size > 1` -- see `compile_program`'s own
// ECS section) that's REUSED across every call. The real, disclosed cost of reuse: nothing
// inside `world.run_all()` itself can shut the pool down anymore (it might be called again),
// so it's now on the PROGRAM to call `world.shutdown()` once, near the end -- exactly the same
// "you must call this or the process never exits" contract `PhoenixPool::shutdown()` already
// puts on ordinary Phoenix Flight callers (see `finish_method_call`'s own `World#shutdown`
// branch, and `__world_shutdown`'s own header, right below).
// `Changed<T>`'s own tick boundary: reset EVERY archetype's EVERY component's own change-flag
// Vec to `false`, one per-element loop per (archetype, component) pair -- there's no `Vec::fill`,
// so this is the same "ordinary `For` loop over `.length()`, `.set(i, ...)` each element" shape
// every other per-row ECS codegen in this file already uses. Prepended to `__world_run_all`'s
// own body right AFTER the queued add/remove flush and right BEFORE any system actually
// dispatches this tick -- a real, disclosed consequence of that ordering: a row's own flush-time
// "just added"/"just moved-into" flag (set `true` by `build_move_stmts_ecs`'s own "Changed<T>"
// carry-over) is wiped out by THIS SAME reset before any system ever sees it, so `Changed<T>`
// never reports "just transitioned via `world.add`/`world.remove` this tick" -- only "written by
// an earlier-SCHEDULED `&mut`-taking system this same tick." See `Checker.hotc`'s own `check_
// systems` "Changed<Component>" branch for the full, disclosed tick-boundary consequence this
// establishes.
fn build_reset_changed_stmts_ecs(archetype_signatures: &Vec<Vec<String>>) -> Vec<Stmt> {
    var stmts = empty_stmt_vec2();
    var ai = 0;
    while ai < archetype_signatures.length() {
        let sig = archetype_signatures.get(ai);
        let static_name = archetype_static_name_ecs(&sig);
        var ci = 0;
        while ci < sig.length() {
            let field_name = archetype_field_changed_name_ecs(ci);
            let loop_var = "__ecs_clear" + JString::valueOf(ai) + "_" + JString::valueOf(ci);
            let n_expr = MethodCall { recv: FieldAccess { obj: Ident { name: static_name }, field: field_name }, method: "length", args: empty_expr_vec_cg() };
            var set_args = vec_of(Ident { name: loop_var });
            set_args.push(BoolLit { value: false });
            let set_stmt = ExprStmt { expr: MethodCall { recv: FieldAccess { obj: Ident { name: static_name }, field: field_name }, method: "set", args: set_args }, line: 0 };
            stmts.push(For { var_name: loop_var, is_range: true, range_start: IntLit { value: 0 }, range_end: n_expr, inclusive: false, arr_expr: IntLit { value: 0 }, body: vec_of(set_stmt), line: 0 });
            ci = ci + 1;
        }
        ai = ai + 1;
    }
    return stmts;
}

fn build_run_all_body_ecs(groups: &Vec<Vec<String>>) -> Vec<Stmt> {
    var body = empty_stmt_vec2();
    var gi = 0;
    while gi < groups.length() {
        let group = groups.get(gi);
        if group.length() == 1 {
            let sys_name = group.get(0);
            body.push(ExprStmt { expr: Call { callee: system_dispatch_fn_name_ecs(sys_name), args: empty_expr_vec_cg() }, line: 0 });
        } else {
            var task_names = empty_str_vec4();
            var mi = 0;
            while mi < group.length() {
                let sys_name2 = group.get(mi);
                let task_name = "__ecs_task" + JString::valueOf(gi) + "_" + JString::valueOf(mi);
                let dispatch_call = Call { callee: system_dispatch_fn_name_ecs(sys_name2), args: empty_expr_vec_cg() };
                let lambda = Lambda { params: empty_str_vec4(), body: Cast { expr: dispatch_call, target_type: "PhoenixObject" } };
                let spawn_call = MethodCall { recv: Ident { name: "__world_pool" }, method: "spawn", args: vec_of(lambda) };
                body.push(Let { name: task_name, mutable: false, init: spawn_call, declared_type: none_string2(), line: 0 });
                task_names.push(task_name);
                mi = mi + 1;
            }
            var ji = 0;
            while ji < task_names.length() {
                body.push(ExprStmt { expr: MethodCall { recv: Ident { name: task_names.get(ji) }, method: "join", args: empty_expr_vec_cg() }, line: 0 });
                ji = ji + 1;
            }
        }
        gi = gi + 1;
    }
    return body;
}

// `__world_shutdown` -- a real, plain, zero-param fn (`world.shutdown()`'s own thin forward, same
// shape as `run_all`'s) that shuts `__world_pool` down for real, IF it exists (`pool_size > 1`)
// -- an empty body, a genuine no-op, otherwise. Whether `__world_pool` exists at all is a
// COMPILE-TIME fact (a static field either got declared on the class or it didn't), so this
// decision has to be made here, at SYNTHESIS time, not as a runtime branch inside the fn body.
fn build_world_shutdown_body_ecs(pool_size: Int) -> Vec<Stmt> {
    var body = empty_stmt_vec2();
    if pool_size > 1 {
        body.push(ExprStmt { expr: MethodCall { recv: Ident { name: "__world_pool" }, method: "shutdown", args: empty_expr_vec_cg() }, line: 0 });
    }
    return body;
}

// The most parallel work any single group ever asks for -- `__world_pool`'s own real thread
// count, synthesized to be exactly wide enough for the widest batch (no wasted idle
// threads, no batch that has to queue and wait for a slot inside itself).
fn max_group_size_ecs(groups: &Vec<Vec<String>>) -> Int {
    var m = 0;
    var i = 0;
    while i < groups.length() {
        let g = groups.get(i);
        if g.length() > m { m = g.length(); }
        i = i + 1;
    }
    return m;
}

// Archetype-transition mechanics -- see `ECS_IDEAS.md`'s own "Archetype-transition mechanics"
// design section. `world.add(entity, Component { ... })`/`world.remove(entity, Component)` move
// an already-spawned entity's row between archetypes for real (evacuate the old row via swap-
// with-last + pop, populate a new row in the target archetype, fix up whichever entity got
// swapped into the vacated slot) -- built entirely from synthesized `Ast.hc` (loops/ifs/method
// calls), same "materialize real AST, reuse existing codegen" pattern `world.run_all()`'s own
// dispatcher already used, so no new hand-written bytecode is needed for the MOVE logic itself
// (only the thin `world.add`/`world.remove` call-site forward, mirroring `world.run_all()`'s).
//
// The full set of archetypes a program can ever need isn't just what `world.spawn(...)` builds
// directly -- `world.add`/`world.remove` can move an entity into a signature nothing ever
// spawned into. `archetype_closure_ecs` computes the real closure: starting from every spawned
// signature, repeatedly adding "signature + a type ever added" and "signature - a type ever
// removed" (whenever applicable) until nothing new appears -- bounded by 2^(distinct component
// count), fine for any realistic program.

// Exact, order-sensitive `Vec<String>` equality -- `Checker.hotc`'s own `str_vec_eq_ecs` has an
// identical twin; duplicated independently here for the same reason every other `_ecs`/`_cg`-
// suffixed helper in this file already is (`Codegen.hotc` doesn't share Checker's registries).
fn str_vec_eq_ecs2(a: &Vec<String>, b: &Vec<String>) -> Bool {
    if a.length() != b.length() { return false; }
    var i = 0;
    while i < a.length() {
        if a.get(i) != b.get(i) { return false; }
        i = i + 1;
    }
    return true;
}

// The first index of a signature matching `sig` (exact, order-sensitive) in `list`, or `-1`.
fn sig_list_index_of_ecs(list: &Vec<Vec<String>>, sig: &Vec<String>) -> Int {
    var i = 0;
    while i < list.length() {
        let e = list.get(i);
        if str_vec_eq_ecs2(&e, sig) { return i; }
        i = i + 1;
    }
    return -1;
}

fn sig_list_contains_ecs(list: &Vec<Vec<String>>, sig: &Vec<String>) -> Bool {
    return sig_list_index_of_ecs(list, sig) != -1;
}

// `v` with `s` appended -- the "add a component" target signature (always appended at the end,
// a real, disclosed convention: an entity that reaches the same target component SET via a
// DIFFERENT add order still lands in a DIFFERENT archetype, same imprecision `world.spawn(...)`'s
// own signature-is-order-sensitive design already accepts).
fn str_vec_with_ecs(v: &Vec<String>, s: String) -> Vec<String> {
    var out = empty_str_vec4();
    var i = 0;
    while i < v.length() {
        out.push(v.get(i));
        i = i + 1;
    }
    out.push(s);
    return out;
}

// `v` with every occurrence of `s` removed, order otherwise preserved -- the "remove a
// component" target signature.
fn str_vec_without_ecs(v: &Vec<String>, s: String) -> Vec<String> {
    var out = empty_str_vec4();
    var i = 0;
    while i < v.length() {
        let e = v.get(i);
        if e != s { out.push(e); }
        i = i + 1;
    }
    return out;
}

fn archetype_closure_ecs(base: &Vec<Vec<String>>, add_types: &Vec<String>, remove_types: &Vec<String>) -> Vec<Vec<String>> {
    var out = empty_str_vec_vec();
    var bi = 0;
    while bi < base.length() {
        out.push(base.get(bi));
        bi = bi + 1;
    }
    var changed = true;
    while changed {
        changed = false;
        let cur_len = out.length();
        var oi = 0;
        while oi < cur_len {
            let sig = out.get(oi);
            var ai = 0;
            while ai < add_types.length() {
                let t = add_types.get(ai);
                if str_vec_index_of_ecs(&sig, t) == -1 {
                    let cand = str_vec_with_ecs(&sig, t);
                    if !sig_list_contains_ecs(&out, &cand) {
                        out.push(cand);
                        changed = true;
                    }
                }
                ai = ai + 1;
            }
            var ri = 0;
            while ri < remove_types.length() {
                let t2 = remove_types.get(ri);
                if str_vec_index_of_ecs(&sig, t2) != -1 {
                    let cand2 = str_vec_without_ecs(&sig, t2);
                    if !sig_list_contains_ecs(&out, &cand2) {
                        out.push(cand2);
                        changed = true;
                    }
                }
                ri = ri + 1;
            }
            oi = oi + 1;
        }
    }
    return out;
}

// The REAL mover -- internal-only (see "Queued archetype transitions", right above `compile_
// program`, for why `world.add`/`world.remove` no longer call this directly).
fn apply_fn_name_ecs(comp_type: String, is_add: Bool) -> String {
    if is_add { return "__world_apply_add_" + comp_type; }
    return "__world_apply_remove_" + comp_type;
}

// `world.add`/`world.remove`'s own real forward target -- unchanged name from before queuing
// existed (`Codegen.hotc`'s own `finish_method_call` branches construct this exact string), but
// now points at a QUEUEING fn (`synthesize_queue_add_fn_ecs`/`synthesize_queue_remove_fn_ecs`)
// instead of the mover directly.
fn queue_fn_name_ecs(comp_type: String, is_add: Bool) -> String {
    if is_add { return "__world_add_" + comp_type; }
    return "__world_remove_" + comp_type;
}

fn pending_add_entities_name_ecs(comp_type: String) -> String {
    return "__pending_add_" + comp_type + "_entities";
}

fn pending_add_values_name_ecs(comp_type: String) -> String {
    return "__pending_add_" + comp_type + "_values";
}

fn pending_remove_entities_name_ecs(comp_type: String) -> String {
    return "__pending_remove_" + comp_type + "_entities";
}

// One real move, source archetype `src_sig` (own id `src_id`) to target `dst_sig` (own id
// `dst_id`) -- see this whole section's own header for the shape (evacuate `src_sig`'s row via
// swap-with-last + pop on every one of its own fields, populate a fresh row in `dst_sig` sourcing
// every SHARED component from the just-read old row, plus `__value` for the newly added one when
// `is_add`). Building blocks are plain `Vec$<T>` method calls (`.get`/`.set`/`.pop`/`.push`/
// `.length`) -- ordinary generic calls the ORDINARY check/codegen pipeline already knows how to
// monomorphize, nothing bespoke needed here at all.
fn build_move_stmts_ecs(src_sig: &Vec<String>, dst_sig: &Vec<String>, src_id: Int, dst_id: Int, is_add: Bool) -> Vec<Stmt> {
    let src_static = archetype_static_name_ecs(src_sig);
    let dst_static = archetype_static_name_ecs(dst_sig);
    var stmts = empty_stmt_vec2();
    stmts.push(Let { name: "__row", mutable: false, init: MethodCall { recv: Ident { name: "__entity_row" }, method: "get", args: vec_of(Ident { name: "__entity" }) }, declared_type: none_string2(), line: 0 });
    var last_args = empty_expr_vec_cg();
    stmts.push(Let { name: "__last", mutable: false, init: Binary { op: "-", left: MethodCall { recv: FieldAccess { obj: Ident { name: src_static }, field: "entities" }, method: "length", args: last_args }, right: IntLit { value: 1 } }, declared_type: none_string2(), line: 0 });
    stmts.push(Let { name: "__moved", mutable: false, init: MethodCall { recv: FieldAccess { obj: Ident { name: src_static }, field: "entities" }, method: "get", args: vec_of(Ident { name: "__last" }) }, declared_type: none_string2(), line: 0 });
    stmts.push(ExprStmt { expr: MethodCall { recv: FieldAccess { obj: Ident { name: dst_static }, field: "entities" }, method: "push", args: vec_of(Ident { name: "__entity" }) }, line: 0 });
    var j = 0;
    while j < dst_sig.length() {
        let fname = dst_sig.get(j);
        var value_expr = Ident { name: "__value" };
        // `Changed<T>`'s own backing flag, carried along with the value itself: the newly ADDED
        // component (the `is_add && j == last` case, no source row to read from) always reads as
        // freshly changed; every SHARED component carries over whatever `__row`'s own flag
        // already was in the source archetype -- moving archetypes doesn't change a value, so it
        // shouldn't manufacture a false "changed" reading for data that didn't actually change.
        var changed_expr = BoolLit { value: true };
        if !(is_add && j == dst_sig.length() - 1) {
            let src_idx = str_vec_index_of_ecs(src_sig, fname);
            value_expr = MethodCall { recv: FieldAccess { obj: Ident { name: src_static }, field: archetype_field_name_ecs(src_idx) }, method: "get", args: vec_of(Ident { name: "__row" }) };
            changed_expr = MethodCall { recv: FieldAccess { obj: Ident { name: src_static }, field: archetype_field_changed_name_ecs(src_idx) }, method: "get", args: vec_of(Ident { name: "__row" }) };
        }
        stmts.push(ExprStmt { expr: MethodCall { recv: FieldAccess { obj: Ident { name: dst_static }, field: archetype_field_name_ecs(j) }, method: "push", args: vec_of(value_expr) }, line: 0 });
        stmts.push(ExprStmt { expr: MethodCall { recv: FieldAccess { obj: Ident { name: dst_static }, field: archetype_field_changed_name_ecs(j) }, method: "push", args: vec_of(changed_expr) }, line: 0 });
        j = j + 1;
    }
    var set_args = vec_of(Ident { name: "__row" });
    set_args.push(Ident { name: "__moved" });
    stmts.push(ExprStmt { expr: MethodCall { recv: FieldAccess { obj: Ident { name: src_static }, field: "entities" }, method: "set", args: set_args }, line: 0 });
    stmts.push(ExprStmt { expr: MethodCall { recv: FieldAccess { obj: Ident { name: src_static }, field: "entities" }, method: "pop", args: empty_expr_vec_cg() }, line: 0 });
    var k = 0;
    while k < src_sig.length() {
        let src_field = archetype_field_name_ecs(k);
        let get_last = MethodCall { recv: FieldAccess { obj: Ident { name: src_static }, field: src_field }, method: "get", args: vec_of(Ident { name: "__last" }) };
        var kset_args = vec_of(Ident { name: "__row" });
        kset_args.push(get_last);
        stmts.push(ExprStmt { expr: MethodCall { recv: FieldAccess { obj: Ident { name: src_static }, field: src_field }, method: "set", args: kset_args }, line: 0 });
        stmts.push(ExprStmt { expr: MethodCall { recv: FieldAccess { obj: Ident { name: src_static }, field: src_field }, method: "pop", args: empty_expr_vec_cg() }, line: 0 });
        // Same swap-with-last + pop eviction, mirrored onto the changed-flag Vec so it always
        // stays row-aligned with its own component Vec (the swapped-in entity's OWN flag must
        // move with it, exactly like its data already does above).
        let src_field_changed = archetype_field_changed_name_ecs(k);
        let get_last_changed = MethodCall { recv: FieldAccess { obj: Ident { name: src_static }, field: src_field_changed }, method: "get", args: vec_of(Ident { name: "__last" }) };
        var kset_changed_args = vec_of(Ident { name: "__row" });
        kset_changed_args.push(get_last_changed);
        stmts.push(ExprStmt { expr: MethodCall { recv: FieldAccess { obj: Ident { name: src_static }, field: src_field_changed }, method: "set", args: kset_changed_args }, line: 0 });
        stmts.push(ExprStmt { expr: MethodCall { recv: FieldAccess { obj: Ident { name: src_static }, field: src_field_changed }, method: "pop", args: empty_expr_vec_cg() }, line: 0 });
        k = k + 1;
    }
    var moved_row_args = vec_of(Ident { name: "__moved" });
    moved_row_args.push(Ident { name: "__row" });
    stmts.push(ExprStmt { expr: MethodCall { recv: Ident { name: "__entity_row" }, method: "set", args: moved_row_args }, line: 0 });
    var arch_id_args = vec_of(Ident { name: "__entity" });
    arch_id_args.push(IntLit { value: dst_id });
    stmts.push(ExprStmt { expr: MethodCall { recv: Ident { name: "__entity_archetype_id" }, method: "set", args: arch_id_args }, line: 0 });
    let new_row_expr = Binary { op: "-", left: MethodCall { recv: FieldAccess { obj: Ident { name: dst_static }, field: "entities" }, method: "length", args: empty_expr_vec_cg() }, right: IntLit { value: 1 } };
    var new_row_args = vec_of(Ident { name: "__entity" });
    new_row_args.push(new_row_expr);
    stmts.push(ExprStmt { expr: MethodCall { recv: Ident { name: "__entity_row" }, method: "set", args: new_row_args }, line: 0 });
    return stmts;
}

// Queued archetype transitions -- see `ECS_IDEAS.md`'s own "Archetype-move mechanics" open
// question, resolved here: applying `world.add`/`world.remove` IMMEDIATELY is unsafe when called
// from inside a system's own `run` body mid-`world.run_all()` (it would mutate an archetype's
// own arrays while THAT SAME call is iterating them, the classic "don't mutate a collection
// you're iterating" hazard). Fixed by making `world.add`/`world.remove` QUEUE the request
// instead of applying it -- the real move only ever happens at the START of the NEXT `world.
// run_all()` call, before any system runs (`build_flush_transitions_stmts_ecs`, prepended to
// `__world_run_all`'s own body). A real, disclosed consequence: a queued transition that's never
// followed by another `world.run_all()` call simply never takes effect -- same as any ECS with a
// deferred-transition sync point. Doesn't change observable behavior for the common case (`add`/
// `remove` called between `run_all()` calls, from ordinary code, not from inside a system) --
// the transition is still fully visible by the time the VERY NEXT `run_all()`'s own systems run,
// exactly as before.
//
// `__world_apply_add_<Component>(entity: Int, value: Component)`/`__world_apply_remove_
// <Component>(entity: Int)` -- one real, plain top-level fn per component type ever added/
// removed anywhere in the program, dispatching on the entity's own CURRENT archetype (`__entity_
// archetype_id.get(entity)`, a runtime value -- there's no way to know which archetype a given
// call site's entity is in at COMPILE time in general) via one `If` per compatible source
// archetype in `closed_sigs`. Called only by the flush logic now, never directly by `world.add`/
// `world.remove` (see this section's own header just above).
fn synthesize_transition_fn_ecs(comp_type: String, is_add: Bool, closed_sigs: &Vec<Vec<String>>) -> FnDecl {
    var params = empty_param_vec2();
    params.push(Param { name: "__entity", type_name: "Int", is_ref: false, is_mut_ref: false });
    if is_add {
        params.push(Param { name: "__value", type_name: comp_type, is_ref: false, is_mut_ref: false });
    }
    var body = empty_stmt_vec2();
    var si = 0;
    while si < closed_sigs.length() {
        let src_sig = closed_sigs.get(si);
        let has_comp = str_vec_index_of_ecs(&src_sig, comp_type) != -1;
        var applies = false;
        if is_add && !has_comp { applies = true; }
        if !is_add && has_comp { applies = true; }
        if applies {
            var dst_sig = str_vec_with_ecs(&src_sig, comp_type);
            if !is_add { dst_sig = str_vec_without_ecs(&src_sig, comp_type); }
            let dst_id = sig_list_index_of_ecs(closed_sigs, &dst_sig);
            if dst_id != -1 {
                let cond = Binary { op: "==", left: MethodCall { recv: Ident { name: "__entity_archetype_id" }, method: "get", args: vec_of(Ident { name: "__entity" }) }, right: IntLit { value: si } };
                let branch_body = build_move_stmts_ecs(&src_sig, &dst_sig, si, dst_id, is_add);
                body.push(If { cond: cond, then_body: branch_body, else_body: none_stmt_list_cg(), line: 0, narrow_name: "", narrow_is_eq: false });
            }
        }
        si = si + 1;
    }
    return FnDecl { name: apply_fn_name_ecs(comp_type, is_add), params: params, ret_type: none_string2(), body: body, type_param: none_string2(), type_bounds: empty_str_vec4(), self_is_mut: false, type_param2: none_string2(), type_bounds2: empty_str_vec4() };
}

// `world.add(entity, Value { ... })`'s own real forward target -- just enqueues (see this
// whole section's own header for why), pushing onto `__pending_add_<Component>_entities`/
// `_values` in lockstep. The real move happens later, in `build_flush_transitions_stmts_ecs`.
// A fresh `[__entity: Int, __value: <comp_type>]` param list -- called several times per add
// type (once per registration call PLUS once for the real `FnDecl`, since `param_types_of`/
// `param_names_of`/`param_is_ref_of`/`param_is_mut_ref_of` all take `Vec<Param>` BY VALUE, same
// "fresh copy per use" requirement every other synthesized param list in this file already has).
fn queue_add_params_ecs(comp_type: String) -> Vec<Param> {
    var params = empty_param_vec2();
    params.push(Param { name: "__entity", type_name: "Int", is_ref: false, is_mut_ref: false });
    params.push(Param { name: "__value", type_name: comp_type, is_ref: false, is_mut_ref: false });
    return params;
}

fn synthesize_queue_add_fn_ecs(comp_type: String) -> FnDecl {
    var params = queue_add_params_ecs(comp_type);
    var body = empty_stmt_vec2();
    body.push(ExprStmt { expr: MethodCall { recv: Ident { name: pending_add_entities_name_ecs(comp_type) }, method: "push", args: vec_of(Ident { name: "__entity" }) }, line: 0 });
    body.push(ExprStmt { expr: MethodCall { recv: Ident { name: pending_add_values_name_ecs(comp_type) }, method: "push", args: vec_of(Ident { name: "__value" }) }, line: 0 });
    return FnDecl { name: queue_fn_name_ecs(comp_type, true), params: params, ret_type: none_string2(), body: body, type_param: none_string2(), type_bounds: empty_str_vec4(), self_is_mut: false, type_param2: none_string2(), type_bounds2: empty_str_vec4() };
}

// `world.remove(entity, Value)`'s own real forward target -- the `synthesize_queue_add_fn_ecs`
// sibling, minus a value to carry (there's nothing to push but the entity id).
fn queue_remove_params_ecs() -> Vec<Param> {
    var params = empty_param_vec2();
    params.push(Param { name: "__entity", type_name: "Int", is_ref: false, is_mut_ref: false });
    return params;
}

fn synthesize_queue_remove_fn_ecs(comp_type: String) -> FnDecl {
    var params = queue_remove_params_ecs();
    var body = empty_stmt_vec2();
    body.push(ExprStmt { expr: MethodCall { recv: Ident { name: pending_remove_entities_name_ecs(comp_type) }, method: "push", args: vec_of(Ident { name: "__entity" }) }, line: 0 });
    return FnDecl { name: queue_fn_name_ecs(comp_type, false), params: params, ret_type: none_string2(), body: body, type_param: none_string2(), type_bounds: empty_str_vec4(), self_is_mut: false, type_param2: none_string2(), type_bounds2: empty_str_vec4() };
}

// Prepended to `__world_run_all`'s own body (see `compile_program`'s own ECS section) -- one
// `For` loop per queued add/remove type, draining `__pending_add_<T>_entities`/`_values` (or
// `__pending_remove_<T>_entities`) into a real call to `__world_apply_add_<T>`/`__world_apply_
// remove_<T>`, then resetting each pending `Vec` back to empty via `Vec::clear()` (`stdlib/
// vec.hotc`'s own new method -- a real, previously-hit gap: a bare `pending.len = 0;` field
// assignment here was REJECTED by Phase 3's own borrow checker, which only recognizes a direct
// field assignment's receiver as mutable when it's a `var` local, an `&mut`-borrowed param, or
// `&mut self` -- never a top-level `pub static`, even though calling a real `&mut self` METHOD
// on one, like `.push()`/`.pop()` already do throughout this whole feature, works fine).
fn build_flush_transitions_stmts_ecs(add_types: &Vec<String>, remove_types: &Vec<String>) -> Vec<Stmt> {
    var body = empty_stmt_vec2();
    var loop_idx = 0;
    var ai = 0;
    while ai < add_types.length() {
        let t = add_types.get(ai);
        let entities_name = pending_add_entities_name_ecs(t);
        let values_name = pending_add_values_name_ecs(t);
        let loop_var = "__flush_i" + JString::valueOf(loop_idx);
        loop_idx = loop_idx + 1;
        let n_expr = MethodCall { recv: Ident { name: entities_name }, method: "length", args: empty_expr_vec_cg() };
        var call_args = vec_of(MethodCall { recv: Ident { name: entities_name }, method: "get", args: vec_of(Ident { name: loop_var }) });
        call_args.push(MethodCall { recv: Ident { name: values_name }, method: "get", args: vec_of(Ident { name: loop_var }) });
        let call_stmt = ExprStmt { expr: Call { callee: apply_fn_name_ecs(t, true), args: call_args }, line: 0 };
        body.push(For { var_name: loop_var, is_range: true, range_start: IntLit { value: 0 }, range_end: n_expr, inclusive: false, arr_expr: IntLit { value: 0 }, body: vec_of(call_stmt), line: 0 });
        body.push(ExprStmt { expr: MethodCall { recv: Ident { name: entities_name }, method: "clear", args: empty_expr_vec_cg() }, line: 0 });
        body.push(ExprStmt { expr: MethodCall { recv: Ident { name: values_name }, method: "clear", args: empty_expr_vec_cg() }, line: 0 });
        ai = ai + 1;
    }
    var ri = 0;
    while ri < remove_types.length() {
        let t2 = remove_types.get(ri);
        let entities_name2 = pending_remove_entities_name_ecs(t2);
        let loop_var2 = "__flush_i" + JString::valueOf(loop_idx);
        loop_idx = loop_idx + 1;
        let n_expr2 = MethodCall { recv: Ident { name: entities_name2 }, method: "length", args: empty_expr_vec_cg() };
        let get_expr2 = MethodCall { recv: Ident { name: entities_name2 }, method: "get", args: vec_of(Ident { name: loop_var2 }) };
        let call_stmt2 = ExprStmt { expr: Call { callee: apply_fn_name_ecs(t2, false), args: vec_of(get_expr2) }, line: 0 };
        body.push(For { var_name: loop_var2, is_range: true, range_start: IntLit { value: 0 }, range_end: n_expr2, inclusive: false, arr_expr: IntLit { value: 0 }, body: vec_of(call_stmt2), line: 0 });
        body.push(ExprStmt { expr: MethodCall { recv: Ident { name: entities_name2 }, method: "clear", args: empty_expr_vec_cg() }, line: 0 });
        ri = ri + 1;
    }
    return body;
}

pub fn compile_program(fns: Vec<FnDecl>, structs: Vec<StructDecl>, impls: Vec<ImplDecl>, enums: Vec<EnumDecl>, externs: Vec<ExternClassDecl>, statics: Vec<StaticDecl>, interfaces: Vec<InterfaceDecl>, binary_name: String, entry_name: String, entry_args: Vec<Int>, out_path: String, struct_annotation_names: Vec<String>, struct_annotation_data: Vec<Annotation>, fn_annotation_names: Vec<String>, fn_annotation_data: Vec<Annotation>, extend_decls: Vec<ExtendDecl>, must_use_fn_names: Vec<String>, struct_doc_names: Vec<String>, struct_doc_data: Vec<DocComment>, fn_doc_names: Vec<String>, fn_doc_data: Vec<DocComment>, sendable_struct_names: Vec<String>, components: Vec<ComponentDecl>, systems: Vec<SystemDecl>, target: Int, explain_schedule: Bool, classpath: Vec<String>, resources: Vec<ComponentDecl>) -> Vec<String> {
    // `arena struct` -- see README's own "Off-heap data" section: built on `java.lang.foreign`,
    // stable only since JDK 22 (still preview at 21). Gated at `25` -- the only discrete
    // `--target` level this compiler actually has (17/21/25, no "22") that's genuinely >= 22 --
    // rather than inventing a new target value just for this one feature. A real, previously-
    // hit gap this closes: `arena struct` wasn't gated by `--target` AT ALL before this -- a
    // `--target 17`/`--target 21` compile happily accepted it and produced a program that
    // crashes at RUNTIME with `NoClassDefFoundError: java.lang.foreign.Arena` on exactly the JDK
    // it was told to target, instead of failing loudly at COMPILE time the way `--target`'s
    // whole point is to guarantee.
    var arena_gate_errors = empty_str_vec4();
    var agi = 0;
    while agi < structs.length() {
        let ags = structs.get(agi);
        if ags.is_arena && target < 25 {
            arena_gate_errors.push("'arena struct " + ags.name + "' needs java.lang.foreign, stable only since JDK 22 -- compile with --target 25 (java.lang.foreign is still preview on JDK 21, and this compiler's own --target levels are 17/21/25, not 22)");
        }
        agi = agi + 1;
    }
    if arena_gate_errors.length() > 0 {
        return arena_gate_errors;
    }
    var fns = merge_fn_decl_vec_cg(fns, materialize_extend_fns(extend_decls, &structs, &interfaces));
    var checker = checker_new();
    var mui = 0;
    while mui < must_use_fn_names.length() {
        let mu_name = must_use_fn_names.get(mui);
        checker.must_use_fns.register(mu_name, true);
        // `@must_use` on a `Unit`-returning fn has nothing to enforce -- a real, loud compile
        // error rather than a silent no-op (same "catch the mistake, don't just ignore it" spirit
        // `check_extern_static_field_get`'s own unknown-field error already has).
        var muj = 0;
        while muj < fns.length() {
            let mu_fd = fns.get(muj);
            if mu_fd.name == mu_name {
                let mu_ret = opt_string_or(mu_fd.ret_type, "Unit");
                if mu_ret == "Unit" {
                    checker.errors.push("'@must_use' on '" + mu_name + "' has nothing to enforce -- it returns Unit");
                }
            }
            muj = muj + 1;
        }
        mui = mui + 1;
    }
    let sn = structs.length();
    var si0 = 0;
    while si0 < sn {
        let sd = structs.get(si0);
        checker.register_struct(sd.name, sd.type_param, sd.fields, sd.is_arena, sd.super_class, sd.type_param2);
        si0 = si0 + 1;
    }
    // ECS with ownership-derived scheduling -- see `ECS_IDEAS.md`'s own design doc. Components
    // register before systems (a system's own `run` params get checked against them); the whole
    // pass (`check_systems`) runs right after, since it needs every component AND every system
    // registered first (an `@after`/`@before` target can be declared later in the same file).
    let cn = components.length();
    var ci0 = 0;
    while ci0 < cn {
        let cd = components.get(ci0);
        let cd2 = components.get(ci0); // fresh copy -- `.fields` is only safe to read once
        checker.register_component(cd.name, cd.fields);
        // `register_component` already taught the CHECKER's own `self.structs` registry about
        // this component's fields (same registry `register_struct` uses) -- but `Codegen.hotc`'s
        // OWN, separate `struct_fields`/`struct_ftypes` (populated from the `structs: Vec<
        // StructDecl>` list below via `build_program_info`, not from anything the checker tracks)
        // never hears about a `ComponentDecl` at all, since it's a different AST node entirely.
        // A real, previously-hit gap: a system's own `run` body reading/writing a component field
        // (`transforms.x = ...`) type-checked fine but crashed CODEGEN ("unknown field 'x' on
        // struct 'Transform'") the first time `world.spawn(...)`/`world.run_all()` were actually
        // exercised end-to-end. Fixed the same way archetype storage itself is -- synthesizing a
        // real, plain `StructDecl` (no methods, no type param) and letting it flow through the
        // ORDINARY struct-registration/codegen pipeline like any other.
        structs.push(StructDecl { name: cd2.name, type_param: none_string2(), fields: cd2.fields, is_arena: false, module_name: none_string2(), super_class: none_string2(), type_param2: none_string2() });
        ci0 = ci0 + 1;
    }
    // Same "register, then synthesize a real `StructDecl` so its fields flow through the
    // ordinary struct codegen pipeline" shape components use right above, for `resource Name
    // { ... }` -- into `checker.resources`, NOT `checker.components` (see that registry's own
    // header for why the two must stay separate).
    let rn0 = resources.length();
    var ri0 = 0;
    while ri0 < rn0 {
        let rd = resources.get(ri0);
        let rd2 = resources.get(ri0); // fresh copy -- `.fields` is only safe to read once
        checker.register_resource(rd.name, rd.fields);
        structs.push(StructDecl { name: rd2.name, type_param: none_string2(), fields: rd2.fields, is_arena: false, module_name: none_string2(), super_class: none_string2(), type_param2: none_string2() });
        // `__resource_<Name>` needs to be a real, known static from HERE on -- both to the
        // checker (`register_static_decl`, so the synthesized system-dispatch call sites'
        // `Ident` reference to it type-checks -- see `synthesize_system_call_stmts_ecs`'s own
        // header) AND to `Codegen.hotc`'s OWN, separate `static_types` registry (populated from
        // THIS `statics` list by `build_program_info`, independently of anything the checker
        // tracks -- same "checker and codegen don't share registries" split as `component`
        // needed its own `structs.push(...)` for, right above). Pushed onto the REAL `statics`
        // list rather than tracked separately, so every ordinary mechanism (field declaration,
        // `build_program_info`) picks it up automatically with zero special-casing -- the ONE
        // exception is `gen_static_init`'s own per-static PUTSTATIC-with-value loop, which
        // explicitly SKIPS any `__resource_`-prefixed entry (see that fn's own header) so this
        // field is left at the JVM's own default (`null`) instead of getting this throwaway
        // `.value` written into it.
        let rd3 = resources.get(ri0); // fresh copy -- `rd`/`rd2` above are both already consumed
        let resource_static = StaticDecl { name: resource_field_name_ecs(rd3.name), type_name: rd3.name, value: BoolLit { value: false } };
        checker.register_static_decl(&resource_static);
        statics.push(resource_static);
        ri0 = ri0 + 1;
    }
    checker.check_systems(&systems);
    var wi0 = 0;
    while wi0 < checker.warnings.length() {
        let w = checker.warnings.get(wi0);
        if w != "" {
            print("warning: " + w);
        }
        wi0 = wi0 + 1;
    }
    // `--explain-schedule` -- see `ECS_IDEAS.md`'s own "Resolved decisions" #6 ("both": a real
    // compile-time warning for every conflicting pair, ALWAYS on -- the loop right above -- AND a
    // flag that prints the FULL derived schedule for every `system` in the program, not just the
    // conflicts). `checker.system_groups` is already exactly this: each inner list is one
    // parallel-dispatch batch, in run order (`check_systems`'s own grouped topo-sort) -- a size-1
    // group runs directly, a size>1 group is real Phoenix-Flight-backed parallel dispatch (Phase
    // B). Printed only when the flag is set, and only when the program actually declares any
    // `system` at all (an empty report for a program with none would just be noise).
    if explain_schedule && systems.length() > 0 {
        print_schedule_report_ecs(&checker.system_groups);
    }
    // `world.run_all()` -- see `build_run_all_body_ecs`'s own header. One real, plain top-level fn
    // per `system` (`synthesize_system_fn_ecs` -- literally its own `run` block, callable by a
    // real name) pushed into `fns` NOW, early, so the ordinary fn-registration/check passes right
    // below type-check its body for the first time ever, same as any other top-level fn. The
    // ARCHETYPE struct/static pair and the `__world_run_all` fn ITSELF are deliberately NOT built
    // here -- see the "ECS archetype synthesis" section further down, right after checking
    // finishes, for why (`checker.archetype_signatures` isn't populated yet at this point in the
    // function -- checking `main`'s own `world.spawn(...)` calls is what populates it, and that
    // hasn't happened yet this early).
    var ecs_sysi = 0;
    while ecs_sysi < systems.length() {
        fns.push(synthesize_system_fn_ecs(systems.get(ecs_sysi)));
        ecs_sysi = ecs_sysi + 1;
    }
    let en = enums.length();
    var ei0 = 0;
    while ei0 < en {
        let ed0 = enums.get(ei0);
        checker.register_enum(ed0.name, ed0.type_param, ed0.variants, ed0.type_param2);
        ei0 = ei0 + 1;
    }
    let xn = externs.length();
    var xi0 = 0;
    while xi0 < xn {
        let xd = externs.get(xi0);
        checker.register_extern(xd.name, xd.binary_name, xd.methods, xd.fields);
        xi0 = xi0 + 1;
    }
    // Real classpath-based signature verification (`Checker.hotc`'s own `verify_extern_
    // signature`, proven correct via the compiler's own internal probe -- see `Driver.hotc`'s
    // own `run_classpath_verify_probe` -- but never reachable from an ordinary compile before
    // this). An EMPTY `classpath` (the default, no `--classpath` given) still checks anything
    // findable via the plain context classloader for free -- every JDK-only `extern` gets
    // verified with zero extra ceremony; `class_exists_reflect` itself is what silently skips a
    // binary name it can't find on WHATEVER classpath was actually given, so calling this
    // unconditionally for every declared method is always safe, never a false positive.
    //
    // A SEPARATE loop, run only after EVERY extern above has already been registered -- not
    // fused into the registration loop itself. Real, previously-hit ordering bug found running
    // this against the compiler's OWN source: `JClassRefX::getMethods` declares `-> [JMethodRefX]`,
    // and `declared_type_to_key`'s own array-element lookup resolves `JMethodRefX` through
    // `self.externs` (populated by `register_extern`) -- verifying `JClassRefX` INLINE, in the
    // same pass that registers each extern one at a time, means `JMethodRefX` (declared AFTER
    // `JClassRefX` in this file) isn't registered yet, so the lookup fails, `declared_type_to_key`
    // falls through to `"?"`, and a completely correct declaration reads as unresolvable. Same
    // "a checker field populated as a side effect isn't ready until the whole pass finishes"
    // class of bug this project has hit before (see `ECS_IDEAS.md`'s own bug #2).
    var xi1 = 0;
    while xi1 < xn {
        let xd2 = externs.get(xi1);
        var mi0 = 0;
        while mi0 < xd2.methods.length() {
            let m = xd2.methods.get(mi0);
            var ptypes = empty_str_vec4();
            var pi0 = 0;
            while pi0 < m.params.length() {
                ptypes.push(m.params.get(pi0).type_name);
                pi0 = pi0 + 1;
            }
            checker.verify_extern_signature(xd2.name, xd2.binary_name, m.name, ptypes, m.ret_type, m.is_static, m.is_ctor, &classpath);
            mi0 = mi0 + 1;
        }
        xi1 = xi1 + 1;
    }
    let stn = statics.length();
    var sti0 = 0;
    while sti0 < stn {
        checker.register_static_decl(&statics.get(sti0));
        sti0 = sti0 + 1;
    }
    let ifn = interfaces.length();
    var ifi0 = 0;
    while ifi0 < ifn {
        let ifd = interfaces.get(ifi0);
        checker.register_interface(ifd.name, ifd.is_sealed, ifd.parents, &interfaces);
        ifi0 = ifi0 + 1;
    }
    let impls = materialize_delegated_methods(impls, &interfaces);
    let impls = materialize_default_methods(impls, &interfaces);
    var imp0 = 0;
    while imp0 < impls.length() {
        let imd = impls.get(imp0);
        if let Some { value: iface_reg } = imd.interface_name {
            // APPEND, not overwrite -- a struct with more than one `impl SomeInterface for
            // StructName { ... }` block (a real, separate `ImplDecl` each time) needs every one
            // of them remembered, not just whichever registered last (see `struct_interfaces`'s
            // own header).
            var existing_ifaces = empty_str_vec4();
            let existing_found = checker.struct_interfaces.get(imd.struct_name);
            if let Some { value: ex } = existing_found { existing_ifaces = ex; }
            existing_ifaces.push(iface_reg);
            checker.struct_interfaces.register(imd.struct_name, existing_ifaces);
        }
        imp0 = imp0 + 1;
    }
    let n = fns.length();
    var i = 0;
    while i < n {
        let f = fns.get(i);
        // A generic top-level fn (`fn identity<T>(x: T) -> T { ... }`) goes into
        // `generic_fn_templates` instead -- it isn't directly callable until some call site's
        // inferred type argument monomorphizes a concrete `Base$Arg` name for it (see
        // `Checker.hotc`'s own `ensure_fn_instantiated`/`check_generic_call`).
        var is_generic_fn = false;
        if let Some { value: tpx } = f.type_param { is_generic_fn = true; }
        if is_generic_fn {
            checker.generic_fn_templates.register(f.name, f);
        } else {
            checker.fn_sigs.register(f.name, FnSig { param_types: param_types_of(f.params), ret_type: ty_from_name(opt_string_or(f.ret_type, "Unit")) });
            let f_names_copy = fns.get(i); // fresh copy -- `.params` is only safe to read once
            checker.fn_param_names.register(f.name, param_names_of(f_names_copy.params));
            let f_ref_copy = fns.get(i); // fresh copy -- same reason as `f_names_copy` above
            checker.fn_param_is_ref.register(f.name, param_is_ref_of(f_ref_copy.params));
            let f_mutref_copy = fns.get(i); // fresh copy -- same reason as `f_ref_copy` above
            checker.fn_param_is_mut_ref.register(f.name, param_is_mut_ref_of(f_mutref_copy.params));
        }
        i = i + 1;
    }
    let inn = impls.length();
    var i0 = 0;
    while i0 < inn {
        let im0 = impls.get(i0);
        // An instance method declared inside a GENERIC struct's own `impl` block goes into
        // `generic_method_templates` instead -- it isn't directly callable until some method-call
        // site's receiver (already a concrete `"Box$Int"`-shaped instantiation) asks for it (see
        // `Checker.hotc`'s own `ensure_method_instantiated`).
        var im0_is_generic = false;
        let gtmpl0_found = checker.generic_templates.get(im0.struct_name);
        if let Some { value: gt0 } = gtmpl0_found { im0_is_generic = true; }
        var mi0 = 0;
        while mi0 < im0.methods.length() {
            let m0 = im0.methods.get(mi0);
            if im0_is_generic {
                checker.generic_method_templates.register(im0.struct_name + "#" + m0.name, m0);
            } else {
                checker.register_method(im0.struct_name, m0);
            }
            mi0 = mi0 + 1;
        }
        var smi0 = 0;
        while smi0 < im0.static_methods.length() {
            checker.register_static_method(im0.struct_name, im0.static_methods.get(smi0));
            smi0 = smi0 + 1;
        }
        i0 = i0 + 1;
    }
    var j = 0;
    while j < n {
        let fj = fns.get(j);
        // A generic fn template's body is only checked per-instantiation (`ensure_fn_instantiated`,
        // triggered lazily by whichever call site infers a concrete type argument for it) -- the
        // template itself, with its still-abstract `T`, was never registered into `fn_sigs` above,
        // so checking it directly here would be checking an uncallable declaration.
        var is_generic_j = false;
        if let Some { value: tpj } = fj.type_param { is_generic_j = true; }
        if !is_generic_j {
            checker.check_fn(fj);
        }
        j = j + 1;
    }
    var i1 = 0;
    while i1 < inn {
        let im1 = impls.get(i1);
        // A generic struct's own impl-block method template is only checked per-instantiation
        // (`ensure_method_instantiated`, triggered lazily by whichever method-call site's receiver
        // is the first concrete use of it) -- same reasoning as the generic top-level fn loop
        // above.
        var im1_is_generic = false;
        let gtmpl1_found = checker.generic_templates.get(im1.struct_name);
        if let Some { value: gt1 } = gtmpl1_found { im1_is_generic = true; }
        var mi1 = 0;
        while mi1 < im1.methods.length() {
            if !im1_is_generic {
                checker.check_method(im1.struct_name, im1.methods.get(mi1));
            }
            mi1 = mi1 + 1;
        }
        // Static methods check exactly like a top-level fn (no `self` to bind) -- `check_fn`
        // reused directly rather than needing a separate `check_static_method`.
        var smi1 = 0;
        while smi1 < im1.static_methods.length() {
            checker.check_fn(im1.static_methods.get(smi1));
            smi1 = smi1 + 1;
        }
        i1 = i1 + 1;
    }
    // `register_static_decl` (way above) only ever recorded each static's DECLARED type, never
    // evaluated `.value` against it at all (see its own header: "never actually evaluates `s.value`
    // ... see `Ast.hc`'s own `StaticDecl` header"). Real gap found running `examples/statics.hc`
    // with a generic initializer (`pub static log: Vec<String> = vec_of("boot");`): skipping
    // `check_expr` here means a `Call` to a generic fn inside a static's initializer never reaches
    // `ensure_fn_instantiated`, so its monomorphization (`"vec_of$String"`) never gets requested at
    // all -- `Codegen.hotc`'s own `gen_static_init` still happily emits an `INVOKESTATIC` for it
    // (nothing there re-checks types), but `self.fn_descs.get("vec_of$String")` comes back empty,
    // corrupting the emitted method descriptor into `""` and crashing deep inside ASM's own stack-
    // map-frame computation (`Frame.pop`/`StringIndexOutOfBoundsException`) rather than failing
    // cleanly at compile time. Running `check_expr` on every static's value here -- late, after
    // every fn/method signature and generic template is registered, exactly like an ordinary fn
    // body would be checked -- makes a static's initializer request instantiations the same way any
    // other call site does, and also catches a genuinely mistyped initializer (`pub static x: Int =
    // "oops";`) that silently went unchecked before.
    var sti1 = 0;
    while sti1 < stn {
        let s3 = statics.get(sti1);
        // `__resource_<Name>` (see `resource_field_name_ecs`'s own header): a real entry in this
        // list, but its own `.value` is a meaningless throwaway (`BoolLit{false}`, never the
        // field's real type) -- checking it against the declared type here would always fail.
        // Skipped here for the same reason `gen_static_init`'s own per-static PUTSTATIC loop
        // skips it: this field is deliberately left at the JVM's own default (`null`).
        if !str_starts_with(s3.name, "__resource_") {
            let s4 = statics.get(sti1); // fresh copy -- `.value` is only safe to read once
            let vt = checker.check_expr(s4.value);
            let vn = ty_name(vt);
            if vn != "?" && s3.type_name != vn {
                checker.error("static '" + s3.name + "' declared as " + s3.type_name + " but initializer is " + vn);
            }
        }
        sti1 = sti1 + 1;
    }
    checker.check_doc_sees(&struct_doc_names, &struct_doc_data);
    checker.check_doc_sees(&fn_doc_names, &fn_doc_data);
    if has_real_errors(checker.errors) {
        return checker.errors;
    }

    // ECS archetype synthesis -- see `ECS_IDEAS.md`'s own design doc, and `synthesize_archetype_
    // struct_ecs`/`synthesize_archetype_static_ecs`'s own headers for the real shape. One real
    // `StructDecl` + one real top-level `pub static` per distinct component set actually spawned
    // (`checker.archetype_signatures`, populated by the `World#spawn` gate in `check_method_call_
    // by_type` -- which only ever ran just now, as a side effect of the `check_fn`/`check_method`
    // loops right above checking every REAL call site, including whichever fn's body calls `world.
    // spawn(...)`) -- pushed onto `structs`/`statics` themselves so the ORDINARY codegen passes
    // right below pick them up with zero special-casing beyond this.
    //
    // Deliberately done HERE, not back where `component`/`system` first get registered -- a real,
    // previously-hit gap: `checker.archetype_signatures` is EMPTY until `world.spawn(...)` is
    // actually type-checked, which doesn't happen until the `check_fn` loop above runs (checking
    // whichever fn -- typically `main` -- calls it) -- synthesizing archetypes any earlier than
    // this silently produced ZERO archetype structs/statics for a program that spawns entities
    // perfectly validly, since `checker.archetype_signatures.length()` was still 0 at that point.
    // Caught only once `world.spawn(...)`/`world.run_all()` were finally run end-to-end
    // (`NoSuchFieldError` at runtime for the archetype static that never got declared).
    // The FULL closure -- not just what `world.spawn(...)` builds directly -- since `world.add`/
    // `world.remove` can move an entity into a signature nothing ever spawned into. See this
    // whole closure/transition section's own header, right before `compile_program`, for the
    // real shape.
    let closed_sigs = archetype_closure_ecs(&checker.archetype_signatures, &checker.add_component_types, &checker.remove_component_types);
    var eai = 0;
    while eai < closed_sigs.length() {
        let sig = closed_sigs.get(eai);
        let asd = synthesize_archetype_struct_ecs(sig);
        checker.register_struct(asd.name, asd.type_param, asd.fields, asd.is_arena, asd.super_class, asd.type_param2);
        structs.push(asd);
        let sig2 = closed_sigs.get(eai); // fresh copy -- `sig` already consumed above
        let astatic = synthesize_archetype_static_ecs(sig2, &structs, eai);
        checker.register_static_decl(&astatic);
        // The ordinary "check every static's own `.value`" loop (way above -- see its own header:
        // "makes a static's initializer request instantiations the same way any other call site
        // does") already ran and MISSED this one, since it didn't exist yet at that point -- a
        // real, previously-hit gap: `astatic.value` is a `Vec$<T>`-shaped `StructLit` (built by
        // `empty_vec_expr_ecs`) for `entities`/every `c{i}` field, and ONLY type-checking a
        // generic-shaped `StructLit` like that ever triggers `Vec$<T>`'s own real struct-level
        // monomorphization (`ensure_instantiated`, populating `checker.mono_needed` -- separate
        // from, and a precondition for, the METHOD-level `ensure_method_instantiated` the `World#
        // spawn` gate already nudges) -- skip it, and `Vec$Int`/`Vec$<Component>` never get a real
        // `.class` file with a real constructor at all, crashing `<clinit>` with `NoSuchMethodError:
        // Vec$Int: method 'void <init>()' not found` the instant this archetype static's own
        // initializer tries to construct one.
        checker.check_expr(&astatic.value);
        statics.push(astatic);
        eai = eai + 1;
    }
    // One program-wide, monotonically increasing entity id counter -- shared by every archetype
    // (an entity id is only ever used to line up a row across archetypes if it later needs to
    // move between them, Phase B territory -- see `ECS_IDEAS.md`'s own "Archetype-move mechanics"
    // answer -- but every `world.spawn(...)` needs a real, distinct id regardless).
    if closed_sigs.length() > 0 {
        let counter_static = StaticDecl { name: "__next_entity_id", type_name: "Int", value: IntLit { value: 0 } };
        checker.register_static_decl(&counter_static);
        checker.check_expr(&counter_static.value);
        statics.push(counter_static);
        // `__entity_archetype_id`/`__entity_row` -- entity-id-indexed (entities are sequential
        // from 0, so the entity id itself is the index) trackers of "which archetype does this
        // entity currently live in, and at which row" -- the real data `world.add`/`world.
        // remove`'s own transition dispatch (`synthesize_transition_fn_ecs`) needs to locate an
        // entity's CURRENT row before moving it, and that a runtime value in general (a given
        // call site's entity could have come from any of several `world.spawn(...)` call sites,
        // or already been moved once). `World#spawn`'s own codegen (`finish_method_call`) pushes
        // into both, right alongside the entity id itself.
        let arch_id_static = StaticDecl { name: "__entity_archetype_id", type_name: "Vec$Int", value: empty_vec_expr_ecs("Int", &structs) };
        checker.register_static_decl(&arch_id_static);
        checker.check_expr(&arch_id_static.value);
        statics.push(arch_id_static);
        let row_static = StaticDecl { name: "__entity_row", type_name: "Vec$Int", value: empty_vec_expr_ecs("Int", &structs) };
        checker.register_static_decl(&row_static);
        checker.check_expr(&row_static.value);
        statics.push(row_static);
        // `Changed<T>`'s own backing store (`c{i}_changed: Vec<Bool>`, see `archetype_field_
        // changed_name_ecs`'s own header) -- struct-level `Vec$Bool` instantiation already
        // happens above (every archetype static's own literal already contains one `Vec$Bool`
        // per component), but METHOD-level instantiation (`ensure_method_instantiated`,
        // populating `struct_methods` with a real `.push`/`.get`/`.set` descriptor) only ever
        // fires from type-checking a REAL method call -- forced here explicitly, the same
        // "materialize one real `Expr`, check it directly" trick `checker.check_expr(&astatic.
        // value)` itself already is, rather than trusting one of this file's own many OTHER
        // synthesized `.push`/`.get`/`.set` calls against `Vec$Bool` to happen to run early
        // enough on its own (`World#spawn`'s own hand-written bytecode, right in `finish_method_
        // call`, needs a real descriptor the INSTANT it runs, not "eventually").
        let force_vecbool_ecs = MethodCall { recv: empty_vec_expr_ecs("Bool", &structs), method: "push", args: vec_of(BoolLit { value: true }) };
        checker.check_expr(&force_vecbool_ecs);
    }
    // `__world_run_all` -- unlike the per-system fns (already pushed into `fns` way above, and
    // already checked by the ordinary `check_fn` loop like any other top-level fn), THIS fn can
    // only be BUILT now too (its own body walks the closed archetype list, just computed above)
    // -- which means it MISSED the ordinary bulk `check_fn` loop entirely, so it needs its own
    // explicit `check_fn` call here. Real, structural reason this matters: its body calls
    // `.get(...)`/`.length()` on `Vec$<Component>` fields -- ordinary GENERIC method calls that
    // only ever trigger `Vec$<Component>`'s own real monomorphization (`ensure_method_
    // instantiated`) by being type-checked, exactly like any other `.push(...)`/`.get(...)` call
    // site in this whole compiler -- skip that, and `Codegen.hotc`'s own `struct_methods` lookup
    // for e.g. `Vec$Transform#get` comes back empty, corrupting the emitted method descriptor.
    // The CLOSED signature list is used here too (not just `checker.archetype_signatures`) so a
    // system also runs against entities that only ever reached a given archetype via `world.add`/
    // `world.remove`, never a direct `world.spawn(...)`.
    //
    // `__system_<Name>_dispatch` -- one per system, ALWAYS (even a system in its own size-1 group
    // calls it directly rather than being inlined -- see `synthesize_system_dispatch_fn_ecs`'s
    // own header for why Phase B needs every system's own query-iteration wrapped in a real,
    // zero-param, separately-callable fn). Same reasoning as `__world_run_all` right below:
    // built from data (the closed archetype list) that's only real after checking finished, so
    // it MISSED the ordinary bulk registration/`check_fn` loops entirely -- needs its own
    // explicit signature registration (mirroring that bulk loop's own four `.register` calls,
    // `param_types_of(empty_param_vec2())` etc. rather than re-reading a built `FnDecl`'s own
    // `.params` field, since a zero-param fn's param list is always trivially `empty_param_vec2()`
    // anyway) AND its own explicit `check_fn` call.
    // `@profile` -- see `synthesize_profile_clock_extern_ecs`'s own header. Registered (and
    // pushed into `externs`, so `build_program_info`'s own downstream codegen resolution sees
    // it too) BEFORE the dispatch-fn loop right below, since that loop's own `checker.check_fn`
    // call needs `__ProfileClock::nanoTime()` to already resolve for any profiled system's body.
    let any_profiled = any_system_profiled_ecs(&systems);
    if any_profiled {
        let profile_extern = synthesize_profile_clock_extern_ecs();
        checker.register_extern(profile_extern.name, profile_extern.binary_name, profile_extern.methods, profile_extern.fields);
        externs.push(profile_extern);
    }
    // Flat name list of every declared `resource` -- threaded down into the system-dispatch-body
    // synthesis below so a resource-typed `run` param can be told apart from an ordinary
    // component-typed one (fetched from a real top-level static, not a per-row archetype field --
    // see `synthesize_system_call_stmts_ecs`'s own header).
    var resource_names = empty_str_vec4();
    var rni2 = 0;
    while rni2 < resources.length() {
        resource_names.push(resources.get(rni2).name);
        rni2 = rni2 + 1;
    }
    var sdi = 0;
    while sdi < systems.length() {
        let sysd_disp = systems.get(sdi);
        let dispatch_name = system_dispatch_fn_name_ecs(sysd_disp.name);
        checker.fn_sigs.register(dispatch_name, FnSig { param_types: param_types_of(empty_param_vec2()), ret_type: ty_from_name("String") });
        checker.fn_param_names.register(dispatch_name, param_names_of(empty_param_vec2()));
        checker.fn_param_is_ref.register(dispatch_name, param_is_ref_of(empty_param_vec2()));
        checker.fn_param_is_mut_ref.register(dispatch_name, param_is_mut_ref_of(empty_param_vec2()));
        let group_size = group_size_for_system_ecs(&checker.system_groups, sysd_disp.name);
        let dispatch_decl = synthesize_system_dispatch_fn_ecs(&sysd_disp, &closed_sigs, sysd_disp.has_profile, group_size, &resource_names);
        let dispatch_decl2 = synthesize_system_dispatch_fn_ecs(&sysd_disp, &closed_sigs, sysd_disp.has_profile, group_size, &resource_names);
        checker.check_fn(dispatch_decl2);
        fns.push(dispatch_decl);
        sdi = sdi + 1;
    }
    // `__world_pool` -- a real `PhoenixPool`, synthesized only when `checker.system_groups`
    // actually has a group bigger than 1 (most programs never will -- two systems only land in
    // the same group when the checker's own conflict analysis already proved neither can alias
    // the other's mutable state). Sized to the WIDEST group so no batch ever has to queue inside
    // itself waiting for a free thread. A program-wide STATIC, reused across every `world.
    // run_all()` call rather than a per-call local -- see `build_run_all_body_ecs`'s own header
    // for the real performance reasoning, and why that means the PROGRAM now owns calling
    // `world.shutdown()` once, near the end (`__world_shutdown`, right below).
    let pool_size = max_group_size_ecs(&checker.system_groups);
    if pool_size > 1 {
        let pool_static = StaticDecl { name: "__world_pool", type_name: "PhoenixPool", value: StaticCall { type_name: "PhoenixPool", method: "new", args: vec_of(IntLit { value: pool_size }) } };
        checker.register_static_decl(&pool_static);
        checker.check_expr(&pool_static.value);
        statics.push(pool_static);
    }
    // `__world_add_<Component>`/`__world_remove_<Component>` -- see "Queued archetype
    // transitions" (right before `synthesize_transition_fn_ecs`'s own header) for the full
    // design. Per add type: two pending statics (`__pending_add_<T>_entities`/`_values`), the
    // real mover (`__world_apply_add_<T>`), and the queueing fn `world.add`'s own codegen
    // actually forwards to (`__world_add_<T>`). Per remove type: one pending static, the mover,
    // and the queueing fn. Every synthesized fn here is built from data that's only real AFTER
    // checking finished, so each needs its own explicit signature registration AND `check_fn`
    // call, same reasoning as `__world_run_all`'s own (right below, which is why this whole
    // block runs BEFORE `__world_run_all` gets built now -- its body needs to reference the
    // pending statics and apply fns this block creates).
    var ati = 0;
    while ati < checker.add_component_types.length() {
        let at = checker.add_component_types.get(ati);
        let entities_static = StaticDecl { name: pending_add_entities_name_ecs(at), type_name: "Vec$Int", value: empty_vec_expr_ecs("Int", &structs) };
        checker.register_static_decl(&entities_static);
        checker.check_expr(&entities_static.value);
        statics.push(entities_static);
        let values_static = StaticDecl { name: pending_add_values_name_ecs(at), type_name: "Vec$" + at, value: empty_vec_expr_ecs(at, &structs) };
        checker.register_static_decl(&values_static);
        checker.check_expr(&values_static.value);
        statics.push(values_static);
        let apply_add_decl = synthesize_transition_fn_ecs(at, true, &closed_sigs);
        let apply_add_decl2 = synthesize_transition_fn_ecs(at, true, &closed_sigs);
        checker.check_fn(apply_add_decl2);
        fns.push(apply_add_decl);
        let queue_add_name = queue_fn_name_ecs(at, true);
        checker.fn_sigs.register(queue_add_name, FnSig { param_types: param_types_of(queue_add_params_ecs(at)), ret_type: ty_from_name("Unit") });
        checker.fn_param_names.register(queue_add_name, param_names_of(queue_add_params_ecs(at)));
        checker.fn_param_is_ref.register(queue_add_name, param_is_ref_of(queue_add_params_ecs(at)));
        checker.fn_param_is_mut_ref.register(queue_add_name, param_is_mut_ref_of(queue_add_params_ecs(at)));
        let queue_add_decl = synthesize_queue_add_fn_ecs(at);
        let queue_add_decl2 = synthesize_queue_add_fn_ecs(at);
        checker.check_fn(queue_add_decl2);
        fns.push(queue_add_decl);
        ati = ati + 1;
    }
    var rti = 0;
    while rti < checker.remove_component_types.length() {
        let rtcomp = checker.remove_component_types.get(rti);
        let remove_entities_static = StaticDecl { name: pending_remove_entities_name_ecs(rtcomp), type_name: "Vec$Int", value: empty_vec_expr_ecs("Int", &structs) };
        checker.register_static_decl(&remove_entities_static);
        checker.check_expr(&remove_entities_static.value);
        statics.push(remove_entities_static);
        let apply_remove_decl = synthesize_transition_fn_ecs(rtcomp, false, &closed_sigs);
        let apply_remove_decl2 = synthesize_transition_fn_ecs(rtcomp, false, &closed_sigs);
        checker.check_fn(apply_remove_decl2);
        fns.push(apply_remove_decl);
        let queue_remove_name = queue_fn_name_ecs(rtcomp, false);
        checker.fn_sigs.register(queue_remove_name, FnSig { param_types: param_types_of(queue_remove_params_ecs()), ret_type: ty_from_name("Unit") });
        checker.fn_param_names.register(queue_remove_name, param_names_of(queue_remove_params_ecs()));
        checker.fn_param_is_ref.register(queue_remove_name, param_is_ref_of(queue_remove_params_ecs()));
        checker.fn_param_is_mut_ref.register(queue_remove_name, param_is_mut_ref_of(queue_remove_params_ecs()));
        let queue_remove_decl = synthesize_queue_remove_fn_ecs(rtcomp);
        let queue_remove_decl2 = synthesize_queue_remove_fn_ecs(rtcomp);
        checker.check_fn(queue_remove_decl2);
        fns.push(queue_remove_decl);
        rti = rti + 1;
    }
    // `__world_run_all` -- its own body now starts with `build_flush_transitions_stmts_ecs`
    // (applying every queued `world.add`/`world.remove` from the previous tick, or from ordinary
    // code between `run_all()` calls, before any system runs this tick), then the ordinary
    // group-dispatch body as before.
    var run_all_body = build_flush_transitions_stmts_ecs(&checker.add_component_types, &checker.remove_component_types);
    let reset_body = build_reset_changed_stmts_ecs(&closed_sigs);
    var rbi = 0;
    while rbi < reset_body.length() { run_all_body.push(reset_body.get(rbi)); rbi = rbi + 1; }
    let group_body = build_run_all_body_ecs(&checker.system_groups);
    var gbi = 0;
    while gbi < group_body.length() { run_all_body.push(group_body.get(gbi)); gbi = gbi + 1; }
    var run_all_body2 = build_flush_transitions_stmts_ecs(&checker.add_component_types, &checker.remove_component_types);
    let reset_body2 = build_reset_changed_stmts_ecs(&closed_sigs);
    var rbi2 = 0;
    while rbi2 < reset_body2.length() { run_all_body2.push(reset_body2.get(rbi2)); rbi2 = rbi2 + 1; }
    let group_body2 = build_run_all_body_ecs(&checker.system_groups);
    var gbi2 = 0;
    while gbi2 < group_body2.length() { run_all_body2.push(group_body2.get(gbi2)); gbi2 = gbi2 + 1; }
    let run_all_decl = FnDecl { name: "__world_run_all", params: empty_param_vec2(), ret_type: none_string2(), body: run_all_body, type_param: none_string2(), type_bounds: empty_str_vec4(), self_is_mut: false, type_param2: none_string2(), type_bounds2: empty_str_vec4() };
    let run_all_decl2 = FnDecl { name: "__world_run_all", params: empty_param_vec2(), ret_type: none_string2(), body: run_all_body2, type_param: none_string2(), type_bounds: empty_str_vec4(), self_is_mut: false, type_param2: none_string2(), type_bounds2: empty_str_vec4() };
    checker.check_fn(run_all_decl2);
    fns.push(run_all_decl);
    // `__world_shutdown` -- always synthesized (see its own header on why an empty body is a
    // real, correct no-op when `__world_pool` was never created at all), registered and checked
    // the same way every other fn synthesized in this section is.
    let shutdown_name = "__world_shutdown";
    checker.fn_sigs.register(shutdown_name, FnSig { param_types: param_types_of(empty_param_vec2()), ret_type: ty_from_name("Unit") });
    checker.fn_param_names.register(shutdown_name, param_names_of(empty_param_vec2()));
    checker.fn_param_is_ref.register(shutdown_name, param_is_ref_of(empty_param_vec2()));
    checker.fn_param_is_mut_ref.register(shutdown_name, param_is_mut_ref_of(empty_param_vec2()));
    let shutdown_decl = FnDecl { name: shutdown_name, params: empty_param_vec2(), ret_type: none_string2(), body: build_world_shutdown_body_ecs(pool_size), type_param: none_string2(), type_bounds: empty_str_vec4(), self_is_mut: false, type_param2: none_string2(), type_bounds2: empty_str_vec4() };
    let shutdown_decl2 = FnDecl { name: shutdown_name, params: empty_param_vec2(), ret_type: none_string2(), body: build_world_shutdown_body_ecs(pool_size), type_param: none_string2(), type_bounds: empty_str_vec4(), self_is_mut: false, type_param2: none_string2(), type_bounds2: empty_str_vec4() };
    checker.check_fn(shutdown_decl2);
    fns.push(shutdown_decl);
    // The ordinary `n` (captured way above, before this whole section's own `fns` growth -- the
    // per-system fns don't need it, but `__world_run_all` and every transition fn do) is now
    // stale for anything that still needs to see EVERY top-level fn, including these -- the
    // codegen loop and the `main`-detection loop right after it, both further down this fn.
    let n_final = fns.length();

    // Each struct is its own real, separate `.class` file (`gen_struct` calls `CodegenShim`
    // itself, and emits its own impl-block methods too), written before the functions that
    // construct/use instances of them. Enums the same way (`gen_enum` -- no methods on enums this
    // phase, see `Ast.hc`'s own header). A *generic* struct declaration (`type_param` is `Some`)
    // is never directly instantiable -- it's just a template, skipped here -- only its concrete
    // monomorphizations (`checker.mono_needed`, populated during the check pass above by
    // `ensure_instantiated` every time a `Box<Int>`-shaped name was actually used) get real
    // classes, right after the plain structs.
    //
    // Deliberately NOT `sn` (captured way back before this fn's own ECS section pushed the
    // synthesized component/archetype structs onto `structs`) -- a real, previously-hit gap:
    // `world.spawn(...)`'s own hand-written bytecode compiled fine (nothing there re-checks
    // `structs`), but neither a `component`'s own struct nor an archetype's ever got a REAL
    // `.class` file written, since the stale `sn` excluded them from this exact loop -- a
    // `NoClassDefFoundError` at RUNTIME (classes are loaded lazily), not a compile-time failure,
    // caught only once `world.spawn(...)`/`world.run_all()` were finally run end-to-end.
    let sn_final = structs.length();
    var si1 = 0;
    while si1 < sn_final {
        let sd2 = structs.get(si1);
        var is_generic = false;
        if let Some { value: tp } = sd2.type_param { is_generic = true; }
        // An `arena struct` is never a real JVM object -- it only ever exists as raw
        // `MemorySegment` byte offsets (see `Ast.hc`'s own `StructDecl.is_arena` header) -- there's
        // no class to emit for it at all, same as a generic struct TEMPLATE right above.
        if !is_generic && !sd2.is_arena {
            let sd2_ann = find_annotation_cg(&struct_annotation_names, &struct_annotation_data, sd2.name);
            gen_struct(target, sd2.name, sd2.fields, methods_for_struct(&impls, sd2.name), static_methods_for_struct(&impls, sd2.name), binary_name, &fns, &structs, &impls, &enums, &checker.mono_needed, &checker.fn_mono_needed, &checker.method_mono_needed, &statics, &externs, &interfaces, sd2.super_class, sd2_ann, &sendable_struct_names);
        }
        si1 = si1 + 1;
    }
    // A monomorphized name (`"Box$Int"`/`"Option$Int"`) might be a generic struct's or a generic
    // enum's concrete instantiation -- `is_generic_enum_mono` tells the two apart and routes to
    // `gen_enum` (substituted variants) or `gen_struct` (substituted fields) accordingly (see
    // `monomorphized_enum_variants`'s own header).
    var mi2 = 0;
    while mi2 < checker.mono_needed.length() {
        let mono_name = checker.mono_needed.get(mi2);
        if is_generic_enum_mono(&enums, mono_name) {
            let mono_variants = monomorphized_enum_variants(&enums, mono_name);
            gen_enum(target, mono_name, mono_variants, find_enum_module_cg(mono_name, &enums), &structs, &enums);
        } else {
            let mono_fields = monomorphized_fields(&structs, mono_name);
            gen_struct(target, mono_name, mono_fields, monomorphized_methods_for_struct_cg(&impls, &structs, &checker.method_mono_needed, mono_name), empty_fn_decl_vec2(), binary_name, &fns, &structs, &impls, &enums, &checker.mono_needed, &checker.fn_mono_needed, &checker.method_mono_needed, &statics, &externs, &interfaces, none_string2(), none_annotation2(), &sendable_struct_names);
        }
        mi2 = mi2 + 1;
    }
    var ei1 = 0;
    while ei1 < en {
        let ed1 = enums.get(ei1);
        var ed1_is_generic = false;
        if let Some { value: etp1 } = ed1.type_param { ed1_is_generic = true; }
        if !ed1_is_generic {
            gen_enum(target, ed1.name, ed1.variants, ed1.module_name, &structs, &enums);
        }
        ei1 = ei1 + 1;
    }
    var ifi1 = 0;
    while ifi1 < interfaces.length() {
        let ifd1 = interfaces.get(ifi1);
        // `extern interface`s bind to a REAL, already-existing JVM interface -- no `.class` file
        // to emit at all (see `Ast.hc`'s own `InterfaceDecl.extern_binary_name` header), matching
        // the real compiler's own `interfaceDecls.filter { it.externBinaryName == null }`.
        var has_extern_binary = false;
        if let Some { value: ebn } = ifd1.extern_binary_name { has_extern_binary = true; }
        if !has_extern_binary {
            gen_interface(target, ifd1.name, ifd1.methods, ifd1.parents, ifd1.module_name, &interfaces);
        }
        ifi1 = ifi1 + 1;
    }

    var cw = ClassWriter2::new(2); // COMPUTE_FRAMES (implies COMPUTE_MAXS; real ASM value is 2, not 4)
    CodegenShim::visitClassHeader(&mut cw, classfile_major_for_target(target), 33, binary_name, "java/lang/Object", ["x"; 0]); // ACC_PUBLIC | ACC_SUPER
    CodegenShim::visitSource(&mut cw, binary_name + ".hotc");

    let ctor = CodegenShim::visitMethodNoSig(&mut cw, 1, "<init>", "()V", ["x"; 0]);
    ctor.visitCode();
    ctor.visitVarInsn(25, 0); // ALOAD 0
    ctor.visitMethodInsn(183, "java/lang/Object", "<init>", "()V", false); // INVOKESPECIAL
    ctor.visitInsn(177); // RETURN
    ctor.visitMaxs(1, 1);
    ctor.visitEnd();

    // `pub static NAME: Type = expr;` -- each becomes a real `static` field on the main class
    // (`ACC_PUBLIC | ACC_STATIC` = 9, same access-flag convention `gen_fn`'s own top-level fns
    // already use), initialized for real in a `<clinit>` static initializer (`gen_static_init`)
    // rather than folded to a constant-value attribute -- simpler, and this subset's own `Ident`/
    // `Assign` codegen already knows how to emit ordinary expression bytecode, no separate
    // constant-folding machinery needed.
    let static_alias_names = extern_alias_list(&externs);
    let static_alias_binaries = extern_binary_list(&externs);
    // Same reasoning as `gen_struct`'s own field-descriptor tables -- a `pub static` naming a
    // LOCAL, module-qualified struct/enum type needs the real qualified descriptor too.
    var static_module_names = empty_str_vec4();
    var static_module_values = empty_str_vec4();
    var smmi = 0;
    while smmi < structs.length() {
        let smms = structs.get(smmi);
        if let Some { value: smmv } = smms.module_name {
            static_module_names.push(smms.name);
            static_module_values.push(smmv);
        }
        smmi = smmi + 1;
    }
    var smmei = 0;
    while smmei < enums.length() {
        let smme = enums.get(smmei);
        if let Some { value: smmev } = smme.module_name {
            static_module_names.push(smme.name);
            static_module_values.push(smmev);
        }
        smmei = smmei + 1;
    }
    // `__resource_<Name>` fields (see `resource_field_name_ecs`'s own header) were already
    // pushed onto `statics` itself (the resource-registration loop, earlier in this fn) -- this
    // ordinary per-static field-declaration loop picks them up with zero special-casing.
    var sti = 0;
    while sti < statics.length() {
        let sd3 = statics.get(sti);
        CodegenShim::visitInstanceField(&mut cw, 9, sd3.name, descriptor_of_type(sd3.type_name, &static_alias_names, &static_alias_binaries, &static_module_names, &static_module_values)); // ACC_PUBLIC | ACC_STATIC
        sti = sti + 1;
    }
    // `$stdin` -- backs the `read_line` intrinsic (see `gen_expr`'s own `Call` codegen header),
    // which `read_int`/`read_string` (real prelude functions, not intrinsics) call in turn --
    // declared on every compiled class unconditionally, same as
    // `System.out` is implicitly always available for `print`. `gen_static_init` is now called
    // UNCONDITIONALLY too (not gated on `statics.length() > 0` like before this feature) since
    // it's the only place that initializes this field -- a program with no `pub static`s of its
    // own but a real `read_line()` call still needs a `<clinit>` to run.
    CodegenShim::visitInstanceField(&mut cw, 8, "$stdin", "Ljava/io/BufferedReader;"); // ACC_STATIC
    let clinit_info = build_program_info(target, &fns, &structs, &impls, &enums, &checker.mono_needed, &checker.fn_mono_needed, &checker.method_mono_needed, &statics, &externs, &interfaces, &sendable_struct_names);
    gen_static_init(&mut cw, binary_name, &statics, clinit_info);

    // A generic fn declaration (`type_param` is `Some`) is never directly emitted -- it's just a
    // template, skipped here (same as a generic struct/enum declaration above) -- only its
    // concrete monomorphizations (`checker.fn_mono_needed`, populated during the check pass by
    // `ensure_fn_instantiated` every time an inferred `identity$Int`-shaped call was actually
    // made) get a real compiled method, right after the plain fns.
    var k = 0;
    while k < n_final {
        let f = fns.get(k);
        let f2 = fns.get(k); // fresh copy -- `.params` is only safe to read once
        var f_is_generic = false;
        if let Some { value: ftp } = f.type_param { f_is_generic = true; }
        if !f_is_generic {
            let info = build_program_info(target, &fns, &structs, &impls, &enums, &checker.mono_needed, &checker.fn_mono_needed, &checker.method_mono_needed, &statics, &externs, &interfaces, &sendable_struct_names); // fresh every iteration, see build_program_info's own header
            let f_ann = find_annotation_cg(&fn_annotation_names, &fn_annotation_data, f.name);
            gen_fn(&mut cw, binary_name, f.name, param_names_of(f.params), param_type_names_of(f2.params), opt_string_or(f.ret_type, "Unit"), f.body, info, f_ann);
        }
        k = k + 1;
    }
    var fmk = 0;
    while fmk < checker.fn_mono_needed.length() {
        let fmono_name = checker.fn_mono_needed.get(fmk);
        let mono_params = monomorphized_fn_params_cg(&fns, fmono_name);
        let mono_params2 = monomorphized_fn_params_cg(&fns, fmono_name);
        let mono_ret = monomorphized_fn_retty_cg(&fns, fmono_name);
        let mono_body = fn_body_of_generic_template_cg(&fns, fmono_name);
        let info2 = build_program_info(target, &fns, &structs, &impls, &enums, &checker.mono_needed, &checker.fn_mono_needed, &checker.method_mono_needed, &statics, &externs, &interfaces, &sendable_struct_names); // fresh every iteration
        gen_fn(&mut cw, binary_name, fmono_name, param_names_of(mono_params), param_type_names_of(mono_params2), mono_ret, mono_body, info2, none_annotation2());
        fmk = fmk + 1;
    }

    // `main(String[])` -- three possible shapes, resolved in priority order right below: (1) a
    // real `fn main(args: [String])` returning `Unit` (genuine argv passthrough, see the comment
    // just below the detection loop); (2) a real, zero-param `fn main()` of any return type,
    // called for real with its result printed only as a debugging convenience since this shape
    // can't see argv at all; (3) neither -- falls back to the old test-harness convention (call
    // `entry_name` with hardcoded `entry_args` and print the Int result) for demo/test files that
    // define neither.
    var has_real_main = false;
    var has_argv_main = false;
    var main_ret = "Unit";
    var hm = 0;
    while hm < n_final {
        let fm = fns.get(hm);
        if fm.name == "main" {
            has_real_main = true;
            main_ret = opt_string_or(fm.ret_type, "Unit");
            if fm.params.length() == 1 && main_ret == "Unit" {
                let p0 = fm.params.get(0);
                if p0.type_name == "[String]" { has_argv_main = true; }
            }
        }
        hm = hm + 1;
    }
    // A real `fn main(args: [String])` returning `Unit` is a genuine argv-passthrough entry --
    // `[String]`'s own descriptor is ALREADY the exact JVM `main` shape (`descriptor_of_type`
    // gives `[Ljava/lang/String;`), so the ordinary `gen_fn` compile of this fn (further up) under
    // its own real name already produces a method identical in name+descriptor to what the JVM
    // entry point itself needs (`main`, `ACC_PUBLIC | ACC_STATIC`, `([Ljava/lang/String;)V`). No
    // synthetic wrapper is generated in this case at all -- the user's own compiled method
    // directly IS the entry point (emitting a second `main` with the identical descriptor here
    // would be a real duplicate-method class-format error, not just redundant). Real gap closed
    // this session -- `Driver.hotc`'s own header used to disclose "this subset's own `main` can't
    // take argv yet."
    if !has_argv_main {
        let main_mv = CodegenShim::visitMethodNoSig(&mut cw, 9, "main", "([Ljava/lang/String;)V", ["x"; 0]);
        main_mv.visitCode();
        if has_real_main {
            if main_ret == "Unit" {
                main_mv.visitMethodInsn(184, binary_name, "main", "()V", false); // INVOKESTATIC
            } else if main_ret == "String" {
                main_mv.visitFieldInsn(178, "java/lang/System", "out", "Ljava/io/PrintStream;"); // GETSTATIC
                main_mv.visitMethodInsn(184, binary_name, "main", "()Ljava/lang/String;", false); // INVOKESTATIC
                main_mv.visitMethodInsn(182, "java/io/PrintStream", "println", "(Ljava/lang/String;)V", false); // INVOKEVIRTUAL
            } else {
                main_mv.visitFieldInsn(178, "java/lang/System", "out", "Ljava/io/PrintStream;"); // GETSTATIC
                main_mv.visitMethodInsn(184, binary_name, "main", "()I", false); // INVOKESTATIC
                main_mv.visitMethodInsn(182, "java/io/PrintStream", "println", "(I)V", false); // INVOKEVIRTUAL
            }
        } else {
            main_mv.visitFieldInsn(178, "java/lang/System", "out", "Ljava/io/PrintStream;"); // GETSTATIC
            var a = 0;
            while a < entry_args.length() {
                main_mv.visitIntInsn(17, entry_args.get(a)); // SIPUSH
                a = a + 1;
            }
            main_mv.visitMethodInsn(184, binary_name, entry_name, int_descriptor(entry_args.length()), false); // INVOKESTATIC
            main_mv.visitMethodInsn(182, "java/io/PrintStream", "println", "(I)V", false); // INVOKEVIRTUAL
        }
        main_mv.visitInsn(177); // RETURN
        main_mv.visitMaxs(0, 0); // COMPUTE_FRAMES makes explicit values irrelevant
        main_mv.visitEnd();
    }

    cw.visitEnd();
    CodegenShim::writeClass(cw, out_path);
    return checker.errors;
}

// Gathers methods from EVERY `ImplDecl` matching `struct_name`, not just the first -- a real,
// pre-existing gap found alongside `struct_interfaces_of`'s own matching fix: a struct with more
// than one `impl` block (multiple interfaces, or an interface impl alongside a plain inherent
// `impl StructName { ... }` block) used to silently return ONLY the first matching block's own
// methods, so any method declared in a SECOND block never made it into the compiled class at all
// -- not a compile error, a real `AbstractMethodError` at runtime the first time something called
// through the missing method (direct OR `&dyn` dispatch alike, since the method genuinely isn't
// on the class file either way).
fn methods_for_struct(impls: &Vec<ImplDecl>, struct_name: String) -> Vec<FnDecl> {
    var out = empty_fn_decl_vec2();
    var i = 0;
    while i < impls.length() {
        let im = impls.get(i);
        if im.struct_name == struct_name {
            var mi = 0;
            while mi < im.methods.length() {
                out.push(im.methods.get(mi));
                mi = mi + 1;
            }
        }
        i = i + 1;
    }
    return out;
}

fn static_methods_for_struct(impls: &Vec<ImplDecl>, struct_name: String) -> Vec<FnDecl> {
    var out = empty_fn_decl_vec2();
    var i = 0;
    while i < impls.length() {
        let im = impls.get(i);
        if im.struct_name == struct_name {
            var mi = 0;
            while mi < im.static_methods.length() {
                out.push(im.static_methods.get(mi));
                mi = mi + 1;
            }
        }
        i = i + 1;
    }
    return out;
}

fn empty_fn_decl_vec2() -> Vec<FnDecl> {
    var v = vec_of(FnDecl { name: "_", params: empty_param_vec2(), ret_type: none_string2(), body: empty_stmt_vec2(), type_param: none_string2(), type_bounds: empty_str_vec4(), self_is_mut: false, type_param2: none_string2(), type_bounds2: empty_str_vec4() });
    return Vec { data: v.data, len: 0 };
}

fn empty_param_vec2() -> Vec<Param> {
    var v = vec_of(Param { name: "_", type_name: "_", is_ref: false, is_mut_ref: false });
    return Vec { data: v.data, len: 0 };
}

fn none_string2() -> Option<String> {
    return None;
}

fn some_string2(s: String) -> Option<String> {
    return Some { value: s };
}

fn empty_stmt_vec2() -> Vec<Stmt> {
    var v = vec_of(ExprStmt { expr: IntLit { value: 0 }, line: 0 });
    return Vec { data: v.data, len: 0 };
}

// `param_types_of` -- now shared with `Checker.hotc` via `Types.hotc` (used to be a near-
// duplicate copy here; harmless under the flat bootstrap namespace, but genuine duplication).

fn all_int_types(count: Int) -> Vec<String> {
    var out = vec_of("__init__");
    var real = Vec { data: out.data, len: 0 };
    var i = 0;
    while i < count {
        real.push("Int");
        i = i + 1;
    }
    return real;
}

fn param_type_names_of(params: &Vec<Param>) -> Vec<String> {
    var out = vec_of("__init__");
    var real = Vec { data: out.data, len: 0 };
    var i = 0;
    while i < params.length() {
        real.push(params.get(i).type_name);
        i = i + 1;
    }
    return real;
}

fn param_names_of(params: &Vec<Param>) -> Vec<String> {
    var out = vec_of("__init__");
    var real = Vec { data: out.data, len: 0 };
    var i = 0;
    while i < params.length() {
        real.push(params.get(i).name);
        i = i + 1;
    }
    return real;
}

fn opt_string_or(o: Option<String>, default_val: String) -> String {
    if let Some { value: v } = o {
        return v;
    }
    return default_val;
}

fn has_real_errors(errs: Vec<String>) -> Bool {
    var i = 0;
    while i < errs.length() {
        if errs.get(i) != "" {
            return true;
        }
        i = i + 1;
    }
    return false;
}
