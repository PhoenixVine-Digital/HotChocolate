module hc.selfhost.parser;

// The self-hosted parser, phase 1 -- see `Ast.hc`'s own header for the exact grammar subset this
// covers (expressions with full precedence climbing, a minimal statement layer, one `fn`
// declaration form). Consumes `Lexer.hc`'s `Vec<Token>` output directly (same directory-mode
// compile, same flat global namespace -- no extern bridging needed between these two files, the
// whole point of porting both natively).
//
// Real finding from building this file, not just the AST it consumes: `==`/`!=` on two `enum`
// values used to compile as raw reference identity (`IF_ACMPEQ`), not tag/variant comparison --
// `some_fn() == SomeVariant` was silently `false` even when `some_fn()` genuinely returned that
// variant, since they're two separately-constructed objects. Fixed at the compiler level (tag
// comparison, `CodeGen.genBinary`) rather than worked around here with `match`-based dispatch
// everywhere `check(kind)` is called below -- this is a foundational operation for ANY parser-
// shaped code (constantly comparing a just-read token's kind against an expected one), not
// something worth papering over per call site.

extern class JObject3 = "java.lang.Object" {}
extern class ParseError = "java.lang.RuntimeException" {
    fn new(msg: String) -> Self;
}
extern class JString3 = "java.lang.String" {
    static fn valueOf(v: Int) -> String;
}

// Parser-internal only -- the return shape of `one_field_binding` (HC has no tuples). Not part of
// the real AST.
pub struct FieldBinding {
    field: String,
    bind: String,
}

// Parser-internal only -- the return shape of `unit_decl` (HC has no tuples, and a `unit`
// declaration synthesizes THREE separate top-level decls at once: the newtype struct itself, its
// operator-overload `impl` block, and a free constructor fn). Not part of the real AST.
pub struct UnitDeclResult {
    sd: StructDecl,
    im: ImplDecl,
    ctor_fn: FnDecl,
}

// Parser-internal only -- the return shape of `typestate_decl` (a `typestate` block can declare
// any number of `state`s and `impl`s, not a fixed count like `UnitDeclResult`'s three). Not part
// of the real AST.
pub struct TypestateResult {
    structs: Vec<StructDecl>,
    impls: Vec<ImplDecl>,
}

// Parser-internal only -- the return shape of `state_machine_decl` (a `state Name { ... }` block
// synthesizes a states enum, an events enum, and a transition fn all at once). Not part of the
// real AST.
pub struct StateMachineResult {
    state_enum: EnumDecl,
    event_enum: EnumDecl,
    transition_fn: FnDecl,
}

pub struct Parser {
    tokens: Vec<Token>,
    pos: Int,
    // Set while parsing an `if`/`while` condition -- disambiguates `if n { ... }` (bare Bool
    // condition followed by the `then` block) from `if n { f: 1 }` (which would otherwise parse
    // as a struct-literal condition swallowing the real block's own `{`). Same restriction real
    // languages with this exact ambiguity (Rust, Go) apply; see `primary`'s own use of it.
    no_struct_lit: Bool,
    // `module a.b.c;`'s own real, dot-joined string (`"a.b.c"`), or `""` for a file with no
    // `module` declaration at all -- real gap found integrating this compiler into an actual
    // Java-package-organized project (Phoenix Chronicles): every struct/enum/interface this file
    // declares gets tagged with THIS value (`Ast.hc`'s own `StructDecl.module_name` etc. header),
    // so `Codegen.hotc` can emit a REAL, package-qualified JVM class name instead of always
    // landing in the default package. `module` is still only ever consumed once per file, at the
    // top -- see `parse_program`'s own header for why a real per-declaration override isn't
    // needed (nothing in this subset re-parents a struct into a DIFFERENT module mid-file).
    current_module: String,
    // `parallel for x in arr { expr; }` -- see this file's own `parallel_for_stmts` header for
    // the full design. A unique counter (avoids two `parallel for` sites in the same file
    // colliding on the SAME local variable names once desugared) and a flag noting whether
    // `"phoenix"` needs auto-injecting into `Program.uses` (mirroring `Driver.hotc`'s own `ecs`
    // -> `phoenix` transitive dependency -- a program using `parallel for` needs `PhoenixPool`/
    // `PhoenixTask` regardless of whether it ALSO wrote `use phoenix;` itself).
    parallel_for_counter: Int,
    needs_phoenix: Bool,
    // `@derive(Eq, Hash)` -- see `derive_impls`'s own header. `Eq`/`Hashable` (the interfaces the
    // synthesized `impl` blocks target) are only declared in `stdlib/collections.hotc`, so a
    // program using `@derive` needs `"collections"` auto-injected into `Program.uses` regardless
    // of whether it ALSO wrote `use collections;` itself -- same transitive-dependency pattern
    // `needs_phoenix` right above already establishes for `parallel for`.
    needs_collections: Bool,
    // `sequence { ... }` -- see `sequence_stmts`'s own header. `sequence_counter` avoids two
    // `sequence` sites in the same file colliding on the same synthesized helper-fn/local names
    // once desugared (mirrors `parallel_for_counter` exactly); `needs_sequence` auto-injects
    // `"sequence"` into `Program.uses` (mirrors `needs_phoenix`/`needs_collections`);
    // `pending_seq_fns` collects each `sequence` block's own synthesized top-level helper `fn` --
    // `sequence_stmts` can be called from ANYWHERE inside a fn body (any nesting depth `block()`
    // reaches), far from `parse_program`'s own top-level `fns` list, so the synthesized fn is
    // queued here and only actually appended to `fns` once `parse_program` reaches its own return.
    sequence_counter: Int,
    needs_sequence: Bool,
    pending_seq_fns: Vec<FnDecl>,
    // `@tunable static NAME: Float = value;` -- see `build_tunable_get_fn`'s own header. Every
    // tunable's own NAME (declaration order), collected as they're parsed anywhere in the file's
    // own top-level `static` list; `parse_program`'s own tail synthesizes `tunable_get`/
    // `tunable_set`/`tunable_names` from this list ONLY when it's non-empty (so a program that
    // never uses `@tunable` gets zero extra generated code).
    tunable_names: Vec<String>,
    // `@requires(cond)`/`@ensures(cond)` -- see `apply_contract`'s own header. `ContractError`
    // (the exception type both throw) isn't in any stdlib topic at all -- it's synthesized
    // directly into `Program.externs` by `parse_program`'s own tail, ONLY when at least one
    // `@requires`/`@ensures` was actually seen (mirrors `tunable_names`'s own "zero extra
    // generated code when unused" discipline).
    needs_contracts: Bool,
    // `event Name(field: Type, ...);` / `handle Name(bind, ...) { body }` -- see `event_decl`'s
    // own header for the full design. `event_names`/`event_field_counts` are parallel Vecs
    // (declaration order, index-aligned) rather than a `Registry` -- this file has no dependency
    // on `stdlib/registry.hotc`'s own `Registry<T>` (a real stdlib TOPIC, resolved through the
    // ordinary user-program `use`/`resolve_stdlib_modules` machinery, not available to the self-
    // hosted compiler's own bootstrap-merged source files), so a small hand-rolled linear scan
    // (`event_params_for`) is simpler than introducing that dependency for what's always a
    // handful of events per program. Each event's own FIELDS are stored FLATTENED across
    // `event_field_names`/`event_field_types` (concatenated in event-declaration order,
    // `event_field_counts` giving each event's own slice length) rather than as a real `Vec<Vec
    // <Param>>` field -- a real, previously-hit gap found the hard way: a doubly-nested generic
    // Vec AS A STRUCT FIELD TYPE (not just a `.set()` call, the earlier-found narrower version of
    // this same gap) crashes this compiler's own self-compile with `NoClassDefFoundError: Vec$
    // Vec$Param` -- monomorphizing `Vec<Vec<T>>` itself isn't reliable yet, so this field simply
    // never has that shape, avoiding the gap entirely rather than fixing it. `handler_event_names`/
    // `handler_fn_names` are likewise a FLAT pair of parallel Vecs (one entry per `handle` block
    // seen, in declaration order across the WHOLE file, regardless of which event each one
    // names) -- `parse_program`'s own tail filters this flat pair down to one event's own
    // handlers via `handlers_for_event`'s own linear scan.
    event_names: Vec<String>,
    event_field_counts: Vec<Int>,
    event_field_names: Vec<String>,
    event_field_types: Vec<String>,
    event_handler_counter: Int,
    handler_event_names: Vec<String>,
    handler_fn_names: Vec<String>,
    pending_event_fns: Vec<FnDecl>,
}

pub fn parser_new(tokens: Vec<Token>) -> Parser {
    return Parser { tokens: tokens, pos: 0, no_struct_lit: false, current_module: "", parallel_for_counter: 0, needs_phoenix: false, needs_collections: false, sequence_counter: 0, needs_sequence: false, pending_seq_fns: empty_fn_decl_vec(), tunable_names: empty_str_vec2(), needs_contracts: false, event_names: empty_str_vec2(), event_field_counts: empty_int_vec_ev(), event_field_names: empty_str_vec2(), event_field_types: empty_str_vec2(), event_handler_counter: 0, handler_event_names: empty_str_vec2(), handler_fn_names: empty_str_vec2(), pending_event_fns: empty_fn_decl_vec() };
}

impl Parser {
    fn peek(&self) -> Token {
        return self.tokens.get(self.pos);
    }

    // Non-consuming 3-token lookahead from the current `LT` -- see `primary`'s own use of it for
    // why this stays a bounded peek rather than real backtracking.
    fn looks_like_generic_lit(&self) -> Bool {
        if self.pos + 3 >= self.tokens.length() { return false; }
        let t1 = self.tokens.get(self.pos + 1);
        if t1.kind != IDENT { return false; }
        let t2 = self.tokens.get(self.pos + 2);
        if t2.kind != GT { return false; }
        let t3 = self.tokens.get(self.pos + 3);
        return t3.kind == LBRACE;
    }

    // Non-consuming 5-token lookahead from the current `LT`, for the explicitly-qualified generic-
    // enum-variant construction form `Base<Arg>::Variant { ... }` (see `Ast.hc`'s own `EnumDecl`
    // header) -- same bounded-peek approach `looks_like_generic_lit` uses, diverging from it only
    // at token 3 (`COLONCOLON` here vs `LBRACE` there), so the two are mutually exclusive and
    // either check can run first.
    fn looks_like_generic_variant(&self) -> Bool {
        if self.pos + 5 >= self.tokens.length() { return false; }
        let t1 = self.tokens.get(self.pos + 1);
        if t1.kind != IDENT { return false; }
        let t2 = self.tokens.get(self.pos + 2);
        if t2.kind != GT { return false; }
        let t3 = self.tokens.get(self.pos + 3);
        if t3.kind != COLONCOLON { return false; }
        let t4 = self.tokens.get(self.pos + 4);
        if t4.kind != IDENT { return false; }
        let t5 = self.tokens.get(self.pos + 5);
        return t5.kind == LBRACE;
    }

    // Same idea as `looks_like_generic_variant` right above, for the TWO-type-argument shape
    // (`Result<Int, String>::Ok { ... }`, see `Ast.hc`'s own `EnumDecl.type_param2` header) --
    // `LT IDENT COMMA IDENT GT COLONCOLON IDENT LBRACE`, 8 tokens from the current `LT`. Mutually
    // exclusive with the one-arg check purely by shape (token 2 is `COMMA` here, `GT` there), so
    // no ordering dependency between the two.
    fn looks_like_generic_variant2(&self) -> Bool {
        if self.pos + 7 >= self.tokens.length() { return false; }
        let t1 = self.tokens.get(self.pos + 1);
        if t1.kind != IDENT { return false; }
        let t2 = self.tokens.get(self.pos + 2);
        if t2.kind != COMMA { return false; }
        let t3 = self.tokens.get(self.pos + 3);
        if t3.kind != IDENT { return false; }
        let t4 = self.tokens.get(self.pos + 4);
        if t4.kind != GT { return false; }
        let t5 = self.tokens.get(self.pos + 5);
        if t5.kind != COLONCOLON { return false; }
        let t6 = self.tokens.get(self.pos + 6);
        if t6.kind != IDENT { return false; }
        let t7 = self.tokens.get(self.pos + 7);
        return t7.kind == LBRACE;
    }

    // Same idea as `looks_like_generic_lit` above, for the TWO-type-argument PLAIN struct literal
    // shape (`HashMap<ItemStack, Int> { ... }`, see `Ast.hc`'s own `StructDecl.type_param2`
    // header) -- `LT IDENT COMMA IDENT GT LBRACE`, 5 tokens from the current `LT`. Mutually
    // exclusive with `looks_like_generic_lit`/`looks_like_generic_variant`/`looks_like_generic_
    // variant2` purely by shape (token 2 is `COMMA` here, and there's no `COLONCOLON` anywhere in
    // this one), so no ordering dependency between any of them.
    fn looks_like_generic_lit2(&self) -> Bool {
        if self.pos + 5 >= self.tokens.length() { return false; }
        let t1 = self.tokens.get(self.pos + 1);
        if t1.kind != IDENT { return false; }
        let t2 = self.tokens.get(self.pos + 2);
        if t2.kind != COMMA { return false; }
        let t3 = self.tokens.get(self.pos + 3);
        if t3.kind != IDENT { return false; }
        let t4 = self.tokens.get(self.pos + 4);
        if t4.kind != GT { return false; }
        let t5 = self.tokens.get(self.pos + 5);
        return t5.kind == LBRACE;
    }

    // `Vec<Entry<V>> { ... }` / `Vec<Entry2<Int, V>> { ... }` -- a NESTED generic struct literal,
    // where the type ARGUMENT is itself generic, not a bare `IDENT` -- `looks_like_generic_lit`/
    // `_lit2` above only ever handle a bare, non-nested one/two-argument shape. Real gap found
    // writing `stdlib/collections.hotc`'s own `entries()` methods (`Vec<Entry<V>>`), which parsed
    // fine as a TYPE ANNOTATION (`-> Vec<Entry<V>>` -- `type_name_ref` already recurses through
    // arbitrary nesting) but failed as a STRUCT LITERAL head, since nothing here ever tried a
    // real, general parse for that position. A cheap, non-consuming 2-token pre-check (is the
    // type argument itself `IDENT LT`?) rules out every non-nested case for free WITHOUT ever
    // calling the heavier real parse below -- those already-handled shapes stay exactly as cheap
    // as before. When the pre-check passes, this does a REAL (consuming) speculative parse via
    // `type_name_ref` -- safe because `type_name_ref` already recurses correctly through
    // arbitrary depth/argument-count nesting, so there's no need for a second, parallel
    // "look-ahead only" type-expression parser -- then unconditionally restores `self.pos`
    // (a true lookahead), so the caller re-parses for real, once, only after this confirms the
    // whole shape genuinely ends in `> {`.
    fn looks_like_nested_generic_lit(&mut self) -> Bool {
        if self.pos + 2 >= self.tokens.length() { return false; }
        let t1 = self.tokens.get(self.pos + 1);
        if t1.kind != IDENT { return false; }
        let t2 = self.tokens.get(self.pos + 2);
        if t2.kind != LT { return false; }
        let saved = self.pos;
        self.advance(); // outer LT
        let type_arg = self.type_name_ref();
        var matched = false;
        if self.check(GT) {
            self.advance();
            matched = self.check(LBRACE);
        }
        self.pos = saved;
        return matched;
    }

    fn peek_kind(&self) -> TokType {
        let t = self.peek();
        return t.kind;
    }

    fn check(&self, kind: TokType) -> Bool {
        return self.peek_kind() == kind;
    }

    fn advance(&mut self) -> Token {
        let t = self.peek();
        self.pos = self.pos + 1;
        return t;
    }

    fn match_kind(&mut self, kind: TokType) -> Bool {
        if self.check(kind) {
            self.advance();
            return true;
        }
        return false;
    }

    fn expect(&mut self, kind: TokType) -> Token {
        if self.check(kind) {
            return self.advance();
        }
        let t = self.peek();
        throw ParseError::new("Parse error at line " + JString3::valueOf(t.line) + ": unexpected token '" + t.text + "'");
    }

    // === Expressions, full precedence chain, weakest to strongest ===

    fn expression(&mut self) -> Expr {
        return self.assignment();
    }

    fn assignment(&mut self) -> Expr {
        let expr = self.elvis();
        // `return expr;` lives inside the `else`, not after the whole `if`, deliberately -- the
        // checker's move-checking is conservative about `if`/`else` by design (moved on either
        // side counts as moved afterward), so a bare `return expr;` positioned AFTER this `if`
        // would see `expr` as "possibly already moved" by the `if let` below, even on the branch
        // that never reaches it. Same restructuring `Lexer.hotc`'s own `tokenize()` already
        // needed for the same underlying reason, one level up (`if`, not `while`, this time).
        if self.check(EQ) {
            self.advance();
            let value = self.assignment();
            match expr {
                Ident { name } => { return Assign { name: name, value: value }; }
                FieldAccess { obj, field } => { return FieldAssign { obj: obj, field: field, value: value }; }
                ExternStaticFieldGet { type_name, field } => { return ExternStaticFieldSet { type_name: type_name, field: field, value: value }; }
                Index { arr, index } => { return IndexAssign { arr: arr, index: index, value: value }; }
                IndexFieldGet { arr_name, index, field } => { return IndexFieldSet { arr_name: arr_name, index: index, field: field, value: value }; }
                _ => { throw ParseError::new("Invalid assignment target"); }
            }
        } else {
            return expr;
        }
    }

    // `x ?: default` -- Elvis, one precedence tier below `assignment`, above `logical_or` (so
    // `a ?: b || c` parses as `a ?: (b || c)`, matching the usual convention this shape follows
    // elsewhere). Right-associative (`a ?: b ?: c` is `a ?: (b ?: c)`), same convention `assignment`
    // itself already uses for chained `=`. See `Ast.hc`'s own `Expr.Elvis` header.
    fn elvis(&mut self) -> Expr {
        let left = self.logical_or();
        if self.check(QUESTION) && self.tokens.get(self.pos + 1).kind == COLON {
            self.advance(); // QUESTION
            self.advance(); // COLON
            let right = self.elvis();
            return Elvis { left: left, right: right };
        }
        return left;
    }

    fn logical_or(&mut self) -> Expr {
        var expr = self.logical_and();
        while self.check(PIPEPIPE) {
            self.advance();
            expr = Binary { op: "||", left: expr, right: self.logical_and() };
        }
        return expr;
    }

    fn logical_and(&mut self) -> Expr {
        var expr = self.bitwise_or();
        while self.check(AMPAMP) {
            self.advance();
            expr = Binary { op: "&&", left: expr, right: self.bitwise_or() };
        }
        return expr;
    }

    // Real bitwise `|`/`&` -- weaker than `==`/comparison (matching C-family precedence, so
    // `a & mask == 0` parses as `a & (mask == 0)`... no -- matching real C/Java precedence,
    // `==`/comparison bind TIGHTER than `&`/`|`, so `a & mask == 0` actually parses as
    // `a & (mask == 0)` in C too -- a famously easy mistake real C code makes, parenthesizing
    // explicitly is the normal fix, not a HotChocolate-specific concern. `PIPE`/`AMP` are
    // already real, distinct token kinds `Lexer.hotc` has produced all along (`PIPEPIPE`/
    // `AMPAMP` are its own separate two-character tokens) -- the parser itself never had a rule
    // consuming a BARE `|`/`&` as an infix binary operator until now (`&` alone was only ever
    // read as a PREFIX borrow marker, in `unary()`, right below -- an infix use is unambiguous
    // from that: `bitwise_and()` only checks for `&` AFTER it has already parsed a complete left
    // operand via `equality()`, a position `unary()`'s own prefix check never reaches).
    fn bitwise_or(&mut self) -> Expr {
        var expr = self.bitwise_xor();
        while self.check(PIPE) {
            self.advance();
            expr = Binary { op: "|", left: expr, right: self.bitwise_xor() };
        }
        return expr;
    }

    // Real bitwise `^` (XOR) -- slots between `|` and `&`, matching real C/Java precedence
    // (`| < ^ < &`), same reasoning `bitwise_or`'s own header already gives for `|`/`&`'s
    // placement relative to `==`/comparison.
    fn bitwise_xor(&mut self) -> Expr {
        var expr = self.bitwise_and();
        while self.check(CARET) {
            self.advance();
            expr = Binary { op: "^", left: expr, right: self.bitwise_and() };
        }
        return expr;
    }

    fn bitwise_and(&mut self) -> Expr {
        var expr = self.equality();
        while self.check(AMP) {
            self.advance();
            expr = Binary { op: "&", left: expr, right: self.equality() };
        }
        return expr;
    }

    fn equality(&mut self) -> Expr {
        var expr = self.comparison();
        while self.check(EQEQ) || self.check(BANGEQ) {
            let op = self.advance().text;
            expr = Binary { op: op, left: expr, right: self.comparison() };
        }
        return expr;
    }

    fn comparison(&mut self) -> Expr {
        var expr = self.shift();
        while self.check(LT) || self.check(LTEQ) || self.check(GT) || self.check(GTEQ) {
            let op = self.advance().text;
            expr = Binary { op: op, left: expr, right: self.shift() };
        }
        return expr;
    }

    // Non-consuming lookahead: is the token AT THE CURRENT POSITION a `GT`, immediately followed
    // by another `GT`? Used by `shift`, right below, to assemble `>>`/`>>>` from consecutive `GT`
    // tokens -- see `Lexer.hc`'s own `LTLT` header for why the lexer deliberately never merges
    // these itself (a lone `>` still has to close one level of a nested generic type annotation,
    // `Vec<Vec<Int>>`, and `type_name_ref`'s own separate grammar path consumes those one at a
    // time; this check only ever runs from real expression-operand position, never there, so the
    // two can never collide).
    fn is_double_gt(&self) -> Bool {
        if !self.check(GT) { return false; }
        if self.pos + 1 >= self.tokens.length() { return false; }
        return self.tokens.get(self.pos + 1).kind == GT;
    }

    // Same idea, one token further -- THREE consecutive `GT`s, for `>>>` (unsigned right shift).
    fn is_triple_gt(&self) -> Bool {
        if !self.is_double_gt() { return false; }
        if self.pos + 2 >= self.tokens.length() { return false; }
        return self.tokens.get(self.pos + 2).kind == GT;
    }

    // Real `<<`/`>>`/`>>>` (left shift, arithmetic right shift, unsigned/logical right shift) --
    // slots between `comparison` and `term`, matching real C/Java precedence (`relational <
    // shift < additive`). `<<` is already its own real lexer token (`LTLT`, unambiguous -- see
    // that token's own header); `>>`/`>>>` are assembled here from two/three consecutive bare
    // `GT` tokens instead, greedy-longest-match first (three before two), since the lexer itself
    // never merges them (same header, again).
    fn shift(&mut self) -> Expr {
        var expr = self.term();
        while true {
            if self.check(LTLT) {
                self.advance();
                expr = Binary { op: "<<", left: expr, right: self.term() };
            } else if self.is_triple_gt() {
                self.advance();
                self.advance();
                self.advance();
                expr = Binary { op: ">>>", left: expr, right: self.term() };
            } else if self.is_double_gt() {
                self.advance();
                self.advance();
                expr = Binary { op: ">>", left: expr, right: self.term() };
            } else {
                return expr;
            }
        }
    }

    fn term(&mut self) -> Expr {
        var expr = self.factor();
        while self.check(PLUS) || self.check(MINUS) {
            let op = self.advance().text;
            expr = Binary { op: op, left: expr, right: self.factor() };
        }
        return expr;
    }

    fn factor(&mut self) -> Expr {
        var expr = self.unary();
        while self.check(STAR) || self.check(SLASH) || self.check(PERCENT) {
            let op = self.advance().text;
            expr = Binary { op: op, left: expr, right: self.unary() };
        }
        return expr;
    }

    fn unary(&mut self) -> Expr {
        if self.check(BANG) || self.check(MINUS) {
            let op = self.advance().text;
            return Unary { op: op, expr: self.unary() };
        }
        // `&expr`/`&mut expr` (real `Codegen.hotc` usage: `self.mv.visitJumpInsn(153,
        // &else_label)`, passing a local by reference to an extern method param declared `&Type`)
        // -- a TRANSPARENT no-op wrapper, not a real tracked "reference" AST node the way the real
        // compiler's own `Expr.Borrow` is: this subset has no borrow-checking at all (same
        // "accepted but not distinguished" simplification `self_receiver`'s own `&`/`mut` handling
        // already makes, and the exact same treatment `type_name_ref` now gives a PARAM's `&Type`
        // annotation -- see that fn's own header). The JVM has no real notion of "reference to a
        // reference" anyway -- a `Label` value already IS a reference, so `&expr` and `expr`
        // compile to identical bytecode either way.
        if self.check(AMP) {
            self.advance();
            if self.check(MUT) { self.advance(); }
            return self.unary();
        }
        return self.cast();
    }

    // `expr as Type` -- a real gap found self-compiling `Lexer.hotc` (`JLong::parseLong(...) as
    // Int`). Chains at the same precedence real Kotlin/HC give it -- tighter than arithmetic,
    // looser than a bare primary/call/field-access chain, so `x as Int + 1` parses as `(x as Int)
    // + 1`, not `x as (Int + 1)`. See `Ast.hc`'s own `Cast` header for the deliberately narrow
    // scope (no cast-legality checking, `Long` not a general first-class primitive).
    // `expr is Type` joins `as` in this same loop -- see `Ast.hc`'s own `Expr.IsCheck` header for
    // why they share a precedence tier and chain freely in either order.
    // `expr?` -- the try operator, binds as a tight postfix, applying right after any `.field`/
    // `.method()`/`[index]` chain (`call_or_primary` already resolved) and before `as`/`is` get a
    // chance to bind. See `Ast.hc`'s own `Expr.TryOp` header for why it isn't named `Try`.
    // `expr??` (double try) parses fine here -- two nested `TryOp` nodes -- same "correct by the
    // desugaring rule, just unusual" the design doc for this feature calls out explicitly.
    fn try_postfix(&mut self) -> Expr {
        var expr = self.call_or_primary();
        // `?:` (Elvis, see `elvis()` above `assignment()`) and `?.` (safe call/field access, see
        // `postfix_loop`'s own `QUESTION`+`DOT` branch -- already fully consumed by the
        // `call_or_primary()` call above by the time this loop runs, so it never reaches here
        // unconsumed) both start with the SAME `QUESTION` token this loop would otherwise eat as a
        // `TryOp`. Only `?:` needs an explicit guard here -- a bare lookahead for `COLON` right
        // after `QUESTION`, so `x ?: y` correctly leaves the `?` for `elvis()` to consume instead of
        // wrapping `x` in a `TryOp` and choking on the dangling `: y`.
        while self.check(QUESTION) && self.tokens.get(self.pos + 1).kind != COLON {
            self.advance();
            expr = TryOp { expr: expr };
        }
        return expr;
    }

    fn cast(&mut self) -> Expr {
        var expr = self.try_postfix();
        while self.check(AS) || self.check(IS) {
            if self.check(AS) {
                self.advance();
                let target_type = self.type_name_ref();
                expr = Cast { expr: expr, target_type: target_type };
            } else {
                self.advance();
                let target_type2 = self.type_name_ref();
                expr = IsCheck { expr: expr, target_type: target_type2 };
            }
        }
        return expr;
    }

    // Scoped subset of the real `callOrPrimary`: a bare-identifier call (`name(args)`), field
    // access (`.field`), and method calls (`.method(args)`) chain freely off any primary
    // expression, left to right.
    // `arr_name[index].field` -- captured as its OWN `IndexFieldGet` shape (arr's NAME as a plain
    // `String`, not a nested `Ident` expr) rather than the generic `FieldAccess { obj: Index {...}
    // } }` nesting, for a real, structural reason found writing arena support: the CHECKER/CODEGEN
    // would otherwise need to inspect `obj`'s shape (is it an `Index` on an arena value?) via `if
    // let`/`match`, but this metalanguage's own move-checker treats ANY `if let`/`match` scrutinee
    // as consumed for EVERY arm (including a would-be "wasn't that shape, use the original value
    // generically" fallback) -- there's no wildcard arm that can bind "the whole original value" to
    // fall back on (see `Parser.hotc`'s OWN `assignment()`, whose header already documents this
    // same constraint one level up). A first attempt tried stashing the parsed index `Expr` in a
    // loop-scoped `var` across postfix-loop iterations (materializing it into a real `Index` node
    // once it became clear no `.field` was coming) -- broke for a DIFFERENT reason: consuming a
    // non-`Copy` `var` via `if let` more than once, even across DIFFERENT iterations of the SAME
    // loop with a reassignment in between, still isn't safe here (this checker's move-tracking
    // doesn't fully reset a `var`'s moved status just because a loop iteration ends -- the exact
    // same class of bug `Checker.hotc`'s own `declared_keys` hit earlier this session, see that
    // fix's header). The fix here is to decide the SHAPE up front via pure TOKEN lookahead
    // (`looks_like_index_field_access`, bracket-depth-aware, scanning for a `.` right after the
    // matching `]`) -- no `Expr` value is ever provisionally built and reconsidered, so there's
    // nothing to move twice. Only the plain `arr_name[idx].field` shape gets this treatment (an
    // arena buffer access can ONLY be a bare local/param this phase anyway, see `Ast.hc`'s own
    // `StructDecl.is_arena` header) -- `some_call()[idx].field` or `arr[idx][idx2].field` fall back
    // to the ordinary `Index`/`FieldAccess` nesting via the untouched, original postfix loop.
    fn call_or_primary(&mut self) -> Expr {
        if self.check(IDENT) {
            if self.pos + 1 < self.tokens.length() {
                let nxt = self.tokens.get(self.pos + 1);
                if nxt.kind == LBRACKET && self.looks_like_index_field_access() {
                    let arr_name = self.peek().text;
                    self.advance(); // IDENT
                    self.advance(); // LBRACKET
                    let idx = self.expression();
                    self.expect(RBRACKET);
                    self.expect(DOT);
                    let field = self.expect(IDENT).text;
                    return self.postfix_loop(IndexFieldGet { arr_name: arr_name, index: idx, field: field });
                }
            }
        }
        let expr = self.primary();
        return self.postfix_loop(expr);
    }

    // Bracket-depth-aware, non-consuming lookahead from the CURRENT position (an `IDENT` known to
    // be immediately followed by `[`): true iff the token right after the MATCHING `]` is a `.` --
    // i.e., this really is `arr_name[...].field`, not just `arr_name[...]` used some other way
    // (`arr_name[...] + 1`, `arr_name[...];`, ...). Depth-tracked so a nested bracket inside the
    // index expression itself (`buf[other[0]].field`) doesn't stop at the WRONG `]`.
    // Must ALSO confirm `.field` isn't actually `.method(...)` -- a real gap found running this
    // exact check against `arr[i].length()` (real, pre-existing `demo_program22.hcsrc` usage): the
    // FIRST version of this only checked for a `.` right after the matching `]`, which is also
    // true for a METHOD call on an indexed element, not just a plain field read. `IndexFieldGet`
    // only ever represents a bare field access (see `Ast.hc`'s own header) -- a trailing `(` after
    // the field name means this is `arr[i].method(...)`, which must fall through to the ordinary
    // `Index`-then-`MethodCall` postfix-loop path instead.
    fn looks_like_index_field_access(&self) -> Bool {
        var i = self.pos + 1; // the opening `[`
        var depth = 0;
        while i < self.tokens.length() {
            if self.tokens.get(i).kind == LBRACKET { depth = depth + 1; }
            if self.tokens.get(i).kind == RBRACKET {
                depth = depth - 1;
                if depth == 0 {
                    if i + 2 < self.tokens.length() {
                        if self.tokens.get(i + 1).kind != DOT { return false; }
                        if self.tokens.get(i + 2).kind != IDENT { return false; }
                        if i + 3 < self.tokens.length() {
                            return self.tokens.get(i + 3).kind != LPAREN;
                        }
                        return true;
                    }
                    return false;
                }
            }
            i = i + 1;
        }
        return false;
    }

    fn postfix_loop(&mut self, start: Expr) -> Expr {
        var expr = start;
        while true {
            if self.check(LPAREN) {
                if let Ident { name } = expr {
                    self.advance();
                    let args = self.arg_list();
                    expr = Call { callee: name, args: args };
                } else {
                    throw ParseError::new("Only named functions can be called");
                }
            } else if self.check(DOT) {
                self.advance();
                // `recv.open(...)` -- same real keyword collision `extern_method_name`'s own
                // header documents (`javax.sound.sampled.Clip.open(...)`, a real JDK method a
                // caller needs to actually CALL, not just declare). Safe to loosen here too:
                // right after `.`, the next token is ALWAYS a field/method name, never a real
                // `pub open module ...` declaration (which only ever appears at the top level).
                let field = self.extern_method_name();
                if self.check(LPAREN) {
                    self.advance();
                    let args = self.arg_list();
                    expr = MethodCall { recv: expr, method: field, args: args };
                } else {
                    expr = FieldAccess { obj: expr, field: field };
                }
            } else if self.check(LBRACKET) {
                self.advance();
                let idx = self.expression();
                if self.check(DOTDOT) || self.check(DOTDOTEQ) {
                    let inclusive = self.check(DOTDOTEQ);
                    self.advance();
                    let end = self.expression();
                    self.expect(RBRACKET);
                    expr = Slice { arr: expr, start: idx, end: end, inclusive: inclusive };
                } else {
                    self.expect(RBRACKET);
                    expr = Index { arr: expr, index: idx };
                }
            } else if self.check(QUESTION) && self.tokens.get(self.pos + 1).kind == DOT {
                // `x?.field` / `x?.method(args)` -- safe navigation. See `Ast.hc`'s own
                // `Expr.SafeCall`/`Expr.SafeFieldAccess` header. Consumed HERE, inside the ordinary
                // postfix chain (alongside plain `.`), not deferred to `try_postfix`'s own `?`
                // loop -- by the time that loop runs, this branch has already eaten it.
                self.advance(); // QUESTION
                self.advance(); // DOT
                let field2 = self.expect(IDENT).text;
                if self.check(LPAREN) {
                    self.advance();
                    let args2 = self.arg_list();
                    expr = SafeCall { recv: expr, method: field2, args: args2 };
                } else {
                    expr = SafeFieldAccess { recv: expr, field: field2 };
                }
            } else {
                return expr;
            }
        }
    }

    // `name: value` -- a named argument, see `Ast.hc`'s own `Expr.NamedArg` header. Unambiguous
    // via a bounded 1-token lookahead (`IDENT` immediately followed by `COLON`): no legal
    // expression production in this grammar ever has a bare `COLON` right after a leading `IDENT`
    // otherwise, so this can't misfire on an ordinary positional arg that merely starts with an
    // identifier (`x`, `x + 1`, `foo()`, ...).
    fn one_arg(&mut self) -> Expr {
        if self.check(IDENT) && self.tokens.get(self.pos + 1).kind == COLON {
            let name = self.advance().text;
            self.advance(); // COLON
            let value = self.expression();
            return NamedArg { name: name, value: value };
        }
        return self.expression();
    }

    fn arg_list(&mut self) -> Vec<Expr> {
        if self.check(RPAREN) {
            self.advance();
            return empty_expr_vec();
        }
        var args = vec_of(self.one_arg());
        while self.match_kind(COMMA) {
            if self.check(RPAREN) { break; }
            args.push(self.one_arg());
        }
        self.expect(RPAREN);
        return args;
    }

    // `|| expr` / `|x, y| expr` -- a lambda literal, see `Ast.hc`'s own `Expr.Lambda` header.
    // Unambiguous at the START of a primary expression: `bitwise_or`/`logical_or` (this file's own
    // `PIPE`/`PIPEPIPE`-consuming precedence levels) only ever consume those tokens AFTER already
    // parsing a left operand, so seeing either one here can only mean a lambda is starting, never a
    // stray `|`/`||` operator. Params are bare names, no declared types -- always inferred from the
    // target method's own signature at check time (see `Checker.hotc`'s own `check_lambda`), so this
    // is just an `IDENT`-comma-list, not a real `one_param()`-style parse. Body is parsed at the same
    // `expression()` level as anything else -- naturally stops at the enclosing call's own `)`/`,`,
    // same as any other argument expression.
    fn lambda_lit(&mut self) -> Expr {
        var params = empty_str_vec();
        if self.check(PIPEPIPE) {
            self.advance();
        } else {
            self.expect(PIPE);
            if !self.check(PIPE) {
                params.push(self.expect(IDENT).text);
                while self.match_kind(COMMA) {
                    params.push(self.expect(IDENT).text);
                }
            }
            self.expect(PIPE);
        }
        let body = self.expression();
        return Lambda { params: params, body: body };
    }

    fn primary(&mut self) -> Expr {
        if self.check(PIPE) || self.check(PIPEPIPE) {
            return self.lambda_lit();
        }
        // `dev` -- see `Ast.hc`'s own `IDEAS.md` note on `@dev`/conditional compilation. A reserved
        // keyword (`Lexer.hotc`'s own `DEV` token), used ONLY as the exact condition of an `if dev
        // { ... }` block -- `Driver.hotc`'s own `strip_dev_blocks` recognizes that EXACT shape
        // (an `If` whose `cond` is `Ident { name: "dev" }`) and either splices the block's body in
        // unconditionally (dev build) or drops it entirely (release build) as a real AST rewrite
        // pass BEFORE the checker ever runs -- never a real runtime branch. Reusing the plain
        // `Ident` node (rather than a dedicated new one) is what makes that recognition a simple
        // shape match instead of needing its own new `Expr` variant.
        if self.check(DEV) {
            self.advance();
            return Ident { name: "dev" };
        }
        // `3.5f` / `3.5` -- see `Ast.hc`'s own `Expr.FloatLit`/`Expr.DoubleLit` header for why the
        // literal's own source text is kept as-is rather than parsed into a native value here.
        if self.check(FLOAT) {
            let t = self.advance();
            return FloatLit { text: t.text };
        }
        if self.check(DOUBLE) {
            let t = self.advance();
            return DoubleLit { text: t.text };
        }
        if self.check(INT) {
            let t = self.advance();
            return IntLit { value: parse_int(t.text) };
        }
        // `123L` -- a real `Long` literal, full 64-bit precision. An EARLIER version of this
        // parsed the digits through `parse_int`'s own `Int`-width precision first, then wrapped
        // the result in `as Long` -- correct for a small literal, but silently truncating any
        // value naming something outside `Int`'s own 32-bit range (`9999999999L`), which defeats
        // half the point of having `Long` at all. Real `LongLit { text }` now instead (see
        // `Ast.hc`'s own header) -- `Codegen.hotc`'s own `JLongCg::valueOf(String)` parses the
        // FULL text directly as a real `Long` only once a real LDC constant is actually needed.
        if self.check(LONG) {
            let t2 = self.advance();
            return LongLit { text: t2.text };
        }
        // `'a'` -- a real `Char` literal. `Lexer.hotc`'s own `char_literal` already resolved the
        // escape/code-point at lex time; `Token.text` here is just that resolved code point's
        // own decimal string, read back via `parse_int` (same convention `INT` tokens already
        // use for their own `IntLit { value }`).
        if self.check(CHAR) {
            let t3 = self.advance();
            return CharLit { value: parse_int(t3.text) };
        }
        // `arena Name[count]` -- see `Ast.hc`'s own `ArenaNew` header.
        if self.check(ARENA) {
            self.advance();
            let name = self.expect(IDENT).text;
            self.expect(LBRACKET);
            let count = self.expression();
            self.expect(RBRACKET);
            return ArenaNew { struct_name: name, count: count };
        }
        if self.check(STRING) {
            let t = self.advance();
            return StringLit { value: t.text };
        }
        if self.check(ISTRING_BEGIN) {
            return self.istring_expr();
        }
        if self.check(TRUE) {
            self.advance();
            return BoolLit { value: true };
        }
        if self.check(FALSE) {
            self.advance();
            return BoolLit { value: false };
        }
        if self.check(NULL) {
            self.advance();
            return NullLit;
        }
        if self.check(LPAREN) {
            self.advance();
            let inner = self.expression();
            self.expect(RPAREN);
            return inner;
        }
        if self.check(IDENT) {
            let t = self.advance();
            // `Name<Arg> { ... }` -- a generic struct literal. Genuinely ambiguous with `Name <
            // Arg > { ... }` (a less-than comparison whose result then gets... nothing, that's
            // not even valid syntax after it, but the *parser* can't know that without deciding
            // first) -- resolved with a bounded, non-consuming 3-token lookahead
            // (`looks_like_generic_lit`) rather than true backtracking, so only the exact shape
            // `< IDENT > {` commits to the generic-literal reading. Single type argument only,
            // same scope cut `type_name_ref`'s own header discloses for type positions.
            if self.check(LT) && !self.no_struct_lit && self.looks_like_generic_lit() {
                self.advance(); // LT
                let type_arg = self.expect(IDENT).text;
                self.expect(GT);
                return self.struct_lit(t.text + "$" + type_arg, none_string());
            }
            // `HashMap<ItemStack, Int> { ... }` -- the TWO-type-argument plain struct literal
            // shape, see `Ast.hc`'s own `StructDecl.type_param2` header and this file's own
            // `looks_like_generic_lit2`. Checked before the one-arg case's own fallthrough would
            // ever matter since the two are mutually exclusive by shape (see that fn's header).
            if self.check(LT) && !self.no_struct_lit && self.looks_like_generic_lit2() {
                self.advance(); // LT
                let type_arg1 = self.expect(IDENT).text;
                self.expect(COMMA);
                let type_arg2 = self.expect(IDENT).text;
                self.expect(GT);
                return self.struct_lit(t.text + "$" + type_arg1 + "$" + type_arg2, none_string());
            }
            // `Vec<Entry<V>> { ... }` -- the NESTED generic literal shape, see
            // `looks_like_nested_generic_lit`'s own header.
            if self.check(LT) && !self.no_struct_lit && self.looks_like_nested_generic_lit() {
                self.advance(); // LT
                let type_arg = self.type_name_ref();
                self.expect(GT);
                return self.struct_lit(t.text + "$" + type_arg, none_string());
            }
            // `Base<Arg>::Variant { ... }` -- explicitly-qualified generic-enum-variant
            // construction (see `Ast.hc`'s own `EnumDecl` header for why this can't just be bare
            // `Variant { ... }` like a non-generic enum's variants). Checked before the plain
            // `COLONCOLON` branch below so `Option<Int>::Some` doesn't get misread as a
            // `StaticCall` with `type_name: "Option"` (the `<Int>` would be lost).
            if self.check(LT) && !self.no_struct_lit && self.looks_like_generic_variant() {
                self.advance(); // LT
                let type_arg = self.expect(IDENT).text;
                self.expect(GT);
                self.expect(COLONCOLON);
                let variant_name = self.expect(IDENT).text;
                return self.struct_lit(variant_name, some_string(t.text + "$" + type_arg));
            }
            // `Result<Int, String>::Ok { ... }` -- the two-type-argument shape, see
            // `looks_like_generic_variant2`'s own header.
            if self.check(LT) && !self.no_struct_lit && self.looks_like_generic_variant2() {
                self.advance(); // LT
                let type_arg1 = self.expect(IDENT).text;
                self.expect(COMMA);
                let type_arg2 = self.expect(IDENT).text;
                self.expect(GT);
                self.expect(COLONCOLON);
                let variant_name2 = self.expect(IDENT).text;
                return self.struct_lit(variant_name2, some_string(t.text + "$" + type_arg1 + "$" + type_arg2));
            }
            if self.check(LBRACE) && !self.no_struct_lit {
                return self.struct_lit(t.text, none_string());
            }
            if self.check(COLONCOLON) {
                self.advance();
                let method = self.expect(IDENT).text;
                if self.check(LPAREN) {
                    self.advance();
                    let args = self.arg_list();
                    return StaticCall { type_name: t.text, method: method, args: args };
                }
                return ExternStaticFieldGet { type_name: t.text, field: method };
            }
            return Ident { name: t.text };
        }
        if self.check(LBRACKET) {
            return self.array_lit();
        }
        let t = self.peek();
        throw ParseError::new("Parse error at line " + JString3::valueOf(t.line) + ": unexpected token '" + t.text + "'");
    }

    // `"a{x}b{y}c"` -- `Lexer.hotc`'s own `string_tokens` already did the hard part (recursively
    // re-lexing each `{...}` span); this just consumes the resulting flat token stream, one
    // `ISTRING_PART` per literal segment, one full sub-expression (via the ordinary `expression()`,
    // recursing into the ALREADY-EMBEDDED tokens exactly like any parenthesized expression would)
    // per gap between them.
    fn istring_expr(&mut self) -> Expr {
        self.expect(ISTRING_BEGIN);
        var literals = vec_of(self.expect(ISTRING_PART).text);
        var exprs = empty_expr_vec();
        while !self.check(ISTRING_END) {
            exprs.push(self.expression());
            literals.push(self.expect(ISTRING_PART).text);
        }
        self.expect(ISTRING_END);
        return StringInterp { literals: literals, exprs: exprs };
    }

    // `[e1, e2, ...]` -- usually non-empty (see `Ast.hc`'s own header), but a genuine `[]` (real
    // empty array literal, ZERO elements) is now accepted too -- `Checker.hotc`'s own
    // `check_struct_lit` and `Codegen.hotc`'s own struct-literal field-construction loop are the
    // only two places that actually know how to make sense of one (both require the DECLARED
    // field type to already be an array type, since there's no element to infer from) -- anywhere
    // else `[]` is used, `check_array_lit`'s own existing "empty array literal not supported"
    // error still fires, unchanged. This exists specifically so a genuinely empty `Vec<T>` can be
    // built via `Vec<T> { data: [], len: 0 }` for a CONCRETE `T` known at the call site -- see
    // `COLLECTIONS_IDEAS.md`'s own note on why a fully generic `Vec<T>::empty()` (no explicit `T`
    // in sight at all) is a separate, much bigger ask this doesn't attempt.
    fn array_lit(&mut self) -> Expr {
        self.expect(LBRACKET);
        if self.check(RBRACKET) {
            self.advance();
            return ArrayLit { elements: empty_expr_vec() };
        }
        let first = self.expression();
        // `[value; count]` vs `[e1, e2, ...]` vs `[result_expr for var_name in iter_expr if cond]`
        // -- distinguished by whether a `;`, a `for`, or a `,`/`]` follows the first expression
        // (see `Ast.hc`'s own `ArrayRepeat`/`Comprehension` headers). An early `return` inside any
        // branch here (rather than this exhaustive `if`/`else if`/`else`) would trip the move-
        // checker's conservative branch handling -- it doesn't reason about reachability past a
        // `return`, so code after using `first` again would see it as still-possibly-moved even
        // though the three paths are genuinely exclusive (the same trap hit and fixed in
        // `Checker.hotc`'s own `register_enum`).
        if self.check(SEMI) {
            self.advance();
            let count = self.expression();
            self.expect(RBRACKET);
            return ArrayRepeat { value: first, count: count };
        } else if self.check(FOR) {
            self.advance();
            let var_name = self.expect(IDENT).text;
            self.expect(IN);
            let iter_expr = self.expression();
            var cond = none_expr();
            if self.match_kind(IF) {
                cond = some_expr(self.expression());
            }
            self.expect(RBRACKET);
            return Comprehension { result_expr: first, var_name: var_name, iter_expr: iter_expr, cond: cond };
        } else {
            var elements = vec_of(first);
            while self.match_kind(COMMA) {
                if self.check(RBRACKET) { break; }
                elements.push(self.expression());
            }
            self.expect(RBRACKET);
            return ArrayLit { elements: elements };
        }
    }

    // `Name { field: expr, field: expr, ... }` -- `name` is already-consumed (the `IDENT` token
    // text); called right after `primary` sees `IDENT` immediately followed by `LBRACE`.
    // `generic_base` is `Some("Option$Int")` when this literal came from the explicitly-qualified
    // `Base<Arg>::Variant { ... }` form (see `Ast.hc`'s own `EnumDecl` header); `None` otherwise.
    fn struct_lit(&mut self, name: String, generic_base: Option<String>) -> Expr {
        self.expect(LBRACE);
        var field_names = empty_str_vec();
        var field_values = empty_expr_vec();
        if !self.check(RBRACE) {
            let fname0 = self.expect(IDENT).text;
            self.expect(COLON);
            let fval0 = self.expression();
            field_names.push(fname0);
            field_values.push(fval0);
            while self.match_kind(COMMA) {
                if self.check(RBRACE) { break; }
                let fname = self.expect(IDENT).text;
                self.expect(COLON);
                let fval = self.expression();
                field_names.push(fname);
                field_values.push(fval);
            }
        }
        self.expect(RBRACE);
        return StructLit { name: name, field_names: field_names, field_values: field_values, generic_base: generic_base };
    }

    // === Statements ===

    // `parallel for x in arr { expr; }` -- see the `Parser` struct's own `parallel_for_counter`/
    // `needs_phoenix` header for the design summary. Desugars ENTIRELY into ordinary, already-
    // proven statements/expressions -- a fresh `PhoenixPool`, a `Vec<PhoenixTask>` built by
    // spawning one task per element (each capturing `x`, the CURRENT element, via an ordinary
    // zero-param lambda literal), then `join_all_and_shutdown` before continuing -- so NEITHER the
    // checker NOR codegen need a single new line of code: `@sendable`'s own EXISTING lambda-
    // capture-safety check (already wired to `PhoenixPool::spawn`'s own lambda argument)
    // automatically verifies `x`'s own type (and anything else `expr` captures) is safe to hand to
    // a background task -- exactly the guarantee this feature exists for. Real, disclosed v1
    // scope cuts:
    // - `expr` must be a single EXPRESSION (the body's own `{ ... }` must contain exactly one
    //   `ExprStmt`) -- lambda literals in this language only ever support a single-expression
    //   body (the same real, pre-existing limit `HOTC_MC_IDEAS.md`'s own "trailing-block DSL
    //   syntax" entry already flags), so there's no way to wrap a genuinely multi-statement body
    //   as the spawned task's own closure without a bigger, separate lambda-body extension.
    // - only the `Vec<T>`-iteration shape (`parallel for x in arr { ... }`), not the range shape
    //   (`parallel for i in a..b { ... }`) -- `.length()`/`.get(i)` are real `Vec<T>` methods
    //   either way, so this is scoped to that one common real source shape for now.
    // - a fixed worker count (4) this pass, not sized to the real element count -- "correctness
    //   first," the same real, disclosed cost `ECS_IDEAS.md`'s own per-`run_all()` pool already
    //   accepts.
    fn parallel_for_stmts(&mut self, start_line: Int) -> Vec<Stmt> {
        self.expect(PARALLEL);
        self.expect(FOR);
        let var_name = self.expect(IDENT).text;
        self.expect(IN);
        self.no_struct_lit = true;
        let arr_expr = self.expression();
        self.no_struct_lit = false;
        let body = self.block();
        if body.length() != 1 {
            throw ParseError::new("'parallel for' body must be exactly one expression statement (a single 'x.method(...);'-shaped line), got " + JString3::valueOf(body.length()) + " statements");
        }
        var inner_expr = IntLit { value: 0 };
        var got_expr = false;
        match body.get(0) {
            ExprStmt { expr, line } => { inner_expr = expr; got_expr = true; }
            _ => {}
        }
        if !got_expr {
            throw ParseError::new("'parallel for' body must be a single expression statement (a bare 'x.method(...);'-shaped line), not a let/if/while/etc.");
        }
        self.needs_phoenix = true;
        let n = self.parallel_for_counter;
        self.parallel_for_counter = n + 1;
        let suffix = JString3::valueOf(n);
        let pool_name = "__pf_pool" + suffix;
        let tasks_name = "__pf_tasks" + suffix;
        let idx_name = "__pf_i" + suffix;

        var out = empty_stmt_vec();
        // NO intermediate `let __pf_arrN = arr_expr;` here -- deliberately: that would be a real
        // `let x = someVar;` MOVE of `arr_expr` when it's a bare identifier (`Checker.hotc`'s own
        // move-checking, `TyChecker.moved`), making the CALLER's own array/`Vec` unusable after
        // the loop -- a real regression an EARLIER version of this had, caught testing it (the
        // ordinary, non-`parallel` `for x in arr { }` never moves `arr` either, see README's own
        // "Loops" section). `arr_expr` is instead embedded DIRECTLY into two struct-literal-
        // shaped `MethodCall` nodes below (`.length()`, `.get(idx)`) -- safe because struct-
        // literal field VALUES are deliberately never move-checked (same exemption sharing one
        // already-built value elsewhere in a struct literal already relies on), and because
        // `Vec<T>::length`/`::get` both take `&self`, never moving their receiver regardless.
        // `var __pf_poolN = PhoenixPool::new(4);`
        var pool_args = empty_expr_vec();
        pool_args.push(IntLit { value: 4 });
        out.push(Let { name: pool_name, mutable: true, init: StaticCall { type_name: "PhoenixPool", method: "new", args: pool_args }, declared_type: none_string(), line: start_line });
        // var __pf_tasksN = Vec<PhoenixTask> { data: [], len: 0 };
        var tasks_fnames = empty_str_vec();
        tasks_fnames.push("data");
        tasks_fnames.push("len");
        var tasks_fvals = empty_expr_vec();
        tasks_fvals.push(ArrayLit { elements: empty_expr_vec() });
        tasks_fvals.push(IntLit { value: 0 });
        out.push(Let { name: tasks_name, mutable: true, init: StructLit { name: "Vec$PhoenixTask", field_names: tasks_fnames, field_values: tasks_fvals, generic_base: none_string() }, declared_type: none_string(), line: start_line });
        // var __pf_iN = 0;
        out.push(Let { name: idx_name, mutable: true, init: IntLit { value: 0 }, declared_type: none_string(), line: start_line });
        // while __pf_iN < __pf_arrN.length() { let x = __pf_arrN.get(__pf_iN); __pf_tasksN.push(__pf_poolN.spawn(|| expr)); __pf_iN = __pf_iN + 1; }
        let len_call = MethodCall { recv: arr_expr, method: "length", args: empty_expr_vec() };
        let cond = Binary { op: "<", left: Ident { name: idx_name }, right: len_call };
        var get_args = empty_expr_vec();
        get_args.push(Ident { name: idx_name });
        let get_call = MethodCall { recv: arr_expr, method: "get", args: get_args };
        // `mutable: true` (a real `var`, not `let`) -- Phase 3 borrow checking only allows
        // assigning into a local's own fields (`x.value = ...;`) when the BINDING itself is
        // `var`; the whole point of a real `parallel for` body is usually mutating the current
        // element, so this has to be mutable to be useful at all.
        let elem_let = Let { name: var_name, mutable: true, init: get_call, declared_type: none_string(), line: start_line };
        // `PhoenixCallable::call(&self) -> PhoenixObject` -- every spawned lambda's own body has
        // to resolve to a real `PhoenixObject` (see `stdlib/phoenix.hotc`'s own established
        // convention, e.g. `pool.spawn(|| "{step(1)}" as PhoenixObject)`), even though this
        // feature always discards the actual result (`join_all_and_shutdown` never reads a task's
        // own return value) -- wrapping `expr` in the SAME `as PhoenixObject` cast automatically
        // means the caller never has to write it themselves. Real, disclosed v1 consequence: this
        // needs `expr` to actually produce a real value (an `Int`/`Bool`/struct/etc, boxed by the
        // cast) -- a bare call to a `Unit`-returning method as the WHOLE body wouldn't have
        // anything real to box; not attempted here, matches the single-expression-body cut above.
        let lambda = Lambda { params: empty_str_vec(), body: Cast { expr: inner_expr, target_type: "PhoenixObject" } };
        var spawn_args = empty_expr_vec();
        spawn_args.push(lambda);
        let spawn_call = MethodCall { recv: Ident { name: pool_name }, method: "spawn", args: spawn_args };
        var push_args = empty_expr_vec();
        push_args.push(spawn_call);
        let push_call = MethodCall { recv: Ident { name: tasks_name }, method: "push", args: push_args };
        let push_stmt = ExprStmt { expr: push_call, line: start_line };
        let incr = Assign { name: idx_name, value: Binary { op: "+", left: Ident { name: idx_name }, right: IntLit { value: 1 } } };
        let incr_stmt = ExprStmt { expr: incr, line: start_line };
        var while_body = empty_stmt_vec();
        while_body.push(elem_let);
        while_body.push(push_stmt);
        while_body.push(incr_stmt);
        out.push(While { cond: cond, body: while_body, line: start_line });
        // __pf_poolN.join_all_and_shutdown(__pf_tasksN);
        var join_args = empty_expr_vec();
        join_args.push(Ident { name: tasks_name });
        let join_call = MethodCall { recv: Ident { name: pool_name }, method: "join_all_and_shutdown", args: join_args };
        out.push(ExprStmt { expr: join_call, line: start_line });
        return out;
    }

    // `@derive(Eq, Hash)` on a `struct` -- synthesizes real `impl Eq for Name { fn equals(&self,
    // other: &Name) -> Bool { ... } }` / `impl Hashable for Name { fn hash_key(&self) -> Int {
    // ... } }` blocks, field by field, so a caller of `HashMap2<Name, V>` (or anything else
    // wanting real value equality on `Name`) never has to hand-write the boilerplate this file's
    // own `stdlib/collections.hotc` header already documents as the required opt-in (see
    // `examples/hashmap2_itemstack.hotc`'s own hand-written `impl Hashable for ItemStack`/`impl Eq
    // for ItemStack` for exactly what this generates automatically instead). Pure parser-level AST
    // synthesis, same strategy `parallel_for_stmts`/`Driver.hotc`'s own `@dev` pass already use --
    // desugars entirely into ordinary, already-checked/already-codegenned `impl` blocks, so
    // NEITHER `Checker.hotc` NOR `Codegen.hotc` need a single new line for this feature (multiple
    // interfaces on one struct already works -- see `Codegen.hotc`'s own `struct_interfaces_of`
    // fix -- so `Eq`+`Hashable` together on the same struct is safe).
    //
    // **Field-type dispatch, real and disclosed.** Equality: `Int`/`Bool`/`Char`/`Byte`/`Long`/
    // `Float`/`Double`/`String` fields compare with `==` (already exact for every one of those --
    // `String` goes through null-safe `Objects.equals`/`.equals()`, see `Codegen.hotc`'s own
    // `gen_binary` header); any OTHER field type (a nested struct/enum) dispatches through
    // `.equals(other.field)` instead, trusting that field's own type to implement `Eq` itself (a
    // real, clear "no such method" compile error if it doesn't, rather than silently falling back
    // to `==`'s own reference-identity gap on a plain struct field -- see that fn's own header).
    // Hashing: the same seven numeric-ish primitives combine via `(value as Int)` (a legitimate,
    // lossy-but-valid narrowing per `Codegen.hotc`'s own `gen_cast` -- `Bool`'s `0`/`1`
    // representation on the JVM stack is bit-identical to `Int`'s, so the cast is a real, safe
    // no-op there too, not just for the numeric pairs `gen_cast` has dedicated opcodes for);
    // `String` calls `hash_string_hc` (`stdlib/collections.hotc`'s own hand-rolled polynomial
    // hash -- exactly why `needs_collections` auto-injects that topic, not just for `Hashable`'s
    // own declaration); anything else dispatches through `.hash_key()`, same "trust the nested
    // type's own derive/impl" reasoning as `equals` above. Both fold via the standard `h = h * 31
    // + fieldHash` polynomial shape (`Object.hashCode()`'s own convention) -- zero fields yields
    // `true`/`0` respectively, not an error (an empty marker struct is a legitimate, if unusual,
    // hash-map key). Scope cut, disclosed: a NULLABLE field (`Int?`, `String?`, ...) is matched by
    // EXACT type-name string in `is_derive_numeric_type_hc`/the `String` check below, so the
    // trailing `?` always misses and falls through to the `.hash_key()`/`.equals()` dispatch meant
    // for nested struct/enum fields -- a real, clear "no such method" compile error for a nullable
    // field, not silent wrongness, but not specifically supported this pass either (not attempted:
    // `==`'s own reference-identity gap on a nullable NON-String type -- see `Codegen.hotc`'s own
    // `gen_binary` header -- means naively stripping the `?` here wouldn't actually be correct for
    // every nullable primitive anyway).
    fn derive_impls(&mut self, sd: &StructDecl, kinds: &Vec<String>) -> Vec<ImplDecl> {
        var out = empty_impl_decl_vec();
        var wants_eq = false;
        var wants_hash = false;
        var wants_snapshot = false;
        var ki = 0;
        while ki < kinds.length() {
            let k = kinds.get(ki);
            if k == "Eq" {
                wants_eq = true;
            } else if k == "Hash" {
                wants_hash = true;
            } else if k == "Snapshot" {
                wants_snapshot = true;
            } else {
                throw ParseError::new("'@derive(" + k + ")' isn't supported -- only 'Eq', 'Hash', and 'Snapshot' can be derived");
            }
            ki = ki + 1;
        }
        if wants_eq || wants_hash {
            // `Eq`/`Hashable` are only declared in `stdlib/collections.hotc` -- see
            // `needs_collections`'s own header.
            self.needs_collections = true;
        }
        if wants_eq {
            var eq_expr = BoolLit { value: true };
            var has_field = false;
            var fi = 0;
            while fi < sd.fields.length() {
                let f = sd.fields.get(fi);
                let one = derive_field_eq_expr(&f);
                if has_field {
                    eq_expr = Binary { op: "&&", left: eq_expr, right: one };
                } else {
                    eq_expr = one;
                    has_field = true;
                }
                fi = fi + 1;
            }
            var eq_body = empty_stmt_vec();
            eq_body.push(Return { value: some_expr(eq_expr), line: 0 });
            var eq_params = empty_param_vec();
            eq_params.push(Param { name: "other", type_name: sd.name, is_ref: true, is_mut_ref: false });
            var eq_methods = empty_fn_decl_vec();
            eq_methods.push(FnDecl { name: "equals", params: eq_params, ret_type: some_string("Bool"), body: eq_body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() });
            out.push(ImplDecl { struct_name: sd.name, methods: eq_methods, static_methods: empty_fn_decl_vec(), interface_name: some_string("Eq"), delegate_field: none_string() });
        }
        if wants_hash {
            var hash_expr = IntLit { value: 0 };
            var hi = 0;
            while hi < sd.fields.length() {
                let f = sd.fields.get(hi);
                let fh = derive_field_hash_expr(&f);
                hash_expr = Binary { op: "+", left: Binary { op: "*", left: hash_expr, right: IntLit { value: 31 } }, right: fh };
                hi = hi + 1;
            }
            var hash_body = empty_stmt_vec();
            hash_body.push(Return { value: some_expr(hash_expr), line: 0 });
            var hash_methods = empty_fn_decl_vec();
            hash_methods.push(FnDecl { name: "hash_key", params: empty_param_vec(), ret_type: some_string("Int"), body: hash_body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() });
            out.push(ImplDecl { struct_name: sd.name, methods: hash_methods, static_methods: empty_fn_decl_vec(), interface_name: some_string("Hashable"), delegate_field: none_string() });
        }
        // `@derive(Snapshot)` -- rewind support for `@deterministic` simulation state (see
        // `IDEAS.md`'s own "`@deterministic` + replay/rewind" entry). `snapshot(&self) -> Self`
        // builds a fresh copy field by field (a real, shallow copy -- a reference-typed field
        // copies the REFERENCE, not a deep clone of whatever it points to, same disclosed
        // shallowness `@derive(Eq, Hash)`'s own field-by-field dispatch already has for nested
        // struct fields); `restore(&mut self, snap: &Self)` writes every field of `snap` back
        // onto `self` in place. Together: `let saved = state.snapshot(); ...simulate...; state.
        // restore(&saved);` genuinely rewinds `state` to exactly what it held at the snapshot
        // point. Not an interface (`Eq`/`Hashable` are real, both declared in `stdlib/
        // collections.hotc` -- there's no equivalent "Snapshot" interface anywhere, so this is
        // just two plain inherent methods, `interface_name: None`).
        if wants_snapshot {
            var snap_fnames = empty_str_vec();
            var snap_fvals = empty_expr_vec();
            var restore_body = empty_stmt_vec();
            var fi2 = 0;
            while fi2 < sd.fields.length() {
                let f2 = sd.fields.get(fi2);
                snap_fnames.push(f2.name);
                snap_fvals.push(FieldAccess { obj: Ident { name: "self" }, field: f2.name });
                restore_body.push(ExprStmt { expr: FieldAssign { obj: Ident { name: "self" }, field: f2.name, value: FieldAccess { obj: Ident { name: "snap" }, field: f2.name } }, line: 0 });
                fi2 = fi2 + 1;
            }
            var snap_body = empty_stmt_vec();
            snap_body.push(Return { value: some_expr(StructLit { name: sd.name, field_names: snap_fnames, field_values: snap_fvals, generic_base: none_string() }), line: 0 });
            var restore_params = empty_param_vec();
            restore_params.push(Param { name: "snap", type_name: sd.name, is_ref: true, is_mut_ref: false });
            var snap_methods = empty_fn_decl_vec();
            snap_methods.push(FnDecl { name: "snapshot", params: empty_param_vec(), ret_type: some_string(sd.name), body: snap_body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() });
            snap_methods.push(FnDecl { name: "restore", params: restore_params, ret_type: none_string(), body: restore_body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: true, type_param2: none_string(), type_bounds2: empty_str_vec() });
            out.push(ImplDecl { struct_name: sd.name, methods: snap_methods, static_methods: empty_fn_decl_vec(), interface_name: none_string(), delegate_field: none_string() });
        }
        return out;
    }

    // `unit Name(Base);` -- units-as-types: a distinct newtype struct wrapping a numeric
    // primitive (`Int`/`Long`/`Float`/`Double`), with real `+`/`-`/`*`/`/`/`==` operator overloads
    // generated automatically (reusing `Checker.hotc`'s own EXISTING operator-overload dispatch --
    // see that file's own `check_binary` header: a plain struct method named `add`/`sub`/`mul`/
    // `div`/`eq` already lets `+`/`-`/`*`/`/`/`==` dispatch to it instead of requiring a built-in
    // numeric type, ZERO Checker.hotc/Codegen.hotc changes needed for this feature at all). The
    // real payoff: `Ticks + Degrees` is a genuine, checker-caught type error (`check_binary`'s own
    // `en != rn` mismatch against `add`'s declared `other: Ticks` parameter), not just a naming
    // convention a caller could still accidentally violate.
    //
    // Generates, per `unit Ticks(Int);`:
    // - `struct Ticks { value: Int }` (`value` is an ordinary, publicly-accessible field, same as
    //   every other struct field in this subset -- no accessor method needed for reading it back
    //   out).
    // - `impl Ticks { fn add(&self, other: &Ticks) -> Ticks { ... } fn sub(...) ... fn eq(...) ...
    //   fn mul(&self, factor: Int) -> Ticks { ... } fn div(...) ... }` -- `add`/`sub`/`eq` take
    //   ANOTHER `Ticks` (same-unit arithmetic/equality); `mul`/`div` take a bare `Int` SCALAR
    //   (`t * 3`, real unit-times-scalar multiplication, not unit-times-unit -- units-of-units
    //   aren't attempted this pass, see this fn's own scope-cut note below).
    // - `fn ticks(v: Int) -> Ticks { return Ticks { value: v }; }` -- a free constructor,
    //   lowercasing the unit's own name. Real, disclosed scope cut versus the brainstormed
    //   `20.ticks` POSTFIX-LITERAL sugar: that needs a genuine parser-level lookahead keyed off a
    //   registry of every unit suffix declared so far in THIS file (order-sensitive, since this is
    //   a single top-to-bottom token-stream pass with no forward declarations) and was judged a
    //   separate, riskier follow-up rather than bundling it in here -- `ticks(20)` gets the same
    //   real type-safety win via ordinary, already-proven call syntax.
    //
    // Scope cut, disclosed: ordering operators (`<`/`<=`/`>`/`>=`) aren't overloadable at all
    // under this compiler's existing convention (`operator_method_name`'s own fixed list stops at
    // `add`/`sub`/`mul`/`div`/`rem`/`eq`) -- comparing two units needs `t1.value < t2.value`
    // directly, not `t1 < t2`. Only `Int`/`Long`/`Float`/`Double` may be wrapped (validated right
    // below) -- a `String`/struct-wrapping "unit" isn't a coherent concept for this feature (no
    // numeric `+`/`-`/`*`/`/` to generate in the first place).
    fn unit_decl(&mut self) -> UnitDeclResult {
        self.expect(UNIT);
        let name = self.expect(IDENT).text;
        self.expect(LPAREN);
        let base = self.expect(IDENT).text;
        self.expect(RPAREN);
        self.expect(SEMI);
        if base != "Int" && base != "Long" && base != "Float" && base != "Double" {
            throw ParseError::new("'unit " + name + "(" + base + ")' -- the wrapped base type must be one of Int, Long, Float, Double, got '" + base + "'");
        }
        var fields = empty_param_vec();
        fields.push(Param { name: "value", type_name: base, is_ref: false, is_mut_ref: false });
        let mod0 = self.current_module_opt();
        let sd = StructDecl { name: name, type_param: none_string(), fields: fields, is_arena: false, module_name: mod0, super_class: none_string(), type_param2: none_string() };

        var methods = empty_fn_decl_vec();
        methods.push(unit_binop_fn("add", "+", name));
        methods.push(unit_binop_fn("sub", "-", name));
        methods.push(unit_scale_fn("mul", "*", name, base));
        methods.push(unit_scale_fn("div", "/", name, base));
        methods.push(unit_eq_fn(name));
        let im = ImplDecl { struct_name: name, methods: methods, static_methods: empty_fn_decl_vec(), interface_name: none_string(), delegate_field: none_string() };

        let ctor_name = name.toLowerCase();
        var ctor_params = empty_param_vec();
        ctor_params.push(Param { name: "v", type_name: base, is_ref: false, is_mut_ref: false });
        var ctor_fnames = empty_str_vec();
        ctor_fnames.push("value");
        var ctor_fvals = empty_expr_vec();
        ctor_fvals.push(Ident { name: "v" });
        var ctor_body = empty_stmt_vec();
        ctor_body.push(Return { value: some_expr(StructLit { name: name, field_names: ctor_fnames, field_values: ctor_fvals, generic_base: none_string() }), line: 0 });
        let ctor_fn = FnDecl { name: ctor_name, params: ctor_params, ret_type: some_string(name), body: ctor_body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() };

        return UnitDeclResult { sd: sd, im: im, ctor_fn: ctor_fn };
    }

    // `typestate Texture { state Loading { path: String } state Ready { path: String, width:
    // Int } impl Loading { fn poll(&self) -> Ready { ... } } impl Ready { fn width(&self) -> Int
    // { ... } } }` -- a resource whose valid OPERATIONS differ by its own current state
    // ("used a `Texture` before it's ready" becomes a real "no such method" compile error, not a
    // runtime null-check), the way `Texture<Loading>`/`Texture<Ready>` was originally brainstormed
    // in `IDEAS.md`.
    //
    // Real, disclosed scope cut versus that original phantom-generic-type-parameter framing:
    // each `state S { fields }` hoists to an ORDINARY, INDEPENDENT top-level `struct S { fields
    // }` (and each `impl S { ... }` to an ordinary top-level `impl S { ... }`) -- there is no
    // shared `Texture<State>` generic family, no auto-renaming of a bare state name into a
    // mangled `TextureReady`-style name, and no move-checking that actually CONSUMES the old
    // state on a transition method call (this compiler's existing move-checking only tracks bare
    // local variables, not method RECEIVERS -- calling `.poll()` twice on the same `Loading`
    // value is not currently rejected). What IS real and enforced: `Loading` genuinely has no
    // `.width()` method (an ordinary, already-proven "no such method" checker error -- ZERO new
    // Checker.hotc/Codegen.hotc code for THAT part), and this fn adds exactly one new, real
    // compile-time check beyond what plain top-level structs already give you: every `impl S {
    // ... }` inside a `typestate` block must name an `S` that was actually declared as a `state`
    // in that SAME block (catches a real, easy-to-make typo -- `impl Redy { ... }` inside a block
    // that only declared `state Ready` -- as a real, named error instead of silently registering
    // orphaned methods on a struct that happens to not exist yet). The user picks each state's
    // own struct name directly (a real naming-collision responsibility across the whole file,
    // same as any other top-level struct -- `TextureLoading`/`TextureReady` rather than bare
    // `Loading`/`Ready`, if more than one typestate machine in the same program would otherwise
    // want the same state name).
    fn typestate_decl(&mut self) -> TypestateResult {
        self.expect(TYPESTATE);
        let ts_name = self.expect(IDENT).text;
        self.expect(LBRACE);
        var state_names = empty_str_vec();
        var out_structs = empty_struct_decl_vec();
        var out_impls = empty_impl_decl_vec();
        while !self.check(RBRACE) {
            if self.check(STATE) {
                self.advance();
                let sname = self.expect(IDENT).text;
                if str_vec_contains_ts(&state_names, sname) {
                    throw ParseError::new("typestate '" + ts_name + "' declares state '" + sname + "' more than once");
                }
                let fields = self.struct_fields();
                state_names.push(sname);
                let mod0 = self.current_module_opt();
                out_structs.push(StructDecl { name: sname, type_param: none_string(), fields: fields, is_arena: false, module_name: mod0, super_class: none_string(), type_param2: none_string() });
            } else if self.check(IMPL) {
                let imd = self.impl_decl();
                if !str_vec_contains_ts(&state_names, imd.struct_name) {
                    throw ParseError::new("typestate '" + ts_name + "' has an 'impl " + imd.struct_name + "' block, but no 'state " + imd.struct_name + "' was declared in it");
                }
                out_impls.push(imd);
            } else {
                throw ParseError::new("expected 'state' or 'impl' inside 'typestate " + ts_name + "' block");
            }
        }
        self.expect(RBRACE);
        return TypestateResult { structs: out_structs, impls: out_impls };
    }

    // `state PlayerState { Idle { Move -> Walking; } Walking { Stop -> Idle; Attack ->
    // Attacking; } Attacking { Complete -> Idle; } }` -- see `IDEAS.md`'s own "State machine
    // syntax" entry. Real, disclosed deviation from that entry's own original sketch: each
    // transition line drops the leading `on` keyword the sketch used (`on Move -> Walking;`)
    // and is written as bare `Move -> Walking;` instead -- `on` was already renamed to `handle`
    // earlier (see `on_decl`'s own header/`HANDLE` token) specifically because it collided with
    // this compiler's OWN self-hosted source (`Checker.hotc`'s field-access-type-resolution code
    // uses bare `on`/`on0` as real local variable names throughout). Reintroducing `on` here
    // would recreate that exact same hazard, and inside a dedicated `StateName { ... }` mini-
    // grammar `IDENT ARROW IDENT SEMI` is already unambiguous without any leading keyword at
    // all, so it's dropped rather than replaced with a second keyword.
    //
    // Synthesizes, entirely as ordinary already-proven AST shapes (zero new Checker.hotc/
    // Codegen.hotc code): a fieldless `enum <Machine> { State1 {}, ... }` (one variant per
    // declared state block, in declaration order), a fieldless `enum <Machine>Event { Event1
    // {}, ... }` (one variant per unique event name seen, in first-seen order), and a `fn
    // <Machine>_transition(current: <Machine>, event: <Machine>Event) -> <Machine> { match
    // current { State1 {} => { match event { Event1 {} => { return Target {}; } ... _ => {
    // return State1 {}; } } } ... } }` (the no-op wildcard returns a fresh literal of the
    // OUTER arm's own already-known state, not a re-read of `current` -- see `state_machine_
    // decl`'s own header on why). Real, disclosed scope cuts (matching `typestate_decl`'s
    // own precedent of disclosed cuts over the original brainstormed design): states are
    // fieldless for v1 (a state "carrying its own data", one of the doc's own explicitly-listed
    // open questions, isn't attempted); an event with no matching transition arm in the CURRENT
    // state is a silent no-op (the generated `_ => { return current; }` wildcard), not a compile
    // error or a runtime exception -- the other two options the doc's own open question listed.
    // Every state name that appears ANYWHERE (as its own declared block OR only as a transition
    // TARGET) must have its own explicit declared block -- an undeclared target-only name is a
    // real, named compile error, mirroring `typestate_decl`'s own "every impl S needs a matching
    // state S" discipline.
    fn state_machine_decl(&mut self) -> StateMachineResult {
        self.expect(STATE);
        let machine_name = self.expect(IDENT).text;
        self.expect(LBRACE);
        var state_names = empty_str_vec();
        var trans_state = empty_str_vec();
        var trans_event = empty_str_vec();
        var trans_target = empty_str_vec();
        while !self.check(RBRACE) {
            let sname = self.expect(IDENT).text;
            if str_vec_contains_ts(&state_names, sname) {
                throw ParseError::new("state machine '" + machine_name + "' declares state '" + sname + "' more than once");
            }
            state_names.push(sname);
            self.expect(LBRACE);
            while !self.check(RBRACE) {
                let ename = self.expect(IDENT).text;
                self.expect(ARROW);
                let tname = self.expect(IDENT).text;
                self.expect(SEMI);
                trans_state.push(sname);
                trans_event.push(ename);
                trans_target.push(tname);
            }
            self.expect(RBRACE);
        }
        self.expect(RBRACE);
        var ti = 0;
        while ti < trans_target.length() {
            let target = trans_target.get(ti);
            if !str_vec_contains_ts(&state_names, target) {
                throw ParseError::new("state machine '" + machine_name + "' transitions to '" + target + "', which was never declared as a state (every state needs its own '" + target + "' block, even if empty)");
            }
            ti = ti + 1;
        }
        var event_names = empty_str_vec();
        var ei = 0;
        while ei < trans_event.length() {
            let ename2 = trans_event.get(ei);
            if !str_vec_contains_ts(&event_names, ename2) {
                event_names.push(ename2);
            }
            ei = ei + 1;
        }

        let mod0 = self.current_module_opt();

        var state_variants = empty_variant_vec();
        var svi = 0;
        while svi < state_names.length() {
            state_variants.push(EnumVariant { name: state_names.get(svi), fields: empty_param_vec() });
            svi = svi + 1;
        }
        let state_enum = EnumDecl { name: machine_name, variants: state_variants, type_param: none_string(), module_name: mod0, type_param2: none_string() };

        let event_enum_name = machine_name + "Event";
        var event_variants = empty_variant_vec();
        var evi = 0;
        while evi < event_names.length() {
            event_variants.push(EnumVariant { name: event_names.get(evi), fields: empty_param_vec() });
            evi = evi + 1;
        }
        let event_enum = EnumDecl { name: event_enum_name, variants: event_variants, type_param: none_string(), module_name: mod0, type_param2: none_string() };

        var outer_arms = empty_matcharm_vec();
        var osi = 0;
        while osi < state_names.length() {
            let cur_state = state_names.get(osi);
            var inner_arms = empty_matcharm_vec();
            var tj = 0;
            while tj < trans_state.length() {
                if trans_state.get(tj) == cur_state {
                    var inner_body = empty_stmt_vec();
                    let target_lit = StructLit { name: trans_target.get(tj), field_names: empty_str_vec(), field_values: empty_expr_vec(), generic_base: none_string() };
                    inner_body.push(Return { value: some_expr(target_lit), line: 0 });
                    inner_arms.push(MatchArm { variant_name: trans_event.get(tj), field_names: empty_str_vec(), bind_names: empty_str_vec(), body: inner_body, is_literal: false, literal: IntLit { value: 0 }, is_positional: false });
                }
                tj = tj + 1;
            }
            // A fresh `StateName {}` literal, NOT `return current;` -- `cur_state` is already
            // statically known here (it's this exact outer arm's own matched variant), and
            // avoiding a bare `Ident` read of `current` sidesteps a real move-checker trap:
            // `check_match` doesn't snapshot/restore moved-state per arm the way `if`/`else`
            // does (see `Checker.hotc`'s own `check_stmt`'s `Let` header on this "conservative
            // branch handling" -- once ANY arm moves a name, every arm checked AFTER it sees it
            // as moved too), so a real `return current;` in one state's own no-op wildcard would
            // spuriously fail "use of moved value 'current'" while checking the NEXT state's arm.
            var no_op_body = empty_stmt_vec();
            let no_op_lit = StructLit { name: cur_state, field_names: empty_str_vec(), field_values: empty_expr_vec(), generic_base: none_string() };
            no_op_body.push(Return { value: some_expr(no_op_lit), line: 0 });
            inner_arms.push(MatchArm { variant_name: "_", field_names: empty_str_vec(), bind_names: empty_str_vec(), body: no_op_body, is_literal: false, literal: IntLit { value: 0 }, is_positional: false });

            var outer_body = empty_stmt_vec();
            outer_body.push(Match { subject: Ident { name: "event" }, arms: inner_arms, line: 0 });
            outer_arms.push(MatchArm { variant_name: cur_state, field_names: empty_str_vec(), bind_names: empty_str_vec(), body: outer_body, is_literal: false, literal: IntLit { value: 0 }, is_positional: false });
            osi = osi + 1;
        }
        var fn_body = empty_stmt_vec();
        fn_body.push(Match { subject: Ident { name: "current" }, arms: outer_arms, line: 0 });

        var params = empty_param_vec();
        params.push(Param { name: "current", type_name: machine_name, is_ref: false, is_mut_ref: false });
        params.push(Param { name: "event", type_name: event_enum_name, is_ref: false, is_mut_ref: false });
        let transition_fn = FnDecl { name: machine_name + "_transition", params: params, ret_type: some_string(machine_name), body: fn_body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() };

        return StateMachineResult { state_enum: state_enum, event_enum: event_enum, transition_fn: transition_fn };
    }

    // `event PlayerDied(player: Entity, cause: String);` -- events/signals, compile-time-wired
    // (see `IDEAS.md`'s own "Events/signals as a language construct" entry, which explicitly
    // recommends this cheaper, zero-runtime-cost version over a genuinely dynamic subscription
    // system). Declares an event's own payload SHAPE only -- a real param list, exactly like a
    // `fn`'s own, parsed via the same `param_list()` every `fn`/`extern method` already uses --
    // recorded into `self.event_names`/`self.event_field_counts`/`self.event_field_names`/`self.
    // event_field_types` (see that field's own header) for `on_decl`/`parse_program`'s tail to
    // read back later. No struct, no `Checker.hotc`/
    // `Codegen.hotc` code, and no AST node of its own at all -- this declaration produces NOTHING
    // in the final `Program` directly; it only feeds the TWO real things that do (each `handle`
    // block's own synthesized handler `fn`, and `parse_program`'s own tail-synthesized `emit_
    // Name` dispatcher, see `on_decl`'s and that tail code's own headers).
    fn event_decl(&mut self) -> Unit {
        self.expect(EVENT);
        let name = self.expect(IDENT).text;
        let params = self.param_list();
        self.expect(SEMI);
        if str_vec_contains_ts(&self.event_names, name) {
            throw ParseError::new("event '" + name + "' is declared more than once");
        }
        self.event_names.push(name);
        self.event_field_counts.push(params.length());
        var pi = 0;
        while pi < params.length() {
            let p = params.get(pi);
            self.event_field_names.push(p.name);
            self.event_field_types.push(p.type_name);
            pi = pi + 1;
        }
    }

    // `handle PlayerDied(player) { spawn_death_effect(player); }` -- a real, disclosed ORDER
    // dependency (same "declared before used" constraint `unit`/`typestate` already have): the
    // named `event` must already have been parsed earlier in the file, since this needs its real
    // field TYPES (only the bind NAMES are written here, positionally matched to `event`'s own
    // declared fields, same convention `typestate`'s own positional-binding-free field reuse
    // establishes and positional `match` patterns established before that). Named `handle`, not
    // the more obvious `on` (matching the brainstormed syntax) -- `on` collides hard with this
    // compiler's OWN source (see `Lexer.hotc`'s own `HANDLE` token header for the real, found-
    // the-hard-way reason). Desugars into a fresh, uniquely-named top-level handler `fn __on_
    // <Name>_<N>(bind1: Type1, ...) { <body> }` (queued in `self.pending_event_fns`, appended to
    // the real `Program.fns` only once `parse_program` reaches its own tail -- `handle` can only
    // ever appear at the top level, unlike `sequence`, but the SAME queuing shape is reused for
    // consistency) -- MULTIPLE `handle` blocks for the same event are real and expected (`self.
    // handler_event_names`/`self.handler_fn_names`, a flat parallel pair, records EVERY one
    // across the whole file, in declaration order); `parse_program`'s own tail generates ONE
    // `emit_Name` dispatcher per declared event that calls every one of ITS OWN handlers, in
    // that same order.
    fn on_decl(&mut self) -> Unit {
        self.expect(HANDLE);
        let name = self.expect(IDENT).text;
        var binds = empty_str_vec();
        self.expect(LPAREN);
        if !self.check(RPAREN) {
            binds.push(self.expect(IDENT).text);
            while self.match_kind(COMMA) {
                binds.push(self.expect(IDENT).text);
            }
        }
        self.expect(RPAREN);
        let fields = event_params_for(&self.event_names, &self.event_field_counts, &self.event_field_names, &self.event_field_types, name);
        if binds.length() != fields.length() {
            throw ParseError::new("'handle " + name + "(...)' expects " + JString3::valueOf(fields.length()) + " binding(s) (matching 'event " + name + "'), got " + JString3::valueOf(binds.length()));
        }
        let body = self.block();
        let n = self.event_handler_counter;
        self.event_handler_counter = n + 1;
        let handler_name = "__on_" + name + "_" + JString3::valueOf(n);
        var handler_params = empty_param_vec();
        var bi = 0;
        while bi < binds.length() {
            let ftype = fields.get(bi).type_name;
            handler_params.push(Param { name: binds.get(bi), type_name: ftype, is_ref: false, is_mut_ref: false });
            bi = bi + 1;
        }
        self.pending_event_fns.push(FnDecl { name: handler_name, params: handler_params, ret_type: none_string(), body: body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() });
        self.handler_event_names.push(name);
        self.handler_fn_names.push(handler_name);
    }

    // `sequence { npc.say("hi"); wait(2.0); npc.say("bye"); wait_until(|| player_near(npc)); }` --
    // coroutines for game-logic sequencing. Pure AST desugaring, same "expand into already-
    // proven, already-checked constructs" strategy `parallel_for_stmts`/`@dev` already use --
    // NEITHER `Checker.hotc` NOR `Codegen.hotc` need a single new line for this feature.
    //
    // The real trick: a `sequence` block's body can be an arbitrary STATEMENT LIST (any number of
    // statements, unlike `parallel_for_stmts`'s own single-expression-body restriction), but
    // `Lambda.body` (`Ast.hc`) is a single `Expr`, and spawning onto `PhoenixVirtualPool` (see
    // `stdlib/sequence.hotc`'s own header) needs a `&dyn PhoenixCallable` lambda. Resolved by
    // NOT inlining the body into the lambda at all: the whole statement list becomes a fresh,
    // synthesized TOP-LEVEL `fn __seq_fnN() -> Int { <body>; return 0; }` (queued in `self.
    // pending_seq_fns`, since `sequence` can appear at any nesting depth `block()` reaches, far
    // from `parse_program`'s own top-level `fns` list -- only actually appended there once
    // `parse_program` reaches its own return), and the spawned lambda becomes the trivial single-
    // expression `|| __seq_fnN() as PhoenixObject` -- the SAME "wrap a call in `as PhoenixObject`"
    // convention `parallel_for_stmts` already established for its own single-expression body
    // (the dummy `-> Int { ...; return 0; }` gives that cast something real to box, same
    // disclosed reasoning as `parallel_for_stmts`'s own header on why a bare `Unit`-returning
    // body wouldn't have anything to box).
    //
    // The `sequence { ... }` STATEMENT itself desugars into three ordinary statements: create a
    // fresh `PhoenixVirtualPool`, spawn the lambda above onto it (the `PhoenixTask` handle is
    // bound but not currently exposed back to the caller -- see this fn's own scope-cut note
    // below), then immediately `shutdown()` the pool (graceful -- refuses new submissions, but
    // the one already-spawned task keeps running to completion regardless, same contract
    // `PhoenixPool::shutdown`'s own header documents). `wait`/`wait_until` (`stdlib/
    // sequence.hotc`) do the real suspending, entirely as ordinary function calls inside the
    // synthesized fn's body -- genuinely non-blocking because they run on a virtual thread
    // (`needs_sequence` auto-injects `use sequence;`, which transitively needs `use
    // phoenix_virtual;`, itself gated to `--target 21`+ -- a real, disclosed hard requirement:
    // `sequence` on `--target 17` is a real, clear compile error naming `phoenix_virtual`, not a
    // silent fallback to blocking the caller's own thread).
    //
    // Scope cut, disclosed: the spawned `PhoenixTask` handle is discarded, not returned to the
    // caller -- there's currently no way to `.join()`/`.cancel()` a running `sequence` from the
    // statement that started it. A real, possible follow-up (`let handle = sequence { ... };`,
    // using `sequence` as an EXPRESSION rather than a bare statement) if a concrete use case
    // (cancelling an NPC's dialogue sequence early, say) ever needs it -- not attempted this pass.
    fn sequence_stmts(&mut self, start_line: Int) -> Vec<Stmt> {
        self.expect(SEQUENCE);
        let body = self.block();
        self.needs_sequence = true;
        let n = self.sequence_counter;
        self.sequence_counter = n + 1;
        let suffix = JString3::valueOf(n);
        let fn_name = "__seq_fn" + suffix;
        let pool_name = "__seq_pool" + suffix;
        let task_name = "__seq_task" + suffix;

        var seq_body = empty_stmt_vec();
        var bi = 0;
        while bi < body.length() {
            seq_body.push(body.get(bi));
            bi = bi + 1;
        }
        seq_body.push(Return { value: some_expr(IntLit { value: 0 }), line: start_line });
        let seq_fn = FnDecl { name: fn_name, params: empty_param_vec(), ret_type: some_string("Int"), body: seq_body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() };
        self.pending_seq_fns.push(seq_fn);

        var out = empty_stmt_vec();
        out.push(Let { name: pool_name, mutable: true, init: StaticCall { type_name: "PhoenixVirtualPool", method: "new", args: empty_expr_vec() }, declared_type: none_string(), line: start_line });
        let lambda = Lambda { params: empty_str_vec(), body: Cast { expr: Call { callee: fn_name, args: empty_expr_vec() }, target_type: "PhoenixObject" } };
        var spawn_args = empty_expr_vec();
        spawn_args.push(lambda);
        let spawn_call = MethodCall { recv: Ident { name: pool_name }, method: "spawn", args: spawn_args };
        out.push(Let { name: task_name, mutable: true, init: spawn_call, declared_type: none_string(), line: start_line });
        let shutdown_call = MethodCall { recv: Ident { name: pool_name }, method: "shutdown", args: empty_expr_vec() };
        out.push(ExprStmt { expr: shutdown_call, line: start_line });
        return out;
    }

    fn block(&mut self) -> Vec<Stmt> {
        self.expect(LBRACE);
        if self.check(RBRACE) {
            self.advance();
            return empty_stmt_vec();
        }
        var stmts = empty_stmt_vec();
        while !self.check(RBRACE) {
            if self.check(PARALLEL) {
                let start_line = self.peek().line;
                let desugared = self.parallel_for_stmts(start_line);
                var di = 0;
                while di < desugared.length() {
                    stmts.push(desugared.get(di));
                    di = di + 1;
                }
            } else if self.check(SEQUENCE) {
                let start_line2 = self.peek().line;
                let desugared2 = self.sequence_stmts(start_line2);
                var di2 = 0;
                while di2 < desugared2.length() {
                    stmts.push(desugared2.get(di2));
                    di2 = di2 + 1;
                }
            } else {
                stmts.push(self.statement());
            }
        }
        self.expect(RBRACE);
        return stmts;
    }

    fn statement(&mut self) -> Stmt {
        let start_line = self.peek().line;
        if self.check(LET) || self.check(VAR) {
            let mutable = self.check(VAR);
            self.advance();
            let name = self.expect(IDENT).text;
            // An explicit `: Type` annotation (`let found: Option<TokType> = ...;` -- a real gap
            // found self-compiling `Lexer.hotc`) is captured now, not discarded -- see `Ast.hc`'s
            // own `Stmt::Let.declared_type` header for why: `Checker.hotc`'s own `check_stmt`
            // honors it for exactly one case (widening a concrete struct up to a `&dyn Interface`),
            // and ignores it (same as before) for everything else, so this stays a strict
            // superset of the old "accepted syntax, no semantic effect" behavior.
            var declared_type = none_string();
            if self.check(COLON) {
                self.advance();
                declared_type = some_string(self.type_name_ref());
            }
            self.expect(EQ);
            let init = self.expression();
            self.expect(SEMI);
            return Let { name: name, mutable: mutable, init: init, declared_type: declared_type, line: start_line };
        }
        if self.check(RETURN) {
            self.advance();
            if self.check(SEMI) {
                self.advance();
                return Return { value: none_expr(), line: start_line };
            }
            let e = self.expression();
            self.expect(SEMI);
            return Return { value: some_expr(e), line: start_line };
        }
        if self.check(IF) {
            self.advance();
            if self.check(LET) {
                return self.if_let_stmt(start_line);
            }
            // Guard-clause null-narrowing -- see `Ast.hc`'s own `Stmt::If.narrow_name` header for
            // why this is a raw, 3-token lookahead over the TOKEN stream (`IDENT (EQEQ|BANGEQ)
            // NULL`) done BEFORE `cond` is parsed, rather than inspecting the built `cond` `Expr`
            // afterward. A bare read -- `self.tokens.get(...)`, no `self.advance()` -- so it never
            // disturbs the normal `self.expression()` parse right below.
            var narrow_name = "";
            var narrow_is_eq = false;
            if self.check(IDENT) && (self.tokens.get(self.pos + 1).kind == EQEQ || self.tokens.get(self.pos + 1).kind == BANGEQ) && self.tokens.get(self.pos + 2).kind == NULL {
                narrow_name = self.tokens.get(self.pos).text;
                narrow_is_eq = self.tokens.get(self.pos + 1).kind == EQEQ;
            }
            self.no_struct_lit = true;
            let cond = self.expression();
            self.no_struct_lit = false;
            let then_body = self.block();
            if self.match_kind(ELSE) {
                // `else if ...` desugars to `else { if ... }` -- a one-statement block wrapping
                // a recursively-parsed `if`, same shape any hand-rolled recursive-descent parser
                // uses for this (no separate "else-if" AST node needed).
                if self.check(IF) {
                    let nested = self.statement();
                    return If { cond: cond, then_body: then_body, else_body: some_stmt_vec(vec_of(nested)), line: start_line, narrow_name: narrow_name, narrow_is_eq: narrow_is_eq };
                } else {
                    let else_body = self.block();
                    return If { cond: cond, then_body: then_body, else_body: some_stmt_vec(else_body), line: start_line, narrow_name: narrow_name, narrow_is_eq: narrow_is_eq };
                }
            } else {
                return If { cond: cond, then_body: then_body, else_body: none_stmt_vec(), line: start_line, narrow_name: narrow_name, narrow_is_eq: narrow_is_eq };
            }
        }
        if self.check(WHILE) {
            self.advance();
            self.no_struct_lit = true;
            let cond = self.expression();
            self.no_struct_lit = false;
            let body = self.block();
            return While { cond: cond, body: body, line: start_line };
        }
        // `for var_name in a..b { }` / `for var_name in a..=b { }` (a real range, `Ast.hc`'s own
        // `Stmt::For` header explains why it's flattened onto this ONE variant rather than a
        // separate general `Expr::Range` type) or `for var_name in arr_expr { }` (a real `[T]`
        // array) -- same `no_struct_lit` ambiguity-avoidance trick `while`'s own condition just
        // used, for the exact same reason (the iterable expression is immediately followed by the
        // body's own `{`).
        if self.check(FOR) {
            self.advance();
            let var_name = self.expect(IDENT).text;
            self.expect(IN);
            self.no_struct_lit = true;
            let start = self.expression();
            if self.check(DOTDOT) || self.check(DOTDOTEQ) {
                let inclusive = self.check(DOTDOTEQ);
                self.advance();
                let end = self.expression();
                self.no_struct_lit = false;
                let body = self.block();
                return For { var_name: var_name, is_range: true, range_start: start, range_end: end, inclusive: inclusive, arr_expr: IntLit { value: 0 }, body: body, line: start_line };
            } else {
                self.no_struct_lit = false;
                let body = self.block();
                return For { var_name: var_name, is_range: false, range_start: IntLit { value: 0 }, range_end: IntLit { value: 0 }, inclusive: false, arr_expr: start, body: body, line: start_line };
            }
        }
        if self.check(MATCH) {
            return self.match_stmt(start_line);
        }
        if self.check(THROW) {
            self.advance();
            let e = self.expression();
            self.expect(SEMI);
            return Throw { value: e, line: start_line };
        }
        if self.check(BREAK) {
            self.advance();
            self.expect(SEMI);
            return Break { line: start_line };
        }
        if self.check(CONTINUE) {
            self.advance();
            self.expect(SEMI);
            return Continue { line: start_line };
        }
        if self.check(TRY) {
            return self.try_stmt(start_line);
        }
        let e = self.expression();
        self.expect(SEMI);
        return ExprStmt { expr: e, line: start_line };
    }

    // `if let VariantName { field, ... } = subject { then_body } [else { else_body }]` --
    // desugars directly to a two-arm `Match` (the variant arm, plus an implicit `_` wildcard arm
    // holding `else_body`, or an empty one if there's no `else`) rather than needing its own
    // separate AST node or Checker/Codegen support -- reuses everything `match` already has.
    // `EnumName::VariantName` (the qualifier parsed and discarded) -- same real gap `match_arm`'s
    // own header explains, found by the exact same `examples/calc/Calculator.hotc` usage
    // (`if let Option::Some { value: a } = a_opt { ... }`).
    fn if_let_stmt(&mut self, start_line: Int) -> Stmt {
        self.expect(LET);
        var variant_name = self.expect(IDENT).text;
        if self.check(COLONCOLON) {
            self.advance();
            variant_name = self.expect(IDENT).text;
        }
        self.expect(LBRACE);
        var field_names = empty_str_vec();
        var bind_names = empty_str_vec();
        if !self.check(RBRACE) {
            let fb0 = self.one_field_binding();
            field_names.push(fb0.field);
            bind_names.push(fb0.bind);
            while self.match_kind(COMMA) {
                if self.check(RBRACE) { break; }
                let fb = self.one_field_binding();
                field_names.push(fb.field);
                bind_names.push(fb.bind);
            }
        }
        self.expect(RBRACE);
        self.expect(EQ);
        self.no_struct_lit = true;
        let subject = self.expression();
        self.no_struct_lit = false;
        let then_body = self.block();
        var arms = empty_matcharm_vec();
        arms.push(MatchArm { variant_name: variant_name, field_names: field_names, bind_names: bind_names, body: then_body, is_literal: false, literal: IntLit { value: 0 }, is_positional: false });
        if self.match_kind(ELSE) {
            let else_body = self.block();
            arms.push(MatchArm { variant_name: "_", field_names: empty_str_vec(), bind_names: empty_str_vec(), body: else_body, is_literal: false, literal: IntLit { value: 0 }, is_positional: false });
        } else {
            arms.push(MatchArm { variant_name: "_", field_names: empty_str_vec(), bind_names: empty_str_vec(), body: empty_stmt_vec(), is_literal: false, literal: IntLit { value: 0 }, is_positional: false });
        }
        return Match { subject: subject, arms: arms, line: start_line };
    }

    // === `match subject { VariantName { field, ... } => { body } ... _ => { body } }` ===
    fn match_stmt(&mut self, start_line: Int) -> Stmt {
        self.expect(MATCH);
        self.no_struct_lit = true; // same reasoning as if/while's own condition parsing
        let subject = self.expression();
        self.no_struct_lit = false;
        self.expect(LBRACE);
        var arms = empty_matcharm_vec();
        while !self.check(RBRACE) {
            arms.push(self.match_arm());
        }
        self.expect(RBRACE);
        return Match { subject: subject, arms: arms, line: start_line };
    }

    // `try { ... } catch (name: Type) { ... } catch (name2: Type2) { ... } ...` -- one or more
    // catch clauses (real gap closed, see `Ast.hc`'s own `Try`/`CatchClause` headers). Each is
    // parsed identically; the loop just keeps going as long as another bare `catch` follows the
    // previous clause's own closing `}`.
    fn try_stmt(&mut self, start_line: Int) -> Stmt {
        self.expect(TRY);
        let try_block = self.block();
        var catches = empty_catchclause_vec();
        catches.push(self.catch_clause());
        while self.check(CATCH) {
            catches.push(self.catch_clause());
        }
        return Try { try_block: try_block, catches: catches, line: start_line };
    }

    fn catch_clause(&mut self) -> CatchClause {
        self.expect(CATCH);
        self.expect(LPAREN);
        let catch_var = self.expect(IDENT).text;
        self.expect(COLON);
        let catch_type = self.type_name_ref();
        self.expect(RPAREN);
        let catch_block = self.block();
        return CatchClause { catch_var: catch_var, catch_type: catch_type, catch_block: catch_block };
    }

    // `field` or `field: localName` -- returns the declared field name and the local binding name
    // (the rename target if given, else the same name). Shared by `match_arm` and `if_let_stmt`,
    // both of which parse this exact same field-binding shape. See `Ast.hc`'s own `MatchArm`
    // header. Returns a small struct rather than taking `&mut Vec<String>` out-params -- HC has no
    // tuples, and this keeps the same "return a real value" shape every other parser helper in
    // this file already uses, rather than introducing an untested mutable-out-param pattern.
    fn one_field_binding(&mut self) -> FieldBinding {
        let fname = self.expect(IDENT).text;
        if self.match_kind(COLON) {
            let bname = self.expect(IDENT).text;
            return FieldBinding { field: fname, bind: bname };
        } else {
            return FieldBinding { field: fname, bind: fname };
        }
    }

    // A literal pattern (`"+" => { ... }`, `1 => { ... }`, `true => { ... }`) -- tried BEFORE the
    // ordinary variant-name pattern (`match_arm`'s own header, right below), mirroring the real
    // compiler's own `literalPattern`/`matchExpr` ordering exactly: an `INT`/`STRING`/`TRUE`/
    // `FALSE` token here can never be the start of a real variant-name pattern (which always
    // starts with `IDENT`), so trying this first is unambiguous. `None` when the next token isn't
    // one of those, letting `match_arm` fall through to the variant-pattern path unchanged.
    fn try_literal_pattern(&mut self) -> Option<Expr> {
        if self.check(INT) {
            let t = self.advance();
            return some_expr(IntLit { value: parse_int(t.text) });
        }
        if self.check(STRING) {
            let t = self.advance();
            return some_expr(StringLit { value: t.text });
        }
        if self.check(TRUE) {
            self.advance();
            return some_expr(BoolLit { value: true });
        }
        if self.check(FALSE) {
            self.advance();
            return some_expr(BoolLit { value: false });
        }
        return none_expr();
    }

    // `VariantName { field, ... } => { body }` / `EnumName::VariantName { ... } => { body }` (the
    // qualifier is parsed and discarded -- real `examples/calc/Calculator.hotc` usage,
    // `match op { "+" => ..., }`'s own sibling `if let Option::Some { ... }`, found needing this;
    // this subset's own variant names are already unique/unqualified everywhere else, so dropping
    // the qualifier loses no real information) / a literal pattern (`try_literal_pattern`, above --
    // `is_literal: true`, `variant_name`/`field_names`/`bind_names` unused placeholders then) /
    // `_ => { body }` (the wildcard). See `Ast.hc`'s own `MatchArm.is_literal` header for why
    // literal patterns get their own flag rather than a separate AST node.
    fn match_arm(&mut self) -> MatchArm {
        let lit_found = self.try_literal_pattern();
        if let Some { value: lit } = lit_found {
            self.expect(FATARROW);
            let body = self.block();
            return MatchArm { variant_name: "$literal", field_names: empty_str_vec(), bind_names: empty_str_vec(), body: body, is_literal: true, literal: lit, is_positional: false };
        }
        let head0 = self.expect(IDENT).text;
        if head0 == "_" {
            self.expect(FATARROW);
            let body = self.block();
            return MatchArm { variant_name: "_", field_names: empty_str_vec(), bind_names: empty_str_vec(), body: body, is_literal: false, literal: IntLit { value: 0 }, is_positional: false };
        }
        var head = head0;
        if self.check(COLONCOLON) {
            self.advance();
            head = self.expect(IDENT).text;
        }
        // The `{ ... }` field-binding list is OPTIONAL, not required -- a fieldless variant can be
        // matched bare (`TyInt => { ... }`, no braces at all), real `Checker.hotc` usage
        // (`ty_name`'s own match over `Ty`) found self-compiling it. Mirrors the real compiler's
        // own `variantPattern` (`Parser.kt`), which only consumes bindings `if (match(LBRACE))` in
        // the first place -- this subset had turned that "only if present" into "always required".
        var field_names = empty_str_vec();
        var bind_names = empty_str_vec();
        var is_positional = false;
        if self.check(LBRACE) {
            self.advance();
            if !self.check(RBRACE) {
                let fb0 = self.one_field_binding();
                field_names.push(fb0.field);
                bind_names.push(fb0.bind);
                while self.match_kind(COMMA) {
                    if self.check(RBRACE) { break; }
                    let fb = self.one_field_binding();
                    field_names.push(fb.field);
                    bind_names.push(fb.bind);
                }
            }
            self.expect(RBRACE);
        } else if self.check(LPAREN) {
            // `Goblin(hp)` -- positional pattern sugar, see `Ast.hc`'s own `MatchArm.
            // is_positional` header. Only bare bind names here (no `field: name` renaming --
            // the whole point is a SHORTER spelling for the common one/two-field case), bound
            // in DECLARATION-ORDER position; `field_names` stays empty (the parser has no way
            // to know the variant's own real field names yet), resolved later by `Checker.hotc`/
            // `Codegen.hotc` from the variant's own already-known field table.
            is_positional = true;
            self.advance();
            if !self.check(RPAREN) {
                bind_names.push(self.expect(IDENT).text);
                while self.match_kind(COMMA) {
                    if self.check(RPAREN) { break; }
                    bind_names.push(self.expect(IDENT).text);
                }
            }
            self.expect(RPAREN);
        }
        self.expect(FATARROW);
        let body = self.block();
        return MatchArm { variant_name: head, field_names: field_names, bind_names: bind_names, body: body, is_literal: false, literal: IntLit { value: 0 }, is_positional: is_positional };
    }

    // === One `fn` declaration form: `fn name(params) [-> RetType] { block }` ===
    // Bare type names only (no arrays/refs/generics) -- see this file's own header.

    fn param_list(&mut self) -> Vec<Param> {
        self.expect(LPAREN);
        if self.check(RPAREN) {
            self.advance();
            return empty_param_vec();
        }
        var params = vec_of(self.one_param());
        while self.match_kind(COMMA) {
            if self.check(RPAREN) { break; }
            params.push(self.one_param());
        }
        self.expect(RPAREN);
        return params;
    }

    // Bare `Ident` type names, `[Ident]` for a (single-level, non-nested) array type, or
    // `Name<Arg>` for a single-type-parameter generic instantiation -- all represented as plain
    // strings throughout `Checker.hotc`/`Codegen.hotc`, the same "everything is a type-name
    // string" convention every other type already uses. A generic instantiation's *own* string
    // form is `"Base$Arg"` (`$` specifically because it can never appear in a real HC identifier
    // -- see the lexer's own identifier rules -- so it's unambiguous with a real user-written
    // name containing `_`, which `_` itself wouldn't be). Recursion here (`type_name_ref` calling
    // itself for the type argument) supports nested generics fine in *this* position (`Vec<T>` as
    // a field type, say) since there's no ambiguity with the `<`/`>` comparison operators the way
    // there is in expression position -- see `primary`'s own, much more restricted, single-level
    // handling of `Name<Arg> { ... }` construction syntax.
    fn type_name_ref(&mut self) -> String {
        // A leading `&`/`&mut` on a REGULAR (non-`self`) param's type (`label: &Label`, `cw: &mut
        // ClassWriter2` -- real `Codegen.hotc` extern-method usage, a genuine gap found self-
        // compiling it) is accepted but not distinguished, same as `self_receiver`'s own `&`/`mut`
        // handling right above in this file (this subset has no borrow-checking at all either
        // way).
        if self.check(AMP) {
            self.advance();
            if self.check(MUT) { self.advance(); }
        }
        // `&dyn Name` -- dynamic-dispatch interface type. Encoded as the plain type-name string
        // "dyn Name" (the same "just a type-name string, no separate type-ref struct" convention
        // this whole subset already uses for arrays -- `"[Name]"` above), NOT a new `Ty` variant:
        // `ty_from_name`'s existing catch-all (`TyStruct { name: name }`) already handles any
        // unrecognized name, so "dyn Name" flows through the checker/codegen as a plain
        // reference-typed name string that happens to start with "dyn " -- see `Checker.hotc`'s own
        // `is_dyn_type_name`/`dyn_interface_name` for where that prefix gets interpreted.
        if self.check(DYN) {
            self.advance();
            let iface = self.expect(IDENT).text;
            return "dyn " + iface;
        }
        if self.check(LBRACKET) {
            self.advance();
            let inner = self.expect(IDENT).text;
            self.expect(RBRACKET);
            return "[" + inner + "]";
        }
        let base = self.expect(IDENT).text;
        var result = base;
        if self.check(LT) {
            self.advance();
            let arg = self.type_name_ref();
            // `Result<T, E>` -- a SECOND type argument, comma-separated (see `Ast.hc`'s own
            // `EnumDecl.type_param2` header: enums only, but this is just building the mono-name
            // STRING, the same "Base$Arg" convention a one-param reference already uses -- nothing
            // here needs to know whether `base` even resolves to a real two-param enum).
            if self.match_kind(COMMA) {
                let arg2 = self.type_name_ref();
                self.expect(GT);
                result = base + "$" + arg + "$" + arg2;
            } else {
                self.expect(GT);
                result = base + "$" + arg;
            }
        }
        // `TypeName?` -- a nullable type, same "plain suffixed type-name string" convention as
        // `dyn Name`/`[Name]` above (no new `Ty` variant -- `ty_from_name`'s catch-all already
        // carries this suffix through untouched). See README's own "Nullable types" section for
        // the real scope this covers this pass (a `TyStruct`-shaped value only -- not native
        // `String?`, a disclosed narrower cut).
        if self.check(QUESTION) {
            self.advance();
            result = result + "?";
        }
        return result;
    }

    fn one_param(&mut self) -> Param {
        let name = self.expect(IDENT).text;
        self.expect(COLON);
        // Consumed HERE, before `type_name_ref` gets a chance to silently eat the same tokens
        // itself (see that fn's own header) -- this is the one call site that actually needs to
        // remember it saw a `&`/`&mut`, for `Param.is_ref` (see that field's own header).
        var is_ref = false;
        var is_mut_ref = false;
        if self.check(AMP) {
            self.advance();
            if self.check(MUT) { self.advance(); is_mut_ref = true; }
            is_ref = true;
        }
        let type_name = self.type_name_ref();
        return Param { name: name, type_name: type_name, is_ref: is_ref, is_mut_ref: is_mut_ref };
    }

    fn fn_decl(&mut self) -> FnDecl {
        self.expect(FN);
        let name = self.expect(IDENT).text;
        var type_param = none_string();
        var type_bounds = empty_str_vec();
        var type_param2 = none_string();
        var type_bounds2 = empty_str_vec();
        if self.match_kind(LT) {
            let tp = self.expect(IDENT).text;
            type_param = some_string(tp);
            // `<T: A + B>` -- one or more bound trait names, `+`-joined. See `Ast.hc`'s own
            // `FnDecl.type_bounds` header.
            if self.match_kind(COLON) {
                type_bounds.push(self.expect(IDENT).text);
                while self.match_kind(PLUS) {
                    type_bounds.push(self.expect(IDENT).text);
                }
            }
            // `<K: Hashable, V>` -- a second, independently-bounded type param, see `Ast.hc`'s own
            // `FnDecl.type_param2` header.
            if self.match_kind(COMMA) {
                let tp2 = self.expect(IDENT).text;
                type_param2 = some_string(tp2);
                if self.match_kind(COLON) {
                    type_bounds2.push(self.expect(IDENT).text);
                    while self.match_kind(PLUS) {
                        type_bounds2.push(self.expect(IDENT).text);
                    }
                }
            }
            self.expect(GT);
        }
        let params = self.param_list();
        var ret_type = none_string();
        if self.match_kind(ARROW) {
            ret_type = some_string(self.type_name_ref());
        }
        let body = self.block();
        return FnDecl { name: name, params: params, ret_type: ret_type, body: body, type_param: type_param, type_bounds: type_bounds, self_is_mut: false, type_param2: type_param2, type_bounds2: type_bounds2 };
    }

    // === One `struct` declaration form: `struct Name { field: Type, field: Type, ... }` ===
    fn struct_fields(&mut self) -> Vec<Param> {
        self.expect(LBRACE);
        if self.check(RBRACE) {
            self.advance();
            return empty_param_vec();
        }
        var fields = vec_of(self.one_param());
        while self.match_kind(COMMA) {
            if self.check(RBRACE) { break; }
            fields.push(self.one_param());
        }
        self.expect(RBRACE);
        return fields;
    }

    // `self.current_module` as an `Option<String>` (`None` for `""`, the "no `module` decl seen
    // yet" sentinel) -- every struct/enum/interface declaration reads this fresh, right at
    // construction time, so a `module` declared partway through a file (this subset's own real,
    // disclosed leniency -- see `parse_program`'s own header) still correctly tags everything
    // parsed AFTER it.
    fn current_module_opt(&mut self) -> Option<String> {
        if self.current_module == "" {
            return none_string();
        }
        return some_string(self.current_module);
    }

    fn struct_decl(&mut self) -> StructDecl {
        self.expect(STRUCT);
        let name = self.expect(IDENT).text;
        var type_param = none_string();
        var type_param2 = none_string();
        if self.match_kind(LT) {
            let tp = self.expect(IDENT).text;
            type_param = some_string(tp);
            // `struct HashMap<K, V> { ... }` -- see `Ast.hc`'s own `StructDecl.type_param2` header,
            // mirroring `enum_decl`'s own identical `<T, E>` parsing above.
            if self.match_kind(COMMA) {
                type_param2 = some_string(self.expect(IDENT).text);
            }
            self.expect(GT);
        }
        var super_class = none_string();
        if self.match_kind(EXTENDS) {
            super_class = some_string(self.expect(IDENT).text);
        }
        let fields = self.struct_fields();
        let mod0 = self.current_module_opt();
        return StructDecl { name: name, type_param: type_param, fields: fields, is_arena: false, module_name: mod0, super_class: super_class, type_param2: type_param2 };
    }

    // `arena struct Name { field: Type, ... }` -- see `Ast.hc`'s own `StructDecl.is_arena` header.
    // No generic arena structs (`arena struct Box<T>`) this phase -- `type_param` stays `None`
    // unconditionally, a real, disclosed narrower scope than the real compiler's own grammar
    // (which doesn't restrict it either, though nothing exercises a generic arena struct there).
    fn arena_struct_decl(&mut self) -> StructDecl {
        self.expect(ARENA);
        self.expect(STRUCT);
        let name = self.expect(IDENT).text;
        let fields = self.struct_fields();
        let mod1 = self.current_module_opt();
        return StructDecl { name: name, type_param: none_string(), fields: fields, is_arena: true, module_name: mod1, super_class: none_string(), type_param2: none_string() };
    }

    // === `impl Name { fn method(self[, ...]) [-> Ret] { block } ... }` ===
    // `self`/`&self`/`&mut self` -- the `&`/`mut` markers are accepted but not distinguished
    // (this subset has no borrow-checking at all); required as the literal first parameter of
    // every method, and NOT added to the returned `FnDecl.params` (see `Ast.hc`'s own header).
    // Returns whether the receiver was declared `&mut self` specifically (not `&self` or bare
    // `self`) -- `Param.self_is_mut`'s own header explains why `method_decl` needs this.
    fn self_receiver(&mut self) -> Bool {
        var is_mut = false;
        if self.check(AMP) {
            self.advance();
            if self.check(MUT) { self.advance(); is_mut = true; }
        }
        let t = self.expect(IDENT);
        if t.text != "self" {
            throw ParseError::new("expected 'self' as the first parameter of an impl method, got '" + t.text + "'");
        }
        return is_mut;
    }

    fn method_decl(&mut self) -> FnDecl {
        // `override fn method(...)` -- purely cosmetic this phase (see README's own "`extends`:
        // subclassing a real Java class" section): an extends-struct's override is recognized by
        // ORDINARY name-matching against the struct's own compiled superclass method table, the
        // same mechanism an interface override already uses, so `override` itself carries no
        // checker-enforced meaning yet -- just consumed here so it parses at all.
        self.match_kind(OVERRIDE);
        self.expect(FN);
        let name = self.expect(IDENT).text;
        self.expect(LPAREN);
        let self_is_mut = self.self_receiver();
        var params = empty_param_vec();
        while self.match_kind(COMMA) {
            if self.check(RPAREN) { break; }
            params.push(self.one_param());
        }
        self.expect(RPAREN);
        var ret_type = none_string();
        if self.match_kind(ARROW) {
            ret_type = some_string(self.type_name_ref());
        }
        let body = self.block();
        return FnDecl { name: name, params: params, ret_type: ret_type, body: body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: self_is_mut, type_param2: none_string(), type_bounds2: empty_str_vec() };
    }

    // `static fn name(...) -> Ret { body }` -- no `self`, plain params like a top-level `fn`.
    fn static_method_decl(&mut self) -> FnDecl {
        self.expect(STATIC);
        self.expect(FN);
        let name = self.expect(IDENT).text;
        let params = self.param_list();
        var ret_type = none_string();
        if self.match_kind(ARROW) {
            ret_type = some_string(self.type_name_ref());
        }
        let body = self.block();
        return FnDecl { name: name, params: params, ret_type: ret_type, body: body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() };
    }

    // `impl Box<T> { ... }` -- the `<T>` (matching the struct's own declared type parameter) is
    // parsed and discarded, not stored on `ImplDecl` itself: the struct's own registered
    // `type_param` (already known via `structs: Vec<StructDecl>`) is what governs what `T` means
    // inside these methods, so there's nothing new to remember here beyond consuming the syntax
    // (see `Checker.hotc`'s own `generic_method_templates` header).
    // Parses and discards an optional `<T>` OR `<K, V>` right here -- shared by all three spots
    // `impl_decl` needs it (leading `impl<T>`, trailing `Box<T>`, trailing `for StructName<T>`).
    // Never stored on `ImplDecl` itself, same reasoning the ONE-param form already documented at
    // `impl_decl`'s own header: the struct's own registered `type_param`/`type_param2` (`struct
    // HashMap<K, V> { ... }`, see `Ast.hc`'s own `StructDecl.type_param2` header) is what governs
    // what `K`/`V` mean inside these methods, so there's nothing new to remember beyond consuming
    // the syntax -- `impl Pair<K, V> { ... }` needs this to parse at all now that two-param
    // generic structs exist.
    fn skip_optional_type_params(&mut self) {
        if self.match_kind(LT) {
            self.expect(IDENT);
            if self.match_kind(COMMA) {
                self.expect(IDENT);
            }
            self.expect(GT);
        }
    }

    fn impl_decl(&mut self) -> ImplDecl {
        self.expect(IMPL);
        // `impl<T> Box<T> { ... }` / `impl<T> Labeled for Box<T> { ... }` -- an optional LEADING
        // `<T>` right after `impl`, before the struct/interface name (the Rust-familiar spelling
        // for "this impl block is generic over T"). Real gap found running `examples/methods.hc`/
        // `examples/interfaces2.hc`/`examples/showcase.hc`: only the TRAILING `<T>` right after the
        // struct name (`impl Box<T> { ... }`, `for StructName<T>` below) was ever accepted, both of
        // which this parser already discards outright (a struct's own declared `type_param` is what
        // the checker/codegen actually key off of via `struct_name` -- see `generic_method_templates`/
        // `ensure_method_instantiated` in `Checker.hotc`, unaffected either way) -- so accepting and
        // discarding this leading form the same way is a pure parser change, no checker/codegen gap
        // at all once past this point.
        self.skip_optional_type_params();
        let name1 = self.expect(IDENT).text;
        self.skip_optional_type_params();
        // `impl InterfaceName for StructName { ... }` -- the FIRST identifier is the interface, the
        // one after `for` is the struct actually implementing it (mirrors the real compiler's own
        // `implDecl` exactly: `name1` is provisionally the struct name, reinterpreted as the
        // interface name only once `for` is actually seen). Plain `impl StructName { ... }`
        // (`interface_name` stays `None`) is unaffected -- `for` never appears in that form.
        var struct_name = name1;
        var interface_name = none_string();
        if self.match_kind(FOR) {
            interface_name = some_string(name1);
            struct_name = self.expect(IDENT).text;
            self.skip_optional_type_params();
        }
        // `by fieldName` -- composition delegation sugar, only meaningful right after `for
        // StructName` (an interface impl); see `Ast.hc`'s own `ImplDecl.delegate_field` header. No
        // method bodies are required in the `{ }` block below when this is present -- any interface
        // method not explicitly overridden gets a forwarding method synthesized later (see
        // `Codegen.hotc`'s own `materialize_delegated_methods`).
        var delegate_field = none_string();
        if self.check(BY) {
            self.advance();
            delegate_field = some_string(self.expect(IDENT).text);
        }
        self.expect(LBRACE);
        var methods = empty_fn_decl_vec();
        var static_methods = empty_fn_decl_vec();
        while !self.check(RBRACE) {
            if self.check(STATIC) {
                static_methods.push(self.static_method_decl());
            } else {
                methods.push(self.method_decl());
            }
        }
        self.expect(RBRACE);
        return ImplDecl { struct_name: struct_name, methods: methods, static_methods: static_methods, interface_name: interface_name, delegate_field: delegate_field };
    }

    // `extend Target { fn m(&self, params) -> Ret { body } ... }` -- see `Ast.hc`'s own
    // `ExtendDecl` header. Structurally almost identical to a plain `impl Target { ... }` block
    // (same `self_receiver`-required, real-body-required `method_decl()` reused directly), just
    // with no `for Interface`/`by field`/`static fn` shapes at all -- an extension method is
    // always an ordinary instance method, on a target this block doesn't own the declaration of.
    fn extend_decl(&mut self) -> ExtendDecl {
        self.expect(EXTEND);
        let target = self.expect(IDENT).text;
        self.expect(LBRACE);
        var methods = empty_fn_decl_vec();
        while !self.check(RBRACE) {
            methods.push(self.method_decl());
        }
        self.expect(RBRACE);
        return ExtendDecl { target: target, methods: methods };
    }

    // `[open] [sealed] interface Name [: Super1, Super2] { fn method(&self, ...) -> RetType; ... }`
    // -- see `Ast.hc`'s own `InterfaceDecl` header for the real, disclosed scope cut versus the real
    // language's own `interface` (no static methods, no `by` delegate-field impls). Interface
    // inheritance (`: Super1, Super2`) AND default method bodies
    // (`fn m(&self) -> T { ... }` instead of a bare `;`-terminated signature) ARE now both real --
    // see `flatten_interface_methods`'s own header (`Ast.hc`) for how a supertrait's methods reach
    // an implementing struct, and `Checker.hotc`'s own `check_interface_completeness` for how a
    // default method excuses a struct from providing its own override. `sealed`-exhaustiveness
    // itself is still real too (`Checker.hotc`'s own `check_sealed_match`) -- only a `sealed
    // interface` can be `match`ed on at all.
    fn interface_decl(&mut self) -> InterfaceDecl {
        let is_open = self.match_kind(OPEN);
        let is_sealed = self.match_kind(SEALED);
        self.expect(INTERFACE);
        let name = self.expect(IDENT).text;
        var parents = empty_str_vec();
        if self.match_kind(COLON) {
            parents.push(self.expect(IDENT).text);
            while self.match_kind(COMMA) {
                parents.push(self.expect(IDENT).text);
            }
        }
        self.expect(LBRACE);
        var methods = empty_interface_method_vec();
        while !self.check(RBRACE) {
            methods.push(self.interface_method_decl());
        }
        self.expect(RBRACE);
        let mod2 = self.current_module_opt();
        return InterfaceDecl { name: name, methods: methods, is_sealed: is_sealed, parents: parents, extern_binary_name: none_string(), module_name: mod2, is_open: is_open };
    }

    // `extern interface Name = "java.lang.Runnable" { fn method(&self, ...) -> RetType; ... }` --
    // see `Ast.hc`'s own `InterfaceDecl.extern_binary_name` header. Every method is ALWAYS a bare,
    // `;`-terminated abstract signature -- there's no HC body to give a method that binds to an
    // already-implemented-elsewhere real Java interface (unlike a plain `interface`'s own default
    // methods), so this reuses `interface_method_decl`'s own params/ret-type parsing directly but
    // never calls into ITS body-vs-`;` branch at all. No `sealed`/`: Super1, Super2` here either --
    // a real JVM interface's own implementors aren't a closed world this compile unit can see, and
    // real interface inheritance is already expressed by the real interface's OWN `extends` clause
    // on the JVM side, not something this declaration needs to re-state.
    fn extern_interface_decl(&mut self) -> InterfaceDecl {
        self.expect(EXTERN);
        self.expect(INTERFACE);
        let name = self.expect(IDENT).text;
        self.expect(EQ);
        let binary_name = self.expect(STRING).text;
        self.expect(LBRACE);
        var methods = empty_interface_method_vec();
        while !self.check(RBRACE) {
            self.expect(FN);
            let mname = self.expect(IDENT).text;
            self.expect(LPAREN);
            self.self_receiver();
            var params = empty_param_vec();
            while self.match_kind(COMMA) {
                if self.check(RPAREN) { break; }
                params.push(self.one_param());
            }
            self.expect(RPAREN);
            var ret_type = "Unit";
            if self.match_kind(ARROW) {
                ret_type = self.type_name_ref();
            }
            self.expect(SEMI);
            methods.push(InterfaceMethod { name: mname, params: params, ret_type: ret_type, body: none_stmt_vec() });
        }
        self.expect(RBRACE);
        return InterfaceDecl { name: name, methods: methods, is_sealed: false, parents: empty_str_vec(), extern_binary_name: some_string(binary_name), module_name: none_string(), is_open: false };
    }

    fn interface_method_decl(&mut self) -> InterfaceMethod {
        self.expect(FN);
        let name = self.expect(IDENT).text;
        self.expect(LPAREN);
        self.self_receiver(); // every interface method takes `&self` -- see `Ast.hc`'s own header
        var params = empty_param_vec();
        while self.match_kind(COMMA) {
            if self.check(RPAREN) { break; }
            params.push(self.one_param());
        }
        self.expect(RPAREN);
        var ret_type = "Unit";
        if self.match_kind(ARROW) {
            ret_type = self.type_name_ref();
        }
        // A default method's body parses through the EXACT SAME `self.block()` every plain `fn`
        // body already uses -- a real `{ ... }` here means "default", `;` means "abstract, every
        // implementer must override it" -- same `Some`/`None`-on-presence convention `if`'s own
        // `else_body` (`some_stmt_vec`/`none_stmt_vec`, right above) already established.
        var body = none_stmt_vec();
        if self.check(LBRACE) {
            body = some_stmt_vec(self.block());
        } else {
            self.expect(SEMI);
        }
        return InterfaceMethod { name: name, params: params, ret_type: ret_type, body: body };
    }

    // === `enum Name { Variant1 { field: Type, ... }, Variant2 {}, ... }` ===
    // Every variant needs explicit `{ }` even with no fields -- see `Ast.hc`'s own header.
    // A bare fieldless variant (`Foo,` or a trailing `Foo` before `}`, no `{ }` at all) is now
    // also accepted -- a real gap found attempting to self-compile the compiler's OWN `Lexer.hotc`,
    // whose own `TokType` enum declares dozens of variants this exact bare way (`INT, LONG,
    // FLOAT, ...`). Purely a parsing convenience: `EnumVariant.fields` was already an ordinary
    // (possibly empty) `Vec<Param>` for the explicit `Foo {}` form, so nothing downstream
    // (`Checker.hotc`/`Codegen.hotc`) needed any change at all -- an empty fields vec behaves
    // identically either way.
    fn enum_variant(&mut self) -> EnumVariant {
        let name = self.expect(IDENT).text;
        if self.check(LBRACE) {
            let fields = self.struct_fields();
            return EnumVariant { name: name, fields: fields };
        } else {
            return EnumVariant { name: name, fields: empty_param_vec() };
        }
    }

    fn enum_decl(&mut self) -> EnumDecl {
        self.expect(ENUM);
        let name = self.expect(IDENT).text;
        var type_param = none_string();
        var type_param2 = none_string();
        if self.match_kind(LT) {
            let tp = self.expect(IDENT).text;
            type_param = some_string(tp);
            // `<T, E>` -- see `Ast.hc`'s own `EnumDecl.type_param2` header.
            if self.match_kind(COMMA) {
                type_param2 = some_string(self.expect(IDENT).text);
            }
            self.expect(GT);
        }
        self.expect(LBRACE);
        var variants = empty_variant_vec();
        if !self.check(RBRACE) {
            variants.push(self.enum_variant());
            while self.match_kind(COMMA) {
                if self.check(RBRACE) { break; }
                variants.push(self.enum_variant());
            }
        }
        self.expect(RBRACE);
        let mod3 = self.current_module_opt();
        return EnumDecl { name: name, variants: variants, type_param: type_param, module_name: mod3, type_param2: type_param2 };
    }

    // === `extern class Alias = "binary/Name" { fn new(...) -> Self; fn m(&self, ...) -> Ret;
    // static fn s(...) -> Ret; } ===
    // Lookahead-only (restores `self.pos` before returning either way) -- tells whether the
    // UPCOMING tokens are a `self`/`&self`/`&mut self` receiver, without committing to consuming
    // them. Needed because an extern method's `static` keyword is OPTIONAL, not required, for a
    // method with no receiver at all (real `Codegen.hotc` usage: `CodegenShim`'s own methods,
    // e.g. `fn visitInstanceField(cw: &mut ClassWriter2, ...);`, take a plain named first param,
    // never `self`, and are never marked `static` either -- they're invoked via `Alias::method(
    // args)` static-call syntax regardless, same as if `static` HAD been written). `extern_method`
    // needs to know WHICH shape it's looking at before it can decide whether to call
    // `self_receiver()` or just parse an ordinary param list.
    fn looks_like_self_receiver(&mut self) -> Bool {
        let saved_pos = self.pos;
        if self.check(AMP) {
            self.advance();
            if self.check(MUT) { self.advance(); }
        }
        var is_self = false;
        if self.check(IDENT) {
            if self.peek().text == "self" { is_self = true; }
        }
        self.pos = saved_pos;
        return is_self;
    }

    // Disambiguates an `extern class` body item: `[static] fn ...` is a method, `[static] IDENT :
    // Type;` is a field (see `Ast.hc`'s own `ExternField` header) -- a bounded 1-token lookahead
    // past an optional leading `static`, same "peek, don't backtrack" style `looks_like_generic_lit`
    // and friends already use.
    fn is_extern_field_next(&self) -> Bool {
        var idx = self.pos;
        if self.tokens.get(idx).kind == STATIC { idx = idx + 1; }
        if idx >= self.tokens.length() { return false; }
        return self.tokens.get(idx).kind != FN;
    }

    fn extern_field(&mut self) -> ExternField {
        let is_static = self.match_kind(STATIC);
        let name = self.expect(IDENT).text;
        self.expect(COLON);
        let type_name = self.type_name_ref();
        self.expect(SEMI);
        return ExternField { name: name, type_name: type_name, is_static: is_static };
    }

    // A real JVM method's own name occasionally collides with a real HC keyword -- `open` is
    // the concrete case that surfaced this (`javax.sound.sampled.Clip.open(...)`, real JDK API,
    // needed by `stdlib/audio.hotc`'s own `Sound::load`/`Sound::play`): `open` never lexes as
    // `IDENT` at all (it's the real `pub open module ...` visibility keyword -- same trap
    // `Window::open` hit as a STRUCT method name, documented in `window.hotc`'s own header,
    // except THAT one could just be renamed to `new` since it was HC's own naming choice; a real
    // extern method's name is NOT a free choice -- it must match the real JVM method exactly, so
    // renaming isn't an option here). Used at BOTH the places this can bite: declaring the
    // extern method itself (right after `fn` inside an `extern class` body), and CALLING it
    // (`postfix_loop`'s own `.method(...)` parsing, right after a `.`) -- both positions always
    // expect a plain member name next, never a real `open module` visibility declaration, so
    // loosening them is safe; ordinary identifier parsing everywhere else is untouched.
    fn extern_method_name(&mut self) -> String {
        if self.check(IDENT) { return self.advance().text; }
        if self.check(OPEN) { return self.advance().text; }
        return self.expect(IDENT).text; // real error, naming what was actually expected
    }

    fn extern_method(&mut self) -> ExternMethod {
        let is_static_kw = self.match_kind(STATIC);
        self.expect(FN);
        let name = self.extern_method_name();
        self.expect(LPAREN);
        let is_ctor = name == "new";
        var params = empty_param_vec();
        var is_static = is_static_kw;
        var takes_self = false;
        if !is_static_kw && !is_ctor && self.looks_like_self_receiver() {
            takes_self = true;
        }
        if takes_self {
            self.self_receiver();
            while self.match_kind(COMMA) {
                if self.check(RPAREN) { break; }
                params.push(self.one_param());
            }
        } else {
            // No receiver at all -- implicitly static (callable via `Alias::method(args)`) even
            // without the `static` keyword, UNLESS this is a constructor (`is_ctor` already
            // dispatches through its own `NEW`/`INVOKESPECIAL` codegen path, not
            // INVOKESTATIC/INVOKEVIRTUAL, so it isn't really "static" in that sense either way).
            if !is_ctor { is_static = true; }
            if !self.check(RPAREN) {
                params.push(self.one_param());
                while self.match_kind(COMMA) {
                    if self.check(RPAREN) { break; }
                    params.push(self.one_param());
                }
            }
        }
        self.expect(RPAREN);
        var ret_type = "Unit";
        if self.match_kind(ARROW) {
            ret_type = self.type_name_ref(); // "Self" just reads as the literal string "Self"; no keyword needed
        }
        self.expect(SEMI);
        return ExternMethod { name: name, params: params, ret_type: ret_type, is_static: is_static, is_ctor: is_ctor };
    }

    fn extern_class_decl(&mut self) -> ExternClassDecl {
        self.expect(EXTERN);
        self.expect(CLASS);
        let name = self.expect(IDENT).text;
        self.expect(EQ);
        let binary_name = self.expect(STRING).text;
        // Optional trailing `interface` keyword -- see `Ast.hc`'s own `ExternClassDecl` header
        // for what it changes (instance-call dispatch opcode only).
        var is_interface = false;
        if self.check(INTERFACE) {
            self.advance();
            is_interface = true;
        }
        self.expect(LBRACE);
        var methods = empty_extern_method_vec();
        var fields = empty_extern_field_vec();
        while !self.check(RBRACE) {
            if self.is_extern_field_next() {
                fields.push(self.extern_field());
            } else {
                methods.push(self.extern_method());
            }
        }
        self.expect(RBRACE);
        return ExternClassDecl { name: name, binary_name: binary_name, methods: methods, fields: fields, is_interface: is_interface };
    }

    // === Top level: a whole source file is zero or more `fn`/`struct`/`impl`/`enum`/`extern`
    // declarations ===
    // Consumes every consecutive `DOC_COMMENT` token (one per `///` line) right here, building a
    // structured `DocComment` -- see `Ast.hc`'s own `DocComment` header for the full section
    // model. Called from `parse_program`'s own top-level loop, right before the `struct`/`fn` it's
    // attached to (mirrors `annotation()`'s own calling convention).
    fn doc_comment_block(&mut self) -> DocComment {
        var summary = "";
        var param_names = empty_str_vec();
        var param_texts = empty_str_vec();
        var returns_text = "";
        var example_text = "";
        var warning_text = "";
        var see_targets = empty_str_vec();
        var deprecated_text = "";
        var has_deprecated = false;
        // Which section an untagged line continues: 0=summary, 1=the LAST @param's own text,
        // 2=@returns, 3=@example, 4=@warning, 5=@deprecated, -1=none (right after @see, whose own
        // target is never continued).
        var section = 0;
        while self.check(DOC_COMMENT) {
            let line = self.advance().text;
            if str_starts_with(line, "@param") {
                let rest = str_after_prefix(line, "@param");
                var pname = rest;
                var ptext = "";
                let sp = rest.indexOf(" ");
                if sp >= 0 {
                    pname = rest.substring(0, sp);
                    ptext = rest.substring(sp + 1, rest.length());
                }
                param_names.push(pname);
                param_texts.push(ptext);
                section = 1;
            } else if str_starts_with(line, "@returns") {
                returns_text = str_after_prefix(line, "@returns");
                section = 2;
            } else if str_starts_with(line, "@example") {
                example_text = str_after_prefix(line, "@example");
                section = 3;
            } else if str_starts_with(line, "@warning") {
                warning_text = str_after_prefix(line, "@warning");
                section = 4;
            } else if str_starts_with(line, "@deprecated") {
                deprecated_text = str_after_prefix(line, "@deprecated");
                has_deprecated = true;
                section = 5;
            } else if str_starts_with(line, "@see") {
                see_targets.push(str_after_prefix(line, "@see"));
                section = -1;
            } else if section == 0 {
                if summary == "" { summary = line; } else { summary = summary + " " + line; }
            } else if section == 1 {
                let pidx = param_texts.length() - 1;
                param_texts.set(pidx, param_texts.get(pidx) + " " + line);
            } else if section == 2 {
                returns_text = returns_text + " " + line;
            } else if section == 3 {
                example_text = example_text + " " + line;
            } else if section == 4 {
                warning_text = warning_text + " " + line;
            } else if section == 5 {
                deprecated_text = deprecated_text + " " + line;
            }
            // `section == -1` (right after `@see`): an untagged line here has nothing real to
            // continue -- dropped, same as this design's own "@see's target is always exactly one
            // line" rule implies.
        }
        return DocComment { summary: summary, param_names: param_names, param_texts: param_texts, returns_text: returns_text, example_text: example_text, warning_text: warning_text, see_targets: see_targets, deprecated_text: deprecated_text, has_deprecated: has_deprecated };
    }

    fn parse_program(&mut self) -> Program {
        var fns = empty_fn_decl_vec();
        var structs = empty_struct_decl_vec();
        var impls = empty_impl_decl_vec();
        var enums = empty_enum_decl_vec();
        var externs = empty_extern_class_vec();
        var statics = empty_static_decl_vec();
        var interfaces = empty_interface_decl_vec();
        var extend_decls = empty_extend_decl_vec();
        var struct_annotation_names = empty_str_vec();
        var struct_annotation_data = empty_annotation_vec();
        var fn_annotation_names = empty_str_vec();
        var fn_annotation_data = empty_annotation_vec();
        var must_use_fn_names = empty_str_vec();
        var dev_fn_names = empty_str_vec();
        var deterministic_fn_names = empty_str_vec();
        // `@startup`/`@update`/`@fixed_update`/`@render` -- see `build_lifecycle_dispatcher_fn`'s
        // own header. Each is its own flat name list (same accumulator shape `dev_fn_names`/
        // `deterministic_fn_names` already use), consumed ONLY by `parse_program`'s own tail --
        // nothing else in the pipeline needs to know this feature exists.
        var startup_fn_names = empty_str_vec();
        var update_fn_names = empty_str_vec();
        var fixed_update_fn_names = empty_str_vec();
        var render_fn_names = empty_str_vec();
        var struct_doc_names = empty_str_vec();
        var struct_doc_data = empty_doc_comment_vec();
        var fn_doc_names = empty_str_vec();
        var fn_doc_data = empty_doc_comment_vec();
        var uses = empty_str_vec();
        var sendable_struct_names = empty_str_vec();
        var private_type_names = empty_str_vec();
        var pub_struct_names = empty_str_vec();
        var pub_enum_names = empty_str_vec();
        var pub_interface_names = empty_str_vec();
        var pub_fn_names = empty_str_vec();
        var pub_static_names = empty_str_vec();
        var const_fns = empty_fn_decl_vec();
        var const_names = empty_str_vec();
        var const_types = empty_str_vec();
        var const_inits = empty_expr_vec();
        var components = empty_component_decl_vec();
        var systems = empty_system_decl_vec();
        var resources = empty_component_decl_vec();
        while !self.check(EOF) {
            // `use vec;` -- see `Ast.hc`'s own `Program.uses` header for the full design. A bare
            // topic name, no path/namespace syntax at all (there's no real module-path resolution
            // system behind this) -- `Driver.hotc`'s own `resolve_stdlib_modules` is the only
            // reader. Consumed in this same top-level loop, same "no fixed position enforced"
            // leniency `module`/`pub` already get right above/below.
            if self.check(USE) {
                self.advance();
                uses.push(self.expect(IDENT).text);
                self.expect(SEMI);
                continue;
            }
            // `module a.b.c;` -- real now (see `Ast.hc`'s own `StructDecl.module_name` header):
            // builds the real dot-joined string into `self.current_module`, read back by every
            // struct/enum/interface declaration parsed from THIS POINT ON in the file. Consuming
            // it inline in this same top-level loop (rather than requiring it strictly first)
            // still matches this subset's existing leniency elsewhere (`pub` also isn't gated to
            // a fixed position) -- real `.hotc` source always puts it first anyway, by
            // convention, not by a rule this parser enforces.
            if self.check(MODULE) {
                self.advance();
                var mod = self.expect(IDENT).text;
                while self.match_kind(DOT) {
                    mod = mod + "." + self.expect(IDENT).text;
                }
                self.expect(SEMI);
                self.current_module = mod;
                continue;
            }
            // `/// ...` -- see `Ast.hc`'s own `DocComment` header. Consumed BEFORE any `@`
            // annotation/directive (same ordering `///` doc comments always take relative to
            // attributes in every language that has both), so a doc comment followed by
            // `@must_use`/`@"binary.Name"(...)` followed by the actual declaration all attach
            // correctly. Scoped to top-level `struct`/`fn` only, same cut every other side-channel
            // feature in this loop already makes.
            var pending_doc = none_doc_comment();
            var has_pending_doc = false;
            if self.check(DOC_COMMENT) {
                pending_doc = some_doc_comment(self.doc_comment_block());
                has_pending_doc = true;
            }
            // `@"binary.Name"(...)` -- see `Ast.hc`'s own `Program.struct_annotation_names`
            // header for why this is a side-channel rather than a field threaded through
            // `StructDecl`/`FnDecl` themselves. Scoped to top-level `struct`/`fn` only -- any
            // OTHER following declaration is a real error, not silently dropped.
            var pending_annotation = none_annotation();
            var has_pending_annotation = false;
            // `@must_use` -- a bare compiler DIRECTIVE (no quoted binary name), distinguished from
            // a real `@"binary.Name"(...)` annotation right here, at parse time, by whether a
            // STRING or an IDENT follows the `@` -- same distinction `Ast.hc`'s own `Annotation`
            // header already draws for `@serializable` (a different, still-unported directive).
            var pending_must_use = false;
            // `@dev` -- see `IDEAS.md`'s own "conditionally-compiled debug-only code" entry.
            // Bare, like `@must_use`; only meaningful on a top-level `fn` (gated in ONE place,
            // right below, rather than `@must_use`'s own scattered per-branch rejects -- same
            // practical effect, less repetition).
            var pending_dev = false;
            // `@deterministic` -- see `Ast.hc`'s own `Program.deterministic_fn_names` header.
            // Same bare-directive shape/gate as `@dev` right above.
            var pending_deterministic = false;
            // `@startup`/`@update`/`@fixed_update`/`@render` -- see `build_lifecycle_dispatcher_
            // fn`'s own header. Same bare-directive shape/gate as `@dev`/`@deterministic` above;
            // real param-signature validation happens once the `fn` itself is actually parsed
            // (`@startup` must be zero-param, the other three exactly one `Float` param), since
            // only THEN is the signature known.
            var pending_startup = false;
            var pending_update = false;
            var pending_fixed_update = false;
            var pending_render = false;
            // `@sendable` -- see `Ast.hc`'s own `Program.sendable_struct_names` header. Same bare-
            // directive distinction as `@must_use` right below, and same "only on struct" gate as
            // Phoenix Flight's own `PhoenixPool::spawn` needs to actually check anything -- see
            // README's own "Compile-time concurrency safety" section.
            var pending_sendable = false;
            // `@after(Other)` / `@before(Other)` / `@profile` -- `system`-only directives (see
            // `Ast.hc`'s own `SystemDecl` header), the first ones needing a parenthesized argument
            // rather than being bare like `@must_use`/`@sendable` -- parsed inline here rather than
            // generalizing `directive()` itself, since nothing else needs an argument yet. A `while`
            // here (not the single `if` this used to be) so multiple directives can stack on one
            // declaration (`@after(...) @profile system Foo { ... }`) -- strictly more permissive
            // than before, every previously-valid single-`@` case still parses identically.
            // `Vec<String>`, not `Option<String>` -- `@after(A, B, ...)` multi-target (2026-09-17,
            // see `Ast.hc`'s own `SystemDecl.after` header for why); empty means no `@after`/
            // `@before` was written at all.
            var pending_after = empty_str_vec2();
            var pending_before = empty_str_vec2();
            var pending_profile = false;
            // `@main_thread` -- see `Ast.hc`'s own `SystemDecl.has_main_thread` header. Same
            // bare-directive shape `@profile` already has.
            var pending_main_thread = false;
            // `@run_if(condition_fn)` -- see `Ast.hc`'s own `SystemDecl.run_if` header. `""` when
            // no `@run_if` was written.
            var pending_run_if = "";
            // `@derive(Eq, Hash)` -- see `derive_impls`'s own header for the full design. A list
            // (not a single bare directive) since both can be requested together on one struct,
            // same `Vec<String>` "empty means not written at all" convention `pending_after`/
            // `pending_before` right above already use for their own multi-target lists.
            var pending_derive = empty_str_vec2();
            // `@tunable` -- see `build_tunable_get_fn`'s own header. Bare, like `@must_use`/
            // `@sendable`; only meaningful on a top-level `static` declared `Float` (checked once
            // the static itself is parsed, since only THEN is its declared type known).
            var pending_tunable = false;
            // `@requires(cond)`/`@ensures(cond)` -- see `apply_contract`'s own header. Each takes
            // a real parenthesized EXPRESSION (not a bare identifier list like `@after(A, B)`),
            // so parsed via `self.expression()` right where the directive itself is recognized --
            // only ONE of each is supported per `fn` (a real, disclosed scope cut; multiple
            // conditions can already be written as one `cond1 && cond2` by the caller).
            var pending_requires = none_expr();
            var has_pending_requires = false;
            var pending_ensures = none_expr();
            var has_pending_ensures = false;
            while self.check(AT) {
                if self.tokens.get(self.pos + 1).kind == STRING {
                    pending_annotation = some_annotation(self.annotation());
                    has_pending_annotation = true;
                } else if self.tokens.get(self.pos + 1).kind == DEV {
                    // `@dev` -- `dev` is a reserved KEYWORD (`Lexer.hotc`'s own `DEV` token, also
                    // usable as a real expression inside `if dev { ... }`, see `primary`'s own
                    // header), not an `IDENT` -- `directive()`'s own `self.expect(IDENT)` would
                    // throw on it, so this one directive is recognized directly here instead.
                    self.advance(); // AT
                    self.advance(); // DEV
                    pending_dev = true;
                } else {
                    let directive = self.directive();
                    if directive == "must_use" {
                        pending_must_use = true;
                    } else if directive == "deterministic" {
                        pending_deterministic = true;
                    } else if directive == "sendable" {
                        pending_sendable = true;
                    } else if directive == "after" {
                        self.expect(LPAREN);
                        pending_after.push(self.expect(IDENT).text);
                        while self.match_kind(COMMA) {
                            pending_after.push(self.expect(IDENT).text);
                        }
                        self.expect(RPAREN);
                    } else if directive == "before" {
                        self.expect(LPAREN);
                        pending_before.push(self.expect(IDENT).text);
                        while self.match_kind(COMMA) {
                            pending_before.push(self.expect(IDENT).text);
                        }
                        self.expect(RPAREN);
                    } else if directive == "profile" {
                        pending_profile = true;
                    } else if directive == "main_thread" {
                        pending_main_thread = true;
                    } else if directive == "run_if" {
                        self.expect(LPAREN);
                        pending_run_if = self.expect(IDENT).text;
                        self.expect(RPAREN);
                    } else if directive == "derive" {
                        self.expect(LPAREN);
                        pending_derive.push(self.expect(IDENT).text);
                        while self.match_kind(COMMA) {
                            pending_derive.push(self.expect(IDENT).text);
                        }
                        self.expect(RPAREN);
                    } else if directive == "tunable" {
                        pending_tunable = true;
                    } else if directive == "startup" {
                        pending_startup = true;
                    } else if directive == "update" {
                        pending_update = true;
                    } else if directive == "fixed_update" {
                        pending_fixed_update = true;
                    } else if directive == "render" {
                        pending_render = true;
                    } else if directive == "requires" {
                        self.expect(LPAREN);
                        pending_requires = some_expr(self.expression());
                        has_pending_requires = true;
                        self.expect(RPAREN);
                    } else if directive == "ensures" {
                        self.expect(LPAREN);
                        pending_ensures = some_expr(self.expression());
                        has_pending_ensures = true;
                        self.expect(RPAREN);
                    } else {
                        throw ParseError::new("unknown compiler directive '@" + directive + "'");
                    }
                }
            }
            // Visibility isn't tracked or enforced at all this phase -- this subset only ever
            // compiles one file at a time (no cross-module resolution to gate), so `pub` is
            // parsed purely so real HC source that uses it doesn't fail to parse; consumed and
            // otherwise ignored.
            // **Fixed 2026-09-23**: `pub`'s own real effect was previously discarded entirely
            // right here -- see `ARCHITECTURE.md`'s own "Modules" section corrections for the
            // full story. Captured now, pushed into the matching `pub_*_names` list once the
            // actual declaration kind is known (each branch below), same shape `is_priv` right
            // below already establishes.
            let is_pub_decl = self.match_kind(PUB);
            // `priv struct Foo { ... }` / `priv enum` / `priv interface` -- see IDEAS.md's own "A
            // minimal import/visibility system" entry. Only meaningful on a top-level TYPE
            // declaration (real, disclosed v1 scope: not `fn`/`static` -- the actual motivating
            // case is a shared library's internal helper TYPES leaking into a consumer's
            // namespace, and restricting to types keeps `Driver.hotc`'s own `check_private_
            // visibility` walker looking only at type-name-shaped references, which is both a
            // smaller walker and a much lower false-positive surface than tracking arbitrary
            // value/call references too). Gated the same single-check way `@sendable`/`@derive`/
            // `@tunable` already are right below, rather than repeating the reject once per arm.
            let is_priv = self.match_kind(PRIV);
            // `@sendable` is only meaningful on `struct` -- checked HERE (after `pub`, before
            // dispatching on which declaration kind follows) rather than repeating a reject in
            // every OTHER arm's own body the way `@must_use`'s reverse restriction does below,
            // since there's only ONE valid target to check for instead of many invalid ones.
            if pending_sendable && !self.check(STRUCT) {
                throw ParseError::new("'@sendable' is only supported on 'struct' declarations");
            }
            // `@derive` is only meaningful on `struct` -- same single-gate shape `@sendable`
            // right above uses.
            if pending_derive.length() > 0 && !self.check(STRUCT) {
                throw ParseError::new("'@derive' is only supported on 'struct' declarations");
            }
            // `@tunable` is only meaningful on a top-level `static` -- same single-gate shape
            // `@sendable`/`@derive` right above use.
            if pending_tunable && !self.check(STATIC) {
                throw ParseError::new("'@tunable' is only supported on top-level 'static' declarations");
            }
            // `@dev` is only meaningful on a top-level `fn` -- same single-gate shape `@sendable`
            // right above uses (one valid target, checked here, rather than `@must_use`'s own
            // scattered per-branch rejects below). Positive check (IS it one of the other
            // declaration-kind keywords the loop right below this one dispatches on?) rather than
            // a long negation -- easier to keep in sync with that chain's own real member list.
            var next_is_other_decl_kind = self.check(STRUCT) || self.check(ARENA) || self.check(IMPL) || self.check(ENUM) || self.check(EXTERN) || self.check(STATIC) || self.check(INTERFACE) || self.check(SEALED) || self.check(OPEN) || self.check(EXTEND) || self.check(COMPONENT) || self.check(RESOURCE) || self.check(SYSTEM) || self.check(UNIT) || self.check(TYPESTATE) || self.check(EVENT) || self.check(HANDLE) || self.check(CONST) || self.check(STATE);
            if is_priv && !(self.check(STRUCT) || self.check(ENUM) || self.check(INTERFACE) || self.check(SEALED) || self.check(OPEN)) {
                throw ParseError::new("'priv' is only supported on top-level 'struct'/'enum'/'interface' declarations");
            }
            if pending_dev && next_is_other_decl_kind {
                throw ParseError::new("'@dev' is only supported on top-level 'fn' declarations");
            }
            if pending_deterministic && next_is_other_decl_kind {
                throw ParseError::new("'@deterministic' is only supported on top-level 'fn' declarations");
            }
            var has_pending_lifecycle = pending_startup || pending_update || pending_fixed_update || pending_render;
            if has_pending_lifecycle && next_is_other_decl_kind {
                throw ParseError::new("'@startup'/'@update'/'@fixed_update'/'@render' are only supported on top-level 'fn' declarations");
            }
            // `@requires`/`@ensures` are only meaningful on a top-level `fn` -- same gate `@dev`
            // right above uses.
            if (has_pending_requires || has_pending_ensures) && next_is_other_decl_kind {
                throw ParseError::new("'@requires'/'@ensures' are only supported on top-level 'fn' declarations");
            }
            // `@after`/`@before`/`@profile` are only meaningful on `system` -- same single up-
            // front gate `@sendable` uses right above, rather than repeating the reject in every
            // other arm.
            var has_pending_ordering_or_profile = pending_profile || pending_main_thread || pending_run_if != "";
            if pending_after.length() > 0 { has_pending_ordering_or_profile = true; }
            if pending_before.length() > 0 { has_pending_ordering_or_profile = true; }
            if has_pending_ordering_or_profile && !self.check(SYSTEM) {
                throw ParseError::new("'@after'/'@before'/'@profile'/'@main_thread'/'@run_if' are only supported on 'system' declarations");
            }
            if self.check(STRUCT) {
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'struct' declarations");
                }
                let sd = self.struct_decl();
                if pending_sendable {
                    sendable_struct_names.push(sd.name);
                }
                if is_priv {
                    private_type_names.push(sd.name);
                }
                if is_pub_decl {
                    pub_struct_names.push(sd.name);
                }
                if pending_derive.length() > 0 {
                    let synth = self.derive_impls(&sd, &pending_derive);
                    var dsi = 0;
                    while dsi < synth.length() {
                        impls.push(synth.get(dsi));
                        dsi = dsi + 1;
                    }
                }
                if has_pending_annotation {
                    if let Some { value: ann } = pending_annotation {
                        struct_annotation_names.push(sd.name);
                        struct_annotation_data.push(ann);
                    }
                }
                if has_pending_doc {
                    if let Some { value: docv } = pending_doc {
                        struct_doc_names.push(sd.name);
                        struct_doc_data.push(docv);
                    }
                }
                structs.push(sd);
            } else if self.check(ARENA) {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on 'arena struct' declarations");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'arena struct' declarations");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on 'arena struct' declarations");
                }
                structs.push(self.arena_struct_decl());
            } else if self.check(IMPL) {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on 'impl' blocks");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'impl' blocks");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on 'impl' blocks");
                }
                impls.push(self.impl_decl());
            } else if self.check(ENUM) {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on 'enum' declarations");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'enum' declarations");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on 'enum' declarations");
                }
                let ed = self.enum_decl();
                if is_priv {
                    private_type_names.push(ed.name);
                }
                if is_pub_decl {
                    pub_enum_names.push(ed.name);
                }
                enums.push(ed);
            } else if self.check(EXTERN) && self.tokens.get(self.pos + 1).kind == INTERFACE {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on 'extern interface' declarations");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'extern interface' declarations");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on 'extern interface' declarations");
                }
                interfaces.push(self.extern_interface_decl());
            } else if self.check(EXTERN) {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on 'extern class' declarations");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'extern class' declarations");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on 'extern class' declarations");
                }
                externs.push(self.extern_class_decl());
            } else if self.check(STATIC) {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on top-level 'static' declarations");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on top-level 'static' declarations");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on top-level 'static' declarations");
                }
                let sdecl = self.static_decl();
                if is_pub_decl {
                    pub_static_names.push(sdecl.name);
                }
                if pending_tunable {
                    if sdecl.type_name != "Float" {
                        throw ParseError::new("'@tunable' currently only supports 'Float' statics, got '" + sdecl.name + ": " + sdecl.type_name + "'");
                    }
                    self.tunable_names.push(sdecl.name);
                }
                statics.push(sdecl);
            } else if self.check(CONST) {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on 'const' declarations");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'const' declarations");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on 'const' declarations");
                }
                // `const fn name(...) -> Ret { body }` vs. `const NAME: Type = expr;` --
                // distinguished by whether `FN` follows `CONST` (one token of lookahead), same
                // "peek the very next token to pick a branch" approach `event_decl`/`on_decl`'s
                // own dispatch already uses.
                if self.tokens.get(self.pos + 1).kind == FN {
                    self.advance(); // CONST
                    const_fns.push(self.fn_decl());
                } else {
                    self.advance(); // CONST
                    let cname = self.expect(IDENT).text;
                    self.expect(COLON);
                    let ctype = self.type_name_ref();
                    self.expect(EQ);
                    let cinit = self.expression();
                    self.expect(SEMI);
                    const_names.push(cname);
                    const_types.push(ctype);
                    const_inits.push(cinit);
                }
            } else if self.check(INTERFACE) || self.check(SEALED) || self.check(OPEN) {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on 'interface' declarations");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'interface' declarations");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on 'interface' declarations");
                }
                let ifd = self.interface_decl();
                if is_priv {
                    private_type_names.push(ifd.name);
                }
                if is_pub_decl {
                    pub_interface_names.push(ifd.name);
                }
                interfaces.push(ifd);
            } else if self.check(EXTEND) {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on 'extend' blocks");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'extend' blocks");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on 'extend' blocks");
                }
                extend_decls.push(self.extend_decl());
            } else if self.check(COMPONENT) {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on 'component' declarations");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'component' declarations");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on 'component' declarations");
                }
                components.push(self.component_decl());
            } else if self.check(RESOURCE) {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on 'resource' declarations");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'resource' declarations");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on 'resource' declarations");
                }
                resources.push(self.resource_decl());
            } else if self.check(SYSTEM) {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on 'system' declarations");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'system' declarations");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on 'system' declarations");
                }
                systems.push(self.system_decl(pending_after, pending_before, pending_profile, pending_main_thread, pending_run_if));
            } else if self.check(UNIT) {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on 'unit' declarations");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'unit' declarations");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on 'unit' declarations");
                }
                let ud = self.unit_decl();
                structs.push(ud.sd);
                impls.push(ud.im);
                fns.push(ud.ctor_fn);
            } else if self.check(TYPESTATE) {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on 'typestate' declarations");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'typestate' declarations");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on 'typestate' declarations");
                }
                let tr = self.typestate_decl();
                var tsi = 0;
                while tsi < tr.structs.length() {
                    structs.push(tr.structs.get(tsi));
                    tsi = tsi + 1;
                }
                var tii = 0;
                while tii < tr.impls.length() {
                    impls.push(tr.impls.get(tii));
                    tii = tii + 1;
                }
            } else if self.check(EVENT) {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on 'event' declarations");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'event' declarations");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on 'event' declarations");
                }
                self.event_decl();
            } else if self.check(HANDLE) {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on 'handle' declarations");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'handle' declarations");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on 'handle' declarations");
                }
                self.on_decl();
            } else if self.check(STATE) {
                if has_pending_annotation {
                    throw ParseError::new("annotations aren't supported on 'state' declarations");
                }
                if pending_must_use {
                    throw ParseError::new("'@must_use' isn't supported on 'state' declarations");
                }
                if has_pending_doc {
                    throw ParseError::new("doc comments aren't supported on 'state' declarations");
                }
                let smr = self.state_machine_decl();
                enums.push(smr.state_enum);
                enums.push(smr.event_enum);
                fns.push(smr.transition_fn);
            } else {
                var fd = self.fn_decl();
                if is_pub_decl {
                    pub_fn_names.push(fd.name);
                }
                if has_pending_annotation {
                    if let Some { value: ann2 } = pending_annotation {
                        fn_annotation_names.push(fd.name);
                        fn_annotation_data.push(ann2);
                    }
                }
                if pending_must_use {
                    must_use_fn_names.push(fd.name);
                }
                if pending_dev {
                    dev_fn_names.push(fd.name);
                }
                if pending_deterministic {
                    deterministic_fn_names.push(fd.name);
                }
                if pending_startup {
                    if fd.params.length() != 0 {
                        throw ParseError::new("'@startup' fn '" + fd.name + "' must take zero parameters, got " + JString3::valueOf(fd.params.length()));
                    }
                    startup_fn_names.push(fd.name);
                }
                if pending_update {
                    check_lifecycle_dt_param(&fd, "@update");
                    update_fn_names.push(fd.name);
                }
                if pending_fixed_update {
                    check_lifecycle_dt_param(&fd, "@fixed_update");
                    fixed_update_fn_names.push(fd.name);
                }
                if pending_render {
                    check_lifecycle_dt_param(&fd, "@render");
                    render_fn_names.push(fd.name);
                }
                if has_pending_doc {
                    if let Some { value: docv2 } = pending_doc {
                        fn_doc_names.push(fd.name);
                        fn_doc_data.push(docv2);
                    }
                }
                if has_pending_requires || has_pending_ensures {
                    self.needs_contracts = true;
                    fd = apply_contract(fd, has_pending_requires, pending_requires, has_pending_ensures, pending_ensures);
                }
                fns.push(fd);
            }
        }
        // `parallel for` needs `PhoenixPool`/`PhoenixTask` regardless of whether this program
        // ever wrote `use phoenix;` itself -- same "auto-inject a transitive dependency" pattern
        // `Driver.hotc`'s own `ecs` -> `phoenix` topic dependency already establishes.
        if self.needs_phoenix {
            uses.push("phoenix");
        }
        // `@derive(Eq, Hash)` needs `Eq`/`Hashable` (both declared in `stdlib/collections.hotc`)
        // regardless of whether this program ever wrote `use collections;` itself -- see
        // `needs_collections`'s own header.
        if self.needs_collections {
            uses.push("collections");
        }
        // `sequence { ... }` needs `wait`/`wait_until` (`stdlib/sequence.hotc`) regardless of
        // whether this program ever wrote `use sequence;` itself -- see `needs_sequence`'s own
        // header. Each `sequence` block's own synthesized helper `fn` (queued in `pending_seq_
        // fns` by `sequence_stmts`, however deeply nested the block that created it was) gets
        // appended to the real top-level `fns` list here, the first point in this fn where that
        // list is fully assembled but not yet handed to `Program`.
        if self.needs_sequence {
            uses.push("sequence");
            var sfi = 0;
            while sfi < self.pending_seq_fns.length() {
                fns.push(self.pending_seq_fns.get(sfi));
                sfi = sfi + 1;
            }
        }
        // `@tunable` -- see `tunable_names`'s own header and `build_tunable_get_fn`'s. Only
        // synthesized when at least one `@tunable static` was actually seen -- a program that
        // never uses this feature gets zero extra generated code, same discipline `needs_
        // sequence`/`needs_phoenix` right above already follow.
        if self.tunable_names.length() > 0 {
            uses.push("vec");
            fns.push(build_tunable_get_fn(&self.tunable_names));
            fns.push(build_tunable_set_fn(&self.tunable_names));
            fns.push(build_tunable_names_fn(&self.tunable_names));
        }
        // `@requires`/`@ensures` -- see `apply_contract`'s own header. `ContractError` isn't
        // declared in any stdlib topic (there was no existing "exceptions" topic to hang it off
        // of) -- synthesized directly into `Program.externs` here instead, the same "only when
        // actually used" discipline every other `needs_*` flag in this fn already follows.
        if self.needs_contracts {
            var ctor_params = empty_param_vec();
            ctor_params.push(Param { name: "msg", type_name: "String", is_ref: false, is_mut_ref: false });
            var ctor_methods = empty_extern_method_vec();
            ctor_methods.push(ExternMethod { name: "new", params: ctor_params, ret_type: "Self", is_static: false, is_ctor: true });
            externs.push(ExternClassDecl { name: "ContractError", binary_name: "java.lang.RuntimeException", methods: ctor_methods, fields: empty_extern_field_vec(), is_interface: false });
        }
        // `@startup`/`@update`/`@fixed_update`/`@render` -- see `build_lifecycle_dispatcher_fn`'s
        // own header. Each dispatcher is only generated when its own category actually has at
        // least one marked fn -- a program using none of these gets zero extra generated code.
        if startup_fn_names.length() > 0 {
            fns.push(build_lifecycle_dispatcher_fn("run_startup", &startup_fn_names, false));
        }
        if update_fn_names.length() > 0 {
            fns.push(build_lifecycle_dispatcher_fn("run_update", &update_fn_names, true));
        }
        if fixed_update_fn_names.length() > 0 {
            fns.push(build_lifecycle_dispatcher_fn("run_fixed_update", &fixed_update_fn_names, true));
        }
        if render_fn_names.length() > 0 {
            fns.push(build_lifecycle_dispatcher_fn("run_render", &render_fn_names, true));
        }
        // `event`/`on` -- see `event_decl`/`on_decl`'s own headers. Every synthesized handler
        // `fn` (one per `on` block) gets appended to the real top-level `fns` list here; ONE
        // `emit_Name` dispatcher is generated per DECLARED event, calling every handler
        // registered for it.
        var pei = 0;
        while pei < self.pending_event_fns.length() {
            fns.push(self.pending_event_fns.get(pei));
            pei = pei + 1;
        }
        var evi = 0;
        while evi < self.event_names.length() {
            let ev_name = self.event_names.get(evi);
            let ev_fields = event_params_for(&self.event_names, &self.event_field_counts, &self.event_field_names, &self.event_field_types, ev_name);
            let ev_handlers = handlers_for_event(&self.handler_event_names, &self.handler_fn_names, ev_name);
            fns.push(build_event_emit_fn(ev_name, &ev_fields, &ev_handlers));
            evi = evi + 1;
        }
        return Program { fns: fns, structs: structs, impls: impls, enums: enums, externs: externs, statics: statics, interfaces: interfaces, struct_annotation_names: struct_annotation_names, struct_annotation_data: struct_annotation_data, fn_annotation_names: fn_annotation_names, fn_annotation_data: fn_annotation_data, extend_decls: extend_decls, must_use_fn_names: must_use_fn_names, dev_fn_names: dev_fn_names, deterministic_fn_names: deterministic_fn_names, struct_doc_names: struct_doc_names, struct_doc_data: struct_doc_data, fn_doc_names: fn_doc_names, fn_doc_data: fn_doc_data, uses: uses, sendable_struct_names: sendable_struct_names, components: components, systems: systems, resources: resources, private_type_names: private_type_names, pub_struct_names: pub_struct_names, pub_enum_names: pub_enum_names, pub_interface_names: pub_interface_names, pub_fn_names: pub_fn_names, pub_static_names: pub_static_names, const_fns: const_fns, const_names: const_names, const_types: const_types, const_inits: const_inits };
    }

    // `component Name { field: Type, ... }` -- see `Ast.hc`'s own `ComponentDecl` header. Field
    // syntax reuses `struct_fields()` directly (same `name: Type, ...` shape a struct's own fields
    // already use).
    fn component_decl(&mut self) -> ComponentDecl {
        self.expect(COMPONENT);
        let name = self.expect(IDENT).text;
        let fields = self.struct_fields();
        return ComponentDecl { name: name, fields: fields };
    }

    // `resource Name { field: Type, ... }` -- see `Ast.hc`'s own `Program.resources` header.
    // Identical grammar to `component_decl` right above (reuses the same `ComponentDecl` AST
    // shape) -- the two are only ever told apart by which registry `Checker.hotc` puts the name
    // into.
    fn resource_decl(&mut self) -> ComponentDecl {
        self.expect(RESOURCE);
        let name = self.expect(IDENT).text;
        let fields = self.struct_fields();
        return ComponentDecl { name: name, fields: fields };
    }

    // `system Name { fn run(a: &mut A, b: &B) { ... } }` -- see `Ast.hc`'s own `SystemDecl` header.
    // `after`/`before`/`has_profile`/`has_main_thread`/`run_if` come from whichever `@after`/
    // `@before`/`@profile`/`@main_thread`/`@run_if` directives preceded this declaration in the
    // top-level loop (already parsed by the time this runs).
    fn system_decl(&mut self, after: Vec<String>, before: Vec<String>, has_profile: Bool, has_main_thread: Bool, run_if: String) -> SystemDecl {
        self.expect(SYSTEM);
        let name = self.expect(IDENT).text;
        self.expect(LBRACE);
        self.expect(FN);
        let run_name = self.expect(IDENT).text;
        if run_name != "run" {
            throw ParseError::new("a 'system' block's only method must be named 'run', got '" + run_name + "'");
        }
        let run_params = self.param_list();
        // `run` never declares its own return type -- always `Unit`, same as a `fn` with no
        // `-> Ret` at all.
        let run_body = self.block();
        self.expect(RBRACE);
        return SystemDecl { name: name, run_params: run_params, run_body: run_body, after: after, before: before, has_profile: has_profile, has_main_thread: has_main_thread, run_if: run_if };
    }

    // `@must_use` -- a bare `@IDENT` compiler directive, no quoted binary name and no `(...)`
    // argument list either (unlike `@"binary.Name"(...)`). See `Ast.hc`'s own
    // `Program.must_use_fn_names` header.
    fn directive(&mut self) -> String {
        self.expect(AT);
        return self.expect(IDENT).text;
    }

    // `@"binary.Name"` alone (marker) or `@"binary.Name"(argName: value, ...)` -- see `Ast.hc`'s
    // own `Annotation` header for the full value grammar. Called from `parse_program`'s own
    // top-level loop, right before the `struct`/`fn` it's attached to.
    fn annotation(&mut self) -> Annotation {
        self.expect(AT);
        let binary_name = self.expect(STRING).text;
        var args = empty_annotation_arg_vec();
        if self.check(LPAREN) {
            self.advance();
            if !self.check(RPAREN) {
                args.push(self.annotation_arg());
                while self.match_kind(COMMA) {
                    if self.check(RPAREN) { break; } // trailing comma
                    args.push(self.annotation_arg());
                }
            }
            self.expect(RPAREN);
        }
        return Annotation { binary_name: binary_name, args: args };
    }

    fn annotation_arg(&mut self) -> AnnotationArg {
        let name = self.expect(IDENT).text;
        self.expect(COLON);
        let value = self.annotation_value();
        return AnnotationArg { name: name, value: value };
    }

    // Three shapes only -- see `Ast.hc`'s own `AnnValue` header for why this is its own small
    // grammar, not the general expression language. `enum(...)` reuses the ordinary `ENUM`
    // keyword token in this one new context (same "one token, more than one grammar position"
    // convention `static` already has between a top-level `static NAME: Type = ...;` and an
    // impl-block `static fn ...`).
    fn annotation_value(&mut self) -> AnnValue {
        if self.check(STRING) {
            return AnnStr { value: self.advance().text };
        }
        if self.check(ENUM) {
            self.advance();
            self.expect(LPAREN);
            let ebin = self.expect(STRING).text;
            self.expect(COMMA);
            let econst = self.expect(STRING).text;
            self.expect(RPAREN);
            return AnnEnumConst { binary_name: ebin, const_name: econst };
        }
        if self.check(LBRACKET) {
            self.advance();
            var values = empty_annvalue_vec();
            if !self.check(RBRACKET) {
                values.push(self.annotation_value());
                while self.match_kind(COMMA) {
                    if self.check(RBRACKET) { break; }
                    values.push(self.annotation_value());
                }
            }
            self.expect(RBRACKET);
            return AnnArray { values: values };
        }
        let t = self.peek();
        throw ParseError::new("Parse error at line " + JString3::valueOf(t.line) + ": expected an annotation value (string, enum(...), or [...]), got '" + t.text + "'");
    }

    // `pub static NAME: Type = expr;` -- see `Ast.hc`'s own `StaticDecl` header. Unambiguous with
    // an impl block's own `static fn ...` (that `static` only ever appears immediately after
    // `impl Name { ` or between two methods inside one, never at the top level of the program).
    fn static_decl(&mut self) -> StaticDecl {
        self.expect(STATIC);
        let name = self.expect(IDENT).text;
        self.expect(COLON);
        let type_name = self.type_name_ref();
        self.expect(EQ);
        let value = self.expression();
        self.expect(SEMI);
        return StaticDecl { name: name, type_name: type_name, value: value };
    }
}

// `@requires(cond)`/`@ensures(cond)` -- design-by-contract, compiled to real assertions in DEV
// builds only, gone entirely in RELEASE. The real trick this whole feature piggybacks on: every
// generated check is wrapped in `if dev { ... }`, the EXACT shape `Driver.hotc`'s own, already-
// shipped `strip_dev_code`/`strip_dev_blocks_list` pass already recognizes and strips -- see that
// fn's own header (`Ident { name: "dev" }` as the condition, recognized ONLY by that literal
// shape). `--release` drops the whole `if dev { ... }` block (and everything inside it, INCLUDING
// the condition expression itself) before the checker ever sees it; the default (no `--release`)
// keeps it, inlined as ordinary always-executed code. Zero NEW strip machinery needed -- this is
// pure reuse of `@dev`'s own existing infrastructure, exactly as `IDEAS.md`'s own brainstormed
// note for this feature called for. `ContractError` (declared nowhere in any stdlib topic --
// synthesized straight into `Program.externs`, see `parse_program`'s own tail) is what gets
// thrown on a real violation.
//
// `@requires(cond)`: prepends ONE check to the very start of the fn body, checked once at entry.
// `@ensures(cond)`: rewrites EVERY explicit `return expr;` throughout the WHOLE body (recursing
// into `if`/`while`/`for`/`try`/`match`, mirroring `strip_dev_blocks_list`'s own exact recursion
// shape) into `let result = expr; if dev { if !(cond) { throw ContractError::new(...); } }
// return result;` -- binding the return value to a REAL local named literally `result` (not an
// AST substitution of the user's own `cond` expression) is what lets `cond` reference `result`
// (e.g. `@ensures(result >= 0)`) using nothing more than ORDINARY variable lookup; `cond` itself
// is never rewritten at all.
//
// Real, disclosed scope cuts: only ONE `@requires` and ONE `@ensures` per `fn` (multiple
// conditions are already expressible as one `cond1 && cond2`); a bare `return;` (no value) is
// left completely UNCHECKED by `@ensures` (there's no value to bind `result` to); a `Unit`-
// returning fn that falls off the end of its body with no explicit `return` at all is likewise
// unchecked (there's no `Return` node to intercept there either) -- `@ensures` only ever fires on
// an EXPLICIT `return expr;`, not on every possible exit path.
pub fn build_contract_check_stmt(cond: &Expr, msg: String) -> Stmt {
    var throw_args = empty_expr_vec();
    throw_args.push(StringLit { value: msg });
    var inner_body = empty_stmt_vec();
    inner_body.push(Throw { value: StaticCall { type_name: "ContractError", method: "new", args: throw_args }, line: 0 });
    var dev_body = empty_stmt_vec();
    dev_body.push(If { cond: Unary { op: "!", expr: cond }, then_body: inner_body, else_body: none_stmt_vec(), line: 0, narrow_name: "", narrow_is_eq: false });
    return If { cond: Ident { name: "dev" }, then_body: dev_body, else_body: none_stmt_vec(), line: 0, narrow_name: "", narrow_is_eq: false };
}

// `apply_contract`'s own `@ensures` half -- see `build_contract_check_stmt`'s own header for the
// full design. `ens_cond` (not `cond`) is this fn's own parameter name specifically to avoid
// shadowing every `Stmt` variant's OWN `cond` field (`If`/`While`) inside this fn's own `match`
// arms below -- a real, easy-to-miss naming trap this fn's own recursion would otherwise walk
// straight into.
pub fn rewrite_ensures_returns(ss: Vec<Stmt>, ens_cond: &Expr, fn_name: String) -> Vec<Stmt> {
    var out = empty_stmt_vec();
    var i = 0;
    while i < ss.length() {
        let s = ss.get(i);
        match s {
            Return { value, line } => {
                var was_value = false;
                if let Some { value: v } = value {
                    out.push(Let { name: "result", mutable: false, init: v, declared_type: none_string(), line: line });
                    out.push(build_contract_check_stmt(ens_cond, "ensures failed in '" + fn_name + "'"));
                    out.push(Return { value: some_expr(Ident { name: "result" }), line: line });
                    was_value = true;
                }
                if !was_value {
                    out.push(Return { value: none_expr(), line: line });
                }
            }
            If { cond, then_body, else_body, line, narrow_name, narrow_is_eq } => {
                var new_else = none_stmt_vec();
                if let Some { value: eb } = else_body {
                    new_else = some_stmt_vec(rewrite_ensures_returns(eb, ens_cond, fn_name));
                }
                out.push(If { cond: cond, then_body: rewrite_ensures_returns(then_body, ens_cond, fn_name), else_body: new_else, line: line, narrow_name: narrow_name, narrow_is_eq: narrow_is_eq });
            }
            While { cond, body, line } => {
                out.push(While { cond: cond, body: rewrite_ensures_returns(body, ens_cond, fn_name), line: line });
            }
            For { var_name, is_range, range_start, range_end, inclusive, arr_expr, body, line } => {
                out.push(For { var_name: var_name, is_range: is_range, range_start: range_start, range_end: range_end, inclusive: inclusive, arr_expr: arr_expr, body: rewrite_ensures_returns(body, ens_cond, fn_name), line: line });
            }
            Try { try_block, catches, line } => {
                out.push(Try { try_block: rewrite_ensures_returns(try_block, ens_cond, fn_name), catches: catches, line: line });
            }
            Match { subject, arms, line } => {
                var new_arms = empty_matcharm_vec();
                var ai = 0;
                while ai < arms.length() {
                    let a = arms.get(ai);
                    new_arms.push(MatchArm { variant_name: a.variant_name, field_names: a.field_names, bind_names: a.bind_names, body: rewrite_ensures_returns(a.body, ens_cond, fn_name), is_literal: a.is_literal, literal: a.literal, is_positional: a.is_positional });
                    ai = ai + 1;
                }
                out.push(Match { subject: subject, arms: new_arms, line: line });
            }
            _ => { out.push(s); }
        }
        i = i + 1;
    }
    return out;
}

// The single entry point `parse_program`'s own plain-`fn` dispatch branch calls once a `fn` had
// `@requires`/`@ensures` -- see `build_contract_check_stmt`'s own header for the full design.
pub fn apply_contract(fd: FnDecl, has_req: Bool, req: Option<Expr>, has_ens: Bool, ens: Option<Expr>) -> FnDecl {
    var body = fd.body;
    if has_req {
        if let Some { value: rc } = req {
            var new_body = empty_stmt_vec();
            new_body.push(build_contract_check_stmt(&rc, "requires failed in '" + fd.name + "'"));
            var i = 0;
            while i < body.length() {
                new_body.push(body.get(i));
                i = i + 1;
            }
            body = new_body;
        }
    }
    if has_ens {
        if let Some { value: ec } = ens {
            body = rewrite_ensures_returns(body, &ec, fd.name);
        }
    }
    return FnDecl { name: fd.name, params: fd.params, ret_type: fd.ret_type, body: body, type_param: fd.type_param, type_bounds: fd.type_bounds, self_is_mut: fd.self_is_mut, type_param2: fd.type_param2, type_bounds2: fd.type_bounds2 };
}

// `typestate_decl`'s own small "have I seen this state name before" check -- a local, narrow
// helper (not a reusable general-purpose one) rather than depending on `Driver.hotc`'s own
// similarly-named `str_vec_contains`, since that lives in a different phase file.
pub fn str_vec_contains_ts(v: &Vec<String>, target: String) -> Bool {
    var i = 0;
    while i < v.length() {
        if v.get(i) == target { return true; }
        i = i + 1;
    }
    return false;
}

// `on_decl`'s own "look up this event's declared field list" step -- a real, disclosed order
// dependency: throws when `target` was never declared via `event` earlier in the file (`on`
// always requires it).
// Reconstructs `target`'s own field `Param` list ON DEMAND from the FLAT storage `event_decl`
// populates (see `Parser`'s own `event_field_counts`/`event_field_names`/`event_field_types`
// header for why those are flat rather than a real `Vec<Vec<Param>>` field) -- the RETURN value
// here is a plain, single-level `Vec<Param>` (no nesting at all), so this itself hits no
// monomorphization gap; only a doubly-nested generic STORED AS A FIELD does.
pub fn event_params_for(names: &Vec<String>, field_counts: &Vec<Int>, field_names: &Vec<String>, field_types: &Vec<String>, target: String) -> Vec<Param> {
    var offset = 0;
    var i = 0;
    while i < names.length() {
        let cnt = field_counts.get(i);
        if names.get(i) == target {
            var out = empty_param_vec();
            var j = 0;
            while j < cnt {
                out.push(Param { name: field_names.get(offset + j), type_name: field_types.get(offset + j), is_ref: false, is_mut_ref: false });
                j = j + 1;
            }
            return out;
        }
        offset = offset + cnt;
        i = i + 1;
    }
    throw ParseError::new("'handle " + target + "(...)' names an event that was never declared with 'event " + target + "(...);'");
}

// `parse_program`'s own tail -- every handler `fn` name registered for `target`, in the SAME
// declaration order `on_decl` recorded them (`handler_event_names`/`handler_fn_names` are a flat
// pair spanning EVERY event in the file, not just `target`'s own).
pub fn handlers_for_event(handler_event_names: &Vec<String>, handler_fn_names: &Vec<String>, target: String) -> Vec<String> {
    var out = empty_str_vec2();
    var i = 0;
    while i < handler_event_names.length() {
        if handler_event_names.get(i) == target {
            out.push(handler_fn_names.get(i));
        }
        i = i + 1;
    }
    return out;
}

// `parse_program`'s own tail -- one `emit_Name(field1: Type1, ...)` dispatcher per DECLARED
// event (generated even for zero handlers -- firing an event nobody's listening to yet is a
// normal no-op, not an error), calling every one of its own handlers, forwarding the same
// arguments, in declaration order.
pub fn build_event_emit_fn(name: String, fields: &Vec<Param>, handler_names: &Vec<String>) -> FnDecl {
    var params = empty_param_vec();
    var fwd_args = empty_expr_vec();
    var fi = 0;
    while fi < fields.length() {
        let f = fields.get(fi);
        params.push(Param { name: f.name, type_name: f.type_name, is_ref: false, is_mut_ref: false });
        fwd_args.push(Ident { name: f.name });
        fi = fi + 1;
    }
    var body = empty_stmt_vec();
    var hi = 0;
    while hi < handler_names.length() {
        body.push(ExprStmt { expr: Call { callee: handler_names.get(hi), args: fwd_args }, line: 0 });
        hi = hi + 1;
    }
    return FnDecl { name: "emit_" + name, params: params, ret_type: none_string(), body: body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() };
}

// `@update`/`@fixed_update`/`@render` -- see `build_lifecycle_dispatcher_fn`'s own header. All
// three share one uniform, real, disclosed scope-cut signature (exactly one `Float` delta-time
// parameter) so `parse_program`'s own tail can generate ONE call shape (`fn_name(dt)`) per
// dispatcher regardless of which specific fns it's calling -- no per-fn signature introspection
// needed at CALL-SITE-GENERATION time, only here, once, right when each fn is first parsed.
pub fn check_lifecycle_dt_param(fd: &FnDecl, directive_text: String) {
    if fd.params.length() != 1 || fd.params.get(0).type_name != "Float" {
        throw ParseError::new("'" + directive_text + "' fn '" + fd.name + "' must take exactly one 'Float' parameter (the delta time)");
    }
}

// `@startup`/`@update`/`@fixed_update`/`@render` -- lifecycle annotations for any HC program with
// a game loop, ECS-shaped or not (see `IDEAS.md`'s own "Lifecycle annotations" entry). Pure
// parser-level AST synthesis, same "collect names, generate ONE dispatcher fn" strategy `@tunable`
// already established -- zero `Checker.hotc`/`Codegen.hotc` changes. `parse_program`'s own tail
// calls this once per category (`run_startup`/`run_update`/`run_fixed_update`/`run_render`),
// ONLY when that category actually has at least one marked fn, generating a single dispatcher
// that calls every one of them, in DECLARATION order, passing `dt` through unchanged where the
// category takes one. This deliberately punts the real design question `IDEAS.md`'s own entry
// raises ("what actually PROVIDES the loop") to the cheapest possible answer it names as the
// right first cut: this is purely descriptive metadata plus a callable dispatcher -- nothing
// here spins up an actual loop/timer/frame-pump. A host application (a hand-written `while true {
// ... }`, or a future HC-owned game-loop runtime) calls `run_update(dt)`/etc. itself, on whatever
// cadence it already has.
pub fn build_lifecycle_dispatcher_fn(dispatcher_name: String, names: &Vec<String>, has_dt_param: Bool) -> FnDecl {
    var params = empty_param_vec();
    if has_dt_param {
        params.push(Param { name: "dt", type_name: "Float", is_ref: false, is_mut_ref: false });
    }
    var body = empty_stmt_vec();
    var i = 0;
    while i < names.length() {
        var args = empty_expr_vec();
        if has_dt_param {
            args.push(Ident { name: "dt" });
        }
        body.push(ExprStmt { expr: Call { callee: names.get(i), args: args }, line: 0 });
        i = i + 1;
    }
    return FnDecl { name: dispatcher_name, params: params, ret_type: none_string(), body: body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() };
}

// `derive_impls`'s own field-type dispatch -- these seven are the ones that combine directly as
// `(value as Int)` for hashing (see that fn's own header for why `Bool` is safe here too), and
// compare directly with `==` for equality (already exact for every one of them). `String` is
// deliberately NOT in this list -- it shares the `==` equality path but needs a different,
// dedicated hashing path (`hash_string_hc`, not a cast).
pub fn is_derive_numeric_type_hc(ty: String) -> Bool {
    if ty == "Int" { return true; }
    if ty == "Bool" { return true; }
    if ty == "Char" { return true; }
    if ty == "Byte" { return true; }
    if ty == "Long" { return true; }
    if ty == "Float" { return true; }
    if ty == "Double" { return true; }
    return false;
}

// One field's own `self.field == other.field` (numeric/`String`) or `self.field.equals(other.
// field)` (anything else -- a nested struct/enum, dispatching to ITS OWN `Eq` impl) -- see
// `derive_impls`'s own header for the full field-type-dispatch design.
pub fn derive_field_eq_expr(f: &Param) -> Expr {
    let lhs = FieldAccess { obj: Ident { name: "self" }, field: f.name };
    let rhs = FieldAccess { obj: Ident { name: "other" }, field: f.name };
    if is_derive_numeric_type_hc(f.type_name) || f.type_name == "String" {
        return Binary { op: "==", left: lhs, right: rhs };
    }
    var args = empty_expr_vec();
    args.push(rhs);
    return MethodCall { recv: lhs, method: "equals", args: args };
}

// One field's own hash contribution -- `(self.field as Int)` for the seven numeric-ish
// primitives, `hash_string_hc(self.field)` for `String` (`stdlib/collections.hotc`'s own hand-
// rolled polynomial hash), or `self.field.hash_key()` for anything else (a nested struct/enum,
// dispatching to ITS OWN `Hashable` impl) -- see `derive_impls`'s own header.
pub fn derive_field_hash_expr(f: &Param) -> Expr {
    let lhs = FieldAccess { obj: Ident { name: "self" }, field: f.name };
    if is_derive_numeric_type_hc(f.type_name) {
        return Cast { expr: lhs, target_type: "Int" };
    }
    if f.type_name == "String" {
        var args = empty_expr_vec();
        args.push(lhs);
        return Call { callee: "hash_string_hc", args: args };
    }
    return MethodCall { recv: lhs, method: "hash_key", args: empty_expr_vec() };
}

// `unit_decl`'s own `add`/`sub` -- `fn add(&self, other: &Ticks) -> Ticks { return Ticks { value:
// self.value + other.value }; }`. `op` is `"+"`/`"-"`, `method_name` the operator-overload
// method name it dispatches through (`Checker.hotc`'s own `operator_method_name`).
pub fn unit_binop_fn(method_name: String, op: String, unit_name: String) -> FnDecl {
    var params = empty_param_vec();
    params.push(Param { name: "other", type_name: unit_name, is_ref: true, is_mut_ref: false });
    let combined = Binary { op: op, left: FieldAccess { obj: Ident { name: "self" }, field: "value" }, right: FieldAccess { obj: Ident { name: "other" }, field: "value" } };
    var fnames = empty_str_vec();
    fnames.push("value");
    var fvals = empty_expr_vec();
    fvals.push(combined);
    var body = empty_stmt_vec();
    body.push(Return { value: some_expr(StructLit { name: unit_name, field_names: fnames, field_values: fvals, generic_base: none_string() }), line: 0 });
    return FnDecl { name: method_name, params: params, ret_type: some_string(unit_name), body: body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() };
}

// `unit_decl`'s own `mul`/`div` -- unit-times-SCALAR (`fn mul(&self, factor: Int) -> Ticks {
// return Ticks { value: self.value * factor }; }`), not unit-times-unit (a units-of-units
// product, e.g. `Ticks * Ticks -> TicksSquared`, isn't a coherent single-declaration concept and
// isn't attempted this pass).
pub fn unit_scale_fn(method_name: String, op: String, unit_name: String, base: String) -> FnDecl {
    var params = empty_param_vec();
    params.push(Param { name: "factor", type_name: base, is_ref: false, is_mut_ref: false });
    let combined = Binary { op: op, left: FieldAccess { obj: Ident { name: "self" }, field: "value" }, right: Ident { name: "factor" } };
    var fnames = empty_str_vec();
    fnames.push("value");
    var fvals = empty_expr_vec();
    fvals.push(combined);
    var body = empty_stmt_vec();
    body.push(Return { value: some_expr(StructLit { name: unit_name, field_names: fnames, field_values: fvals, generic_base: none_string() }), line: 0 });
    return FnDecl { name: method_name, params: params, ret_type: some_string(unit_name), body: body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() };
}

// `unit_decl`'s own `eq` -- `Checker.hotc`'s own operator-overload dispatch always returns `Bool`
// for `==`/`!=` regardless of this method's own declared return type (see `check_binary`'s own
// header), so this returning `Bool` here is just honest, not load-bearing for that part.
pub fn unit_eq_fn(unit_name: String) -> FnDecl {
    var params = empty_param_vec();
    params.push(Param { name: "other", type_name: unit_name, is_ref: true, is_mut_ref: false });
    let cmp = Binary { op: "==", left: FieldAccess { obj: Ident { name: "self" }, field: "value" }, right: FieldAccess { obj: Ident { name: "other" }, field: "value" } };
    var body = empty_stmt_vec();
    body.push(Return { value: some_expr(cmp), line: 0 });
    return FnDecl { name: "eq", params: params, ret_type: some_string("Bool"), body: body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() };
}

// `@tunable` -- marks a top-level `static NAME: Float = value;` as live-editable from a debug
// console/UI by NAME STRING, without recompiling. The real insight this whole feature rides on:
// a plain HC `static` is ALREADY a genuinely mutable JVM static field (`Checker.hotc`'s own
// `check_assign` header documents `NAME = value;` falling back to `PUTSTATIC` when `NAME` isn't a
// local -- proven by real ECS/ownership-tracking statics elsewhere in this compiler's own
// codegen), so there's no new storage mechanism to build at all -- just a way for code that only
// has the tunable's NAME AS A STRING (a generic debug console, unaware of any specific tunable at
// compile time) to reach it. `build_tunable_get_fn`/`build_tunable_set_fn` synthesize a single
// dispatcher function each -- a flat if-chain comparing the requested name against every
// `@tunable` static's own name, generated by `parse_program`'s own tail (see `tunable_names`'s
// header) ONLY once, from every tunable collected across the WHOLE file, regardless of how many
// there are. `build_tunable_names_fn` gives that same debug console a way to enumerate every
// registered tunable without hardcoding names either. Zero `Checker.hotc`/`Codegen.hotc`
// changes -- pure AST synthesis reusing already-proven `Assign`/`If`/`Binary("==")` constructs.
//
// Scope cut, disclosed: `Float`-only (validated where `@tunable` is parsed, `parse_program`'s own
// STATIC branch) -- the overwhelmingly common "balance tuning" case (multipliers, speeds,
// cooldowns), not a general any-type registry (which would need real type-erasure/boxing
// machinery this compiler doesn't have a clean story for yet, see `Codegen.hotc`'s own primitive-
// boxing header on `PhoenixTask::join()`'s similar `Object`-erasure cost). An unknown name passed
// to `tunable_get` returns `0.0f` silently (no exception) -- `tunable_names()` is the intended
// way for a caller to know what's actually valid, rather than probing with unknown strings.
pub fn build_tunable_get_fn(names: &Vec<String>) -> FnDecl {
    var params = empty_param_vec();
    params.push(Param { name: "name", type_name: "String", is_ref: false, is_mut_ref: false });
    var body = empty_stmt_vec();
    var i = 0;
    while i < names.length() {
        let n = names.get(i);
        var then_body = empty_stmt_vec();
        then_body.push(Return { value: some_expr(Ident { name: n }), line: 0 });
        body.push(If { cond: Binary { op: "==", left: Ident { name: "name" }, right: StringLit { value: n } }, then_body: then_body, else_body: none_stmt_vec(), line: 0, narrow_name: "", narrow_is_eq: false });
        i = i + 1;
    }
    body.push(Return { value: some_expr(FloatLit { text: "0.0" }), line: 0 });
    return FnDecl { name: "tunable_get", params: params, ret_type: some_string("Float"), body: body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() };
}

// `build_tunable_get_fn`'s own write-side twin -- `NAME = value;` (`Assign`) is the exact same
// real `PUTSTATIC` fallback that fn's own header explains, just used to WRITE instead of read.
pub fn build_tunable_set_fn(names: &Vec<String>) -> FnDecl {
    var params = empty_param_vec();
    params.push(Param { name: "name", type_name: "String", is_ref: false, is_mut_ref: false });
    params.push(Param { name: "value", type_name: "Float", is_ref: false, is_mut_ref: false });
    var body = empty_stmt_vec();
    var i = 0;
    while i < names.length() {
        let n = names.get(i);
        var then_body = empty_stmt_vec();
        then_body.push(ExprStmt { expr: Assign { name: n, value: Ident { name: "value" } }, line: 0 });
        then_body.push(Return { value: none_expr(), line: 0 });
        body.push(If { cond: Binary { op: "==", left: Ident { name: "name" }, right: StringLit { value: n } }, then_body: then_body, else_body: none_stmt_vec(), line: 0, narrow_name: "", narrow_is_eq: false });
        i = i + 1;
    }
    return FnDecl { name: "tunable_set", params: params, ret_type: none_string(), body: body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() };
}

// Every `@tunable` static's own name, as a real `Vec<String>` -- lets a debug console enumerate
// what's actually valid to pass to `tunable_get`/`tunable_set` instead of guessing names. `names`
// is never empty when this is called (`parse_program`'s own tail only synthesizes all three
// tunable fns together, gated on `self.tunable_names.length() > 0`).
pub fn build_tunable_names_fn(names: &Vec<String>) -> FnDecl {
    var body = empty_stmt_vec();
    var first_args = empty_expr_vec();
    first_args.push(StringLit { value: names.get(0) });
    body.push(Let { name: "v", mutable: true, init: Call { callee: "vec_of", args: first_args }, declared_type: none_string(), line: 0 });
    var i = 1;
    while i < names.length() {
        var push_args = empty_expr_vec();
        push_args.push(StringLit { value: names.get(i) });
        body.push(ExprStmt { expr: MethodCall { recv: Ident { name: "v" }, method: "push", args: push_args }, line: 0 });
        i = i + 1;
    }
    body.push(Return { value: some_expr(Ident { name: "v" }), line: 0 });
    return FnDecl { name: "tunable_names", params: empty_param_vec(), ret_type: some_string("Vec$String"), body: body, type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() };
}

// `String` has no built-in `startsWith` in this compiler's own intrinsic set (`length`/
// `substring`/`indexOf`/etc only, see `Checker.hotc`'s own matching `extern class` declaration) --
// built from those instead. Used by `doc_comment_block`'s own tag dispatch.
pub fn str_starts_with(s: String, prefix: String) -> Bool {
    if s.length() < prefix.length() { return false; }
    return s.substring(0, prefix.length()) == prefix;
}

// The text after `prefix`, with exactly one leading space (if any) also stripped -- `"@param x
// the thing"` stripped of `"@param"` is `" x the thing"`, and every doc-comment tag line has
// that one separating space before its own real content.
pub fn str_after_prefix(s: String, prefix: String) -> String {
    var rest = s.substring(prefix.length(), s.length());
    if rest.length() > 0 && rest.substring(0, 1) == " " {
        rest = rest.substring(1, rest.length());
    }
    return rest;
}

pub fn empty_doc_comment_vec() -> Vec<DocComment> {
    var v = vec_of(DocComment { summary: "_", param_names: empty_str_vec(), param_texts: empty_str_vec(), returns_text: "", example_text: "", warning_text: "", see_targets: empty_str_vec(), deprecated_text: "", has_deprecated: false });
    return Vec { data: v.data, len: 0 };
}

pub fn empty_annotation_vec() -> Vec<Annotation> {
    var v = vec_of(Annotation { binary_name: "_", args: empty_annotation_arg_vec() });
    return Vec { data: v.data, len: 0 };
}

pub fn empty_annotation_arg_vec() -> Vec<AnnotationArg> {
    var v = vec_of(AnnotationArg { name: "_", value: AnnStr { value: "_" } });
    return Vec { data: v.data, len: 0 };
}

pub fn empty_annvalue_vec() -> Vec<AnnValue> {
    var v = vec_of(AnnStr { value: "_" });
    return Vec { data: v.data, len: 0 };
}

pub fn empty_fn_decl_vec() -> Vec<FnDecl> {
    var v = vec_of(FnDecl { name: "_", params: empty_param_vec(), ret_type: none_string(), body: empty_stmt_vec(), type_param: none_string(), type_bounds: empty_str_vec(), self_is_mut: false, type_param2: none_string(), type_bounds2: empty_str_vec() });
    return Vec { data: v.data, len: 0 };
}

pub fn empty_struct_decl_vec() -> Vec<StructDecl> {
    var v = vec_of(StructDecl { name: "_", type_param: none_string(), fields: empty_param_vec(), is_arena: false, module_name: none_string(), super_class: none_string(), type_param2: none_string() });
    return Vec { data: v.data, len: 0 };
}

pub fn empty_component_decl_vec() -> Vec<ComponentDecl> {
    var v = vec_of(ComponentDecl { name: "_", fields: empty_param_vec() });
    return Vec { data: v.data, len: 0 };
}

pub fn empty_system_decl_vec() -> Vec<SystemDecl> {
    var v = vec_of(SystemDecl { name: "_", run_params: empty_param_vec(), run_body: empty_stmt_vec(), after: empty_str_vec2(), before: empty_str_vec2(), has_profile: false, has_main_thread: false, run_if: "" });
    return Vec { data: v.data, len: 0 };
}

// `pub`: `Codegen.hotc`'s own `materialize_default_methods` needs this cross-module too now.
pub fn empty_impl_decl_vec() -> Vec<ImplDecl> {
    var v = vec_of(ImplDecl { struct_name: "_", methods: empty_fn_decl_vec(), static_methods: empty_fn_decl_vec(), interface_name: none_string(), delegate_field: none_string() });
    return Vec { data: v.data, len: 0 };
}

pub fn empty_extend_decl_vec() -> Vec<ExtendDecl> {
    var v = vec_of(ExtendDecl { target: "_", methods: empty_fn_decl_vec() });
    return Vec { data: v.data, len: 0 };
}

// `pub`: `Ast.hc`'s own `flatten_interface_methods_depth`/`remove_interface_method_named` need
// this cross-module too now.
pub fn empty_interface_method_vec() -> Vec<InterfaceMethod> {
    var v = vec_of(InterfaceMethod { name: "_", params: empty_param_vec(), ret_type: "Unit", body: none_stmt_vec() });
    return Vec { data: v.data, len: 0 };
}

pub fn empty_interface_decl_vec() -> Vec<InterfaceDecl> {
    var v = vec_of(InterfaceDecl { name: "_", methods: empty_interface_method_vec(), is_sealed: false, parents: empty_str_vec(), extern_binary_name: none_string(), module_name: none_string(), is_open: false });
    return Vec { data: v.data, len: 0 };
}

// `pub`: `Ast.hc`'s own `transitive_supertraits`/`push_str_if_absent` need this cross-module too
// now.
pub fn empty_str_vec() -> Vec<String> {
    var v = vec_of("__init__");
    return Vec { data: v.data, len: 0 };
}

pub fn empty_variant_vec() -> Vec<EnumVariant> {
    var v = vec_of(EnumVariant { name: "_", fields: empty_param_vec() });
    return Vec { data: v.data, len: 0 };
}

pub fn empty_enum_decl_vec() -> Vec<EnumDecl> {
    var v = vec_of(EnumDecl { name: "_", variants: empty_variant_vec(), type_param: none_string(), module_name: none_string(), type_param2: none_string() });
    return Vec { data: v.data, len: 0 };
}

pub fn empty_catchclause_vec() -> Vec<CatchClause> {
    var v = vec_of(CatchClause { catch_var: "_", catch_type: "_", catch_block: empty_stmt_vec() });
    return Vec { data: v.data, len: 0 };
}

pub fn empty_matcharm_vec() -> Vec<MatchArm> {
    var v = vec_of(MatchArm { variant_name: "_", field_names: empty_str_vec(), bind_names: empty_str_vec(), body: empty_stmt_vec(), is_literal: false, literal: IntLit { value: 0 }, is_positional: false });
    return Vec { data: v.data, len: 0 };
}

pub fn empty_extern_method_vec() -> Vec<ExternMethod> {
    var v = vec_of(ExternMethod { name: "_", params: empty_param_vec(), ret_type: "Unit", is_static: false, is_ctor: false });
    return Vec { data: v.data, len: 0 };
}

pub fn empty_extern_field_vec() -> Vec<ExternField> {
    var v = vec_of(ExternField { name: "_", type_name: "Unit", is_static: false });
    return Vec { data: v.data, len: 0 };
}

pub fn empty_extern_class_vec() -> Vec<ExternClassDecl> {
    var v = vec_of(ExternClassDecl { name: "_", binary_name: "_", methods: empty_extern_method_vec(), fields: empty_extern_field_vec(), is_interface: false });
    return Vec { data: v.data, len: 0 };
}

pub fn empty_static_decl_vec() -> Vec<StaticDecl> {
    var v = vec_of(StaticDecl { name: "_", type_name: "_", value: IntLit { value: 0 } });
    return Vec { data: v.data, len: 0 };
}

// Small helpers standing in for real `[]`-empty-array-literal / generic-type-inference support
// this phase doesn't need to solve -- `vec_of` needs a real first element to infer `T` from, so
// an empty starting `Vec` needs its element pushed onto a throwaway one instead. `Option<T>`'s
// `Some`/`None` constructors need `T` inferrable the same way -- these fns just give the checker
// a call site with a concrete `T` already on hand.
pub fn empty_expr_vec() -> Vec<Expr> {
    var v = vec_of(IntLit { value: 0 });
    return Vec { data: v.data, len: 0 };
}
pub fn empty_stmt_vec() -> Vec<Stmt> {
    var v = vec_of(ExprStmt { expr: IntLit { value: 0 }, line: 0 });
    return Vec { data: v.data, len: 0 };
}
pub fn empty_param_vec() -> Vec<Param> {
    var v = vec_of(Param { name: "_", type_name: "_", is_ref: false, is_mut_ref: false });
    return Vec { data: v.data, len: 0 };
}
// `event_field_counts`'s own empty seed -- same "seed via a real value, then reset `len` to 0"
// convention every other `empty_*_vec` helper here already uses.
pub fn empty_int_vec_ev() -> Vec<Int> {
    var seed = vec_of(0);
    return Vec { data: seed.data, len: 0 };
}
pub fn none_expr() -> Option<Expr> {
    var v = vec_of(Some { value: IntLit { value: 0 } });
    return None;
}
pub fn some_expr(e: Expr) -> Option<Expr> {
    return Some { value: e };
}
// `pub`: `Checker.hotc`'s own `checker_new` seed and `Ast.hc`'s `InterfaceMethod` construction
// need a genuine cross-module `Option<Vec<Stmt>>::None` too now that a default method's own `body`
// field is one (see `Ast.hc`'s own `InterfaceMethod` header) -- every other caller of these two was
// already inside this same module, so this never needed to be `pub` before.
pub fn none_stmt_vec() -> Option<Vec<Stmt>> {
    return None;
}
pub fn some_stmt_vec(v: Vec<Stmt>) -> Option<Vec<Stmt>> {
    return Some { value: v };
}
pub fn none_string() -> Option<String> {
    return None;
}
pub fn none_annotation() -> Option<Annotation> {
    return None;
}
pub fn some_annotation(a: Annotation) -> Option<Annotation> {
    return Some { value: a };
}
pub fn none_doc_comment() -> Option<DocComment> {
    return None;
}
pub fn some_doc_comment(d: DocComment) -> Option<DocComment> {
    return Some { value: d };
}
pub fn some_string(s: String) -> Option<String> {
    return Some { value: s };
}

extern class JInt = "java.lang.Integer" {
    static fn parseInt(s: String) -> Int;
}
pub fn parse_int(s: String) -> Int {
    return JInt::parseInt(s);
}
