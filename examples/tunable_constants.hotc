// `@tunable` -- a debug console/UI can read/write these by NAME STRING, without recompiling.
// The static itself stays an ordinary, real Float -- reading/writing it directly (`SPEED_MULT`)
// still works exactly as before; `tunable_get`/`tunable_set`/`tunable_names` are the auto-
// generated by-name bridge for code that only has the name as a string.
@tunable
static SPEED_MULT: Float = 1.5f;

@tunable
static GRAVITY: Float = 9.8f;

static NOT_TUNABLE: Int = 42;

fn main() {
    print(SPEED_MULT); // 1.5
    print(tunable_get("SPEED_MULT")); // 1.5
    print(tunable_get("GRAVITY")); // 9.8
    print(tunable_get("UNKNOWN")); // 0.0 (disclosed fallback)

    tunable_set("SPEED_MULT", 3.0f);
    print(SPEED_MULT); // 3.0 -- the real static itself changed
    print(tunable_get("SPEED_MULT")); // 3.0

    let names = tunable_names();
    print(names.length()); // 2
    print(names.get(0)); // SPEED_MULT
    print(names.get(1)); // GRAVITY

    print(NOT_TUNABLE); // 42 -- untouched, ordinary static
    print("done");
}
