// Numeric range bounds -- see IDEAS.md's own "Numeric range bounds" entry. `let x: Int<lo..hi>`
// (exclusive) / `Int<lo..=hi>` (inclusive) checks a literal init at COMPILE time (a real, named
// error, no bytecode generated) and inserts a real RUNTIME bounds check (throwing) for anything
// else -- "only literal-vs-literal arithmetic gets proven statically, everything else gets a
// runtime check", the defensible simpler first cut that entry's own header explicitly suggests.
// Also works as a STRUCT FIELD type (`health: Int<0..=100>` -- this entry's own original
// motivating example), a plain top-level fn's PARAM type, and its RETURN type, all checked the
// same way at their own construction/call/return boundary. Bounds may be negative (`Int<-10..
// 10>`) -- a leading `-` on either bound is a real TYPE-position token, not routed through
// `unary()`. Real, disclosed scope: no resulting-range propagation through arithmetic -- a
// ranged Int is an ordinary Int everywhere else once the check passes (reading a struct field, a
// param, or a call's own result back, arithmetic, comparisons, ...). Real, disclosed nuance: a
// DIRECTLY-NEGATED literal init (`let x: Int<-10..10> = -20;`) parses as `Unary { op: "-", ... }`,
// not a bare `IntLit`, so it skips the compile-time literal check specifically -- still fully
// enforced (the runtime check always runs regardless), just not proven statically the way a
// literal `20` or `-20` written as a single token (impossible in this language either way) would
// be.

fn clamp(x: Int, lo: Int, hi: Int) -> Int {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    return x;
}

struct Player {
    name: String,
    health: Int<0..=100>,
}

// A ranged-Int PARAM -- checked at each call site the same way. `amount - 1` inside the body
// works exactly like plain Int arithmetic (the param is registered as ordinary Int for the
// body's own type-checking, matching the "behaves as an ordinary Int everywhere else" promise).
fn take_damage(current: Int, amount: Int<0..=100>) -> Int {
    return current - amount;
}

// A ranged-Int RETURN type -- checked the same way at each `return` statement. `computed_health`'s
// own returned value is `clamp`'s result, not provable statically, so it gets a real runtime
// check; `fixed_health`'s literal `80` is proven in range at compile time.
fn fixed_health() -> Int<0..=100> {
    return 80;
}
fn computed_health(raw: Int) -> Int<0..=100> {
    return clamp(raw, 0, 100);
}

fn main() {
    // A literal init -- proven in range at COMPILE time, zero runtime cost.
    let health: Int<0..=100> = 70;
    print(health);

    // A computed value -- the compiler can't prove this statically, so a real runtime check runs
    // (and passes here, since clamp's own result is always within [0, 100]).
    let clamped: Int<0..=100> = clamp(999, 0, 100);
    print(clamped);

    // Exclusive upper bound: 0 and 99 are valid, 100 is not.
    let a: Int<0..100> = clamp(0, 0, 99);
    print(a);

    // A struct field with a ranged-Int type -- checked the same way at construction (a literal
    // in range here, so zero runtime cost).
    let p = Player { name: "Ada", health: 70 };
    print(p.health);

    // Reading the field back behaves as an ordinary Int -- no propagation, but arithmetic and
    // comparisons against it work exactly like any other Int.
    let total = p.health + health;
    print(total);

    // A literal argument -- proven in range at compile time. A computed one (clamp's own
    // result) gets a real runtime check instead, same split as everywhere else in this file.
    print(take_damage(p.health, 30));
    print(take_damage(p.health, clamp(999, 0, 100)));

    // A fn returning a ranged-Int type -- the result reads back as an ordinary Int too.
    let h1 = fixed_health();
    let h2 = computed_health(999);
    print(h1 + h2);

    // Negative bounds. `-5` is a Unary negation (not a bare IntLit), so this specific assignment
    // gets the runtime check rather than the compile-time one -- see this file's own header.
    let temp: Int<-10..=10> = -5;
    print(temp);
    let delta: Int<-10..10> = clamp(-999, -10, 9);
    print(delta);

    print("done");
}
