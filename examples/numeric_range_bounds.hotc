// Numeric range bounds -- see IDEAS.md's own "Numeric range bounds" entry. `let x: Int<lo..hi>`
// (exclusive) / `Int<lo..=hi>` (inclusive) checks a literal init at COMPILE time (a real, named
// error, no bytecode generated) and inserts a real RUNTIME bounds check (throwing) for anything
// else -- "only literal-vs-literal arithmetic gets proven statically, everything else gets a
// runtime check", the defensible simpler first cut that entry's own header explicitly suggests.
// Also works as a STRUCT FIELD type (`health: Int<0..=100>` -- this entry's own original
// motivating example), checked the same way at struct-literal construction time. Real, disclosed
// scope: only a `let`/`var`/struct field, not fn params/return types, and no resulting-range
// propagation through arithmetic -- a ranged Int is an ordinary Int everywhere else once the
// check passes (reading a struct field back, arithmetic, comparisons, ...).

fn clamp(x: Int, lo: Int, hi: Int) -> Int {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    return x;
}

struct Player {
    name: String,
    health: Int<0..=100>,
}

fn main() {
    // A literal init -- proven in range at COMPILE time, zero runtime cost.
    let health: Int<0..=100> = 70;
    print(health);

    // A computed value -- the compiler can't prove this statically, so a real runtime check runs
    // (and passes here, since clamp's own result is always within [0, 100]).
    let clamped: Int<0..=100> = clamp(999, 0, 100);
    print(clamped);

    // Exclusive upper bound: 0 and 99 are valid, 100 is not.
    let a: Int<0..100> = clamp(0, 0, 99);
    print(a);

    // A struct field with a ranged-Int type -- checked the same way at construction (a literal
    // in range here, so zero runtime cost).
    let p = Player { name: "Ada", health: 70 };
    print(p.health);

    // Reading the field back behaves as an ordinary Int -- no propagation, but arithmetic and
    // comparisons against it work exactly like any other Int.
    let total = p.health + health;
    print(total);

    print("done");
}
