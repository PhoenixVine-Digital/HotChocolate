// `HashMap2<K: Hashable + Eq, V>` -- a real, arbitrary-struct-keyed hash map (see
// `COLLECTIONS_IDEAS.md` for the full design and the two-type-param generics work it took to make
// this possible at all). `ItemStack` opts in with two small methods (`impl Hashable`/`impl Eq`);
// everything else (bucketing, resize, overwrite-on-repeat-key) works exactly like `HashMap<V>`'s
// own String-keyed version. `Eq::equals`'s own `&Self` param needed no new compiler work at all --
// see `COLLECTIONS_IDEAS.md`'s own note -- and gives REAL value equality: `sword_lookalike` below,
// a DIFFERENT `ItemStack` instance with the same fields as `sword`, correctly matches.
use collections;

struct ItemStack {
    item_id: Int,
    count: Int,
}

impl Hashable for ItemStack {
    fn hash_key(&self) -> Int {
        return self.item_id * 31 + self.count;
    }
}

impl Eq for ItemStack {
    fn equals(&self, other: &ItemStack) -> Bool {
        return self.item_id == other.item_id && self.count == other.count;
    }
}

fn main() {
    let sword = ItemStack { item_id: 100, count: 1 };
    let apples = ItemStack { item_id: 5, count: 64 };
    let gold = ItemStack { item_id: 42, count: 999 };

    var m = hash_map2_new(sword, "iron sword");
    m.register(apples, "food");
    m.register(gold, "currency");

    match m.get(sword) {
        Some { value } => { print(value); }
        None => { print("MISS"); }
    }
    match m.get(apples) {
        Some { value } => { print(value); }
        None => { print("MISS"); }
    }
    match m.get(gold) {
        Some { value } => { print(value); }
        None => { print("MISS"); }
    }

    // A DIFFERENT ItemStack instance with the same fields as `sword` -- real VALUE equality via
    // `Eq::equals`, should MATCH (treated as the same key, not a miss).
    let sword_lookalike = ItemStack { item_id: 100, count: 1 };
    match m.get(sword_lookalike) {
        Some { value } => { print("FOUND (expected): {value}"); }
        None => { print("MISS (unexpected)"); }
    }

    print(m.length());
    print(m.contains_key(gold));

    m.remove(apples);
    print(m.contains_key(apples));
    print(m.length());

    // Re-register the SAME sword reference with a new value -- overwrite, not a new entry.
    m.register(sword, "steel sword");
    match m.get(sword) {
        Some { value } => { print(value); }
        None => { print("MISS"); }
    }
    print(m.length());

    // Re-register via the LOOKALIKE (a different instance, equal fields) -- real value equality
    // means this is STILL an overwrite of the same logical key, not a third distinct entry.
    m.register(sword_lookalike, "reforged sword");
    match m.get(sword) {
        Some { value } => { print(value); }
        None => { print("MISS"); }
    }
    print(m.length());

    print("done");
}
