// Basic macros -- see IDEAS.md's own "Macros" entry. Two shapes: `macro name(p1, ...) { expr }`
// (an EXPRESSION macro, invoked `name!(args)` anywhere a value is expected) and `macro name(p1,
// ...) { stmt1; stmt2; ... }` (a STATEMENT macro, invoked `name!(args);` only at statement
// position, spliced directly into the enclosing block). AST-level substitution, not textual --
// the expanded code flows through the checker completely normally. See ARCHITECTURE.md for the
// full design writeup, including the real hygiene story for statement macros.

extern class JMath = "java.lang.Math" {
    static fn min(a: Int, b: Int) -> Int;
    static fn max(a: Int, b: Int) -> Int;
}

// The exact motivating repetition IDEAS.md's own "Macros" entry calls out: a min-of-three
// pattern, hand-duplicated across X/Y/Z components in real project code.
macro min3(a, b, c) {
    JMath::min(JMath::min(a, b), c)
}

macro max3(a, b, c) {
    JMath::max(JMath::max(a, b), c)
}

// A macro's argument can be an arbitrary expression, not just a bare variable -- substitution
// splices the whole caller-supplied Expr tree in, unevaluated, everywhere the param appears.
macro square(x) {
    x * x
}

// An earlier-declared macro can be called from a LATER macro's own body -- expansion is eager
// (happens once, when the outer macro is declared), so this composes correctly: `quad_it`'s own
// stored body ends up as `(y * 2) * 2`, and `quad_it!(5)` only substitutes its own `y` at its
// call site, same as any other expression macro.
macro double_it(x) {
    x * 2
}
macro quad_it(y) {
    double_it!(double_it!(y))
}

// A STATEMENT macro -- its body is a statement list, not one expression, so it's invoked
// `name!(args);` only at statement position, never nested inside a larger expression. Real
// boilerplate this actually earns its keep on: a "clamp, then report" sequence that would
// otherwise be hand-duplicated at every call site.
macro clamp(x, lo, hi) {
    JMath::max(JMath::min(x, hi), lo)
}

macro report_clamped(label, x, lo, hi) {
    let clamped = clamp!(x, lo, hi);
    print(label);
    print(clamped);
}

struct Point { x: Int, y: Int, z: Int }

fn main() {
    let p1 = Point { x: 3, y: 8, z: 1 };
    let p2 = Point { x: 7, y: 2, z: 9 };

    print(min3!(p1.x, p2.x, 5));
    print(max3!(p1.y, p2.y, 5));

    // `square(2 + 3)` expands to `(2 + 3) * (2 + 3)`, not `2 + 3 * 2 + 3` -- confirms the
    // substituted argument expression is spliced in as one unit, not re-tokenized.
    print(square!(2 + 3));

    print(quad_it!(5));

    // `report_clamped!` declares its own local `clamped` -- calling it TWICE in the same scope
    // would collide on that name without hygiene. Each expansion site gensyms its own top-level
    // `let` (`clamped__mexpN`), so this compiles and runs cleanly.
    report_clamped!("first", 999, 0, 10);
    report_clamped!("second", -5, 0, 10);

    print("done");
}
